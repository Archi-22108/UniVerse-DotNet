@{
    var activePage = (ViewBag.ActivePage as string ?? "").ToLowerInvariant();
    if (string.IsNullOrEmpty(activePage))
    {
        var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
        activePage = action switch
        {
            "requests" => "requests",
            "runner" or "runnerhub" => "runner",
            "wallet" => "wallet",
            "marketplace" => "marketplace",
            "chat" => "chat",
            "analytics" => "analytics",
            "profile" => "profile",
            "settings" => "settings",
            _ => "dashboard"
        };
    }
    int liveCount = ViewBag.ActiveRequestsCount is int c ? c : (ViewBag.ActiveCount is int ac ? ac : 1);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "UniVerse") · Campus Super-App</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-canvas: #050A07;
            --bg-card: rgba(10, 15, 12, 0.65);
            --bg-sidebar: #050A07;
            --accent-green: #00E676;
            --emerald-500: #10B981;
            --emerald-400: #34D399;
            --text-muted: #A7B8B0;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-green: rgba(102, 255, 178, 0.12);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            background-color: var(--bg-canvas);
            color: #ffffff;
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Ambient Glow Lights ─── */
        .ambient-glow {
            position: fixed;
            pointer-events: none;
            border-radius: 50%;
            z-index: 0;
            filter: blur(140px);
        }
        .glow-1 { top: -15%; left: 15%; width: 650px; height: 650px; background: rgba(16, 185, 129, 0.12); }
        .glow-2 { top: 35%; left: 20%; width: 520px; height: 520px; background: rgba(16, 185, 129, 0.15); filter: blur(110px); }
        .glow-3 { top: 45%; right: -5%; width: 500px; height: 500px; background: rgba(5, 150, 105, 0.12); }
        .glow-4 { bottom: -10%; left: -5%; width: 500px; height: 500px; background: rgba(20, 184, 166, 0.08); }

        /* ─── Sidebar Navigation (Desktop) ─── */
        .uv-sidebar {
            width: 240px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-green);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 50;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .uv-brand-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 32px;
            padding-left: 6px;
        }

        .uv-brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px rgba(0, 230, 118, 0.4);
        }

        .uv-brand-icon i {
            color: #050A07;
            font-size: 18px;
        }

        .uv-brand-name {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-heading);
            letter-spacing: -0.02em;
        }

        .uv-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            list-style: none;
        }

        .uv-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.2s ease;
            position: relative;
        }

        .uv-nav-link i {
            font-size: 17px;
            flex-shrink: 0;
        }

        .uv-nav-link:hover {
            color: var(--accent-green);
            background: rgba(0, 230, 118, 0.05);
        }

        .uv-nav-link.active {
            background: rgba(0, 230, 118, 0.1);
            color: var(--accent-green);
            font-weight: 700;
        }

        .uv-nav-badge {
            margin-left: auto;
            background: rgba(16, 185, 129, 0.18);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.45);
            font-size: 10.5px;
            font-weight: 800;
            padding: 2.5px 8px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4.5px;
        }

        .uv-dot-indicator {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-green);
            margin-left: auto;
            box-shadow: 0 0 6px var(--accent-green);
        }

        .uv-logout-wrap {
            padding-top: 16px;
            border-top: 1px solid var(--border-green);
        }

        .uv-logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            color: #ef4444;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .uv-logout-btn:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }

        /* ─── Main Content Area ─── */
        .uv-main-content {
            flex: 1;
            margin-left: 240px;
            min-width: 0;
            position: relative;
            z-index: 10;
            padding: 24px 32px 64px;
        }

        @@media (max-width: 1024px) {
            .uv-sidebar { display: none; }
            .uv-main-content { margin-left: 0; padding: 16px 16px 48px; }
        }

        /* ─── Mobile Header (<1024px) ─── */
        .uv-mobile-header {
            display: none;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(5, 10, 7, 0.95);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-green);
            padding: 12px 16px;
            align-items: center;
            justify-content: space-between;
            z-index: 40;
        }

        @@media (max-width: 1024px) {
            .uv-mobile-header { display: flex; }
        }

        /* Mobile Drawer */
        .uv-drawer-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            z-index: 99;
        }

        .uv-drawer {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 280px;
            background: #060c08;
            border-right: 1px solid var(--border-green);
            z-index: 100;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .uv-drawer.open {
            transform: translateX(0);
        }

        .uv-drawer-backdrop.open {
            display: block;
        }

        /* Toast Container */
        .uv-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            background: rgba(10, 20, 15, 0.95);
            border: 1px solid var(--accent-green);
            color: #ffffff;
            padding: 14px 20px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 230, 118, 0.25);
            backdrop-filter: blur(12px);
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            font-weight: 600;
            animation: slideInToast 0.3s ease;
        }

        @@keyframes slideInToast {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Atmospheric Ambient Cosmic Glows -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>
    <div class="ambient-glow glow-4"></div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         1. DESKTOP SIDEBAR (240px Fixed)
    ═══════════════════════════════════════════════════════════════════════ -->
    <aside class="uv-sidebar">
        <!-- Brand / Logo -->
        <a href="/" class="uv-brand-wrap">
            <div class="uv-brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <span class="uv-brand-name">UniVerse</span>
        </a>

        <!-- Navigation Links -->
        <ul class="uv-nav-list">
            <li>
                <a href="/" class="uv-nav-link">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge">
                            <i class="bi bi-circle-fill" style="font-size: 6px;"></i> @liveCount live
                        </span>
                    }
                </a>
            </li>
            <li>
                <a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")">
                    <i class="bi bi-bicycle"></i>
                    <span>Runner Mode</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Wallet" class="uv-nav-link @(activePage == "wallet" ? "active" : "")">
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                    <span class="uv-dot-indicator"></span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")">
                    <i class="bi bi-bag"></i>
                    <span>Marketplace</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")">
                    <i class="bi bi-chat-dots"></i>
                    <span>Chat Support</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Analytics" class="uv-nav-link @(activePage == "analytics" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Profile" class="uv-nav-link @(activePage == "profile" ? "active" : "")">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Settings" class="uv-nav-link @(activePage == "settings" ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <!-- Logout Bottom -->
        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════════════
         2. MOBILE HEADER BAR (<1024px)
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="uv-mobile-header">
        <button id="mobileMenuBtn" style="background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; display: flex; align-items: center;" aria-label="Toggle Menu">
            <i class="bi bi-list"></i>
        </button>

        <a href="/" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
            <div class="uv-brand-icon" style="width: 28px; height: 28px;">
                <i class="bi bi-lightning-charge-fill" style="font-size: 15px;"></i>
            </div>
            <span class="uv-brand-name" style="font-size: 18px;">UniVerse</span>
        </a>

        <div style="display: flex; align-items: center; gap: 8px;">
            <a href="/Delivery/Create" style="display: inline-flex; align-items: center; gap: 4px; background: linear-gradient(90deg, #10B981, #34D399); color: #022c22; font-weight: 800; font-size: 11px; padding: 6px 12px; border-radius: 10px; text-decoration: none;">
                <i class="bi bi-plus-lg"></i>
                <span>New</span>
            </a>
            <a href="/Dashboard/Requests" style="width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                <i class="bi bi-box-seam" style="font-size: 14px;"></i>
            </a>
        </div>
    </header>

    <!-- Mobile Drawer & Backdrop -->
    <div id="drawerBackdrop" class="uv-drawer-backdrop"></div>
    <div id="mobileDrawer" class="uv-drawer">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
            <a href="/" class="uv-brand-wrap" style="margin-bottom: 0;">
                <div class="uv-brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <span class="uv-brand-name">UniVerse</span>
            </a>
            <button id="closeDrawerBtn" style="background: none; border: none; color: #A7B8B0; font-size: 20px; cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <ul class="uv-nav-list">
            <li><a href="/" class="uv-nav-link"><i class="bi bi-house-door"></i><span>Home</span></a></li>
            <li><a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a></li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge"><i class="bi bi-circle-fill" style="font-size: 6px;"></i> @liveCount live</span>
                    }
                </a>
            </li>
            <li><a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")"><i class="bi bi-bicycle"></i><span>Runner Mode</span></a></li>
            <li><a href="/Dashboard/Wallet" class="uv-nav-link @(activePage == "wallet" ? "active" : "")"><i class="bi bi-wallet2"></i><span>Wallet</span></a></li>
            <li><a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")"><i class="bi bi-bag"></i><span>Marketplace</span></a></li>
            <li><a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")"><i class="bi bi-chat-dots"></i><span>Chat Support</span></a></li>
            <li><a href="/Dashboard/Analytics" class="uv-nav-link @(activePage == "analytics" ? "active" : "")"><i class="bi bi-bar-chart"></i><span>Analytics</span></a></li>
            <li><a href="/Dashboard/Profile" class="uv-nav-link @(activePage == "profile" ? "active" : "")"><i class="bi bi-person"></i><span>Profile</span></a></li>
            <li><a href="/Dashboard/Settings" class="uv-nav-link @(activePage == "settings" ? "active" : "")"><i class="bi bi-gear"></i><span>Settings</span></a></li>
        </ul>

        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         3. MAIN CONTENT CONTAINER
    ═══════════════════════════════════════════════════════════════════════ -->
    <main class="uv-main-content">
        @RenderBody()
    </main>

    <!-- Global Toast Notification -->
    <div id="uvGlobalToast" class="uv-toast">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 18px;"></i>
        <span id="uvToastMsg">Action completed successfully</span>
    </div>

    <script>
        // Drawer toggle
        const menuBtn = document.getElementById('mobileMenuBtn');
        const closeBtn = document.getElementById('closeDrawerBtn');
        const drawer = document.getElementById('mobileDrawer');
        const backdrop = document.getElementById('drawerBackdrop');

        function toggleDrawer(open) {
            if (open) {
                drawer.classList.add('open');
                backdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            } else {
                drawer.classList.remove('open');
                backdrop.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        if (menuBtn) menuBtn.addEventListener('click', () => toggleDrawer(true));
        if (closeBtn) closeBtn.addEventListener('click', () => toggleDrawer(false));
        if (backdrop) backdrop.addEventListener('click', () => toggleDrawer(false));

        // Toast Helper
        window.showToast = function(msg, isError = false) {
            const toast = document.getElementById('uvGlobalToast');
            const toastMsg = document.getElementById('uvToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.style.borderColor = isError ? '#ef4444' : 'var(--accent-green)';
                toast.querySelector('i').className = isError ? 'bi bi-exclamation-circle-fill' : 'bi bi-check-circle-fill';
                toast.querySelector('i').style.color = isError ? '#ef4444' : 'var(--accent-green)';
                toast.style.display = 'flex';
                setTimeout(() => { toast.style.display = 'none'; }, 4000);
            }
        };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
