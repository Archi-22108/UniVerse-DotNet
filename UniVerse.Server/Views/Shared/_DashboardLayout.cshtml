@{
    var activePage = (ViewBag.ActivePage as string ?? "").ToLowerInvariant();
    if (string.IsNullOrEmpty(activePage))
    {
        var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
        activePage = action switch
        {
            "requests" => "requests",
            "runner" or "runnerhub" => "runner",
            "wallet" => "wallet",
            "marketplace" => "marketplace",
            "chat" => "chat",
            "analytics" => "analytics",
            "profile" => "profile",
            "settings" => "settings",
            _ => "dashboard"
        };
    }
    int liveCount = ViewBag.ActiveRequestsCount is int c ? c : (ViewBag.ActiveCount is int ac ? ac : 2);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "UniVerse") · Campus Super-App</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Three.js CDN for Authentic Cosmic Space Starfield & Celestial Planet Background -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-canvas: #020604;
            --bg-card: rgba(10, 15, 12, 0.6);
            --bg-sidebar: #050A07;
            --accent-green: #00E676;
            --emerald-500: #10B981;
            --emerald-400: #34D399;
            --text-muted: #A7B8B0;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-green: rgba(102, 255, 178, 0.1);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            background-color: var(--bg-canvas);
            color: #ffffff;
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ─── Atmospheric Cosmic Background & Deep Ambient Nebulae ─── */
        .cosmic-bg-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
            background-color: #020604;
        }

        .glow-nebula-spot {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 70% 30%, rgba(0, 230, 118, 0.25) 0%, transparent 60%);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-1 {
            position: absolute;
            top: -15%;
            left: 15%;
            width: 650px;
            height: 650px;
            background: rgba(16, 185, 129, 0.15);
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-2 {
            position: absolute;
            top: 35%;
            left: 20%;
            width: 520px;
            height: 520px;
            background: rgba(16, 185, 129, 0.20);
            border-radius: 50%;
            filter: blur(110px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-3 {
            position: absolute;
            top: 45%;
            right: -5%;
            width: 500px;
            height: 500px;
            background: rgba(5, 150, 105, 0.15);
            border-radius: 50%;
            filter: blur(130px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-4 {
            position: absolute;
            bottom: -10%;
            left: -5%;
            width: 500px;
            height: 500px;
            background: rgba(20, 184, 166, 0.10);
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 1;
        }

        #cosmicSpaceCanvas {
            position: absolute;
            inset: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 2;
        }

        /* ─── Sidebar Navigation (Desktop Fixed 240px) ─── */
        .uv-sidebar {
            width: 240px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-green);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 50;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .uv-brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 32px;
            padding-left: 6px;
        }

        .uv-brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px rgba(0, 230, 118, 0.4);
            flex-shrink: 0;
        }

        .uv-brand-icon i {
            color: #050A07;
            font-size: 18px;
        }

        .uv-brand-name {
            font-size: 21px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-heading);
            letter-spacing: -0.02em;
        }

        .uv-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            list-style: none;
        }

        .uv-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.2s ease;
            position: relative;
        }

        .uv-nav-link i {
            font-size: 17px;
            flex-shrink: 0;
        }

        .uv-nav-link:hover {
            color: var(--accent-green);
            background: rgba(0, 230, 118, 0.05);
        }

        .uv-nav-link.active {
            background: rgba(0, 230, 118, 0.12);
            color: var(--accent-green);
            font-weight: 700;
        }

        .uv-nav-badge {
            margin-left: auto;
            background: rgba(0, 230, 118, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(0, 230, 118, 0.35);
            font-size: 10.5px;
            font-family: var(--font-mono);
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4.5px;
        }

        .uv-dot-indicator {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-green);
            margin-left: auto;
            box-shadow: 0 0 8px var(--accent-green);
        }

        .uv-logout-wrap {
            padding-top: 16px;
            border-top: 1px solid var(--border-green);
        }

        .uv-logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 12px;
            color: #ef4444;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .uv-logout-btn:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }

        /* ─── Main Content Area ─── */
        .uv-main-content {
            flex: 1;
            margin-left: 240px;
            min-width: 0;
            position: relative;
            z-index: 10;
            padding: 24px 32px 64px;
        }

        @@media (max-width: 1024px) {
            .uv-sidebar { display: none; }
            .uv-main-content { margin-left: 0; padding: 16px 16px 48px; }
        }

        /* ─── Mobile Header (<1024px) ─── */
        .uv-mobile-header {
            display: none;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(5, 10, 7, 0.95);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-green);
            padding: 12px 16px;
            align-items: center;
            justify-content: space-between;
            z-index: 40;
        }

        @@media (max-width: 1024px) {
            .uv-mobile-header { display: flex; }
        }

        /* Mobile Drawer */
        .uv-drawer-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            z-index: 99;
        }

        .uv-drawer {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 280px;
            background: #060c08;
            border-right: 1px solid var(--border-green);
            z-index: 100;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .uv-drawer.open { transform: translateX(0); }
        .uv-drawer-backdrop.open { display: block; }

        /* Toast Container */
        .uv-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            background: rgba(10, 20, 15, 0.95);
            border: 1px solid var(--accent-green);
            color: #ffffff;
            padding: 14px 20px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 230, 118, 0.25);
            backdrop-filter: blur(12px);
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            font-weight: 600;
            animation: slideInToast 0.3s ease;
        }

        @@keyframes slideInToast {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- ═══════════════════════════════════════════════════════════════════════
         COSMIC SPACE BACKGROUND & ATMOSPHERIC NEBULAE
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="cosmic-bg-container">
        <!-- Deep Ambient Cosmic Glow Nebulae -->
        <div class="glow-nebula-spot"></div>
        <div class="glow-nebula-1"></div>
        <div class="glow-nebula-2"></div>
        <div class="glow-nebula-3"></div>
        <div class="glow-nebula-4"></div>

        <!-- Live 3D Three.js Starfield, Rotating Planets & Celestial Scene -->
        <canvas id="cosmicSpaceCanvas"></canvas>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         1. DESKTOP SIDEBAR (240px Fixed)
    ═══════════════════════════════════════════════════════════════════════ -->
    <aside class="uv-sidebar">
        <!-- Brand / Logo -->
        <a href="/" class="uv-brand-wrap">
            <div class="uv-brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <span class="uv-brand-name">UniVerse</span>
        </a>

        <!-- Navigation Links -->
        <ul class="uv-nav-list">
            <li>
                <a href="/" class="uv-nav-link">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge">
                            <i class="bi bi-circle-fill" style="font-size: 5px;"></i> @liveCount live
                        </span>
                    }
                </a>
            </li>
            <li>
                <a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")">
                    <i class="bi bi-bicycle"></i>
                    <span>Runner Mode</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Wallet" class="uv-nav-link @(activePage == "wallet" ? "active" : "")">
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                    <span class="uv-dot-indicator"></span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")">
                    <i class="bi bi-bag"></i>
                    <span>Marketplace</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")">
                    <i class="bi bi-chat-dots"></i>
                    <span>Chat Support</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Analytics" class="uv-nav-link @(activePage == "analytics" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Profile" class="uv-nav-link @(activePage == "profile" ? "active" : "")">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Settings" class="uv-nav-link @(activePage == "settings" ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <!-- Logout Bottom -->
        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════════════
         2. MOBILE HEADER BAR (<1024px)
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="uv-mobile-header">
        <button id="mobileMenuBtn" style="background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; display: flex; align-items: center;" aria-label="Toggle Menu">
            <i class="bi bi-list"></i>
        </button>

        <a href="/" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
            <div class="uv-brand-icon" style="width: 28px; height: 28px;">
                <i class="bi bi-lightning-charge-fill" style="font-size: 15px;"></i>
            </div>
            <span class="uv-brand-name" style="font-size: 18px;">UniVerse</span>
        </a>

        <div style="display: flex; align-items: center; gap: 8px;">
            <a href="/Delivery/Create" style="display: inline-flex; align-items: center; gap: 4px; background: linear-gradient(90deg, #10B981, #34D399); color: #022c22; font-weight: 800; font-size: 11px; padding: 6px 12px; border-radius: 10px; text-decoration: none;">
                <i class="bi bi-plus-lg"></i>
                <span>New</span>
            </a>
            <a href="/Dashboard/Requests" style="width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                <i class="bi bi-box-seam" style="font-size: 14px;"></i>
            </a>
        </div>
    </header>

    <!-- Mobile Drawer & Backdrop -->
    <div id="drawerBackdrop" class="uv-drawer-backdrop"></div>
    <div id="mobileDrawer" class="uv-drawer">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
            <a href="/" class="uv-brand-wrap" style="margin-bottom: 0;">
                <div class="uv-brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <span class="uv-brand-name">UniVerse</span>
            </a>
            <button id="closeDrawerBtn" style="background: none; border: none; color: #A7B8B0; font-size: 20px; cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <ul class="uv-nav-list">
            <li><a href="/" class="uv-nav-link"><i class="bi bi-house"></i><span>Home</span></a></li>
            <li><a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a></li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge"><i class="bi bi-circle-fill" style="font-size: 5px;"></i> @liveCount live</span>
                    }
                </a>
            </li>
            <li><a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")"><i class="bi bi-bicycle"></i><span>Runner Mode</span></a></li>
            <li><a href="/Dashboard/Wallet" class="uv-nav-link @(activePage == "wallet" ? "active" : "")"><i class="bi bi-wallet2"></i><span>Wallet</span></a></li>
            <li><a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")"><i class="bi bi-bag"></i><span>Marketplace</span></a></li>
            <li><a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")"><i class="bi bi-chat-dots"></i><span>Chat Support</span></a></li>
            <li><a href="/Dashboard/Analytics" class="uv-nav-link @(activePage == "analytics" ? "active" : "")"><i class="bi bi-bar-chart"></i><span>Analytics</span></a></li>
            <li><a href="/Dashboard/Profile" class="uv-nav-link @(activePage == "profile" ? "active" : "")"><i class="bi bi-person"></i><span>Profile</span></a></li>
            <li><a href="/Dashboard/Settings" class="uv-nav-link @(activePage == "settings" ? "active" : "")"><i class="bi bi-gear"></i><span>Settings</span></a></li>
        </ul>

        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         3. MAIN CONTENT CONTAINER
    ═══════════════════════════════════════════════════════════════════════ -->
    <main class="uv-main-content">
        @RenderBody()
    </main>

    <!-- Global Toast Notification -->
    <div id="uvGlobalToast" class="uv-toast">
        <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 18px;"></i>
        <span id="uvToastMsg">Action completed successfully</span>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         COSMIC THREE.JS ENGINE (Exact match to Next.js SpaceBackground.tsx)
    ═══════════════════════════════════════════════════════════════════════ -->
    <script>
        (function() {
            const canvas = document.getElementById('cosmicSpaceCanvas');
            if (!canvas) return;

            // If Three.js is loaded, initialize 3D Celestial scene exactly as Next.js SpaceBackground.tsx
            if (typeof THREE !== 'undefined') {
                try {
                    const scene = new THREE.Scene();
                    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
                    camera.position.set(0, 0, 3);

                    const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
                    renderer.setSize(window.innerWidth, window.innerHeight);
                    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

                    const spaceGroup = new THREE.Group();
                    scene.add(spaceGroup);

                    // Ambient & Directional Lights matching SpaceBackground.tsx
                    const ambientLight = new THREE.AmbientLight(0xffffff, 0.25);
                    spaceGroup.add(ambientLight);

                    const dirLight = new THREE.DirectionalLight(0x66FFB2, 1.0);
                    dirLight.position.set(5, 5, 5);
                    spaceGroup.add(dirLight);

                    const ptLight = new THREE.PointLight(0x00C853, 0.6);
                    ptLight.position.set(-5, -5, -5);
                    spaceGroup.add(ptLight);

                    // 1. Main Celestial Planet (lower left in space)
                    const p1Geo = new THREE.SphereGeometry(0.42, 64, 64);
                    const p1Mat = new THREE.MeshStandardMaterial({
                        color: 0x00E676,
                        roughness: 0.85,
                        metalness: 0.15,
                        emissive: 0x00E676,
                        emissiveIntensity: 0.15,
                        transparent: true,
                        opacity: 0.65
                    });
                    const planet1 = new THREE.Mesh(p1Geo, p1Mat);
                    planet1.position.set(-2.4, -1.6, -1.8);
                    spaceGroup.add(planet1);

                    // 2. Small Wireframe Planet (top right)
                    const p2Geo = new THREE.SphereGeometry(0.18, 24, 24);
                    const p2Mat = new THREE.MeshStandardMaterial({
                        color: 0x66FFB2,
                        wireframe: true,
                        roughness: 0.85,
                        metalness: 0.15,
                        emissive: 0x66FFB2,
                        emissiveIntensity: 0.18,
                        transparent: true,
                        opacity: 0.65
                    });
                    const planet2 = new THREE.Mesh(p2Geo, p2Mat);
                    planet2.position.set(1.6, 1.4, -2.5);
                    spaceGroup.add(planet2);

                    // 3. Rotating Starfield (1,667 emerald green points in a sphere of radius 5)
                    const starCount = 1667;
                    const starPositions = new Float32Array(starCount * 3);
                    for (let i = 0; i < starCount; i++) {
                        const u = Math.random();
                        const v = Math.random();
                        const theta = u * 2.0 * Math.PI;
                        const phi = Math.acos(2.0 * v - 1.0);
                        const r = Math.cbrt(Math.random()) * 5.0;
                        const sinPhi = Math.sin(phi);
                        starPositions[i * 3] = r * sinPhi * Math.cos(theta);
                        starPositions[i * 3 + 1] = r * sinPhi * Math.sin(theta);
                        starPositions[i * 3 + 2] = r * Math.cos(phi);
                    }

                    const starGeo = new THREE.BufferGeometry();
                    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));

                    // Soft star circular particle texture
                    const c2d = document.createElement('canvas');
                    c2d.width = 16;
                    c2d.height = 16;
                    const ctx2d = c2d.getContext('2d');
                    const grad = ctx2d.createRadialGradient(8, 8, 0, 8, 8, 8);
                    grad.addColorStop(0, 'rgba(0, 230, 118, 1)');
                    grad.addColorStop(0.4, 'rgba(102, 255, 178, 0.6)');
                    grad.addColorStop(1, 'rgba(0, 230, 118, 0)');
                    ctx2d.fillStyle = grad;
                    ctx2d.fillRect(0, 0, 16, 16);
                    const starTex = new THREE.CanvasTexture(c2d);

                    const starMat = new THREE.PointsMaterial({
                        color: 0x00E676,
                        size: 0.045,
                        map: starTex,
                        transparent: true,
                        depthWrite: false,
                        blending: THREE.AdditiveBlending
                    });

                    const starGroup = new THREE.Group();
                    starGroup.rotation.set(0, 0, Math.PI / 4);
                    const starField = new THREE.Points(starGeo, starMat);
                    starGroup.add(starField);
                    spaceGroup.add(starGroup);

                    // Parallax interaction with mouse
                    let targetRotX = 0, targetRotY = 0;
                    window.addEventListener('mousemove', function(e) {
                        const ptrX = (e.clientX / window.innerWidth) * 2 - 1;
                        const ptrY = -(e.clientY / window.innerHeight) * 2 + 1;
                        targetRotX = (ptrX * Math.PI) / 20;
                        targetRotY = (ptrY * Math.PI) / 20;
                    });

                    // Dynamic Resize
                    window.addEventListener('resize', function() {
                        camera.aspect = window.innerWidth / window.innerHeight;
                        camera.updateProjectionMatrix();
                        renderer.setSize(window.innerWidth, window.innerHeight);
                    });

                    // Render Loop
                    let lastTime = performance.now();
                    function render(time) {
                        requestAnimationFrame(render);
                        const delta = (time - lastTime) / 1000;
                        lastTime = time;

                        // Mouse parallax smooth lerp
                        spaceGroup.rotation.y += (targetRotX - spaceGroup.rotation.y) * 0.05;
                        spaceGroup.rotation.x += (-targetRotY - spaceGroup.rotation.x) * 0.05;

                        // Continuous starfield drift
                        starField.rotation.x -= delta / 20;
                        starField.rotation.y -= delta / 30;

                        // Celestial planets spin
                        planet1.rotation.y += 0.02 * delta;
                        planet1.rotation.x += 0.01 * delta;

                        planet2.rotation.y += 0.06 * delta;
                        planet2.rotation.x += 0.03 * delta;

                        renderer.render(scene, camera);
                    }
                    requestAnimationFrame(render);
                    return; // Successfully initialized Three.js scene
                } catch(err) {
                    console.warn("Three.js initialization fallback:", err);
                }
            }

            // ─── Lightweight Canvas 2D Fallback in case of offline/no-WebGL ───
            const ctx = canvas.getContext('2d');
            let w, h;
            let stars = [];
            function resize2d() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            }
            resize2d();
            window.addEventListener('resize', resize2d);
            for (let i = 0; i < 300; i++) {
                stars.push({
                    x: (Math.random() - 0.5) * 2000,
                    y: (Math.random() - 0.5) * 2000,
                    z: Math.random() * 1500 + 20,
                    size: Math.random() * 1.5 + 0.6,
                    color: Math.random() > 0.3 ? '#00E676' : '#66FFB2',
                    alpha: Math.random() * 0.7 + 0.3
                });
            }
            let rotX = 0, rotY = 0, targetX = 0, targetY = 0;
            window.addEventListener('mousemove', (e) => {
                targetX = (e.clientX / w - 0.5) * 0.15;
                targetY = (e.clientY / h - 0.5) * 0.15;
            });
            function render2d() {
                ctx.clearRect(0, 0, w, h);
                rotX += (targetX - rotX) * 0.05;
                rotY += (targetY - rotY) * 0.05;
                const cosX = Math.cos(rotX), sinX = Math.sin(rotX);
                const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
                for (let i = 0; i < stars.length; i++) {
                    const s = stars[i];
                    s.z -= 0.6;
                    if (s.z <= 0) s.z = 1500;
                    let x1 = s.x * cosY - s.z * sinY;
                    let z1 = s.z * cosY + s.x * sinY;
                    let y1 = s.y * cosX - z1 * sinX;
                    let z2 = z1 * cosX + s.y * sinX;
                    const fov = 380;
                    const px = (x1 / (z2 + fov)) * w + w / 2;
                    const py = (y1 / (z2 + fov)) * h + h / 2;
                    if (px >= 0 && px <= w && py >= 0 && py <= h && z2 > -fov) {
                        const radius = Math.max(0.6, s.size * (fov / (z2 + fov)));
                        ctx.beginPath();
                        ctx.arc(px, py, radius, 0, Math.PI * 2);
                        ctx.fillStyle = s.color;
                        ctx.globalAlpha = Math.min(1, Math.max(0.1, (1 - z2 / 1500) * s.alpha));
                        ctx.fill();
                    }
                }
                ctx.globalAlpha = 1;
                requestAnimationFrame(render2d);
            }
            requestAnimationFrame(render2d);
        })();

        // Drawer toggle
        const menuBtn = document.getElementById('mobileMenuBtn');
        const closeBtn = document.getElementById('closeDrawerBtn');
        const drawer = document.getElementById('mobileDrawer');
        const backdrop = document.getElementById('drawerBackdrop');

        function toggleDrawer(open) {
            if (open) {
                drawer.classList.add('open');
                backdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            } else {
                drawer.classList.remove('open');
                backdrop.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        if (menuBtn) menuBtn.addEventListener('click', () => toggleDrawer(true));
        if (closeBtn) closeBtn.addEventListener('click', () => toggleDrawer(false));
        if (backdrop) backdrop.addEventListener('click', () => toggleDrawer(false));

        // Toast Helper
        window.showToast = function(msg, isError = false) {
            const toast = document.getElementById('uvGlobalToast');
            const toastMsg = document.getElementById('uvToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.style.borderColor = isError ? '#ef4444' : 'var(--accent-green)';
                toast.querySelector('i').className = isError ? 'bi bi-exclamation-circle-fill' : 'bi bi-check-circle-fill';
                toast.querySelector('i').style.color = isError ? '#ef4444' : 'var(--accent-green)';
                toast.style.display = 'flex';
                setTimeout(() => { toast.style.display = 'none'; }, 4000);
            }
        };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
