@{
    var activePage = (ViewBag.ActivePage as string ?? "").ToLowerInvariant();
    if (string.IsNullOrEmpty(activePage))
    {
        var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
        activePage = action switch
        {
            "requests" => "requests",
            "runner" or "runnerhub" => "runner",
            "marketplace" => "marketplace",
            "chat" => "chat",
            "analytics" => "analytics",
            "profile" => "profile",
            "settings" => "settings",
            _ => "dashboard"
        };
    }
    int liveCount = ViewBag.ActiveRequestsCount is int c ? c : (ViewBag.ActiveCount is int ac ? ac : 2);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? "UniVerse") · Campus Super-App</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Three.js CDN for Authentic Cosmic Space Starfield & Celestial Planet Background -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-canvas: #020604;
            --bg-card: rgba(10, 15, 12, 0.6);
            --bg-sidebar: #050A07;
            --accent-green: #00E676;
            --emerald-500: #10B981;
            --emerald-400: #34D399;
            --text-muted: #A7B8B0;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-green: rgba(102, 255, 178, 0.1);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            background-color: var(--bg-canvas);
            color: #ffffff;
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ─── Atmospheric Cosmic Background & Deep Ambient Nebulae ─── */
        .cosmic-bg-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
            background-color: #020604;
        }

        .glow-nebula-spot {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 70% 30%, rgba(0, 230, 118, 0.25) 0%, transparent 60%);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-1 {
            position: absolute;
            top: -15%;
            left: 15%;
            width: 650px;
            height: 650px;
            background: rgba(16, 185, 129, 0.15);
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-2 {
            position: absolute;
            top: 35%;
            left: 20%;
            width: 520px;
            height: 520px;
            background: rgba(16, 185, 129, 0.20);
            border-radius: 50%;
            filter: blur(110px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-3 {
            position: absolute;
            top: 45%;
            right: -5%;
            width: 500px;
            height: 500px;
            background: rgba(5, 150, 105, 0.15);
            border-radius: 50%;
            filter: blur(130px);
            pointer-events: none;
            z-index: 1;
        }

        .glow-nebula-4 {
            position: absolute;
            bottom: -10%;
            left: -5%;
            width: 500px;
            height: 500px;
            background: rgba(20, 184, 166, 0.10);
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 1;
        }

        #cosmicSpaceCanvas {
            position: absolute;
            inset: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 2;
        }

        /* ─── Sidebar Navigation (Desktop Fixed 240px) ─── */
        .uv-sidebar {
            width: 240px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-green);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 50;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .uv-brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 32px;
            padding-left: 6px;
        }

        .uv-brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px rgba(0, 230, 118, 0.4);
            flex-shrink: 0;
        }

        .uv-brand-icon i {
            color: #050A07;
            font-size: 18px;
        }

        .uv-brand-name {
            font-size: 21px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-heading);
            letter-spacing: -0.02em;
        }

        .uv-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            list-style: none;
        }

        .uv-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.2s ease;
            position: relative;
        }

        .uv-nav-link i {
            font-size: 17px;
            flex-shrink: 0;
        }

        .uv-nav-link:hover {
            color: var(--accent-green);
            background: rgba(0, 230, 118, 0.05);
        }

        .uv-nav-link.active {
            background: rgba(0, 230, 118, 0.12);
            color: var(--accent-green);
            font-weight: 700;
        }

        .uv-nav-badge {
            margin-left: auto;
            background: rgba(0, 230, 118, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(0, 230, 118, 0.35);
            font-size: 10.5px;
            font-family: var(--font-mono);
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4.5px;
        }

        .uv-dot-indicator {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-green);
            margin-left: auto;
            box-shadow: 0 0 8px var(--accent-green);
        }

        .uv-logout-wrap {
            padding-top: 16px;
            border-top: 1px solid var(--border-green);
        }

        .uv-logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 12px;
            color: #ef4444;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .uv-logout-btn:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }

        /* ─── Main Content Area & Universal Viewport Adaptability ─── */
        .uv-main-content {
            flex: 1;
            margin-left: 240px;
            min-width: 0;
            position: relative;
            z-index: 10;
            padding: 24px 32px 64px;
            width: calc(100% - 240px);
            max-width: 100%;
            box-sizing: border-box;
            transition: margin-left 0.25s ease, padding 0.25s ease;
        }

        /* Large Displays & MacBooks (1025px - 1440px) */
        @@media (min-width: 1025px) and (max-width: 1440px) {
            .uv-main-content {
                padding: 22px 28px 60px;
            }
        }

        /* Tablets & iPads (768px - 1024px) */
        @@media (max-width: 1024px) {
            .uv-sidebar { display: none !important; }
            .uv-main-content {
                margin-left: 0 !important;
                width: 100% !important;
                padding: 18px 20px calc(80px + env(safe-area-inset-bottom, 0px));
            }
        }

        /* Mobile Phones & Phablets (< 768px) */
        @@media (max-width: 768px) {
            .uv-main-content {
                padding: 14px 14px calc(84px + env(safe-area-inset-bottom, 0px));
            }
        }

        /* Small Phones (iPhone SE, Galaxy Mini < 420px) */
        @@media (max-width: 420px) {
            .uv-main-content {
                padding: 10px 10px calc(88px + env(safe-area-inset-bottom, 0px));
            }
        }

        /* ─── Mobile Header (≤1024px) ─── */
        .uv-mobile-header {
            display: none;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(4, 9, 6, 0.94);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid var(--border-green);
            padding: 10px 16px;
            align-items: center;
            justify-content: space-between;
            z-index: 40;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        @@media (max-width: 1024px) {
            .uv-mobile-header { display: flex; }
        }

        /* ─── Mobile Bottom Navigation Bar (≤1024px) ─── */
        .uv-mobile-bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: calc(62px + env(safe-area-inset-bottom, 0px));
            padding-bottom: env(safe-area-inset-bottom, 0px);
            background: rgba(4, 9, 6, 0.94);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-top: 1px solid rgba(16, 185, 129, 0.22);
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.6);
            z-index: 85;
            align-items: center;
            justify-content: space-around;
            padding-left: 6px;
            padding-right: 6px;
            box-sizing: border-box;
        }

        @@media (max-width: 1024px) {
            .uv-mobile-bottom-nav {
                display: flex;
            }
        }

        .uv-bottom-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            color: #A7B8B0;
            text-decoration: none;
            font-size: 10px;
            font-weight: 700;
            padding: 6px 8px;
            border-radius: 12px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            background: transparent;
            border: none;
            cursor: pointer;
            user-select: none;
            min-width: 50px;
        }

        .uv-bottom-nav-item i {
            font-size: 18px;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .uv-bottom-nav-item:hover, .uv-bottom-nav-item.active {
            color: #00E676;
        }

        .uv-bottom-nav-item.active i {
            transform: translateY(-1px) scale(1.1);
            color: #00E676;
            text-shadow: 0 0 12px rgba(0, 230, 118, 0.6);
        }

        .uv-bottom-nav-item.active::after {
            content: "";
            position: absolute;
            top: 2px;
            width: 16px;
            height: 2px;
            border-radius: 9999px;
            background: #00E676;
            box-shadow: 0 0 8px #00E676;
        }

        /* Floating Center Plus Action Button */
        .uv-bottom-create-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            position: relative;
            top: -10px;
        }

        .uv-bottom-create-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #00E676 0%, #10B981 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #03140a;
            font-size: 19px;
            box-shadow: 0 0 18px rgba(0, 230, 118, 0.55), 0 4px 10px rgba(0, 0, 0, 0.5);
            border: 3px solid #050A07;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .uv-bottom-create-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 0 26px rgba(0, 230, 118, 0.8);
        }

        .uv-bottom-create-lbl {
            font-size: 9.5px;
            font-weight: 800;
            color: #34d399;
            margin-top: 2px;
            letter-spacing: 0.02em;
        }

        .uv-bottom-nav-icon-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .uv-bottom-badge {
            position: absolute;
            top: -4px;
            right: -8px;
            background: #ef4444;
            color: #fff;
            font-size: 9px;
            font-weight: 900;
            padding: 1px 4.5px;
            border-radius: 9999px;
            line-height: 1;
            border: 1px solid #050A07;
            box-shadow: 0 0 6px rgba(239, 68, 68, 0.6);
        }

        /* Mobile Drawer */
        .uv-drawer-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.78);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 99;
        }

        .uv-drawer {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: min(300px, 86vw);
            background: #050a07;
            border-right: 1px solid var(--border-green);
            z-index: 100;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            box-shadow: 10px 0 40px rgba(0, 0, 0, 0.8);
        }

        .uv-drawer.open { transform: translateX(0); }
        .uv-drawer-backdrop.open { display: block; }

        /* Toast Container */
        .uv-toast {
            position: fixed;
            bottom: calc(76px + env(safe-area-inset-bottom, 0px));
            right: 16px;
            max-width: calc(100vw - 32px);
            z-index: 9999;
            background: rgba(10, 20, 15, 0.95);
            border: 1px solid var(--accent-green);
            color: #ffffff;
            padding: 12px 18px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 230, 118, 0.25);
            backdrop-filter: blur(12px);
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            font-weight: 600;
            animation: slideInToast 0.3s ease;
        }

        @@media (min-width: 1025px) {
            .uv-toast {
                bottom: 24px;
                right: 24px;
            }
        }

        @@keyframes slideInToast {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (activePage == "dashboard")
    {
        <!-- ═══════════════════════════════════════════════════════════════════════
             COSMIC SPACE BACKGROUND & ATMOSPHERIC NEBULAE (Dashboard only)
        ═══════════════════════════════════════════════════════════════════════ -->
        <div class="cosmic-bg-container">
            <!-- Deep Ambient Cosmic Glow Nebulae matching universe/src/app/dashboard/page.tsx -->
            <div class="glow-nebula-spot"></div>
            <div class="glow-nebula-1"></div>
            <div class="glow-nebula-2"></div>
            <div class="glow-nebula-3"></div>
            <div class="glow-nebula-4"></div>

            <!-- Floating cosmic particles background with opacity-50 matching page.tsx line 113 -->
            <div style="position: absolute; inset: 0; opacity: 0.5; pointer-events: none;">
                <canvas id="cosmicSpaceCanvas"></canvas>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════
         1. DESKTOP SIDEBAR (240px Fixed)
    ═══════════════════════════════════════════════════════════════════════ -->
    <aside class="uv-sidebar">
        <!-- Brand / Logo -->
        <a href="/" class="uv-brand-wrap">
            <div class="uv-brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <span class="uv-brand-name">UniVerse</span>
        </a>

        <!-- Navigation Links -->
        <ul class="uv-nav-list">
            <li>
                <a href="/" class="uv-nav-link">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge">
                            <i class="bi bi-circle-fill" style="font-size: 5px;"></i> @liveCount live
                        </span>
                    }
                </a>
            </li>
            <li>
                <a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")">
                    <i class="bi bi-bicycle"></i>
                    <span>Runner Mode</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")">
                    <i class="bi bi-bag"></i>
                    <span>Marketplace</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")">
                    <i class="bi bi-chat-dots"></i>
                    <span>Chat Support</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Analytics" class="uv-nav-link @(activePage == "analytics" ? "active" : "")">
                    <i class="bi bi-bar-chart"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Profile" class="uv-nav-link @(activePage == "profile" ? "active" : "")">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard/Settings" class="uv-nav-link @(activePage == "settings" ? "active" : "")">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <!-- Logout Bottom -->
        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════════════
         2. MOBILE HEADER BAR (<1024px)
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="uv-mobile-header">
        <button id="mobileMenuBtn" style="background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; display: flex; align-items: center;" aria-label="Toggle Menu">
            <i class="bi bi-list"></i>
        </button>

        <a href="/" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
            <div class="uv-brand-icon" style="width: 28px; height: 28px;">
                <i class="bi bi-lightning-charge-fill" style="font-size: 15px;"></i>
            </div>
            <span class="uv-brand-name" style="font-size: 18px;">UniVerse</span>
        </a>

        <div style="display: flex; align-items: center; gap: 8px;">
            <a href="/Delivery/Create" style="display: inline-flex; align-items: center; gap: 4px; background: linear-gradient(90deg, #10B981, #34D399); color: #022c22; font-weight: 800; font-size: 11px; padding: 6px 12px; border-radius: 10px; text-decoration: none;">
                <i class="bi bi-plus-lg"></i>
                <span>New</span>
            </a>
            <a href="/Dashboard/Requests" style="width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                <i class="bi bi-box-seam" style="font-size: 14px;"></i>
            </a>
        </div>
    </header>

    <!-- Mobile Drawer & Backdrop -->
    <div id="drawerBackdrop" class="uv-drawer-backdrop"></div>
    <div id="mobileDrawer" class="uv-drawer">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
            <a href="/" class="uv-brand-wrap" style="margin-bottom: 0;">
                <div class="uv-brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <span class="uv-brand-name">UniVerse</span>
            </a>
            <button id="closeDrawerBtn" style="background: none; border: none; color: #A7B8B0; font-size: 20px; cursor: pointer;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <ul class="uv-nav-list">
            <li><a href="/" class="uv-nav-link"><i class="bi bi-house"></i><span>Home</span></a></li>
            <li><a href="/Dashboard" class="uv-nav-link @(activePage == "dashboard" ? "active" : "")"><i class="bi bi-grid-fill"></i><span>Dashboard</span></a></li>
            <li>
                <a href="/Dashboard/Requests" class="uv-nav-link @(activePage == "requests" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                    @if (liveCount > 0)
                    {
                        <span class="uv-nav-badge"><i class="bi bi-circle-fill" style="font-size: 5px;"></i> @liveCount live</span>
                    }
                </a>
            </li>
            <li><a href="/Dashboard/Runner" class="uv-nav-link @(activePage == "runner" ? "active" : "")"><i class="bi bi-bicycle"></i><span>Runner Mode</span></a></li>
            <li><a href="/Dashboard/Marketplace" class="uv-nav-link @(activePage == "marketplace" ? "active" : "")"><i class="bi bi-bag"></i><span>Marketplace</span></a></li>
            <li><a href="/Dashboard/Chat" class="uv-nav-link @(activePage == "chat" ? "active" : "")"><i class="bi bi-chat-dots"></i><span>Chat Support</span></a></li>
