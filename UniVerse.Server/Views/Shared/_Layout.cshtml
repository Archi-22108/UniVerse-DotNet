@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — UniVerse Campus Super-App</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-base: #030712;
            --bg-surface: rgba(15, 23, 42, 0.75);
            --border-subtle: rgba(255, 255, 255, 0.08);
            --primary-emerald: #10b981;
            --emerald-glow: rgba(16, 185, 129, 0.3);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.12) 0%, transparent 45%),
                radial-gradient(circle at 95% 40%, rgba(20, 184, 166, 0.08) 0%, transparent 35%);
            background-attachment: fixed;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Outfit', sans-serif;
        }

        /* Glass Navbar */
        .universe-nav {
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-subtle);
            padding: 0.85rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .brand-logo-badge {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px var(--emerald-glow);
            color: white;
            font-weight: 800;
        }

        .nav-link {
            color: #cbd5e1 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 0.5rem 0.85rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #fff !important;
            background: rgba(255, 255, 255, 0.06);
        }

        .badge-academic {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.3rem 0.7rem;
            border-radius: 9999px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        /* Buttons */
        .btn-emerald {
            background: linear-gradient(135deg, #10b981, #059669);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            font-weight: 600;
            border-radius: 9px;
            box-shadow: 0 4px 16px var(--emerald-glow);
            transition: all 0.2s ease;
        }

        .btn-emerald:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 22px rgba(16, 185, 129, 0.45);
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            color: #e2e8f0;
            font-weight: 500;
            border-radius: 9px;
            transition: all 0.2s ease;
        }

        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }

        /* Cards */
        .universe-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            backdrop-filter: blur(14px);
            transition: all 0.25s ease;
        }

        .universe-card:hover {
            border-color: rgba(16, 185, 129, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        /* Form Controls */
        .form-control, .form-select {
            background-color: rgba(15, 23, 42, 0.6) !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            color: #f8fafc !important;
            border-radius: 10px;
            padding: 0.7rem 1rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: #10b981 !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25) !important;
        }

        .form-control::placeholder {
            color: #64748b !important;
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--border-subtle);
            background: rgba(3, 7, 18, 0.9);
            padding: 2rem 1.5rem;
            margin-top: auto;
            color: var(--text-muted);
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg universe-nav">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="brand-logo-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="d-flex flex-column">
                    <span class="brand-font fw-bold fs-4 text-white lh-1">Uni<span class="text-success">Verse</span></span>
                    <span style="font-size: 0.65rem; color: #94a3b8; letter-spacing: 0.05em;">MARWADI UNIVERSITY</span>
                </div>
            </a>

            <!-- Academic Tag -->
            <div class="d-none d-md-flex align-items-center ms-3">
                <span class="badge-academic">
                    <i class="bi bi-code-slash me-1"></i> ASP.NET Core MVC &bull; ADO.NET
                </span>
            </div>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <i class="bi bi-list fs-2"></i>
            </button>

            <!-- Links -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Delivery" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Deliveries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Delivery" asp-action="RunnerHub">
                            <i class="bi bi-lightning-charge me-1"></i> Runner Hub
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Marketplace" asp-action="Index">
                            <i class="bi bi-shop me-1"></i> Marketplace
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-success fw-bold" href="/swagger" target="_blank">
                            <i class="bi bi-file-earmark-code me-1"></i> Swagger API
                        </a>
                    </li>
                </ul>

                <!-- User Session / Auth Controls -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var studentName = User.Identity.Name ?? "Student";
                        var hostel = User.FindFirst("HostelName")?.Value ?? "Hostel D";
                        var room = User.FindFirst("RoomNumber")?.Value ?? "304";
                        var balance = User.FindFirst("RewardBalance")?.Value ?? "0.00";

                        <div class="dropdown">
                            <button class="btn btn-glass dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" type="button" data-bs-toggle="dropdown">
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-center" style="width: 26px; height: 26px; font-size: 0.75rem;">
                                    @studentName.Substring(0, 1)
                                </div>
                                <span class="fw-semibold">@studentName</span>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">₹@balance</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                <li class="px-3 py-1">
                                    <small class="text-muted d-block">Room Location</small>
                                    <span class="text-white fw-semibold">@hostel, Room @room</span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Delivery" asp-action="Create">
                                        <i class="bi bi-plus-circle me-2"></i> New Delivery Request
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Marketplace" asp-action="Create">
                                        <i class="bi bi-tag me-2"></i> Post Used Item
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-glass btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-emerald btn-sm">
                            Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Alert / Toast Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-10 border border-success text-success d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-10 border border-danger text-danger d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show bg-info bg-opacity-10 border border-info text-info d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <div>@TempData["StatusMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main View Body -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
                <span class="fw-bold text-white">UniVerse Campus Super-App</span>
                <span>&bull;</span>
                <span class="text-success fw-semibold">Marwadi University</span>
            </div>
            <p class="mb-1 text-secondary" style="font-size: 0.8rem;">
                Architectural Implementation: <strong>ASP.NET Core MVC (3-Tier) & ADO.NET Data Access Layer</strong>
            </p>
            <p class="text-muted" style="font-size: 0.75rem;">
                Target Framework: Modern .NET 10 | SQLite Auto-Provisioning | 0% Node.js Dependency
            </p>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
