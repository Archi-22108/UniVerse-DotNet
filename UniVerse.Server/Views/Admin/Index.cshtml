                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 py-2 px-3 font-monospace">
                        <i class="bi bi-shield-check me-1"></i> ADO.NET DAL READY
                    </span>
                </div>

                <div class="row g-3">
