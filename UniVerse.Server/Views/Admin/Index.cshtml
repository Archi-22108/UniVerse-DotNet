                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <h4 class="h6 text-info font-monospace mb-3"><i class="bi bi-diagram-3 me-2"></i>Campus Entity Statistics</h4>
                            <ul class="list-unstyled mb-0 font-monospace small" style="line-height: 2;">
                                <li><strong class="text-white">Registered Students:</strong> @Model.TotalStudents</li>
                                <li><strong class="text-white">Live Delivery Orders:</strong> @Model.TotalDeliveries</li>
                                <li><strong class="text-white">Marketplace Listings:</strong> @Model.TotalListings</li>
                                <li><strong class="text-white">Server Heartbeat Time:</strong> @Model.ServerTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</li>
