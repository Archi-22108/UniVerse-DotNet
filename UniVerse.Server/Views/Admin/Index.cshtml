@model UniVerse.Server.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Campus Authority Command Center — UniVerse Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg-base: #040810;
            --bg-card: rgba(11, 19, 34, 0.82);
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-highlight: rgba(16, 185, 129, 0.3);
            --primary-emerald: #10b981;
            --emerald-glow: rgba(16, 185, 129, 0.35);
            --accent-amber: #f59e0b;
            --accent-indigo: #6366f1;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 10% 0%, rgba(16, 185, 129, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 10%, rgba(99, 102, 241, 0.07) 0%, transparent 40%),
                linear-gradient(rgba(255,255,255,0.012) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.012) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
            overflow-x: hidden;
        }

        /* ─── Top Telemetry Bar ─── */
        .admin-nav {
            background: rgba(6, 12, 22, 0.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-subtle);
            padding: 12px 24px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ffffff;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 16px var(--emerald-glow);
            font-size: 18px;
            color: #ffffff;
        }

        .brand-text {
            font-weight: 800;
            font-size: 19px;
            letter-spacing: -0.02em;
        }

        .brand-text span {
            color: #34d399;
        }

        .admin-portal-tag {
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 6px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #10b981;
            margin-left: 8px;
        }

        .live-pulse {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            color: #34d399;
            background: rgba(16, 185, 129, 0.1);
            padding: 5px 12px;
            border-radius: 20px;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 10px #10b981;
            animation: pulseAnim 1.8s infinite;
        }

        @@keyframes pulseAnim {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.3); }
        }

        /* ─── Metric KPI Cards ─── */
        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 18px;
            padding: 20px 22px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .kpi-card:hover {
            transform: translateY(-3px);
            border-color: rgba(255, 255, 255, 0.16);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--card-color, #10b981), transparent);
        }

        .kpi-label {
            font-size: 12px;
            color: var(--text-muted);
            font-family: 'Space Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .kpi-val {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.1;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .kpi-sub {
            font-size: 12px;
            color: #94a3b8;
        }

        /* ─── Tabs Navigation ─── */
        .admin-nav-tabs {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 14px;
            margin-bottom: 24px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .tab-btn {
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid var(--border-subtle);
            color: #94a3b8;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .tab-btn:hover {
            color: #ffffff;
            background: rgba(30, 41, 59, 0.7);
            border-color: rgba(255, 255, 255, 0.16);
        }

        .tab-btn.active {
            background: rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.45);
            color: #34d399;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
        }

        /* ─── Modern Tables ─── */
        .glass-panel {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 20px;
            padding: 24px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            margin-bottom: 30px;
        }

        .table-custom {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 6px;
            margin-bottom: 0;
        }

        .table-custom th {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 14px;
            border: none;
            background: transparent;
        }

        .table-custom tbody tr {
            background: rgba(15, 23, 42, 0.55);
            transition: all 0.2s ease;
        }

        .table-custom tbody tr:hover {
            background: rgba(30, 41, 59, 0.75);
            transform: scale(1.002);
        }

        .table-custom td {
            padding: 14px 14px;
            vertical-align: middle;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            font-size: 13px;
            color: #e2e8f0;
        }

        .table-custom td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.04);
        }

        .table-custom td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.04);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            font-family: 'Space Mono', monospace;
            text-transform: uppercase;
        }

        .status-pending { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
        .status-in_transit, .status-assigned { background: rgba(99, 102, 241, 0.15); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3); }
        .status-delivered { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
        .status-cancelled { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

        .btn-action-sm {
            padding: 6px 11px;
            font-size: 11.5px;
            font-weight: 600;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(30, 41, 59, 0.6);
            color: #cbd5e1;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-action-sm:hover {
            color: #ffffff;
            background: rgba(51, 65, 85, 0.9);
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-1px);
        }

        .btn-action-view:hover {
            background: rgba(6, 182, 212, 0.22) !important;
            border-color: #06b6d4 !important;
            color: #22d3ee !important;
            box-shadow: 0 0 14px rgba(6, 182, 212, 0.4);
        }

        .btn-action-complete:hover {
            background: rgba(16, 185, 129, 0.22) !important;
            border-color: #10b981 !important;
            color: #34d399 !important;
            box-shadow: 0 0 14px rgba(16, 185, 129, 0.4);
        }

        .btn-action-cancel:hover {
            background: rgba(239, 68, 68, 0.22) !important;
            border-color: #ef4444 !important;
            color: #f87171 !important;
            box-shadow: 0 0 14px rgba(239, 68, 68, 0.4);
        }

        .otp-pill {
            background: rgba(245, 158, 11, 0.15);
            border: 1px dashed rgba(245, 158, 11, 0.4);
            color: #fbbf24;
            font-family: 'Space Mono', monospace;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 6px;
            font-size: 11px;
            letter-spacing: 0.05em;
        }

        .badge-awaiting-pulse {
            background: rgba(245, 158, 11, 0.15) !important;
            color: #fbbf24 !important;
            border: 1px solid rgba(245, 158, 11, 0.35) !important;
            animation: awaitingPulse 2s infinite ease-in-out;
            display: inline-flex;
            align-items: center;
        }

        @@keyframes awaitingPulse {
            0%, 100% {
                box-shadow: 0 0 4px rgba(245, 158, 11, 0.2);
                border-color: rgba(245, 158, 11, 0.35);
            }
            50% {
                box-shadow: 0 0 14px rgba(245, 158, 11, 0.55);
                border-color: rgba(245, 158, 11, 0.75);
                background: rgba(245, 158, 11, 0.25) !important;
            }
        }

        /* ─── Search & Filters Bar ─── */
        .filter-search-box {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 8px 14px;
            color: #ffffff;
            font-size: 13px;
            outline: none;
            width: 100%;
            max-width: 300px;
            transition: border 0.2s ease;
        }

        .filter-search-box:focus {
            border-color: var(--primary-emerald);
        }

        /* ─── Status Filter Buttons (Interactive) ─── */
        .filter-del-btn {
            font-family: 'Space Mono', monospace;
            font-size: 11.5px;
            font-weight: 700;
            padding: 6px 14px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            user-select: none;
        }

        .filter-del-btn.active[data-status="all"] {
            background-color: #475569 !important;
            border-color: #64748b !important;
            color: #ffffff !important;
            box-shadow: 0 0 14px rgba(100, 116, 139, 0.45);
        }

        .filter-del-btn.active[data-status="pending"] {
            background-color: #f59e0b !important;
            border-color: #f59e0b !important;
            color: #040810 !important;
            box-shadow: 0 0 16px rgba(245, 158, 11, 0.6);
        }

        .filter-del-btn.active[data-status="in_transit"] {
            background-color: #06b6d4 !important;
            border-color: #06b6d4 !important;
            color: #040810 !important;
            box-shadow: 0 0 16px rgba(6, 182, 212, 0.6);
        }

        .filter-del-btn.active[data-status="delivered"] {
            background-color: #10b981 !important;
            border-color: #10b981 !important;
            color: #040810 !important;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.6);
        }

        /* ─── Marketplace Grid ─── */
        .listing-admin-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .listing-admin-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .listing-thumb {
            width: 100%;
            height: 140px;
            object-fit: cover;
            background: #0f172a;
        }

        /* ─── Modals ─── */
        .modal-content {
            background: #0b1322 !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            border-radius: 20px !important;
            color: #ffffff !important;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8) !important;
        }
        .modal-header { border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important; }
        .modal-footer { border-top: 1px solid rgba(255, 255, 255, 0.08) !important; }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════════════════════════════
         1. TOP EXECUTIVE TELEMETRY NAVBAR
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="admin-nav">
        <div class="container-fluid px-lg-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin" class="brand-badge">
                    <div class="brand-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div class="brand-text">Uni<span>Verse</span></div>
                </a>
                <span class="admin-portal-tag">CAMPUS AUTHORITY</span>
                <div class="d-none d-md-flex ms-3 live-pulse">
                    <span class="pulse-dot"></span>
                    <span>ONLINE • Marwadi University Dispatch HQ</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-block text-end me-1">
                    <div class="fw-bold text-white" style="font-size: 13px;">@Model.CurrentAdmin.FullName</div>
                    <div class="text-secondary" style="font-size: 11px;">@Model.CurrentAdmin.Email</div>
                </div>

                <a href="/" target="_blank" class="btn-action-sm d-none d-md-inline-flex" title="Open student homepage">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Student View</span>
                </a>

                <a href="/Admin/Logout" class="btn btn-sm btn-outline-danger px-3 rounded-pill" style="font-size: 12px; font-weight: 600;">
                    <i class="bi bi-power me-1"></i> Sign Out
                </a>
            </div>
        </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════════════
         2. ALERT BANNERS
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="container-fluid px-lg-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border border-success text-success d-flex align-items-center justify-content-between py-2 px-3 rounded-3" role="alert" style="font-size: 13px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger text-danger d-flex align-items-center justify-content-between py-2 px-3 rounded-3" role="alert" style="font-size: 13px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         3. TOP TELEMETRY KPI CARDS
    ═══════════════════════════════════════════════════════════════════════ -->
    <main class="container-fluid px-lg-4 py-3">
        <div class="row g-3 mb-4">
            <!-- KPI 1: Total Students -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card" style="--card-color: #10b981;">
                    <div class="kpi-label">
                        <span>CAMPUS DIRECTORY</span>
                        <i class="bi bi-people-fill text-success fs-5"></i>
                    </div>
                    <div class="kpi-val">@Model.TotalStudents</div>
                    <div class="kpi-sub">
                        <span class="text-success fw-semibold"><i class="bi bi-check2"></i> Verified</span> @Model.TotalStudents students on record
                    </div>
                </div>
            </div>

            <!-- KPI 2: Active Runners -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card" style="--card-color: #f59e0b;">
                    <div class="kpi-label">
                        <span>ACTIVE RUNNERS</span>
                        <i class="bi bi-bicycle text-warning fs-5"></i>
                    </div>
                    <div class="kpi-val text-warning">@Model.ActiveRunners</div>
                    <div class="kpi-sub">
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 py-1">READY FOR DISPATCH</span>
                    </div>
                </div>
            </div>

            <!-- KPI 3: Total Deliveries -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card" style="--card-color: #6366f1;">
                    <div class="kpi-label">
                        <span>CAMPUS ORDERS</span>
                        <i class="bi bi-box-seam-fill text-primary fs-5"></i>
                    </div>
                    <div class="kpi-val">@Model.TotalDeliveries</div>
                    <div class="kpi-sub d-flex gap-2 font-monospace" style="font-size: 11px;">
                        <span class="text-warning">⏳ @Model.PendingDeliveries Pend</span>
                        <span class="text-info">🚚 @Model.InTransitDeliveries Active</span>
                        <span class="text-success">✅ @Model.DeliveredCount Done</span>
                    </div>
                </div>
            </div>

            <!-- KPI 4: Total Economy GMV -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card" style="--card-color: #ec4899;">
                    <div class="kpi-label">
                        <span>CAMPUS VOLUME (GMV)</span>
                        <i class="bi bi-cash-stack text-danger fs-5"></i>
                    </div>
                    <div class="kpi-val text-white">₹@Model.TotalEconomyVolume.ToString("N0")</div>
                    <div class="kpi-sub text-muted font-monospace" style="font-size: 11px;">
                        Circulated Rewards: <strong class="text-success">₹@Model.TotalRewardsCirculated.ToString("N1")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════
             4. INTERACTIVE TAB NAVIGATION
        ═══════════════════════════════════════════════════════════════════ -->
        <div class="admin-nav-tabs">
            <button type="button" class="tab-btn active" data-target="tab-deliveries">
                <i class="bi bi-truck"></i>
                <span>Campus Deliveries (@Model.AllDeliveries.Count)</span>
            </button>
            <button type="button" class="tab-btn" data-target="tab-students">
                <i class="bi bi-person-badge"></i>
                <span>Students & Runners (@Model.AllUsers.Count)</span>
            </button>
            <button type="button" class="tab-btn" data-target="tab-marketplace">
                <i class="bi bi-shop"></i>
                <span>Marketplace Moderation (@Model.AllListings.Count)</span>
            </button>
            <button type="button" class="tab-btn" data-target="tab-telemetry">
                <i class="bi bi-cpu"></i>
                <span>ADO.NET & SQLite Diagnostics</span>
            </button>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════
             TAB 1: LIVE CAMPUS DELIVERIES OVERSIGHT
        ═══════════════════════════════════════════════════════════════════ -->
        <div id="tab-deliveries" class="tab-pane-content">
            <div class="glass-panel">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1"><i class="bi bi-truck text-success me-2"></i>Campus Delivery Requests</h2>
                        <p class="text-secondary mb-0" style="font-size: 12px;">Real-time dispatch table for snack orders across hostel blocks.</p>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="button" id="exportDeliveriesCsvBtn" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 font-monospace" style="font-size: 12px; font-weight: 700; border-radius: 10px; padding: 7px 14px;">
                            <i class="bi bi-file-earmark-spreadsheet-fill text-success"></i>
                            <span>Export Audit (CSV)</span>
                        </button>
                        <input type="text" id="deliverySearchInput" class="filter-search-box" placeholder="Search Room, Requester, or ID..." />
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active filter-del-btn" data-status="all">All</button>
                            <button type="button" class="btn btn-outline-warning filter-del-btn" data-status="pending">Pending</button>
                            <button type="button" class="btn btn-outline-info filter-del-btn" data-status="in_transit">In-Transit</button>
                            <button type="button" class="btn btn-outline-success filter-del-btn" data-status="delivered">Delivered</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="deliveriesTable">
                        <thead>
                            <tr style="color: #94a3b8;">
                                <th>Order Ref</th>
                                <th>Requester & Destination</th>
                                <th>Pickup Spot</th>
                                <th>Assigned Runner</th>
                                <th>Total & Tip</th>
                                <th>Status</th>
                                <th>Delivery OTP</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllDeliveries == null || Model.AllDeliveries.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No delivery requests found in database.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var del in Model.AllDeliveries)
                                {
                                    var pickLower = (del.PickupLocation ?? "").ToLower();
                                    var pickIcon = "bi-geo-alt-fill text-secondary";
                                    if (pickLower.Contains("vending")) { pickIcon = "bi-cpu-fill text-info"; }
                                    else if (pickLower.Contains("canteen") || pickLower.Contains("food")) { pickIcon = "bi-cup-hot-fill text-warning"; }
                                    else if (pickLower.Contains("cafe") || pickLower.Contains("coffee")) { pickIcon = "bi-cup-straw text-danger"; }
                                    else if (pickLower.Contains("stationery") || pickLower.Contains("book")) { pickIcon = "bi-book-fill text-primary"; }

                                    <tr class="delivery-row" data-status="@del.Status.ToLower()" data-search="@del.Id.ToLower() @del.RequesterName.ToLower() @del.DropoffLocation.ToLower() @(del.RunnerName ?? "").ToLower()">
                                        <td>
                                            <span class="font-monospace text-secondary fw-semibold">#@del.Id.Substring(0, Math.Min(8, del.Id.Length))</span>
                                            <div class="text-muted font-monospace" style="font-size: 10px;">@del.CreatedAt.Substring(0, Math.Min(16, del.CreatedAt.Length)).Replace("T", " ")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-white">@del.RequesterName</div>
                                            <div class="text-info font-monospace" style="font-size: 11px;">
                                                <i class="bi bi-geo-alt-fill text-info"></i> @del.DropoffLocation
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary text-light d-inline-flex align-items-center gap-1.5 py-1.5 px-2">
                                                <i class="bi @pickIcon"></i>
                                                <span>@del.PickupLocation</span>
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(del.RunnerName))
                                            {
                                                <div class="fw-bold text-warning d-flex align-items-center gap-1">
                                                    <i class="bi bi-person-check-fill text-success" style="font-size: 12px;"></i>
                                                    <span>@del.RunnerName</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(del.RunnerPhone) && del.RunnerPhone.ToLower() != "nophone")
                                                {
                                                    <div class="text-secondary font-monospace" style="font-size: 11px;">
                                                        <i class="bi bi-telephone-fill text-success" style="font-size: 10px;"></i> @del.RunnerPhone
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-secondary opacity-75 font-monospace" style="font-size: 10px;">
                                                        <i class="bi bi-telephone-x"></i> No contact listed
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-awaiting-pulse py-1 px-2 font-monospace" style="font-size: 11px;">
                                                    <i class="bi bi-hourglass-split me-1"></i>AWAITING RUNNER
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold">₹@del.TotalEstimatedAmount</div>
                                            <div class="text-success font-monospace" style="font-size: 11px;">+₹@del.DeliveryFee Tip</div>
                                        </td>
                                        <td>
                                            <span class="status-badge status-@del.Status.ToLower()">
                                                @del.Status.Replace("_", " ")
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(del.DeliveryOtp))
                                            {
                                                <span class="otp-pill" title="Verification OTP given to student">OTP: @del.DeliveryOtp</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                <!-- View details button -->
                                                <button type="button" class="btn-action-sm btn-action-view view-del-btn" 
                                                        title="Inspect Order Items & Notes"
                                                        data-id="@del.Id" 
                                                        data-req="@del.RequesterName" 
                                                        data-drop="@del.DropoffLocation"
                                                        data-pick="@del.PickupLocation"
                                                        data-instr="@del.Instructions"
                                                        data-total="@del.TotalEstimatedAmount"
                                                        data-fee="@del.DeliveryFee"
                                                        data-items="@(del.Items != null ? string.Join(", ", del.Items.Select(i => $"{i.Quantity}x {i.Name}")) : "No specific items listed")">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                @if (del.Status.ToLower() != "delivered" && del.Status.ToLower() != "cancelled")
                                                {
                                                    <!-- Force complete -->
                                                    <form method="post" asp-action="ForceCompleteDelivery" asp-controller="Admin" class="d-inline" onsubmit="return confirm('Force complete this delivery order?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="deliveryId" value="@del.Id" />
                                                        <button type="submit" class="btn-action-sm btn-action-complete text-success" title="Force Complete & Release Tip">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>

                                                    <!-- Cancel -->
                                                    <form method="post" asp-action="CancelDelivery" asp-controller="Admin" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this order as Admin?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="deliveryId" value="@del.Id" />
                                                        <input type="hidden" name="reason" value="Administrative cancel" />
                                                        <button type="submit" class="btn-action-sm btn-action-cancel text-danger" title="Cancel Prank or Fraud Order">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════
             TAB 2: STUDENT & RUNNER MANAGEMENT
        ═══════════════════════════════════════════════════════════════════ -->
        <div id="tab-students" class="tab-pane-content" style="display: none;">
            <div class="glass-panel">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1"><i class="bi bi-people text-success me-2"></i>Campus Student & Runner Directory</h2>
                        <p class="text-secondary mb-0" style="font-size: 12px;">Manage user permissions, runner online duty, and reward wallets.</p>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="button" id="exportStudentsCsvBtn" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 font-monospace" style="font-size: 12px; font-weight: 700; border-radius: 10px; padding: 7px 14px;">
                            <i class="bi bi-file-earmark-spreadsheet-fill text-info"></i>
                            <span>Export Roster (CSV)</span>
                        </button>
                        <input type="text" id="studentSearchInput" class="filter-search-box" placeholder="Search by name, email, or enrollment..." />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="studentsTable">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Enrollment & Email</th>
                                <th>Hostel & Room</th>
                                <th>Role</th>
                                <th>Runner Duty</th>
                                <th>Reward Wallet</th>
                                <th class="text-end">Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.AllUsers)
                            {
                                <tr class="student-row" data-search="@user.FullName.ToLower() @user.Email.ToLower() @(user.EnrollmentNumber ?? "").ToLower()">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white" 
                                                 style="width: 34px; height: 34px; background: linear-gradient(135deg, #10b981 0%, #6366f1 100%); font-size: 13px;">
                                                @(user.FullName.Length > 0 ? user.FullName.Substring(0, 1).ToUpper() : "U")
                                            </div>
                                            <div>
                                                <div class="fw-bold">@user.FullName</div>
                                                <div class="text-muted font-monospace" style="font-size: 10px;">ID: @user.Id.Substring(0, Math.Min(8, user.Id.Length))</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-monospace text-info">@(user.EnrollmentNumber ?? "N/A")</div>
                                        <div class="text-secondary" style="font-size: 11px;">@user.Email</div>
                                    </td>
                                    <td>
                                        <div>@user.HostelName</div>
                                        <div class="text-muted font-monospace" style="font-size: 11px;">Room: @user.RoomNumber</div>
                                    </td>
                                    <td>
                                        <span class="badge @(user.Role == "admin" ? "bg-danger" : (user.Role == "runner" ? "bg-warning text-dark" : "bg-secondary")) px-2 py-1 font-monospace text-uppercase">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input runner-toggle-switch" type="checkbox" role="switch" 
                                                   data-userid="@user.Id" @(user.IsActiveRunner ? "checked" : "") />
                                            <label class="form-check-label font-monospace" style="font-size: 11px;">
                                                @(user.IsActiveRunner ? "ONLINE" : "OFFLINE")
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-success font-monospace">₹@user.RewardBalance.ToString("F2")</div>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn-action-sm edit-balance-btn" 
                                                data-userid="@user.Id" 
                                                data-name="@user.FullName" 
                                                data-balance="@user.RewardBalance"
                                                data-role="@user.Role">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════
             TAB 3: MARKETPLACE MODERATION
        ═══════════════════════════════════════════════════════════════════ -->
        <div id="tab-marketplace" class="tab-pane-content" style="display: none;">
            <div class="glass-panel">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <div>
                        <h2 class="h5 fw-bold mb-1"><i class="bi bi-shop text-success me-2"></i>Marketplace Moderation</h2>
                        <p class="text-secondary mb-0" style="font-size: 12px;">Inspect student buy & sell listings, remove prohibited items.</p>
                    </div>

                    <input type="text" id="marketplaceSearchInput" class="filter-search-box" placeholder="Search item title, seller, or category..." />
                </div>

                <div class="row g-3">
                    @if (Model.AllListings == null || Model.AllListings.Count == 0)
                    {
                        <div class="col-12 text-center py-5 text-muted">
                            <i class="bi bi-bag-x fs-1 d-block mb-2 text-secondary"></i>
                            No active marketplace listings currently on campus.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model.AllListings)
                        {
                            <div class="col-12 col-sm-6 col-md-4 col-xl-3 listing-item-col" data-search="@item.Title.ToLower() @item.SellerName.ToLower() @item.Category.ToLower()">
                                <div class="listing-admin-card h-100 d-flex flex-column">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-product.png" : item.ImageUrl)" 
                                         alt="@item.Title" 
                                         class="listing-thumb" 
                                         onerror="this.src='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'100\'><rect width=\'100%\' height=\'100%\' fill=\'%230f172a\'/><text x=\'50%\' y=\'50%\' fill=\'%2394a3b8\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'12\'>Item Photo</text></svg>';" />

                                    <div class="p-3 d-flex flex-column flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 font-monospace" style="font-size: 10px;">
                                                @item.Category
                                            </span>
                                            <span class="fw-bold text-white font-monospace">₹@item.Price</span>
                                        </div>

                                        <h3 class="h6 fw-bold mb-1 text-truncate text-white">@item.Title</h3>
                                        <p class="text-muted small mb-2 flex-grow-1 text-truncate-2" style="font-size: 12px; max-height: 36px; overflow: hidden;">
                                            @item.Description
                                        </p>

                                        <div class="border-top border-secondary border-opacity-25 pt-2 mt-auto d-flex align-items-center justify-content-between">
                                            <div class="text-secondary small font-monospace" style="font-size: 11px;">
                                                <i class="bi bi-person"></i> @item.SellerName
                                            </div>

                                            <form method="post" asp-action="DeleteListing" asp-controller="Admin" onsubmit="return confirm('Delete this listing from campus marketplace?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="listingId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 11px;">
                                                    <i class="bi bi-trash"></i> Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════
             TAB 4: ADO.NET ARCHITECTURE & SYSTEM DIAGNOSTICS (VIVA READY)
        ═══════════════════════════════════════════════════════════════════ -->
        <div id="tab-telemetry" class="tab-pane-content" style="display: none;">
            <div class="glass-panel">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h2 class="h5 fw-bold mb-1"><i class="bi bi-cpu text-success me-2"></i>Pure ADO.NET Architecture & System Health</h2>
                        <p class="text-secondary mb-0" style="font-size: 12px;">University grading telemetry verifying 0% Node.js and pure ADO.NET implementation.</p>
