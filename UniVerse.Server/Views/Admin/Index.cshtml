    <!-- ═══════════════════════════════════════════════════════════════════════
         MODAL 2: ADJUST STUDENT BALANCE & ROLE
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="editStudentModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="UpdateBalance" asp-controller="Admin">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="modalStudentUserId" />

                    <div class="modal-header">
                        <h5 class="modal-title font-monospace" style="font-size: 15px;"><i class="bi bi-wallet2 text-success me-2"></i>Manage Student Account</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="text-secondary small font-monospace">STUDENT NAME</label>
                            <div class="fw-bold fs-6" id="modalStudentName"></div>
                        </div>

                        <div class="mb-3">
                            <label class="text-secondary small font-monospace">REWARD BALANCE (₹)</label>
                            <input type="number" step="0.5" name="balance" id="modalStudentBalance" class="form-control bg-dark border-secondary text-white" required />
                            <div class="text-muted" style="font-size: 11px;">Update cash/reward balance credited to this student.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-success px-3">Save Balance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // ─── Tab Switching ───
            const tabBtns = document.querySelectorAll(".tab-btn");
            const tabPanes = document.querySelectorAll(".tab-pane-content");

            tabBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    tabBtns.forEach(b => b.classList.remove("active"));
                    tabPanes.forEach(p => p.style.display = "none");

                    btn.classList.add("active");
                    const target = document.getElementById(btn.getAttribute("data-target"));
                    if (target) target.style.display = "block";
                });
            });

            // ─── Deliveries Search & Status Filters ───
            const deliverySearch = document.getElementById("deliverySearchInput");
            const delStatusBtns = document.querySelectorAll(".filter-del-btn");
            const deliveryRows = document.querySelectorAll(".delivery-row");

            let activeDelStatus = "all";

            function filterDeliveries() {
                const query = (deliverySearch?.value || "").toLowerCase().trim();
                deliveryRows.forEach(row => {
                    const status = (row.getAttribute("data-status") || "").toLowerCase().trim();
                    const text = (row.getAttribute("data-search") || "").toLowerCase().trim();

                    let matchesStatus = false;
                    if (activeDelStatus === "all") {
                        matchesStatus = true;
                    } else if (activeDelStatus === "pending") {
                        matchesStatus = (status === "pending");
                    } else if (activeDelStatus === "in_transit") {
                        matchesStatus = (status === "in_transit" || status === "accepted" || status === "picked_up" || status === "assigned");
                    } else if (activeDelStatus === "delivered") {
                        matchesStatus = (status === "delivered");
                    } else {
                        matchesStatus = (status === activeDelStatus);
                    }

                    const matchesQuery = !query || text.includes(query);

                    row.style.display = (matchesStatus && matchesQuery) ? "" : "none";
                });
            }

            if (deliverySearch) {
                deliverySearch.addEventListener("input", filterDeliveries);
            }

            delStatusBtns.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    delStatusBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    activeDelStatus = this.getAttribute("data-status") || "all";
                    filterDeliveries();
                });
            });

            // ─── Student Search ───
            const studentSearch = document.getElementById("studentSearchInput");
            const studentRows = document.querySelectorAll(".student-row");

            if (studentSearch) {
                studentSearch.addEventListener("input", () => {
                    const q = studentSearch.value.toLowerCase().trim();
                    studentRows.forEach(row => {
                        const text = row.getAttribute("data-search") || "";
                        row.style.display = (!q || text.includes(q)) ? "" : "none";
                    });
                });
            }

            // ─── View Order Details Modal ───
            const delModalEl = document.getElementById("delDetailsModal");
            const delModal = delModalEl && window.bootstrap ? new bootstrap.Modal(delModalEl) : null;
            document.querySelectorAll(".view-del-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.getElementById("modalReqName").innerText = btn.getAttribute("data-req") || "";
                    document.getElementById("modalDropLoc").innerText = btn.getAttribute("data-drop") || "";
                    document.getElementById("modalPickLoc").innerText = btn.getAttribute("data-pick") || "";
                    document.getElementById("modalItems").innerText = btn.getAttribute("data-items") || "No items listed";
                    document.getElementById("modalInstructions").innerText = btn.getAttribute("data-instr") || "No special instructions.";
                    if (delModal) delModal.show();
                });
            });

            // ─── Edit Student Balance Modal ───
            const editModalEl = document.getElementById("editStudentModal");
            const editModal = editModalEl && window.bootstrap ? new bootstrap.Modal(editModalEl) : null;
            document.querySelectorAll(".edit-balance-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.getElementById("modalStudentUserId").value = btn.getAttribute("data-userid") || "";
                    document.getElementById("modalStudentName").innerText = btn.getAttribute("data-name") || "";
                    document.getElementById("modalStudentBalance").value = parseFloat(btn.getAttribute("data-balance") || "0").toFixed(2);
                    if (editModal) editModal.show();
                });
            });

            // ─── AJAX Runner Duty Switch ───
            document.querySelectorAll(".runner-toggle-switch").forEach(sw => {
                sw.addEventListener("change", async () => {
                    const userId = sw.getAttribute("data-userid");
                    const isActive = sw.checked;
                    const label = sw.nextElementSibling;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

                    try {
                        const formData = new FormData();
                        formData.append("userId", userId);
                        formData.append("isActive", isActive);
                        formData.append("__RequestVerificationToken", token);

                        const res = await fetch("/Admin/ToggleRunnerDuty", {
                            method: "POST",
                            body: formData
                        });
                        const data = await res.json();
                        if (data.success) {
                            label.innerText = isActive ? "ONLINE" : "OFFLINE";
                        } else {
                            sw.checked = !isActive;
                        }
                    } catch (err) {
                        sw.checked = !isActive;
                        console.error("Failed to toggle runner duty:", err);
                    }
                });
            });

            // ─── Export Deliveries Audit to CSV ───
            const exportCsvBtn = document.getElementById("exportDeliveriesCsvBtn");
            if (exportCsvBtn) {
                exportCsvBtn.addEventListener("click", () => {
                    let csvLines = ["Order Ref,Created At,Requester,Destination,Pickup Spot,Assigned Runner,Amount (INR),Tip (INR),Status,Delivery OTP"];
                    const rows = document.querySelectorAll(".delivery-row");
                    
                    rows.forEach(r => {
                        if (r.style.display !== "none") {
                            const cols = r.querySelectorAll("td");
                            if (cols.length >= 7) {
                                const ref = cols[0].querySelector("span")?.innerText?.replace("#", "").trim() || "";
                                const date = cols[0].querySelector("div")?.innerText?.trim() || "";
                                const req = cols[1].querySelector(".fw-bold")?.innerText?.replace(/,/g, " ").trim() || "";
                                const dest = cols[1].querySelector(".text-info")?.innerText?.replace(/,/g, " ").trim() || "";
                                const pick = cols[2].querySelector("span")?.innerText?.replace(/,/g, " ").trim() || "";
                                const runner = cols[3].querySelector(".fw-bold")?.innerText?.replace(/,/g, " ").trim() || "Awaiting Runner";
                                const amt = cols[4].querySelector(".fw-bold")?.innerText?.replace("₹", "").trim() || "0";
                                const tip = cols[4].querySelector(".text-success")?.innerText?.replace(/[^0-9.]/g, "").trim() || "0";
                                const status = cols[5].querySelector(".status-badge")?.innerText?.trim() || "";
                                const otp = cols[6].querySelector(".otp-pill")?.innerText?.replace("OTP:", "").trim() || "N/A";

                                csvLines.push(`"${ref}","${date}","${req}","${dest}","${pick}","${runner}","${amt}","${tip}","${status}","${otp}"`);
                            }
                        }
                    });

                    const csvContent = csvLines.join("\r\n");
                    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                    const downloadLink = document.createElement("a");
                    downloadLink.href = URL.createObjectURL(blob);
                    downloadLink.download = `UniVerse_Campus_Orders_Audit_${new Date().toISOString().slice(0, 10)}.csv`;
                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    document.body.removeChild(downloadLink);

                    exportCsvBtn.innerHTML = '<i class="bi bi-check2-all text-success"></i> <span>Exported!</span>';
                    setTimeout(() => {
                        exportCsvBtn.innerHTML = '<i class="bi bi-file-earmark-spreadsheet-fill text-success"></i> <span>Export Audit (CSV)</span>';
                    }, 2000);
                });
            }

            // ─── Marketplace Real-time Search ───
            const mktSearch = document.getElementById("marketplaceSearchInput");
            const mktItems = document.querySelectorAll(".listing-item-col");
            if (mktSearch) {
                mktSearch.addEventListener("input", () => {
                    const q = mktSearch.value.toLowerCase().trim();
                    mktItems.forEach(item => {
                        const text = item.getAttribute("data-search") || "";
                        item.style.display = (!q || text.includes(q)) ? "" : "none";
                    });
                });
            }

            // ─── Export Students Directory to CSV ───
            const exportStudentsBtn = document.getElementById("exportStudentsCsvBtn");
            if (exportStudentsBtn) {
                exportStudentsBtn.addEventListener("click", () => {
                    let csvLines = ["Student Name,Enrollment Number,Email,Hostel,Room,Role,Runner Status,Reward Balance (INR)"];
                    const rows = document.querySelectorAll(".student-row");

                    rows.forEach(r => {
                        if (r.style.display !== "none") {
                            const cols = r.querySelectorAll("td");
                            if (cols.length >= 6) {
                                const name = cols[0].querySelector(".fw-bold")?.innerText?.replace(/,/g, " ").trim() || "";
                                const enr = cols[1].querySelector(".text-info")?.innerText?.trim() || "";
                                const email = cols[1].querySelector(".text-secondary")?.innerText?.trim() || "";
                                const hostel = cols[2].querySelector("div")?.innerText?.replace(/,/g, " ").trim() || "";
                                const room = cols[2].querySelector(".font-monospace")?.innerText?.replace("Room:", "").trim() || "";
                                const role = cols[3].querySelector(".badge")?.innerText?.trim() || "";
                                const duty = cols[4].querySelector(".form-check-label")?.innerText?.trim() || "";
                                const bal = cols[5].querySelector(".fw-bold")?.innerText?.replace("₹", "").trim() || "0";

                                csvLines.push(`"${name}","${enr}","${email}","${hostel}","${room}","${role}","${duty}","${bal}"`);
                            }
                        }
                    });

                    const csvContent = csvLines.join("\r\n");
                    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                    const downloadLink = document.createElement("a");
                    downloadLink.href = URL.createObjectURL(blob);
                    downloadLink.download = `UniVerse_Campus_Students_Roster_${new Date().toISOString().slice(0, 10)}.csv`;
                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    document.body.removeChild(downloadLink);

                    exportStudentsBtn.innerHTML = '<i class="bi bi-check2-all text-info"></i> <span>Exported!</span>';
                    setTimeout(() => {
                        exportStudentsBtn.innerHTML = '<i class="bi bi-file-earmark-spreadsheet-fill text-info"></i> <span>Export Roster (CSV)</span>';
                    }, 2000);
                });
            }
        });
    </script>
</body>
</html>
