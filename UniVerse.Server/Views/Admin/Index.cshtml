    <!-- ═══════════════════════════════════════════════════════════════════════
         MODAL 1: VIEW ORDER DETAILS
    ═══════════════════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="delDetailsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-monospace" style="font-size: 15px;"><i class="bi bi-receipt text-success me-2"></i>Order Dispatch Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="text-secondary small font-monospace">REQUESTER & LOCATION</label>
                        <div class="fw-bold" id="modalReqName"></div>
                        <div class="text-info font-monospace small" id="modalDropLoc"></div>
                    </div>
                    <div class="mb-3">
                        <label class="text-secondary small font-monospace">PICKUP SPOT</label>
                        <div class="text-warning fw-semibold" id="modalPickLoc"></div>
                    </div>
                    <div class="mb-3">
                        <label class="text-secondary small font-monospace">REQUESTED SNACKS & ITEMS</label>
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 small font-monospace" id="modalItems"></div>
                    </div>
