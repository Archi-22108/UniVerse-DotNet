@using System.Security.Claims
@{
    Layout = null;
    ViewData["Title"] = "UniVerse — Skip the Stairs. Get It Delivered.";
    var totalUsers = ViewBag.TotalUsers ?? 4;
    var activeRunners = ViewBag.ActiveRunners ?? 2;
    var totalRequests = ViewBag.TotalRequests ?? 3;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-dark: #030a06;
            --emerald: #10B981;
            --emerald-dark: #059669;
            --amber: #F59E0B;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* ─── Top Navbar ─────────────────────────────────────────────────── */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(4, 14, 9, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 0.85rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-link {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #10B981;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1rem;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
            list-style: none;
            margin: 0;
        }

        .nav-links a {
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: #10B981;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.2rem;
        }

        .nav-actions .login-btn {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .nav-actions .login-btn:hover {
            color: #10B981;
        }

        .nav-actions .signup-btn {
            background: #10B981;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.45rem 1.3rem;
            border-radius: 9999px;
            transition: all 0.2s ease;
        }

        .nav-actions .signup-btn:hover {
            background: #059669;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);
            color: #ffffff;
        }

        /* ─── Hero Section ───────────────────────────────────────────────── */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 7rem 1.5rem 4rem;
            overflow: hidden;
        }

        .campus-bg-container {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        .campus-bg-container svg {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            background: radial-gradient(ellipse 85% 65% at 50% 45%, rgba(3, 10, 6, 0.45) 0%, rgba(3, 10, 6, 0.85) 100%),
                        linear-gradient(to bottom, rgba(3, 10, 6, 0.6) 0%, rgba(3, 10, 6, 0.2) 40%, rgba(3, 10, 6, 0.95) 100%);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 10;
            max-width: 820px;
            margin: 0 auto;
        }

        .mu-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #4ADE80;
            padding: 0.35rem 1.1rem;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            backdrop-filter: blur(8px);
            margin-bottom: 1.5rem;
        }

        .hero-title {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(2.8rem, 6.5vw, 5rem);
            font-weight: 900;
            line-height: 1.08;
            letter-spacing: -0.02em;
            color: #ffffff;
            margin-bottom: 1.2rem;
        }

        .hero-title-gradient {
            background: linear-gradient(90deg, #10B981 20%, #F59E0B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-family: 'Inter', sans-serif;
            font-size: clamp(0.95rem, 2vw, 1.15rem);
            color: rgba(255, 255, 255, 0.75);
            line-height: 1.65;
            max-width: 680px;
            margin: 0 auto 2rem;
        }

        .hero-btns {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1.8rem;
            flex-wrap: wrap;
        }

        .btn-start {
            background: #10B981;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.75rem 1.8rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 20px rgba(16, 185, 129, 0.45);
            transition: all 0.25s ease;
        }

        .btn-start:hover {
            background: #059669;
            transform: translateY(-2px);
            color: #ffffff;
        }

        .btn-how {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.75rem 1.8rem;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.25s ease;
        }

        .btn-how:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        .hero-tags {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            margin-bottom: 2.2rem;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.65);
            flex-wrap: wrap;
        }

        .hero-tags span {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        /* ─── Hero Glass Status Strip ────────────────────────────────────── */
        .glass-status-strip {
            background: rgba(10, 25, 18, 0.65);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
            border-radius: 9999px;
            padding: 0.6rem 1.8rem;
            display: inline-flex;
            align-items: center;
            gap: 2rem;
            margin: 0 auto;
        }

        .status-pill-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .status-icon-box {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }

        .status-val {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1;
        }

        .status-lbl {
            font-size: 0.72rem;
            color: rgba(255, 255, 255, 0.55);
            margin-top: 2px;
        }

        .scroll-hint {
            margin-top: 2.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            text-decoration: none;
        }

        @@keyframes bounceDown {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(6px); }
        }

        .scroll-hint i {
            animation: bounceDown 1.8s ease-in-out infinite;
        }

        /* ─── Floating Snack & Drink Objects ─────────────────────────────── */
        @@keyframes floatA { 0%, 100% { transform: translateY(0) rotate(-15deg); } 50% { transform: translateY(-18px) rotate(-12deg); } }
        @@keyframes floatB { 0%, 100% { transform: translateY(0) rotate(-22deg); } 50% { transform: translateY(-15px) rotate(-18deg); } }
        @@keyframes floatC { 0%, 100% { transform: translateY(0) rotate(15deg); } 50% { transform: translateY(-22px) rotate(18deg); } }
        @@keyframes floatD { 0%, 100% { transform: translateY(0) rotate(10deg); } 50% { transform: translateY(-16px) rotate(6deg); } }
        @@keyframes floatE { 0%, 100% { transform: translateY(0) rotate(-12deg); } 50% { transform: translateY(-20px) rotate(-8deg); } }
        @@keyframes floatF { 0%, 100% { transform: translateY(0) rotate(18deg); } 50% { transform: translateY(-18px) rotate(22deg); } }
        @@keyframes floatG { 0%, 100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-14px) rotate(-4deg); } }

        .floating-layer {
            position: absolute;
            inset: 0;
            z-index: 5;
            pointer-events: none;
        }

        .float-item { position: absolute; }
        .float-chips   { top: 10%; left: 4%;   animation: floatA 5.2s ease-in-out infinite; }
        .float-choco   { top: 32%; left: 2%;   animation: floatB 6.1s ease-in-out infinite 0.8s; }
        .float-water   { top: 56%; left: 3.5%; animation: floatE 6.5s ease-in-out infinite 0.5s; }
        .float-noodles { top: 76%; left: 5.5%; animation: floatG 7.0s ease-in-out infinite 1.8s; }
        .float-can     { top: 12%; right: 5%;  animation: floatC 4.8s ease-in-out infinite 0.3s; }
        .float-coffee  { top: 35%; right: 3%;  animation: floatD 5.6s ease-in-out infinite 1.2s; }
        .float-juice   { top: 58%; right: 4%;  animation: floatF 5.8s ease-in-out infinite 1.5s; }

        /* ─── SECTION 2: WHY UNIVERSE ────────────────────────────────────── */
        .why-section {
            background-color: var(--bg-dark);
            padding: 6rem 1.5rem 5rem;
            position: relative;
            z-index: 10;
        }

        .section-pill-green {
            display: inline-block;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #10B981;
            padding: 0.35rem 1rem;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .section-heading-dark {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 0.6rem;
        }

        .section-subheading-dark {
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.05rem;
            margin-bottom: 3.5rem;
        }

        .bento-grid {
            max-width: 1080px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.15fr 1fr 1fr;
            grid-template-rows: auto auto;
            gap: 1.2rem;
        }

        @@media (max-width: 991px) {
            .bento-grid {
                grid-template-columns: 1fr;
            }
        }

        .bento-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 20px;
            padding: 2rem;
            text-align: left;
            transition: all 0.3s ease;
            position: relative;
        }

        .bento-card:hover {
            border-color: rgba(16, 185, 129, 0.3);
            transform: translateY(-4px);
        }

        .bento-card-large {
            grid-row: span 2;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.02) 100%);
            border-color: rgba(16, 185, 129, 0.25);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .bento-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 1.2rem;
        }

        .bento-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.6rem;
        }

        .bento-desc {
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.65);
            line-height: 1.6;
            margin-bottom: 0;
        }

        .why-join-banner {
            margin-top: 3.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.2rem;
            flex-wrap: wrap;
        }

        .why-join-banner span {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            font-weight: 500;
        }

        .btn-join-pill {
            background: #10B981;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.6rem 1.6rem;
            border-radius: 9999px;
            transition: all 0.2s ease;
        }

        .btn-join-pill:hover {
            background: #059669;
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.4);
            color: #ffffff;
        }

        /* ─── SECTION 3: HOW UNIVERSE WORKS (LIGHT THEME) ─────────────────── */
        .how-section {
            background-color: #FAFAF8;
            color: #111827;
            padding: 6rem 1.5rem 6.5rem;
            text-align: center;
        }

        .section-pill-light {
            display: inline-block;
            background: #E8F7EE;
            border: 1px solid #C8EBD3;
            color: #059669;
            padding: 0.35rem 1rem;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .section-heading-light {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            font-weight: 800;
            color: #111827;
            margin-bottom: 0.6rem;
        }

        .section-subheading-light {
            color: #6B7280;
            font-size: 1.05rem;
            margin-bottom: 3.5rem;
        }

        .steps-grid {
            max-width: 1120px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.4rem;
        }

        @@media (max-width: 991px) {
            .steps-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 575px) {
            .steps-grid {
                grid-template-columns: 1fr;
            }
        }

        .step-card {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: 24px;
            padding: 1.8rem 1.6rem;
            text-align: left;
            position: relative;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .step-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
            border-color: #D1D5DB;
        }

        .step-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
        }

        .step-watermark {
            font-family: 'Outfit', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            color: #E5E7EB;
            line-height: 1;
        }

        .step-pill {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 0.2rem 0.65rem;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .step-pill-1 { background: #ECFDF5; color: #10B981; }
        .step-pill-2 { background: #FFFBEB; color: #D97706; }
        .step-pill-3 { background: #EEF2FF; color: #6366F1; }
        .step-pill-4 { background: #FFF7ED; color: #EA580C; }

        .step-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 0.5rem;
        }

        .step-text {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            color: #6B7280;
            line-height: 1.6;
            margin: 0;
        }

        /* ─── SECTION 4: FOOTER ──────────────────────────────────────────── */
        .site-footer {
            background-color: #030704;
            color: #ffffff;
            padding: 5rem 1.5rem 2.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.88rem;
        }

        .footer-container {
            max-width: 1120px;
            margin: 0 auto;
        }

        .footer-tagline {
            font-family: 'Outfit', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-top: 1.2rem;
            margin-bottom: 0.6rem;
        }

        .footer-desc {
            color: rgba(255, 255, 255, 0.6);
            line-height: 1.6;
            max-width: 360px;
            font-size: 0.84rem;
            margin-bottom: 1.2rem;
        }

        .campus-active-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: #34D399;
            padding: 0.35rem 0.9rem;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .footer-cta-btns {
            display: flex;
            gap: 0.75rem;
        }

        .footer-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.5rem 1.1rem;
            border-radius: 9999px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .footer-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #10B981;
        }

        .footer-col-title {
            font-family: 'Outfit', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.45);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 1.2rem;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-links li {
            margin-bottom: 0.75rem;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            font-size: 0.88rem;
            transition: color 0.2s ease;
        }

        .footer-links a:hover {
            color: #10B981;
        }

        .footer-bottom {
            margin-top: 4.5rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.8rem;
        }

        .footer-legal-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-legal-links a {
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
        }

        .footer-legal-links a:hover {
            color: #ffffff;
        }

        .system-status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: #10B981;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TOP NAVBAR
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="top-nav">
        <a href="/" class="brand-link">
            <div class="brand-icon">
                <i class="bi bi-compass-fill"></i>
            </div>
            <span>Uni<span style="color: #10B981;">Verse</span></span>
        </a>

        <ul class="nav-links d-none d-md-flex">
            <li><a href="/">Home</a></li>
            <li><a href="#why">About</a></li>
            <li><a href="#how-it-works">How It Works</a></li>
        </ul>

        <div class="nav-actions">
            <a href="/Account/Login" class="login-btn">Login</a>
            <a href="/Account/Register" class="signup-btn">Sign Up</a>
        </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO SECTION
    ═══════════════════════════════════════════════════════════════════════ -->
    <section class="hero-section">
        <!-- Campus Vector SVG Background -->
        <div class="campus-bg-container">
            <svg viewBox="0 0 1440 800" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="uvSky" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#9EC8E0" />
