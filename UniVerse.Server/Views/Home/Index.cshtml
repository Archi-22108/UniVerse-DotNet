@using System.Security.Claims
@{
    Layout = null;
    ViewData["Title"] = "UniVerse — Skip the Stairs. Get It Delivered.";
    var studentCount = ViewBag.TotalUsers ?? 4;
    var runnerCount = ViewBag.ActiveRunners ?? 1;
    var requestCount = ViewBag.TotalRequests ?? 3;
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
            --font-inter: 'Inter', system-ui, sans-serif;
            --emerald-500: #10B981;
            --emerald-400: #34D399;
            --emerald-600: #059669;
            --amber-500: #F59E0B;
            --amber-400: #FBBF24;
            --dark-bg: #050F0A;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: var(--font-sans);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Campus SVG Keyframe Animations ─── */
        @@keyframes cloud-drift-a {
            0%   { transform: translateX(-220px); }
            100% { transform: translateX(1660px); }
        }
        @@keyframes cloud-drift-b {
            0%   { transform: translateX(-180px); }
            100% { transform: translateX(1620px); }
        }
        @@keyframes cloud-drift-c {
            0%   { transform: translateX(-160px); }
            100% { transform: translateX(1600px); }
        }
        @@keyframes student-bob {
            0%, 100% { transform: translateY(0px); }
            50%      { transform: translateY(-4px); }
        }
        @@keyframes student-walk {
            0%, 100% { transform: translateX(0px) scaleX(1); }
            25%      { transform: translateX(3px)  scaleX(1); }
            75%      { transform: translateX(-3px) scaleX(1); }
        }
        @@keyframes arm-swing {
            0%, 100% { transform: rotate(-10deg); }
            50%      { transform: rotate(15deg); }
        }
        @@keyframes phone-pulse {
            0%, 100% { opacity: 0.7; }
            50%      { opacity: 1; }
        }
        @@keyframes leg-stride-l {
            0%, 100% { transform: rotate(12deg); }
            50%      { transform: rotate(-14deg); }
        }
        @@keyframes leg-stride-r {
            0%, 100% { transform: rotate(-14deg); }
            50%      { transform: rotate(12deg); }
        }
        @@keyframes sun-glow {
            0%, 100% { opacity: 0.12; }
            50%      { opacity: 0.22; }
        }
        @@keyframes flag-wave {
            0%, 100% { transform: scaleX(1); }
            50%      { transform: scaleX(1.12) skewY(-2.5deg); }
        }

        .cloud-a { animation: cloud-drift-a 55s linear infinite; }
        .cloud-b { animation: cloud-drift-b 72s linear infinite 18s; }
        .cloud-c { animation: cloud-drift-c 90s linear infinite 36s; }

        .s1-body  { animation: student-bob  2.1s ease-in-out infinite; transform-origin: 130px 585px; }
        .s2-body  { animation: student-bob  2.4s ease-in-out infinite 0.3s; transform-origin: 435px 580px; }
        .s3-body  { animation: student-walk 0.9s ease-in-out infinite; transform-origin: 705px 580px; }
        .s3-arm-l { animation: arm-swing    0.9s ease-in-out infinite; transform-origin: 699px 563px; }
        .s3-arm-r { animation: arm-swing    0.9s ease-in-out infinite 0.45s; transform-origin: 715px 563px; }
        .s3-leg-l { animation: leg-stride-l 0.9s ease-in-out infinite; transform-origin: 700px 582px; }
        .s3-leg-r { animation: leg-stride-r 0.9s ease-in-out infinite; transform-origin: 710px 582px; }
        .phone-screen { animation: phone-pulse 1.8s ease-in-out infinite; }
        .sun-halo { animation: sun-glow 4s ease-in-out infinite; }
        .tower-flag { animation: flag-wave 2.2s ease-in-out infinite; transform-origin: 779px 116px; }

        /* ─── Floating Product Objects Keyframes ─── */
        @@keyframes float-crunchex { 0%, 100% { transform: translateY(0px) rotate(-12deg); } 50% { transform: translateY(-16px) rotate(-8deg); } }
        @@keyframes float-choco    { 0%, 100% { transform: translateY(0px) rotate(-22deg); } 50% { transform: translateY(-14px) rotate(-18deg); } }
        @@keyframes float-lays     { 0%, 100% { transform: translateY(0px) rotate(-8deg);  } 50% { transform: translateY(-15px) rotate(-5deg); } }
        @@keyframes float-can      { 0%, 100% { transform: translateY(0px) rotate(-12deg); } 50% { transform: translateY(-18px) rotate(-8deg); } }
        @@keyframes float-amul     { 0%, 100% { transform: translateY(0px) rotate(-6deg);  } 50% { transform: translateY(-15px) rotate(-3deg); } }
        @@keyframes float-cuppa    { 0%, 100% { transform: translateY(0px) rotate(4deg);   } 50% { transform: translateY(-16px) rotate(8deg); } }

        /* ─── Top Cosmic Navbar ─── */
        .uv-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
            background: rgba(10, 16, 12, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

        .uv-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .uv-brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            transition: transform 0.2s ease;
        }

        .uv-brand:hover .uv-brand-mark {
            transform: scale(1.05);
        }

        .uv-brand-text {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #ffffff;
            font-family: var(--font-sans);
        }

        .uv-brand-text span {
            color: #34D399;
        }

        .uv-nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        @@media (max-width: 768px) {
            .uv-nav-links {
                display: none;
            }
        }

        .uv-nav-links a {
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 8px;
            font-family: var(--font-inter);
            transition: all 0.2s ease;
        }

        .uv-nav-links a:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        .uv-nav-ctas {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .uv-nav-login {
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .uv-nav-login:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        .uv-nav-signup {
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 700;
            color: #022c22;
            background: #00D084;
            border-radius: 9999px;
            text-decoration: none;
            box-shadow: 0 4px 16px rgba(0, 208, 132, 0.35);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .uv-nav-signup:hover {
            transform: scale(1.04);
            box-shadow: 0 6px 22px rgba(0, 208, 132, 0.5);
            color: #022c22;
        }

        /* ─── Hero Section ─── */
        .uv-hero-section {
            position: relative;
            width: 100%;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 100px 20px 80px;
        }

        .uv-campus-bg-wrap {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
            contain: strict;
            transform: translateZ(0);
        }

        .uv-campus-bg-wrap svg {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .uv-hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(5,15,10,0.35) 0%, rgba(5,15,10,0.68) 100%),
                        linear-gradient(to bottom, rgba(5,15,10,0.55) 0%, rgba(5,15,10,0.30) 40%, rgba(5,15,10,0.70) 100%);
        }

        /* Floating Objects Layer - GPU Hardware Accelerated */
        .uv-float-layer {
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            overflow: hidden;
            contain: layout paint;
        }

        .float-obj {
            position: absolute;
            will-change: transform;
            transform: translateZ(0);
            backface-visibility: hidden;
            pointer-events: auto;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .float-obj img {
            display: block;
            will-change: transform;
            transform: translateZ(0);
            backface-visibility: hidden;
        }

        .float-obj:hover {
            transform: scale(1.12) translateZ(0) !important;
            cursor: pointer;
        }

        .float-obj-crunchex {
            top: 22%;
            left: 4%;
            animation: float-crunchex 5.4s ease-in-out infinite;
        }
        .float-obj-crunchex img {
            width: 95px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(14, 165, 233, 0.45));
        }

        .float-obj-choco {
            top: 50%;
            left: 2.5%;
            animation: float-choco 6.2s ease-in-out infinite 0.8s;
        }
        .float-obj-choco img {
            width: 82px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(168, 85, 247, 0.45));
        }

        .float-obj-lays {
            top: 78%;
            left: 3.5%;
            animation: float-lays 5.8s ease-in-out infinite 1.5s;
        }
        .float-obj-lays img {
            width: 95px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(74, 222, 128, 0.45));
        }

        .float-obj-can {
            top: 22%;
            right: 5%;
            animation: float-can 5.0s ease-in-out infinite 0.4s;
        }
        .float-obj-can img {
            width: 70px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(239, 68, 68, 0.45));
        }

        .float-obj-amul {
            top: 50%;
            right: 3%;
            animation: float-amul 6.0s ease-in-out infinite 1.2s;
        }
        .float-obj-amul img {
            width: 74px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(217, 119, 6, 0.45));
        }

        .float-obj-cuppa {
            top: 78%;
            right: 4.5%;
            animation: float-cuppa 5.6s ease-in-out infinite 1.8s;
        }
        .float-obj-cuppa img {
            width: 86px;
            height: auto;
            filter: drop-shadow(0 10px 18px rgba(234, 179, 8, 0.45));
        }

        @@media (max-width: 992px) {
            .float-obj-choco,
            .float-obj-amul {
                display: none;
            }
        }
        @@media (max-width: 640px) {
            .uv-float-layer {
                display: none;
            }
        }

        /* Hero Content */
        .uv-hero-content {
            position: relative;
            z-index: 10;
            max-width: 896px;
            margin: 0 auto;
            text-align: center;
        }

        .uv-badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 9999px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #4ADE80;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-family: var(--font-inter);
            backdrop-filter: blur(8px);
            margin-bottom: 24px;
        }

        .uv-badge-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #4ADE80;
            box-shadow: 0 0 8px #4ADE80;
            animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
        }

        .uv-hero-heading {
            font-family: var(--font-sans);
            font-size: clamp(2.75rem, 8vw, 5.5rem);
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -0.02em;
            color: #ffffff;
            text-shadow: 0 2px 40px rgba(0, 0, 0, 0.4);
            margin-bottom: 24px;
        }

        .uv-heading-gradient {
            background: linear-gradient(90deg, #10B981 0%, #10B981 40%, #F59E0B 80%, #D97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .uv-hero-sub {
            font-family: var(--font-inter);
            font-size: clamp(0.95rem, 2.2vw, 1.15rem);
            color: rgba(255, 255, 255, 0.72);
            line-height: 1.65;
            max-width: 640px;
            margin: 0 auto 36px;
        }

        .uv-hero-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .uv-btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 30px;
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            border-radius: 9999px;
            font-family: var(--font-inter);
            text-decoration: none;
            background: rgba(6, 44, 32, 0.88);
            border: 1px solid rgba(16, 185, 129, 0.5);
            box-shadow: 0 0 24px rgba(16, 185, 129, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.3s ease;
        }

        .uv-btn-primary:hover {
            background: rgba(16, 185, 129, 0.25);
            border-color: #10B981;
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.5);
            transform: translateY(-2px);
            color: #ffffff;
        }

        .uv-btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 30px;
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            border-radius: 9999px;
            font-family: var(--font-inter);
            text-decoration: none;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.3s ease;
        }

        .uv-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.4);
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* Live Status Glass Strip */
        .uv-status-strip {
            display: inline-flex;
            align-items: center;
            justify-content: space-around;
            padding: 10px 28px;
            border-radius: 9999px;
            background: rgba(10, 20, 15, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            gap: 24px;
            margin: 0 auto 24px;
        }

        .uv-stat-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .uv-stat-icon-wrap {
            position: relative;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .uv-stat-val {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.1;
            font-family: var(--font-sans);
        }

        .uv-stat-lbl {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.55);
            font-family: var(--font-inter);
            margin-top: 2px;
            white-space: nowrap;
        }

        .uv-stat-sep {
            width: 1px;
            height: 28px;
            background: rgba(255, 255, 255, 0.12);
        }

        .uv-trust-badges {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 28px;
            flex-wrap: wrap;
            margin-bottom: 36px;
        }

        .uv-trust-item {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.65);
            font-weight: 500;
            font-family: var(--font-inter);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        /* Scroll down button */
        .uv-scroll-hint {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            color: rgba(255, 255, 255, 0.45);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.22em;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .uv-scroll-hint:hover {
            color: #34D399;
        }

        .uv-scroll-hint i {
            animation: bounceDown 1.6s ease-in-out infinite;
        }

        @@keyframes bounceDown {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(6px); }
        }

        /* ─── Why UniVerse Bento Section ─── */
        .uv-why-section {
            background-color: var(--dark-bg);
            padding: 96px 20px 80px;
            position: relative;
            z-index: 10;
        }

        .uv-why-container {
            max-width: 1120px;
            margin: 0 auto;
            text-align: center;
        }

        .uv-section-pill {
            display: inline-block;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #10B981;
            padding: 6px 16px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .uv-section-h2 {
            font-family: var(--font-sans);
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 10px;
            letter-spacing: -0.02em;
        }

        .uv-section-sub {
            color: rgba(255, 255, 255, 0.55);
            font-size: 16px;
            font-family: var(--font-inter);
            margin-bottom: 56px;
        }

        .uv-bento-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr 1fr;
            grid-template-rows: auto auto;
            gap: 20px;
            margin-bottom: 48px;
        }

        @@media (max-width: 900px) {
            .uv-bento-grid {
                grid-template-columns: 1fr;
            }
        }

        .uv-bento-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-xl);
            padding: 28px;
            text-align: left;
            transition: all 0.3s ease;
            position: relative;
        }

        .uv-bento-card:hover {
            transform: translateY(-4px);
            border-color: rgba(16, 185, 129, 0.3);
            background: rgba(255, 255, 255, 0.07);
        }

        .uv-bento-highlight {
            grid-row: span 2;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.04) 100%);
            border-color: rgba(16, 185, 129, 0.25);
        }

        .uv-bento-highlight:hover {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(16, 185, 129, 0.08) 100%);
            border-color: rgba(16, 185, 129, 0.4);
        }

        .uv-bento-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 18px;
            transition: transform 0.3s ease;
        }

        .uv-bento-card:hover .uv-bento-icon {
            transform: scale(1.1);
        }

        .uv-bento-title {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .uv-bento-highlight .uv-bento-title {
            font-size: 24px;
        }

        .uv-bento-desc {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.55);
            line-height: 1.6;
            font-family: var(--font-inter);
        }

        /* ─── How It Works Section ─── */
        .uv-how-section {
            background-color: #FAFAF8;
            color: #111827;
            padding: 96px 20px 80px;
            position: relative;
            z-index: 10;
        }

        .uv-how-container {
            max-width: 1120px;
            margin: 0 auto;
            text-align: center;
        }

        .uv-how-pill {
            display: inline-block;
            background: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #059669;
            padding: 6px 16px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .uv-how-h2 {
            font-family: var(--font-sans);
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            font-weight: 800;
            color: #111827;
            margin-bottom: 10px;
            letter-spacing: -0.02em;
        }

        .uv-how-sub {
            color: #6B7280;
            font-size: 16px;
            font-family: var(--font-inter);
            margin-bottom: 56px;
        }

        .uv-steps-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        @@media (max-width: 900px) {
            .uv-steps-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 540px) {
            .uv-steps-grid {
                grid-template-columns: 1fr;
            }
        }

        .uv-step-card {
            background: #ffffff;
            border: 1px solid #E5E7EB;
            border-radius: var(--radius-xl);
            padding: 28px 24px;
            text-align: left;
            position: relative;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .uv-step-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
            border-color: #D1D5DB;
        }

        .uv-step-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .uv-step-num {
            font-family: var(--font-sans);
            font-size: 2.2rem;
            font-weight: 800;
            color: #E5E7EB;
            line-height: 1;
        }

        .uv-step-tag {
            display: inline-block;
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 10px;
            width: fit-content;
        }

        .uv-step-tag-1 { background: #ECFDF5; color: #10B981; }
        .uv-step-tag-2 { background: #FFFBEB; color: #D97706; }
        .uv-step-tag-3 { background: #EEF2FF; color: #6366F1; }
        .uv-step-tag-4 { background: #FFF7ED; color: #EA580C; }

        .uv-step-title {
            font-size: 17px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 8px;
        }

        .uv-step-text {
            font-size: 13.5px;
            color: #6B7280;
            line-height: 1.6;
            font-family: var(--font-inter);
            margin: 0;
        }

        /* ─── Footer Section ─── */
        .uv-footer {
            background-color: #060A08;
            color: #ffffff;
            padding: 80px 24px 36px;
            position: relative;
            overflow: hidden;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .uv-footer-line {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.4), rgba(245, 158, 11, 0.3), transparent);
        }

        .uv-footer-container {
            max-width: 1120px;
            margin: 0 auto;
        }

        .uv-footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 48px;
            margin-bottom: 60px;
        }

        @@media (max-width: 768px) {
            .uv-footer-grid {
                grid-template-columns: 1fr;
                gap: 36px;
            }
        }

        .uv-footer-brand-title {
            font-size: 20px;
            font-weight: 700;
            margin-top: 18px;
            margin-bottom: 8px;
        }

        .uv-footer-brand-p {
            color: rgba(255, 255, 255, 0.55);
            font-size: 13.5px;
            line-height: 1.6;
            max-width: 380px;
            font-family: var(--font-inter);
            margin-bottom: 20px;
        }

        .uv-footer-col h4 {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255, 255, 255, 0.35);
            margin-bottom: 18px;
            font-family: var(--font-inter);
        }

        .uv-footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .uv-footer-col a {
            color: rgba(255, 255, 255, 0.55);
            text-decoration: none;
            font-size: 13.5px;
            font-family: var(--font-inter);
            transition: color 0.2s ease;
        }

        .uv-footer-col a:hover {
            color: #ffffff;
        }

        .uv-share-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            font-size: 12px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.75);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .uv-share-btn:hover {
            color: #ffffff;
            border-color: rgba(16, 185, 129, 0.4);
            background: rgba(255, 255, 255, 0.08);
        }

        .uv-footer-bottom {
            padding-top: 28px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 12.5px;
            color: rgba(255, 255, 255, 0.5);
        }

        .uv-footer-bottom a {
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
            margin-right: 18px;
            transition: color 0.2s ease;
        }

        .uv-footer-bottom a:hover {
            color: #ffffff;
        }

        .uv-status-pill-green {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #10B981;
            font-weight: 500;
        }

        /* Mobile & Tablet Specific Responsive Enhancements */
        @@media (max-width: 640px) {
            .uv-navbar {
                padding: 10px 14px;
            }
            .uv-hero-actions {
                flex-direction: column;
                width: 100%;
            }
            .uv-btn-primary, .uv-btn-secondary {
                width: 100%;
                justify-content: center;
            }
            .uv-status-strip {
                flex-direction: column;
                gap: 12px;
                width: 100%;
                border-radius: var(--radius-lg);
                padding: 14px 18px;
            }
            .uv-stat-sep {
                display: none;
            }
            .uv-stat-box {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .uv-hero-heading {
                font-size: 2.3rem;
            }
            .uv-brand-text {
                font-size: 18px;
            }
            .uv-nav-ctas {
                gap: 6px;
            }
            .uv-nav-login, .uv-nav-signup {
                padding: 7px 12px;
                font-size: 12px;
            }
        }
    </style>
</head>
<body>

