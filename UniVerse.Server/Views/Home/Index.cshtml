                <!-- Road Lane Dashes -->
                @for (int i = 0; i < 14; i++)
                {
                    <rect x="@(40 + i * 106)" y="611" width="56" height="5" fill="white" opacity="0.45" rx="2" />
                }

                <!-- Vertical Paths from Hostels -->
                <rect x="107" y="553" width="28" height="44" fill="#C4CAD6" opacity="0.7" />
