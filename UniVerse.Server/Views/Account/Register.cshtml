@model UniVerse.Server.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create Account — UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Space Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Official Google Identity Services Script -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <!-- Three.js for 3D Gargantua Black Hole WebGL Animation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000002;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px 14px;
            position: relative;
            overflow-x: hidden;
        }

        /* ─── WebGL Canvas Container ─── */
        #blackHoleContainer {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* ─── Cinematic Vignette ─── */
        .cinematic-vignette {
            position: fixed;
            inset: 0;
            z-index: 2;
            background: radial-gradient(circle at center, transparent 35%, rgba(0, 2, 8, 0.65) 100%);
            pointer-events: none;
        }

        /* ─── Sci-Fi HUD Overlays ─── */
        .hud-tl {
            position: absolute;
            top: 28px;
            left: 32px;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
        }

        .hud-tl-corner {
            position: absolute;
            top: -6px;
            left: -6px;
            width: 10px;
            height: 10px;
            border-left: 1px solid rgba(0, 210, 255, 0.6);
            border-top: 1px solid rgba(0, 210, 255, 0.6);
        }

        .hud-tr {
            position: absolute;
            top: 28px;
            right: 32px;
            text-align: right;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
        }

        .hud-tr-corner {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 10px;
            height: 10px;
            border-right: 1px solid rgba(0, 210, 255, 0.6);
            border-top: 1px solid rgba(0, 210, 255, 0.6);
        }

        @@media (max-width: 640px) {
            .hud-tl, .hud-tr { display: none; }
        }

        /* ─── Main Container ─── */
        .register-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 460px;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* ─── Brand Logo ─── */
        .brand-header {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
        }

        .brand-logo-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #00d2ff 0%, #0077ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.4);
            flex-shrink: 0;
        }

        .brand-text {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: #ffffff;
            line-height: 1;
        }

        .brand-tagline {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 3px;
            font-weight: 400;
            font-family: 'Space Mono', monospace;
            text-transform: uppercase;
        }

        /* ─── Sci-Fi Glass Card ─── */
        .scifi-card {
            width: 100%;
            background: rgba(12, 14, 20, 0.4);
            backdrop-filter: blur(25px) saturate(140%);
            -webkit-backdrop-filter: blur(25px) saturate(140%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            padding: clamp(20px, 5vw, 32px);
            display: flex;
            flex-direction: column;
            gap: 16px;
            position: relative;
        }

        .card-top-line {
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.6), transparent);
        }

        /* ─── Card Header ─── */
        .card-header-inner {
            text-align: center;
        }

        .card-title-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 4px;
        }

        .card-title {
            margin: 0;
            font-size: 21px;
            font-weight: 600;
            letter-spacing: 3px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .card-subtitle {
            margin: 4px 0 0;
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        /* ─── Form Elements ─── */
        .scifi-form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .field-label {
            font-size: 10px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.65);
            text-transform: uppercase;
        }

        .field-input-box {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            transition: all 0.25s ease;
        }

        .field-input-box.focused {
            border-color: #00d2ff;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.25), inset 0 0 10px rgba(0, 210, 255, 0.1);
        }

        .field-left-icon {
            position: absolute;
            left: 14px;
            display: flex;
            align-items: center;
            color: rgba(255, 255, 255, 0.45);
            pointer-events: none;
            transition: color 0.2s;
        }

        .field-input-box.focused .field-left-icon {
            color: #00d2ff;
        }

        .field-right-node {
            position: absolute;
            right: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .scifi-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #ffffff;
            font-size: 13.5px;
            padding: 12px 42px;
            font-family: 'Inter', sans-serif;
            caret-color: #00d2ff;
        }

        .scifi-input::placeholder {
            color: rgba(255, 255, 255, 0.25);
            font-size: 13px;
        }

        .scifi-input:-webkit-autofill,
        .scifi-input:-webkit-autofill:hover, 
        .scifi-input:-webkit-autofill:focus {
            transition: background-color 5000s ease-in-out 0s;
            -webkit-text-fill-color: #fff !important;
        }

        .field-error-text {
            font-size: 10.5px;
            color: #ff6b6b;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
        }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            padding: 0;
            color: rgba(255, 255, 255, 0.45);
            transition: color 0.2s ease;
        }

        .icon-btn:hover {
            color: #ffffff;
        }

        /* ─── Gravitational Password Stability Meter ─── */
        .stability-meter-bg {
            width: 100%;
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 6px;
        }

        .stability-meter-bar {
            height: 100%;
            width: 0%;
            background: #ff4444;
            transition: all 0.3s ease;
        }

        /* ─── Checkbox Terms ─── */
        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 2px;
        }

        .custom-checkbox {
            width: 15px;
            height: 15px;
            border-radius: 3px;
            flex-shrink: 0;
            margin-top: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.15s;
        }

        .custom-checkbox.checked {
            background: #00d2ff;
            border-color: #00d2ff;
        }

        .terms-text {
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.65);
            font-family: 'Space Mono', monospace;
            line-height: 1.4;
        }

        .terms-link {
            color: #00d2ff;
            text-decoration: none;
        }

        .terms-link:hover {
            text-decoration: underline;
        }

        /* ─── Action Buttons ─── */
        .scifi-btn {
            width: 100%;
            margin-top: 4px;
            padding: 13px 20px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 4px;
            color: #ffffff;
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
            font-size: 12.5px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .scifi-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.25);
        }

        .divider-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 1px 0;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
        }

        .divider-text {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.4);
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
        }

        .signin-redirect {
            margin: 2px 0 0;
            text-align: center;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        .signin-redirect a {
            color: #00d2ff;
            font-weight: 700;
            text-decoration: none;
        }

        .signin-redirect a:hover {
            text-decoration: underline;
        }

        .secure-status {
            text-align: center;
            font-size: 9px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 2px;
        }

        .secure-ticks {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-top: 6px;
        }

        .secure-tick {
            display: block;
            width: 14px;
            height: 2px;
            background: rgba(255, 255, 255, 0.2);
        }

        .secure-tick.active {
            background: rgba(0, 210, 255, 0.8);
            box-shadow: 0 0 8px rgba(0, 210, 255, 0.6);
        }

        /* ─── Trust Bar ─── */
        .trust-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-top: 16px;
            flex-wrap: wrap;
            opacity: 0.75;
            font-family: 'Space Mono', monospace;
            font-size: 9.5px;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.6);
        }

        .scifi-error-box {
            padding: 10px 14px;
            border-radius: 6px;
            background: rgba(255, 68, 68, 0.12);
            border: 1px solid rgba(255, 68, 68, 0.4);
            color: #ff8b8b;
            font-size: 12px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        /* ─── Step Wizard Progress ─── */
        .step-progress-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            padding: 0 4px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-family: 'Space Mono', monospace;
            font-size: 9px;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.4);
            transition: all 0.25s ease;
        }

        .step-item.active {
            color: #00d2ff;
        }

        .step-item.completed {
            color: #34d399;
        }

        .step-number {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
        }

        .step-item.active .step-number {
            border-color: #00d2ff;
            background: rgba(0, 210, 255, 0.2);
            color: #00d2ff;
            box-shadow: 0 0 12px rgba(0, 210, 255, 0.5);
        }

        .step-item.completed .step-number {
            border-color: #34d399;
            background: rgba(16, 185, 129, 0.25);
            color: #34d399;
        }

        .step-connector {
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.12);
            margin: 0 8px 14px 8px;
            transition: background 0.3s ease;
        }

        .step-connector.completed {
            background: rgba(52, 211, 153, 0.6);
            box-shadow: 0 0 8px rgba(52, 211, 153, 0.3);
        }

        /* ─── Campus Mail Notification Toast Banner ─── */
        .campus-mail-toast {
            border-radius: 8px;
            background: linear-gradient(135deg, rgba(6, 78, 59, 0.9) 0%, rgba(4, 120, 87, 0.75) 100%);
            border: 1px solid rgba(52, 211, 153, 0.5);
            padding: 12px 14px;
            color: #ecfdf5;
            font-size: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 20px rgba(16, 185, 129, 0.25);
            margin-bottom: 12px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideDownToast 0.3s ease;
        }

        @@keyframes slideDownToast {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .campus-otp-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 4px;
            background: #022c22;
            color: #34d399;
            font-family: 'Space Mono', monospace;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 4px;
            border: 1px solid rgba(52, 211, 153, 0.5);
            margin-top: 4px;
        }

        .otp-input-field {
            text-align: center;
            font-family: 'Space Mono', monospace;
            font-size: 22px;
            letter-spacing: 8px;
            font-weight: 700;
            color: #00d2ff;
        }

        .verified-badge {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-radius: 6px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #6ee7b7;
            font-size: 12px;
            margin-bottom: 12px;
            font-family: 'Space Mono', monospace;
        }

        .domain-notice {
            font-size: 11px;
            color: #fbbf24;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }

        .chip-autocomplete {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
            padding: 4px 10px;
            border-radius: 4px;
            background: rgba(0, 210, 255, 0.1);
            border: 1px solid rgba(0, 210, 255, 0.4);
            color: #00d2ff;
            font-size: 11px;
            font-family: 'Space Mono', monospace;
            cursor: pointer;
            transition: all 0.2s;
        }

        .chip-autocomplete:hover {
            background: rgba(0, 210, 255, 0.2);
            color: #ffffff;
        }


    </style>
</head>
<body>

    <!-- Top Floating Header Bar with Back to Home -->
    <header style="position: fixed; top: 18px; left: 20px; right: 20px; z-index: 100; display: flex; align-items: center; justify-content: space-between; pointer-events: none;">
        <a href="/" style="pointer-events: auto; display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 9999px; background: rgba(6, 12, 18, 0.88); border: 1px solid rgba(255, 255, 255, 0.16); color: #e2e8f0; font-size: 13px; font-weight: 600; text-decoration: none; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45); transition: all 0.25s ease;" title="Return to UniVerse Home Page">
            <i class="bi bi-arrow-left" style="color: #00d2ff; font-size: 14px;"></i>
            <span>Back to Home</span>
        </a>
        <a href="/" style="pointer-events: auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 9999px; background: rgba(6, 12, 18, 0.88); border: 1px solid rgba(255, 255, 255, 0.16); color: #e2e8f0; font-size: 13px; font-weight: 600; text-decoration: none; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45); transition: all 0.25s ease;" title="UniVerse Home Page">
            <i class="bi bi-house-door-fill" style="color: #00d2ff; font-size: 14px;"></i>
            <span>Home</span>
        </a>
    </header>

    <!-- 3D WebGL Gargantua Black Hole Canvas Background -->
    <div id="blackHoleContainer"></div>
    <div class="cinematic-vignette"></div>

    <!-- HUD Top-Left -->
    <div class="hud-tl">
        <div class="hud-tl-corner"></div>
        <strong style="color: #ffffff;">EVENT HORIZON</strong><br />
        <span style="color: #00d2ff;">GRAVITY: STABILIZED</span>
    </div>

    <!-- HUD Top-Right -->
    <div class="hud-tr">
        <div class="hud-tr-corner"></div>
        <strong style="color: #ffffff;">SYSTEM STATUS</strong><br />
        <span style="color: #00d2ff;">ONLINE // NOMINAL</span>
    </div>

    <!-- Main Register Container -->
    <div class="register-container" id="mainContainer">

        <!-- Logo + Tagline -->
        <a href="/" class="brand-header">
            <div class="brand-logo-box">
                <div class="brand-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="black" stroke="black" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                </div>
                <span class="brand-text">UniVerse</span>
            </div>
            <span class="brand-tagline">One Universe. Infinite Possibilities.</span>
        </a>

        <!-- Semi-Transparent Sci-Fi Glass Card -->
        <div class="scifi-card">
            <div class="card-top-line"></div>

            <!-- Card Header -->
            <div class="card-header-inner">
                <div class="card-title-row">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2L13.5 9.5L21 11L13.5 12.5L12 20L10.5 12.5L3 11L10.5 9.5L12 2Z" fill="#00d2ff" />
                    </svg>
                    <h1 class="card-title">Create account</h1>
                </div>
                <p class="card-subtitle">Join UniVerse — exclusively for Marwadi University</p>
            </div>

            <!-- Institutional Notice Badge -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(0, 210, 255, 0.08); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 12px; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-shield-check" style="color: #00d2ff; font-size: 16px;"></i>
                    <span style="font-size: 11px; font-weight: 700; color: #e2e8f0; font-family: 'Space Mono', monospace;">MARWADI UNIVERSITY ENROLLMENT</span>
                </div>
                <span style="font-size: 10px; color: #34d399; font-weight: 700; font-family: 'Space Mono', monospace;">@@marwadiuniversity.ac.in</span>
            </div>

            <!-- Server & Client Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="scifi-error-box">
                    @Html.ValidationSummary(false, "", new { style = "list-style: none; padding: 0; margin: 0;" })
                </div>
            }
            <div id="clientErrorBox" class="scifi-error-box" style="display: none;"></div>

            <!-- ASP.NET Core MVC Form -->
            <form asp-controller="Account" asp-action="Register" method="post" class="scifi-form" id="registerForm" noValidate>
                @Html.AntiForgeryToken()

                <!-- Hidden inputs -->
                <input type="hidden" name="Role" value="student" />

                <!-- 1. Full Name -->
                <div class="field-group">
                    <label for="nameInput" class="field-label">Full Name</label>
                    <div class="field-input-box" id="nameBox">
                        <span class="field-left-icon">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="FullName" id="nameInput" class="scifi-input" type="text" placeholder="e.g. Avinash Kumar" autocomplete="name" required />
                    </div>
                </div>

                <!-- 2. University Email -->
                <div class="field-group" style="margin-top: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label for="emailInput" class="field-label">University Email</label>
                        <span style="font-size: 9.5px; color: #00d2ff; font-family: 'Space Mono', monospace;">@@marwadiuniversity.ac.in</span>
                    </div>
                    <div class="field-input-box" id="emailBox">
                        <span class="field-left-icon">
                            <i class="bi bi-envelope"></i>
