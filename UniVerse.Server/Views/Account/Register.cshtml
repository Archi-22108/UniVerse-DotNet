@model UniVerse.Server.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create Account — UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Space Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Three.js for 3D Gargantua Black Hole WebGL Animation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000002;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px 14px;
            position: relative;
            overflow-x: hidden;
        }

        /* ─── WebGL Canvas Container ─── */
        #blackHoleContainer {
            position: fixed;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* ─── Cinematic Vignette ─── */
        .cinematic-vignette {
            position: fixed;
            inset: 0;
            z-index: 2;
            background: radial-gradient(circle at center, transparent 35%, rgba(0, 2, 8, 0.65) 100%);
            pointer-events: none;
        }

        /* ─── Sci-Fi HUD Overlays ─── */
        .hud-tl {
            position: absolute;
            top: 28px;
            left: 32px;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
        }

        .hud-tl-corner {
            position: absolute;
            top: -6px;
            left: -6px;
            width: 10px;
            height: 10px;
            border-left: 1px solid rgba(0, 210, 255, 0.6);
            border-top: 1px solid rgba(0, 210, 255, 0.6);
        }

        .hud-tr {
            position: absolute;
            top: 28px;
            right: 32px;
            text-align: right;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
        }

        .hud-tr-corner {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 10px;
            height: 10px;
            border-right: 1px solid rgba(0, 210, 255, 0.6);
            border-top: 1px solid rgba(0, 210, 255, 0.6);
        }

        @@media (max-width: 640px) {
            .hud-tl, .hud-tr { display: none; }
        }

        /* ─── Main Container ─── */
        .register-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 460px;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* ─── Brand Logo ─── */
        .brand-header {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
        }

        .brand-logo-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #00d2ff 0%, #0077ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.4);
            flex-shrink: 0;
        }

        .brand-text {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: #ffffff;
            line-height: 1;
        }

        .brand-tagline {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 3px;
            font-weight: 400;
            font-family: 'Space Mono', monospace;
            text-transform: uppercase;
        }

        /* ─── Sci-Fi Glass Card ─── */
        .scifi-card {
            width: 100%;
            background: rgba(12, 14, 20, 0.4);
            backdrop-filter: blur(25px) saturate(140%);
            -webkit-backdrop-filter: blur(25px) saturate(140%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            padding: clamp(20px, 5vw, 32px);
            display: flex;
            flex-direction: column;
            gap: 16px;
            position: relative;
        }

        .card-top-line {
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.6), transparent);
        }

        /* ─── Card Header ─── */
        .card-header-inner {
            text-align: center;
        }

        .card-title-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 4px;
        }

        .card-title {
            margin: 0;
            font-size: 21px;
            font-weight: 600;
            letter-spacing: 3px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .card-subtitle {
            margin: 4px 0 0;
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        /* ─── Form Elements ─── */
        .scifi-form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .field-label {
            font-size: 10px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.65);
            text-transform: uppercase;
        }

        .field-input-box {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            transition: all 0.25s ease;
        }

        .field-input-box.focused {
            border-color: #00d2ff;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.25), inset 0 0 10px rgba(0, 210, 255, 0.1);
        }

        .field-left-icon {
            position: absolute;
            left: 14px;
            display: flex;
            align-items: center;
            color: rgba(255, 255, 255, 0.45);
            pointer-events: none;
            transition: color 0.2s;
        }

        .field-input-box.focused .field-left-icon {
            color: #00d2ff;
        }

        .field-right-node {
            position: absolute;
            right: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .scifi-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #ffffff;
            font-size: 13.5px;
            padding: 12px 42px;
            font-family: 'Inter', sans-serif;
            caret-color: #00d2ff;
        }

        .scifi-input::placeholder {
            color: rgba(255, 255, 255, 0.25);
            font-size: 13px;
        }

        .scifi-input:-webkit-autofill,
        .scifi-input:-webkit-autofill:hover, 
        .scifi-input:-webkit-autofill:focus {
            transition: background-color 5000s ease-in-out 0s;
            -webkit-text-fill-color: #fff !important;
        }

        .field-error-text {
            font-size: 10.5px;
            color: #ff6b6b;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
        }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            padding: 0;
            color: rgba(255, 255, 255, 0.45);
            transition: color 0.2s ease;
        }

        .icon-btn:hover {
            color: #ffffff;
        }

        /* ─── Gravitational Password Stability Meter ─── */
        .stability-meter-bg {
            width: 100%;
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 6px;
        }

        .stability-meter-bar {
            height: 100%;
            width: 0%;
            background: #ff4444;
            transition: all 0.3s ease;
        }

        /* ─── Checkbox Terms ─── */
        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 2px;
        }

        .custom-checkbox {
            width: 15px;
            height: 15px;
            border-radius: 3px;
            flex-shrink: 0;
            margin-top: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.15s;
        }

        .custom-checkbox.checked {
            background: #00d2ff;
            border-color: #00d2ff;
        }

        .terms-text {
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.65);
            font-family: 'Space Mono', monospace;
            line-height: 1.4;
        }

        .terms-link {
            color: #00d2ff;
            text-decoration: none;
        }

        .terms-link:hover {
            text-decoration: underline;
        }

        /* ─── Action Buttons ─── */
        .scifi-btn {
            width: 100%;
            margin-top: 4px;
            padding: 13px 20px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 4px;
            color: #ffffff;
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
            font-size: 12.5px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .scifi-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.25);
        }

        .divider-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 1px 0;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
        }

        .divider-text {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.4);
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
        }

        .scifi-google-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 4px;
            padding: 11px 18px;
            color: #ffffff;
            font-size: 11.5px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .scifi-google-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 210, 255, 0.4);
        }

        .signin-redirect {
            margin: 2px 0 0;
            text-align: center;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        .signin-redirect a {
            color: #00d2ff;
            font-weight: 700;
            text-decoration: none;
        }

        .signin-redirect a:hover {
            text-decoration: underline;
        }

        .secure-status {
            text-align: center;
            font-size: 9px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 2px;
        }

        .secure-ticks {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-top: 6px;
        }

        .secure-tick {
            display: block;
            width: 14px;
            height: 2px;
            background: rgba(255, 255, 255, 0.2);
        }

        .secure-tick.active {
            background: rgba(0, 210, 255, 0.8);
            box-shadow: 0 0 8px rgba(0, 210, 255, 0.6);
        }

        /* ─── Trust Bar ─── */
        .trust-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-top: 16px;
            flex-wrap: wrap;
            opacity: 0.75;
            font-family: 'Space Mono', monospace;
            font-size: 9.5px;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.6);
        }

        .scifi-error-box {
            padding: 10px 14px;
            border-radius: 6px;
            background: rgba(255, 68, 68, 0.12);
            border: 1px solid rgba(255, 68, 68, 0.4);
            color: #ff8b8b;
            font-size: 12px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

    <!-- 3D WebGL Gargantua Black Hole Canvas Background -->
    <div id="blackHoleContainer"></div>
    <div class="cinematic-vignette"></div>

    <!-- HUD Top-Left -->
    <div class="hud-tl">
        <div class="hud-tl-corner"></div>
        <strong style="color: #ffffff;">EVENT HORIZON</strong><br />
        <span style="color: #00d2ff;">GRAVITY: STABILIZED</span>
    </div>

    <!-- HUD Top-Right -->
    <div class="hud-tr">
        <div class="hud-tr-corner"></div>
        <strong style="color: #ffffff;">SYSTEM STATUS</strong><br />
        <span style="color: #00d2ff;">ONLINE // NOMINAL</span>
    </div>

    <!-- Main Register Container -->
    <div class="register-container" id="mainContainer">

        <!-- Logo + Tagline -->
        <a href="/" class="brand-header">
            <div class="brand-logo-box">
                <div class="brand-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="black" stroke="black" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                </div>
                <span class="brand-text">UniVerse</span>
            </div>
            <span class="brand-tagline">One Universe. Infinite Possibilities.</span>
        </a>

        <!-- Semi-Transparent Sci-Fi Glass Card -->
        <div class="scifi-card">
            <div class="card-top-line"></div>

            <!-- Card Header -->
            <div class="card-header-inner">
                <div class="card-title-row">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2L13.5 9.5L21 11L13.5 12.5L12 20L10.5 12.5L3 11L10.5 9.5L12 2Z" fill="#00d2ff" />
                    </svg>
                    <h1 class="card-title">Create account</h1>
                </div>
                <p class="card-subtitle">Join UniVerse — exclusively for Marwadi University</p>
            </div>

            <!-- ASP.NET Core MVC Form -->
            <form asp-controller="Account" asp-action="Register" method="post" class="scifi-form" id="registerForm" noValidate>
                @Html.AntiForgeryToken()

                <!-- Hidden inputs to fulfill backend default requirements safely -->
                <input type="hidden" name="Role" value="student" />
                <input type="hidden" name="HostelName" value="Hostel D" />
                <input type="hidden" name="RoomNumber" value="Room 101" />

                <!-- Server-side validation summary if errors occur -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="scifi-error-box">
                        @Html.ValidationSummary(false, "", new { style = "list-style: none; padding: 0; margin: 0;" })
                    </div>
                }

                <!-- Client-side error message container -->
                <div id="clientErrorBox" class="scifi-error-box" style="display: none;"></div>

                <!-- 1. Full Name -->
                <div class="field-group">
                    <label for="nameInput" class="field-label">Full Name</label>
                    <div class="field-input-box" id="nameBox">
                        <span class="field-left-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <input asp-for="FullName" id="nameInput" class="scifi-input" type="text" placeholder="e.g. Avinash Kumar" autocomplete="name" required />
                    </div>
                    <span id="nameError" class="field-error-text"></span>
                </div>

                <!-- 2. University Email -->
                <div class="field-group">
                    <label for="emailInput" class="field-label">University Email</label>
                    <div class="field-input-box" id="emailBox">
                        <span class="field-left-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2" />
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                        </span>
                        <input asp-for="Email" id="emailInput" class="scifi-input" type="email" placeholder="you@marwadiuniversity.ac.in" autocomplete="email" required />
                        <span id="emailCheck" class="field-right-node" style="display: none;">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#00d2ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                        </span>
                    </div>
                    <span id="emailError" class="field-error-text"></span>
                </div>

                <!-- 3. Password -->
                <div class="field-group">
                    <label for="passwordInput" class="field-label">Password</label>
                    <div class="field-input-box" id="passBox">
                        <span class="field-left-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="Password" id="passwordInput" class="scifi-input" type="password" placeholder="Min. 8 characters" autocomplete="new-password" required />
                        <span class="field-right-node">
                            <button type="button" class="icon-btn" id="togglePassBtn" aria-label="Toggle password visibility">
                                <svg id="eyePassOpen" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg id="eyePassClose" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </span>
                    </div>
                    <!-- Gravitational Stability Meter -->
                    <div class="stability-meter-bg">
                        <div id="strengthBar" class="stability-meter-bar"></div>
                    </div>
                    <span id="passwordError" class="field-error-text"></span>
                </div>

                <!-- 4. Confirm Password -->
                <div class="field-group">
                    <label for="confirmInput" class="field-label">Confirm Password</label>
                    <div class="field-input-box" id="confirmBox">
                        <span class="field-left-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="ConfirmPassword" id="confirmInput" class="scifi-input" type="password" placeholder="Re-enter your password" autocomplete="new-password" required />
                        <span class="field-right-node">
                            <span id="confirmCheck" style="display: none;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00d2ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <polyline points="22 4 12 14.01 9 11.01" />
                                </svg>
                            </span>
                            <button type="button" class="icon-btn" id="toggleConfirmBtn" aria-label="Toggle confirm password visibility">
                                <svg id="eyeConfirmOpen" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg id="eyeConfirmClose" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </span>
                    </div>
                    <span id="confirmError" class="field-error-text"></span>
                </div>

                <!-- Terms Checkbox -->
                <div class="terms-row">
                    <div id="termsCheckbox" class="custom-checkbox" role="checkbox" aria-checked="false" tabindex="0">
                        <svg id="checkboxSvg" viewBox="0 0 10 8" width="8" height="7" fill="none" style="display: none;">
                            <path d="M1 4l2.5 2.5L9 1" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <span class="terms-text">
                        I agree to the <a href="/" class="terms-link">Terms of Service</a> & <a href="/" class="terms-link">Privacy Policy</a>
                    </span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitBtn" class="scifi-btn">
                    <span>Create Account</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>

                <!-- OR Divider -->
                <div class="divider-row">
                    <div class="divider-line"></div>
                    <span class="divider-text">OR</span>
                    <div class="divider-line"></div>
                </div>

                <!-- Google OAuth Button -->
                <a href="/Account/QuickLogin?email=aarav.patel%40marwadiuniversity.ac.in" class="scifi-google-btn">
                    <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                    Continue with Google
                </a>

                <!-- Sign in redirect -->
                <p class="signin-redirect">
                    Already have an account? <a href="/Account/Login">Sign in &gt;</a>
                </p>
            </form>

            <!-- Secure Connection Status -->
            <div class="secure-status">
                SECURE CONNECTION ESTABLISHED
                <div class="secure-ticks">
                    <span class="secure-tick"></span>
                    <span class="secure-tick active"></span>
                    <span class="secure-tick"></span>
                </div>
            </div>
        </div>

        <!-- Trust Bar -->
        <div class="trust-bar">
            <span>256-BIT ENCRYPTED</span>
            <span>•</span>
            <span>YOUR DATA IS PRIVATE</span>
            <span>•</span>
            <span>TRUSTED BY STUDENTS</span>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         3D WEBGL GARGANTUA BLACK HOLE ANIMATION SCRIPT
    ═══════════════════════════════════════════════════════════════════════ -->
    <script>
        // ─── GLSL Shaders from BlackHoleBackground.tsx ──────────────────────────
        const VERTEX_SHADER = `
            varying vec2 vUv;
            void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
        `;

        const FRAGMENT_SHADER = `
            uniform float uTime;
            uniform float uStabilize; 
            uniform float uAspect;
            uniform float uExposure;
            varying vec2 vUv;

            float random(vec2 st) {
                return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
            }
            
            float noise(vec2 st) {
                vec2 i = floor(st);
                vec2 f = fract(st);
                float a = random(i); float b = random(i + vec2(1.0, 0.0));
                float c = random(i + vec2(0.0, 1.0)); float d = random(i + vec2(1.0, 1.0));
                vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
            }
            
            float fbm(vec2 st) {
                float v = 0.0; float a = 0.5; vec2 shift = vec2(100.0);
                mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
                for (int i = 0; i < 5; ++i) {
                    v += a * noise(st); st = rot * st * 2.0 + shift; a *= 0.5;
                }
                return v;
            }

            void main() {
                vec2 uv = vUv - 0.5;
                uv.x *= uAspect;
                
                float chaos = 1.0 - uStabilize;
                float rBase = length(uv);

                // 1. Interactive Gravitational Twist
                float twist = chaos * 15.0 * exp(-rBase * 6.0); 
                float angle = atan(uv.y, uv.x) + twist;
                
                vec2 p = vec2(cos(angle), sin(angle)) * rBase;
                float pr = length(p);

                // 2. The Singularity (Event Horizon)
                float horizon = 0.15;
                float isVoid = smoothstep(horizon - 0.005, horizon + 0.005, pr);

                // 3. The Lensed Halo
                float haloRadius = horizon * 1.5;
                float haloThickness = abs(pr - haloRadius);
                float pinch = smoothstep(0.0, 0.15, abs(p.y));
                
                float halo = exp(-haloThickness * 40.0) * pinch;
                halo += exp(-haloThickness * 10.0) * 0.4 * pinch;

                // 4. The Front Accretion Disk
                float diskY = abs(p.y);
                float diskX = abs(p.x);
                float innerEllipse = length(vec2(p.x, p.y * 5.0));
                float diskCutout = smoothstep(horizon * 1.1, horizon * 1.4, innerEllipse);
                
                float frontDisk = exp(-diskY * 80.0) * diskCutout;
                frontDisk += exp(-diskY * 15.0) * 0.5 * diskCutout; 
                frontDisk *= smoothstep(1.3, 0.3, diskX);

                // 5. Volumetric Noise Details
                vec2 polar = vec2(atan(p.y, p.x), pr);
                float nHalo = fbm(vec2(polar.x * 4.0 - uTime * 0.15, pr * 50.0));
                halo *= (nHalo * 0.7 + 0.3);
                
                float nDisk = fbm(vec2(p.x * 10.0 - uTime * 0.45, p.y * 100.0));
                frontDisk *= (nDisk * 0.8 + 0.2);

                // 6. Composition
                float density = (halo * isVoid) + frontDisk;
                float nebula = fbm(p * 3.0 + uTime * 0.03) * 0.1;
                nebula *= smoothstep(0.0, 0.6, pr); 
                density += nebula;

                // 7. Cinematic Interstellar Color Grading
                vec3 cDark = vec3(0.18, 0.05, 0.01);
                vec3 cMid = vec3(1.0, 0.45, 0.15);
                vec3 cLight = vec3(1.0, 0.95, 0.9);
                
                vec3 color = mix(vec3(0.0), cDark, smoothstep(0.0, 0.15, density));
                color = mix(color, cMid, smoothstep(0.15, 0.4, density));
                color = mix(color, cLight, smoothstep(0.4, 1.0, density));

                // 8. Doppler Beaming Physics
                float doppler = 1.0 - p.x * 0.6;
                color *= mix(1.0, doppler, smoothstep(0.0, 1.0, pr * 2.0));

                // 9. Lensed Background Stars
                vec2 starPos = p * 150.0;
                float starGrid = random(floor(starPos));
                float starShape = smoothstep(0.4, 0.0, length(fract(starPos) - 0.5));
                float lensedStars = smoothstep(0.98, 1.0, starGrid) * starShape;
                lensedStars *= smoothstep(horizon * 1.05, horizon * 1.5, pr); 
                lensedStars *= smoothstep(0.4, 0.0, density); 
                
                vec3 starColor = mix(vec3(0.5, 0.8, 1.0), vec3(1.0, 0.7, 0.4), random(floor(starPos) + 1.0));
                color += starColor * lensedStars * 3.0 * isVoid;

                // 10. Absolute Vantablack Singularity & Exposure
                color *= isVoid;
                color *= 1.45 * uExposure;

                float alphaMask = smoothstep(1.0, 0.4, pr);
                alphaMask = max(alphaMask, smoothstep(0.1, 0.5, density));

                gl_FragColor = vec4(color, alphaMask);
            }
        `;

        function createStarTexture() {
            const canvas = document.createElement("canvas");
            canvas.width = 32;
            canvas.height = 32;
            const ctx = canvas.getContext("2d");
            if (!ctx) return null;
            const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
            gradient.addColorStop(0, "rgba(255,255,255,1)");
            gradient.addColorStop(0.3, "rgba(255,255,255,0.8)");
            gradient.addColorStop(1, "rgba(255,255,255,0)");
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 32, 32);
            return new THREE.CanvasTexture(canvas);
        }

        // Initialize 3D WebGL Black Hole Scene
        const container = document.getElementById("blackHoleContainer");
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 7.5;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
        container.appendChild(renderer.domElement);

        const uniforms = {
            uTime: { value: 0.0 },
            uStabilize: { value: 0.3 },
            uAspect: { value: window.innerWidth / window.innerHeight },
            uExposure: { value: 0.4 }
        };

        const portalGeometry = new THREE.PlaneGeometry(12, 12);
        const portalMaterial = new THREE.ShaderMaterial({
            vertexShader: VERTEX_SHADER,
            fragmentShader: FRAGMENT_SHADER,
            uniforms: uniforms,
            transparent: true,
            depthWrite: false
        });
        const portal = new THREE.Mesh(portalGeometry, portalMaterial);
        scene.add(portal);

        // 3,000 Starfield Particles
        const starsCount = 2800;
        const starsGeometry = new THREE.BufferGeometry();
        const posArray = new Float32Array(starsCount * 3);
        const colArray = new Float32Array(starsCount * 3);

        for (let i = 0; i < starsCount * 3; i += 3) {
            posArray[i] = (Math.random() - 0.5) * 30;
            posArray[i + 1] = (Math.random() - 0.5) * 30;
            posArray[i + 2] = (Math.random() - 0.5) * 20;
            const isWarm = Math.random() > 0.6;
            colArray[i] = 1.0;
            colArray[i + 1] = isWarm ? 0.6 + Math.random() * 0.2 : 0.8 + Math.random() * 0.2;
            colArray[i + 2] = isWarm ? 0.3 + Math.random() * 0.2 : 0.9 + Math.random() * 0.1;
        }

        starsGeometry.setAttribute("position", new THREE.BufferAttribute(posArray, 3));
        starsGeometry.setAttribute("color", new THREE.BufferAttribute(colArray, 3));

        const starTexture = createStarTexture();
        const starsMaterial = new THREE.PointsMaterial({
            size: 0.055,
            vertexColors: true,
            transparent: true,
            opacity: 0.85,
            blending: THREE.AdditiveBlending,
            map: starTexture || undefined,
            depthWrite: false
        });
        const starMesh = new THREE.Points(starsGeometry, starsMaterial);
        scene.add(starMesh);

        // Interactive Parallax
        let targetX = 0, targetY = 0, mouseX = 0, mouseY = 0;
        let lastTime = performance.now();
        let introProgress = 0;
        let isWarping = false;

        window.addEventListener("mousemove", (e) => {
            if (isWarping) return;
            targetX = (e.clientX / window.innerWidth) * 2 - 1;
            targetY = -(e.clientY / window.innerHeight) * 2 + 1;
        }, { passive: true });

        window.addEventListener("resize", () => {
            const w = window.innerWidth, h = window.innerHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
            uniforms.uAspect.value = w / h;
        });

        // 60FPS Animation Loop
        function animate() {
            requestAnimationFrame(animate);
            const now = performance.now();
            const delta = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;

            if (isWarping) {
                uniforms.uTime.value += delta * 12.0;
                uniforms.uStabilize.value = Math.max(-1.0, uniforms.uStabilize.value - delta * 4.0);
                uniforms.uExposure.value += delta * 3.0;
                camera.position.z -= delta * 15.0;
                camera.lookAt(0, 0, -20);
            } else {
                uniforms.uTime.value += delta * 1.0;

                if (introProgress < 1.0) {
                    introProgress = Math.min(1.0, introProgress + delta * 0.8);
                    const ease = 1.0 - Math.pow(1.0 - introProgress, 3.0);
                    camera.position.z = THREE.MathUtils.lerp(7.5, 4.0, ease);
                    uniforms.uExposure.value = THREE.MathUtils.lerp(0.4, 1.05, ease);
                    uniforms.uStabilize.value = THREE.MathUtils.lerp(0.3, 1.0, ease);
                } else {
                    camera.position.z = 4.0;
                    uniforms.uExposure.value = 1.05;
                    uniforms.uStabilize.value = 1.0;
                }

                // Drift stars forward towards camera
                const pos = starMesh.geometry.attributes.position.array;
                for (let i = 2; i < pos.length; i += 3) {
                    pos[i] += 1.2 * delta;
                    if (pos[i] > camera.position.z) pos[i] = -20;
                }
                starMesh.geometry.attributes.position.needsUpdate = true;

                // Subtle smooth idle & mouse parallax
                const t = uniforms.uTime.value;
                const idleX = Math.sin(t * 0.15) * 0.06;
                const idleY = Math.cos(t * 0.1) * 0.06;
                mouseX += (targetX * 0.12 - mouseX) * 0.05;
                mouseY += (targetY * 0.12 - mouseY) * 0.05;
                camera.position.x = idleX + mouseX;
                camera.position.y = idleY + mouseY;
                camera.lookAt(0, 0, 0);
            }

            renderer.render(scene, camera);
        }

        animate();

        // ─── Form Client-side Logic & Warp Effect ─────────────────────────────
        const nameInput = document.getElementById('nameInput');
        const emailInput = document.getElementById('emailInput');
        const passInput = document.getElementById('passwordInput');
        const confirmInput = document.getElementById('confirmInput');
        const emailCheck = document.getElementById('emailCheck');
        const confirmCheck = document.getElementById('confirmCheck');
        const strengthBar = document.getElementById('strengthBar');
        const termsCheckbox = document.getElementById('termsCheckbox');
        const checkboxSvg = document.getElementById('checkboxSvg');
        const registerForm = document.getElementById('registerForm');
        const clientErrorBox = document.getElementById('clientErrorBox');
        const mainContainer = document.getElementById('mainContainer');

        let agreedToTerms = false;
        const MU_EMAIL_REGEX = /^[a-zA-Z0-9._%+-]+@@marwadiuniversity\.ac\.in$/i;

        [
            { input: nameInput, box: document.getElementById('nameBox') },
            { input: emailInput, box: document.getElementById('emailBox') },
            { input: passInput, box: document.getElementById('passBox') },
            { input: confirmInput, box: document.getElementById('confirmBox') }
        ].forEach(pair => {
            pair.input.addEventListener('focus', () => pair.box.classList.add('focused'));
            pair.input.addEventListener('blur', () => pair.box.classList.remove('focused'));
        });

        emailInput.addEventListener('input', () => {
            emailCheck.style.display = MU_EMAIL_REGEX.test(emailInput.value.trim()) ? 'flex' : 'none';
        });

        passInput.addEventListener('input', () => {
            const val = passInput.value;
            if (val.length === 0) {
                strengthBar.style.width = '0%';
                return;
            }
            const strength = Math.min(100, (val.length * 8) + (/[A-Z]/.test(val) ? 15 : 0) + (/[0-9]/.test(val) ? 15 : 0) + (/[^A-Za-z0-9]/.test(val) ? 20 : 0));
            strengthBar.style.width = strength + '%';
            strengthBar.style.background = strength < 40 ? '#ff4444' : strength < 75 ? '#ff8c42' : '#00d2ff';
            strengthBar.style.boxShadow = '0 0 10px ' + (strength < 40 ? '#ff4444' : strength < 75 ? '#ff8c42' : '#00d2ff');
            checkPasswordsMatch();
        });

        confirmInput.addEventListener('input', checkPasswordsMatch);

        function checkPasswordsMatch() {
            confirmCheck.style.display = (passInput.value.length >= 8 && passInput.value === confirmInput.value) ? 'flex' : 'none';
        }

        const togglePassBtn = document.getElementById('togglePassBtn');
        const eyePassOpen = document.getElementById('eyePassOpen');
        const eyePassClose = document.getElementById('eyePassClose');
        togglePassBtn.addEventListener('click', () => {
            const isPass = passInput.type === 'password';
            passInput.type = isPass ? 'text' : 'password';
            eyePassOpen.style.display = isPass ? 'none' : 'block';
            eyePassClose.style.display = isPass ? 'block' : 'none';
        });

        const toggleConfirmBtn = document.getElementById('toggleConfirmBtn');
        const eyeConfirmOpen = document.getElementById('eyeConfirmOpen');
        const eyeConfirmClose = document.getElementById('eyeConfirmClose');
        toggleConfirmBtn.addEventListener('click', () => {
            const isPass = confirmInput.type === 'password';
            confirmInput.type = isPass ? 'text' : 'password';
            eyeConfirmOpen.style.display = isPass ? 'none' : 'block';
            eyeConfirmClose.style.display = isPass ? 'block' : 'none';
        });

        termsCheckbox.addEventListener('click', toggleTerms);
        termsCheckbox.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                toggleTerms();
            }
        });

        function toggleTerms() {
            agreedToTerms = !agreedToTerms;
            termsCheckbox.classList.toggle('checked', agreedToTerms);
            checkboxSvg.style.display = agreedToTerms ? 'block' : 'none';
        }

        registerForm.addEventListener('submit', (e) => {
            clientErrorBox.style.display = 'none';
            clientErrorBox.innerText = '';

            const name = nameInput.value.trim();
            const email = emailInput.value.trim();
            const pass = passInput.value;
            const confirm = confirmInput.value;

            if (!name || name.length < 2) {
                e.preventDefault();
                showError("Full name must be at least 2 characters.");
                return;
            }

            if (!email || !MU_EMAIL_REGEX.test(email)) {
                e.preventDefault();
                showError("Must be a @@marwadiuniversity.ac.in email address.");
                return;
            }

            if (!pass || pass.length < 8) {
                e.preventDefault();
                showError("Password must be at least 8 characters.");
                return;
            }

            if (pass !== confirm) {
                e.preventDefault();
                showError("Passwords do not match.");
                return;
            }

            if (!agreedToTerms) {
                e.preventDefault();
                showError("You must agree to the Terms & Privacy Policy to continue.");
                return;
            }

            // Trigger Warp Speed animation on valid submission!
            isWarping = true;
            document.getElementById('submitBtn').innerHTML = '<span>ENTERING…</span>';
            mainContainer.style.transform = 'scale(0) rotate(-10deg)';
            mainContainer.style.opacity = '0';
            mainContainer.style.filter = 'blur(10px)';
        });

        function showError(msg) {
            clientErrorBox.innerText = msg;
            clientErrorBox.style.display = 'block';
        }
    </script>
