    <!-- ═══════════════════════════════════════════════════════════════════════
         3D WEBGL GARGANTUA BLACK HOLE ANIMATION SCRIPT
    ═══════════════════════════════════════════════════════════════════════ -->
    <script>
        // ─── GLSL Shaders from BlackHoleBackground.tsx ──────────────────────────
        const VERTEX_SHADER = `
            varying vec2 vUv;
            void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
        `;

        const FRAGMENT_SHADER = `
            uniform float uTime;
            uniform float uStabilize; 
            uniform float uAspect;
            uniform float uExposure;
            varying vec2 vUv;

            float random(vec2 st) {
                return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
            }
            
            float noise(vec2 st) {
                vec2 i = floor(st);
                vec2 f = fract(st);
                float a = random(i); float b = random(i + vec2(1.0, 0.0));
                float c = random(i + vec2(0.0, 1.0)); float d = random(i + vec2(1.0, 1.0));
                vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
            }
            
            float fbm(vec2 st) {
                float v = 0.0; float a = 0.5; vec2 shift = vec2(100.0);
                mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
                for (int i = 0; i < 5; ++i) {
                    v += a * noise(st); st = rot * st * 2.0 + shift; a *= 0.5;
                }
                return v;
            }

            void main() {
                vec2 uv = vUv - 0.5;
                uv.x *= uAspect;
                
                float chaos = 1.0 - uStabilize;
                float rBase = length(uv);

                // 1. Interactive Gravitational Twist
                float twist = chaos * 15.0 * exp(-rBase * 6.0); 
                float angle = atan(uv.y, uv.x) + twist;
                
                vec2 p = vec2(cos(angle), sin(angle)) * rBase;
                float pr = length(p);

                // 2. The Singularity (Event Horizon)
                float horizon = 0.15;
                float isVoid = smoothstep(horizon - 0.005, horizon + 0.005, pr);

                // 3. The Lensed Halo
                float haloRadius = horizon * 1.5;
                float haloThickness = abs(pr - haloRadius);
                float pinch = smoothstep(0.0, 0.15, abs(p.y));
                
                float halo = exp(-haloThickness * 40.0) * pinch;
                halo += exp(-haloThickness * 10.0) * 0.4 * pinch;

                // 4. The Front Accretion Disk
                float diskY = abs(p.y);
                float diskX = abs(p.x);
                float innerEllipse = length(vec2(p.x, p.y * 5.0));
                float diskCutout = smoothstep(horizon * 1.1, horizon * 1.4, innerEllipse);
                
                float frontDisk = exp(-diskY * 80.0) * diskCutout;
                frontDisk += exp(-diskY * 15.0) * 0.5 * diskCutout; 
                frontDisk *= smoothstep(1.3, 0.3, diskX);

                // 5. Volumetric Noise Details
                vec2 polar = vec2(atan(p.y, p.x), pr);
                float nHalo = fbm(vec2(polar.x * 4.0 - uTime * 0.15, pr * 50.0));
                halo *= (nHalo * 0.7 + 0.3);
                
                float nDisk = fbm(vec2(p.x * 10.0 - uTime * 0.45, p.y * 100.0));
                frontDisk *= (nDisk * 0.8 + 0.2);

                // 6. Composition
                float density = (halo * isVoid) + frontDisk;
                float nebula = fbm(p * 3.0 + uTime * 0.03) * 0.1;
                nebula *= smoothstep(0.0, 0.6, pr); 
                density += nebula;

                // 7. Cinematic Interstellar Color Grading
                vec3 cDark = vec3(0.18, 0.05, 0.01);
                vec3 cMid = vec3(1.0, 0.45, 0.15);
                vec3 cLight = vec3(1.0, 0.95, 0.9);
                
                vec3 color = mix(vec3(0.0), cDark, smoothstep(0.0, 0.15, density));
                color = mix(color, cMid, smoothstep(0.15, 0.4, density));
                color = mix(color, cLight, smoothstep(0.4, 1.0, density));

                // 8. Doppler Beaming Physics
                float doppler = 1.0 - p.x * 0.6;
                color *= mix(1.0, doppler, smoothstep(0.0, 1.0, pr * 2.0));

                // 9. Lensed Background Stars
                vec2 starPos = p * 150.0;
                float starGrid = random(floor(starPos));
                float starShape = smoothstep(0.4, 0.0, length(fract(starPos) - 0.5));
                float lensedStars = smoothstep(0.98, 1.0, starGrid) * starShape;
                lensedStars *= smoothstep(horizon * 1.05, horizon * 1.5, pr); 
                lensedStars *= smoothstep(0.4, 0.0, density); 
                
                vec3 starColor = mix(vec3(0.5, 0.8, 1.0), vec3(1.0, 0.7, 0.4), random(floor(starPos) + 1.0));
                color += starColor * lensedStars * 3.0 * isVoid;

                // 10. Absolute Vantablack Singularity & Exposure
                color *= isVoid;
                color *= 1.45 * uExposure;

                float alphaMask = smoothstep(1.0, 0.4, pr);
                alphaMask = max(alphaMask, smoothstep(0.1, 0.5, density));

                gl_FragColor = vec4(color, alphaMask);
            }
        `;

        function createStarTexture() {
            const canvas = document.createElement("canvas");
            canvas.width = 32;
            canvas.height = 32;
            const ctx = canvas.getContext("2d");
            if (!ctx) return null;
            const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
            gradient.addColorStop(0, "rgba(255,255,255,1)");
            gradient.addColorStop(0.3, "rgba(255,255,255,0.8)");
            gradient.addColorStop(1, "rgba(255,255,255,0)");
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 32, 32);
            return new THREE.CanvasTexture(canvas);
        }

        // Initialize 3D WebGL Black Hole Scene
        const container = document.getElementById("blackHoleContainer");
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 7.5;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
        container.appendChild(renderer.domElement);

        const uniforms = {
            uTime: { value: 0.0 },
            uStabilize: { value: 0.3 },
            uAspect: { value: window.innerWidth / window.innerHeight },
            uExposure: { value: 0.4 }
        };

        const portalGeometry = new THREE.PlaneGeometry(12, 12);
        const portalMaterial = new THREE.ShaderMaterial({
            vertexShader: VERTEX_SHADER,
            fragmentShader: FRAGMENT_SHADER,
            uniforms: uniforms,
            transparent: true,
            depthWrite: false
        });
        const portal = new THREE.Mesh(portalGeometry, portalMaterial);
        scene.add(portal);

        // 3,000 Starfield Particles
        const starsCount = 2800;
        const starsGeometry = new THREE.BufferGeometry();
        const posArray = new Float32Array(starsCount * 3);
        const colArray = new Float32Array(starsCount * 3);

        for (let i = 0; i < starsCount * 3; i += 3) {
            posArray[i] = (Math.random() - 0.5) * 30;
            posArray[i + 1] = (Math.random() - 0.5) * 30;
            posArray[i + 2] = (Math.random() - 0.5) * 20;
            const isWarm = Math.random() > 0.6;
            colArray[i] = 1.0;
            colArray[i + 1] = isWarm ? 0.6 + Math.random() * 0.2 : 0.8 + Math.random() * 0.2;
            colArray[i + 2] = isWarm ? 0.3 + Math.random() * 0.2 : 0.9 + Math.random() * 0.1;
        }

        starsGeometry.setAttribute("position", new THREE.BufferAttribute(posArray, 3));
        starsGeometry.setAttribute("color", new THREE.BufferAttribute(colArray, 3));

        const starTexture = createStarTexture();
        const starsMaterial = new THREE.PointsMaterial({
            size: 0.055,
            vertexColors: true,
            transparent: true,
            opacity: 0.85,
            blending: THREE.AdditiveBlending,
            map: starTexture || undefined,
            depthWrite: false
        });
        const starMesh = new THREE.Points(starsGeometry, starsMaterial);
        scene.add(starMesh);

        // Interactive Parallax
        let targetX = 0, targetY = 0, mouseX = 0, mouseY = 0;
        let lastTime = performance.now();
        let introProgress = 0;
        let isWarping = false;

        window.addEventListener("mousemove", (e) => {
            if (isWarping) return;
            targetX = (e.clientX / window.innerWidth) * 2 - 1;
            targetY = -(e.clientY / window.innerHeight) * 2 + 1;
        }, { passive: true });

        window.addEventListener("resize", () => {
            const w = window.innerWidth, h = window.innerHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
            uniforms.uAspect.value = w / h;
        });

        // 60FPS Animation Loop
        function animate() {
            requestAnimationFrame(animate);
            const now = performance.now();
            const delta = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;

            if (isWarping) {
                uniforms.uTime.value += delta * 12.0;
                uniforms.uStabilize.value = Math.max(-1.0, uniforms.uStabilize.value - delta * 4.0);
                uniforms.uExposure.value += delta * 3.0;
                camera.position.z -= delta * 15.0;
                camera.lookAt(0, 0, -20);
            } else {
                uniforms.uTime.value += delta * 1.0;

                if (introProgress < 1.0) {
                    introProgress = Math.min(1.0, introProgress + delta * 0.8);
                    const ease = 1.0 - Math.pow(1.0 - introProgress, 3.0);
                    camera.position.z = THREE.MathUtils.lerp(7.5, 4.0, ease);
                    uniforms.uExposure.value = THREE.MathUtils.lerp(0.4, 1.05, ease);
                    uniforms.uStabilize.value = THREE.MathUtils.lerp(0.3, 1.0, ease);
                } else {
                    camera.position.z = 4.0;
                    uniforms.uExposure.value = 1.05;
                    uniforms.uStabilize.value = 1.0;
                }

                // Drift stars forward towards camera
                const pos = starMesh.geometry.attributes.position.array;
                for (let i = 2; i < pos.length; i += 3) {
                    pos[i] += 1.2 * delta;
                    if (pos[i] > camera.position.z) pos[i] = -20;
                }
                starMesh.geometry.attributes.position.needsUpdate = true;

                // Subtle smooth idle & mouse parallax
                const t = uniforms.uTime.value;
                const idleX = Math.sin(t * 0.15) * 0.06;
                const idleY = Math.cos(t * 0.1) * 0.06;
                mouseX += (targetX * 0.12 - mouseX) * 0.05;
                mouseY += (targetY * 0.12 - mouseY) * 0.05;
                camera.position.x = idleX + mouseX;
                camera.position.y = idleY + mouseY;
                camera.lookAt(0, 0, 0);
            }

            renderer.render(scene, camera);
        }

        animate();

        // ─── Form Client-side Logic & Direct Registration ────────
        const nameInput = document.getElementById('nameInput');
        const emailInput = document.getElementById('emailInput');
        const emailCheck = document.getElementById('emailCheck');
        const emailDomainNotice = document.getElementById('emailDomainNotice');
        const chipWrap = document.getElementById('chipWrap');
        const chipAddDomain = document.getElementById('chipAddDomain');

        const passInput = document.getElementById('passwordInput');
        const confirmInput = document.getElementById('confirmInput');
        const confirmCheck = document.getElementById('confirmCheck');
        const strengthBar = document.getElementById('strengthBar');
        const termsCheckbox = document.getElementById('termsCheckbox');
        const checkboxSvg = document.getElementById('checkboxSvg');
        const registerForm = document.getElementById('registerForm');
        const clientErrorBox = document.getElementById('clientErrorBox');
        const mainContainer = document.getElementById('mainContainer');

        let agreedToTerms = true;
        const MU_EMAIL_REGEX = /^[a-zA-Z0-9._%+-]+@@marwadiuniversity\.ac\.in$/i;

        // Focus Handlers
        [
            { input: nameInput, box: document.getElementById('nameBox') },
            { input: emailInput, box: document.getElementById('emailBox') },
            { input: passInput, box: document.getElementById('passBox') },
            { input: confirmInput, box: document.getElementById('confirmBox') }
        ].forEach(pair => {
            if (pair.input && pair.box) {
                pair.input.addEventListener('focus', () => pair.box.classList.add('focused'));
                pair.input.addEventListener('blur', () => pair.box.classList.remove('focused'));
            }
        });

        // Real-Time Email Validation & Domain Guard
        if (emailInput) {
            emailInput.addEventListener('input', () => {
                const val = emailInput.value.trim().toLowerCase();
                const isValid = MU_EMAIL_REGEX.test(val);
                if (emailCheck) emailCheck.style.display = isValid ? 'flex' : 'none';

                // Show rejection notice if external domain like @@gmail.com is typed
                const isExternalDomain = val.includes('@@') && !val.includes('@@marwadiuniversity.ac.in');
                if (emailDomainNotice) emailDomainNotice.style.display = isExternalDomain ? 'flex' : 'none';

                // Suggest 1-tap completion chip
                const showChip = val.length >= 2 && !isValid && (!val.includes('@@') || val.endsWith('@@') || val.endsWith('@@m'));
                if (chipWrap) chipWrap.style.display = showChip ? 'block' : 'none';
            });
        }

        if (chipAddDomain && emailInput) {
            chipAddDomain.addEventListener('click', () => {
                let base = emailInput.value.trim();
                if (base.includes('@@')) base = base.split('@@')[0];
                emailInput.value = base + '@@marwadiuniversity.ac.in';
                if (emailCheck) emailCheck.style.display = 'flex';
                if (emailDomainNotice) emailDomainNotice.style.display = 'none';
                if (chipWrap) chipWrap.style.display = 'none';
            });
        }

        // Password Strength & Match
        if (passInput) {
            passInput.addEventListener('input', () => {
                const val = passInput.value;
                if (!strengthBar) return;
                if (val.length === 0) {
                    strengthBar.style.width = '0%';
                    return;
                }
                const strength = Math.min(100, (val.length * 8) + (/[A-Z]/.test(val) ? 15 : 0) + (/[0-9]/.test(val) ? 15 : 0) + (/[^A-Za-z0-9]/.test(val) ? 20 : 0));
                strengthBar.style.width = strength + '%';
                strengthBar.style.background = strength < 40 ? '#ff4444' : strength < 75 ? '#ff8c42' : '#00d2ff';
                strengthBar.style.boxShadow = '0 0 10px ' + (strength < 40 ? '#ff4444' : strength < 75 ? '#ff8c42' : '#00d2ff');
                checkPasswordsMatch();
            });
        }

        if (confirmInput) {
            confirmInput.addEventListener('input', checkPasswordsMatch);
        }

        function checkPasswordsMatch() {
            if (confirmCheck && passInput && confirmInput) {
                confirmCheck.style.display = (passInput.value.length >= 6 && passInput.value === confirmInput.value) ? 'flex' : 'none';
            }
        }

        const togglePassBtn = document.getElementById('togglePassBtn');
        const eyePassOpen = document.getElementById('eyePassOpen');
        const eyePassClose = document.getElementById('eyePassClose');
        if (togglePassBtn && passInput) {
            togglePassBtn.addEventListener('click', () => {
                const isPass = passInput.type === 'password';
                passInput.type = isPass ? 'text' : 'password';
                if (eyePassOpen) eyePassOpen.style.display = isPass ? 'none' : 'block';
                if (eyePassClose) eyePassClose.style.display = isPass ? 'block' : 'none';
            });
        }

        const toggleConfirmBtn = document.getElementById('toggleConfirmBtn');
        const eyeConfirmOpen = document.getElementById('eyeConfirmOpen');
        const eyeConfirmClose = document.getElementById('eyeConfirmClose');
        if (toggleConfirmBtn && confirmInput) {
            toggleConfirmBtn.addEventListener('click', () => {
                const isPass = confirmInput.type === 'password';
                confirmInput.type = isPass ? 'text' : 'password';
                if (eyeConfirmOpen) eyeConfirmOpen.style.display = isPass ? 'none' : 'block';
                if (eyeConfirmClose) eyeConfirmClose.style.display = isPass ? 'block' : 'none';
            });
        }

        if (termsCheckbox) {
            termsCheckbox.addEventListener('click', toggleTerms);
            termsCheckbox.addEventListener('keydown', (e) => {
                if (e.key === ' ' || e.key === 'Enter') {
                    e.preventDefault();
                    toggleTerms();
                }
            });
        }

        function toggleTerms() {
            agreedToTerms = !agreedToTerms;
            if (termsCheckbox) termsCheckbox.classList.toggle('checked', agreedToTerms);
            if (checkboxSvg) checkboxSvg.style.display = agreedToTerms ? 'block' : 'none';
        }

        // ─── Registration Form Submit ───
        if (registerForm) {
            registerForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (clientErrorBox) {
                    clientErrorBox.style.display = 'none';
                    clientErrorBox.innerText = '';
                }

                const name = nameInput ? nameInput.value.trim() : '';
                const email = emailInput ? emailInput.value.trim().toLowerCase() : '';
                const pass = passInput ? passInput.value : '';
                const confirm = confirmInput ? confirmInput.value : '';

                if (!name || name.length < 2) {
                    showError("Please enter your full name.");
                    return;
                }

                if (!email || !email.endsWith("@@marwadiuniversity.ac.in")) {
                    showError("Access Denied: Only @@marwadiuniversity.ac.in emails are allowed.");
                    return;
                }

                if (!pass || pass.length < 6) {
                    showError("Password must be at least 6 characters.");
                    return;
                }

                if (pass !== confirm) {
                    showError("Passwords do not match.");
                    return;
                }

                if (!agreedToTerms) {
                    showError("You must agree to the Terms & Privacy Policy to continue.");
                    return;
                }

                const submitBtn = document.getElementById('submitBtn');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span>CREATING ACCOUNT…</span>';
                }

                try {
                    const formData = new FormData(registerForm);
                    const response = await fetch('/Account/Register', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.redirected) {
                        isWarping = true;
                        if (submitBtn) submitBtn.innerHTML = '<span>LAUNCHING UNIVERSE…</span>';
                        if (mainContainer) {
                            mainContainer.style.transform = 'scale(0) rotate(-10deg)';
                            mainContainer.style.opacity = '0';
                            mainContainer.style.filter = 'blur(10px)';
                        }
                        window.location.href = response.url;
                        return;
                    }

                    const contentType = response.headers.get("content-type") || "";
                    if (contentType.includes("application/json")) {
                        const data = await response.json();
                        if (data.success) {
                            isWarping = true;
                            if (submitBtn) submitBtn.innerHTML = '<span>LAUNCHING UNIVERSE…</span>';
                            if (mainContainer) {
                                mainContainer.style.transform = 'scale(0) rotate(-10deg)';
                                mainContainer.style.opacity = '0';
                                mainContainer.style.filter = 'blur(10px)';
                            }
                            window.location.href = data.redirectUrl || "/Dashboard";
                            return;
                        } else {
                            showError(data.message || "Registration failed. Please check your details.");
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<span>Create Account & Launch</span><i class="bi bi-rocket-takeoff-fill"></i>';
                            }
                            return;
                        }
                    }

                    if (response.ok) {
                        window.location.href = "/Dashboard";
                    } else {
                        showError("Unable to create account. Please try again.");
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<span>Create Account & Launch</span><i class="bi bi-rocket-takeoff-fill"></i>';
                        }
                    }
                } catch (err) {
                    showError("Network error. Please try again.");
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<span>Create Account & Launch</span><i class="bi bi-rocket-takeoff-fill"></i>';
                    }
                }
            });
        }

        function showError(msg) {
            if (clientErrorBox) {
                clientErrorBox.innerText = msg;
                clientErrorBox.style.display = 'block';
            }
        }

        // ─── Real Google Identity Services (GIS) Integration ───
        const googleSsoBtnReg = document.getElementById("googleSsoBtnReg");
        const googleOfficialBtnWrapReg = document.getElementById("googleOfficialBtnWrapReg");
        const serverGoogleClientIdReg = "@(ViewData["GoogleClientId"] ?? "")";
        let activeGoogleClientIdReg = serverGoogleClientIdReg || localStorage.getItem("universe_google_client_id") || "";

        function handleGoogleTokenResponseReg(response) {
            if (!response || !response.credential) {
                showError("Google sign-in did not return a valid credential token.");
                return;
            }

            try {
                const payloadBase64 = response.credential.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(payloadBase64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                const payload = JSON.parse(jsonPayload);
                const email = (payload.email || '').toLowerCase();

                if (!email.endsWith('@@marwadiuniversity.ac.in')) {
                    showError("Access Denied: The Google account '" + email + "' is not an official Marwadi University email. Only @@marwadiuniversity.ac.in accounts are permitted.");
                    return;
                }
            } catch (e) { }

            showError("Verifying Marwadi University Google Account...");
            clientErrorBox.style.color = "#34d399";
            clientErrorBox.style.background = "rgba(52, 211, 153, 0.15)";
            clientErrorBox.style.borderColor = "rgba(52, 211, 153, 0.4)";

            const formData = new FormData();
            formData.append("credential", response.credential);

            fetch("/Account/GoogleTokenLogin", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    clientErrorBox.innerText = "✓ Welcome " + (data.studentName || "") + "! Redirecting...";
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || "/Dashboard";
                    }, 500);
                } else {
                    clientErrorBox.style.color = "#fca5a5";
                    clientErrorBox.style.background = "rgba(239, 68, 68, 0.15)";
                    clientErrorBox.style.borderColor = "rgba(239, 68, 68, 0.4)";
                    showError(data.message || "Google authentication failed.");
                }
            })
            .catch(err => {
                clientErrorBox.style.color = "#fca5a5";
                clientErrorBox.style.background = "rgba(239, 68, 68, 0.15)";
                clientErrorBox.style.borderColor = "rgba(239, 68, 68, 0.4)";
                showError("Server error verifying Google token: " + err.message);
            });
        }

        function openGoogleSignInWindowReg(e) {
            const width = 500;
            const height = 640;
            const left = Math.round((window.screen.width - width) / 2);
            const top = Math.round((window.screen.height - height) / 2);
            const typedEmailReg = (document.getElementById("emailInput")?.value || "").trim();
            let targetUrl = "/Account/GoogleLogin?returnUrl=/Dashboard";
            if (typedEmailReg && typedEmailReg.includes("@@")) {
                targetUrl += "&email=" + encodeURIComponent(typedEmailReg);
            }

            try {
                const popup = window.open(
                    targetUrl,
                    "GoogleSignInPopup",
                    `width=${width},height=${height},top=${top},left=${left},status=no,toolbar=no,menubar=no,location=yes,resizable=yes`
                );

                if (popup && !popup.closed && typeof popup.closed !== "undefined") {
                    if (e && typeof e.preventDefault === "function") {
                        e.preventDefault();
                    }
                    popup.focus();
                    return;
                }
            } catch (err) { }

            if (e && typeof e.preventDefault === "function") {
                e.preventDefault();
            }
            window.location.href = targetUrl;
        }

        if (googleSsoBtnReg) {
            googleSsoBtnReg.addEventListener("click", (e) => {
                openGoogleSignInWindowReg(e);
            });
        }

        window.addEventListener("message", (event) => {
            if (event.data && event.data.type === "GOOGLE_AUTH_SUCCESS") {
                if (event.data.email) {
                    try {
                        let accounts = JSON.parse(localStorage.getItem("universe_google_accounts") || "[]");
                        const clean = event.data.email.toLowerCase();
                        accounts = accounts.filter(a => a.email.toLowerCase() !== clean);
                        accounts.unshift({
                            email: clean,
                            name: event.data.name || clean.split("@@")[0]
                        });
                        localStorage.setItem("universe_google_accounts", JSON.stringify(accounts.slice(0, 3)));
                    } catch (e) { }
                }
                showError("✓ Verified with Marwadi University Google Account! Welcome " + (event.data.name || "") + "...");
                clientErrorBox.style.color = "#34d399";
                clientErrorBox.style.background = "rgba(52, 211, 153, 0.15)";
                clientErrorBox.style.borderColor = "rgba(52, 211, 153, 0.4)";
                setTimeout(() => {
                    window.location.href = event.data.redirectUrl || "/Dashboard";
                }, 500);
            }
        });
    </script>
</body>
</html>
