@model UniVerse.Server.Models.ViewModels.SettingsPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Settings";
    ViewBag.ActivePage = "settings";

    var user = Model.CurrentUser;
    var rawName = string.IsNullOrEmpty(user.FullName) ? "Archi Kumar" : user.FullName;
    var initial = rawName.Length > 0 ? rawName.Substring(0, 1).ToUpper() : "A";
    var enrollment = string.IsNullOrEmpty(user.EnrollmentNumber) ? "92100103001" : user.EnrollmentNumber;
    var currentHostel = string.IsNullOrEmpty(user.HostelName) ? "Hostel D" : user.HostelName;
    var currentRoom = string.IsNullOrEmpty(user.RoomNumber) ? "304" : user.RoomNumber;
    var currentPhone = string.IsNullOrEmpty(user.PhoneNumber) ? "+91 98765 43210" : user.PhoneNumber;
    var department = string.IsNullOrEmpty(user.Department) ? "Computer Science & Engineering" : user.Department;
}

@section Styles {
<style>
    /* ─── Background & Cosmic Nebulae matching universe/src/app/dashboard/settings/page.tsx ─── */
    .uv-settings-container {
        position: relative;
        min-height: 100vh;
        max-width: 840px;
        margin: 0 auto;
        padding-bottom: 64px;
        z-index: 10;
    }

    .uv-settings-stars {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: 0.22;
        background-image: radial-gradient(1px 1px at 25px 35px, #00E676, rgba(0,0,0,0)), radial-gradient(1.5px 1.5px at 160px 190px, #ffffff, rgba(0,0,0,0));
        background-size: 320px 320px;
    }

    .uv-glow-emerald {
        position: fixed;
        top: 0;
        right: 20%;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.10) 0%, rgba(0,0,0,0) 70%);
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
    }

    .uv-glow-teal {
        position: fixed;
        bottom: 20%;
        left: 5%;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(20, 184, 166, 0.08) 0%, rgba(0,0,0,0) 70%);
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
    }

    /* ─── Header & Top Cards ─── */
    .uv-settings-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
    }

    .uv-btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #A7B8B0;
        text-decoration: none;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .uv-btn-back:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        transform: translateX(-2px);
    }

    /* ─── Student Identity Banner (Matching SettingsClient.tsx lines 449-521) ─── */
    .uv-identity-banner {
        padding: 24px;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(6, 44, 28, 0.45) 0%, #0c1410 40%, #0A0F0C 100%);
        border: 1px solid rgba(16, 185, 129, 0.22);
        backdrop-filter: blur(16px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
        flex-wrap: wrap;
    }

    .uv-identity-banner::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .uv-banner-avatar {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, #00E676 0%, #14b8a6 50%, #047857 100%);
        color: #050A07;
        font-size: 26px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.35);
        overflow: hidden;
        flex-shrink: 0;
    }

    .uv-banner-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .uv-badge-id {
        padding: 2px 10px;
        border-radius: 9999px;
        font-size: 11px;
        font-family: var(--font-mono);
        font-weight: 700;
        background: rgba(16, 185, 129, 0.12);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.28);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .uv-badge-active {
        padding: 2px 10px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .uv-badge-role {
        padding: 2px 10px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-transform: capitalize;
    }

    /* ─── Navigation Tabs (Matching SettingsClient.tsx lines 523-542) ─── */
    .uv-tabs-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 6px;
        margin-bottom: 24px;
        scrollbar-width: none;
    }

    .uv-tabs-wrap::-webkit-scrollbar {
        display: none;
    }

    .uv-tab-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        background: rgba(10, 15, 12, 0.6);
        color: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .uv-tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
    }

    .uv-tab-btn.active {
        background: rgba(16, 185, 129, 0.15);
        color: #00E676;
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 0 14px rgba(0, 230, 118, 0.2);
    }

    /* ─── Section Cards ─── */
    .uv-section-card {
        background: rgba(10, 15, 12, 0.75);
        border: 1px solid rgba(16, 185, 129, 0.16);
        border-radius: 22px;
        padding: 24px;
        backdrop-filter: blur(20px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .uv-section-card.danger {
        border-color: rgba(239, 68, 68, 0.25);
    }

    .uv-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 16px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .uv-card-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #00E676;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        box-shadow: 0 0 12px rgba(0, 230, 118, 0.18);
        flex-shrink: 0;
    }

    .uv-card-icon-box.danger {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.25);
        color: #f87171;
        box-shadow: 0 0 12px rgba(239, 68, 68, 0.18);
    }

    /* Form Fields */
    .uv-input-wrap {
        position: relative;
    }

    .uv-input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.4);
        font-size: 15px;
        pointer-events: none;
    }

    .uv-input-box {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 10px 14px 10px 38px;
        color: #ffffff;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s ease;
    }

    .uv-input-box:focus {
        border-color: var(--accent-green);
        background: rgba(255, 255, 255, 0.05);
    }

    .uv-label {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 6px;
        display: block;
    }

    /* Toggle Item */
    .uv-toggle-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        gap: 16px;
    }

    .uv-toggle-row:last-child {
        border-bottom: none;
    }

    .uv-switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
        flex-shrink: 0;
    }

    .uv-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .uv-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.15);
        transition: .25s ease;
        border-radius: 34px;
    }

    .uv-slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .25s ease;
        border-radius: 50%;
    }

    input:checked + .uv-slider {
        background-color: #00E676;
        border-color: #00E676;
        box-shadow: 0 0 12px rgba(0, 230, 118, 0.35);
    }

    input:checked + .uv-slider:before {
        transform: translateX(22px);
        background-color: #050A07;
    }

    /* Buttons */
    .btn-save-green {
        background: #00E676;
        color: #050A07;
        font-weight: 800;
        font-size: 13px;
        padding: 10px 22px;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.25);
        transition: all 0.2s ease;
    }

    .btn-save-green:hover {
        transform: scale(1.02);
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.4);
    }

    /* Password strength bar */
    .uv-pwd-bar {
        height: 4px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.1);
        flex: 1;
        transition: all 0.3s ease;
    }
</style>
}

<!-- Stardust Particles & Ambient Glows -->
<div class="uv-settings-stars"></div>
<div class="uv-glow-emerald"></div>
<div class="uv-glow-teal"></div>

<div class="uv-settings-container">
    <!-- 1. Header with Back Button (Matching page.tsx lines 60-75) -->
    <div class="uv-settings-header">
        <a href="/Dashboard" class="uv-btn-back" title="Back to Dashboard">
            <i class="bi bi-arrow-left" style="font-size: 16px; color: #34d399;"></i>
        </a>
        <div>
            <h1 style="font-family: var(--font-heading); font-size: 26px; font-weight: 800; color: #ffffff; margin: 0; letter-spacing: -0.01em;">
                Settings
            </h1>
            <p style="color: rgba(255, 255, 255, 0.6); font-size: 13px; margin: 2px 0 0 0;">
                Manage your campus identity, security credentials, and preferences.
            </p>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (!string.IsNullOrEmpty(Model.DeliverySuccess))
    {
        <div style="background: rgba(0, 230, 118, 0.12); border: 1px solid rgba(0, 230, 118, 0.35); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.DeliverySuccess</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.PasswordSuccess))
    {
        <div style="background: rgba(0, 230, 118, 0.12); border: 1px solid rgba(0, 230, 118, 0.35); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.PasswordSuccess</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.PasswordError))
    {
        <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 14px; padding: 12px 18px; color: #f87171; font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.PasswordError</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.AlertsSuccess))
    {
        <div style="background: rgba(0, 230, 118, 0.12); border: 1px solid rgba(0, 230, 118, 0.35); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.AlertsSuccess</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SecuritySuccess))
    {
        <div style="background: rgba(0, 230, 118, 0.12); border: 1px solid rgba(0, 230, 118, 0.35); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SecuritySuccess</span>
        </div>
    }

    <!-- 2. Student Identity & Profile Banner (Matching SettingsClient.tsx lines 448-521) -->
    <div class="uv-identity-banner">
        <div style="display: flex; align-items: center; gap: 16px; position: relative; z-index: 10;">
            <div class="uv-banner-avatar">
                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                {
                    <img src="@user.AvatarUrl" alt="Avatar" />
                }
                else
                {
                    <span>@initial</span>
                }
            </div>
            <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                    <h3 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0; letter-spacing: -0.01em;">
                        @rawName
                    </h3>
                    <span class="uv-badge-id">
                        <span>ID:</span>
                        <span style="color: #fff;">@enrollment</span>
                    </span>
                    <span class="uv-badge-active">
                        <i class="bi bi-check-circle-fill" style="color: #00E676; font-size: 11px;"></i>
                        <span>Active Student</span>
                    </span>
                    <span class="uv-badge-role">
                        @(user.Role ?? "Student")
                    </span>
                </div>

                <p style="font-size: 12px; color: rgba(255, 255, 255, 0.6); margin: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span style="color: #34d399; font-weight: 600;">🎓 Marwadi University</span>
                    <span>•</span>
                    <span style="font-family: var(--font-mono); color: rgba(255,255,255,0.8);">@enrollment</span>
                    <span>•</span>
                    <span style="color: rgba(255,255,255,0.7);">@department</span>
                    <span>•</span>
                    <span style="color: #34d399; font-weight: 600;">
                        <i class="bi bi-building"></i> @currentHostel (@currentRoom)
                    </span>
                </p>
            </div>
        </div>

        <a href="/Dashboard/Profile" style="display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #ffffff; text-decoration: none; font-size: 12.5px; font-weight: 700; transition: all 0.2s; position: relative; z-index: 10;">
            <i class="bi bi-person text-emerald-400"></i>
            <span>Edit Profile</span>
            <i class="bi bi-box-arrow-up-right" style="font-size: 11px; color: rgba(255,255,255,0.4);"></i>
        </a>
    </div>

    <!-- 3. Category Navigation Tabs (Matching SettingsClient.tsx lines 523-542) -->
    <div class="uv-tabs-wrap">
        <button type="button" class="uv-tab-btn active" onclick="switchSettingsTab('all')">
            <i class="bi bi-stars"></i>
            <span>All Settings</span>
        </button>
        <button type="button" class="uv-tab-btn" onclick="switchSettingsTab('security')">
            <i class="bi bi-shield-check"></i>
            <span>Security & Login</span>
        </button>
        <button type="button" class="uv-tab-btn" onclick="switchSettingsTab('delivery')">
            <i class="bi bi-building"></i>
            <span>Hostel & Delivery</span>
        </button>
        <button type="button" class="uv-tab-btn" onclick="switchSettingsTab('notifications')">
            <i class="bi bi-bell"></i>
            <span>Alerts & Audio</span>
        </button>
        <button type="button" class="uv-tab-btn" onclick="switchSettingsTab('danger')">
            <i class="bi bi-activity" style="color: #f87171;"></i>
            <span>Danger Zone</span>
        </button>
    </div>

    <!-- 4. HOSTEL & DELIVERY DEFAULTS (Matching SettingsClient.tsx lines 544-651) -->
    <div id="section-delivery" class="uv-section-card">
        <div class="uv-card-header">
            <div class="uv-card-icon-box">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <h2 style="font-size: 17px; font-weight: 800; color: #ffffff; margin: 0;">
                    Hostel & Delivery Defaults
                </h2>
                <p style="font-size: 12px; color: rgba(255, 255, 255, 0.5); margin: 2px 0 0 0;">
                    Set your room & phone number so delivery requests prefill automatically
                </p>
            </div>
        </div>

        <form method="post" action="/Dashboard/SaveDeliveryDefaults" style="display: flex; flex-direction: column; gap: 16px;">
            <!-- Info Callout Box -->
            <div style="padding: 14px 16px; border-radius: 12px; background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.15); display: flex; align-items: flex-start; gap: 12px;">
                <i class="bi bi-info-circle" style="color: #34d399; font-size: 18px; margin-top: 1px; flex-shrink: 0;"></i>
                <p style="font-size: 12.5px; color: rgba(255, 255, 255, 0.7); margin: 0; line-height: 1.5;">
                    Whenever you create a delivery request for snacks or drinks, your saved hostel, room, and runner phone number will be pre-filled automatically for 1-tap checkout.
                </p>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <!-- Hostel Selector -->
                <div>
                    <label class="uv-label">
                        <i class="bi bi-building text-emerald-400"></i> Default Hostel Building
                    </label>
                    <div class="uv-input-wrap">
                        <i class="bi bi-building uv-input-icon"></i>
                        <select name="hostelName" class="uv-input-box" style="background: #060d09; cursor: pointer;">
                            <option value="Hostel A" selected="@(currentHostel == "Hostel A")">Hostel A</option>
                            <option value="Hostel B" selected="@(currentHostel == "Hostel B")">Hostel B</option>
                            <option value="Hostel C" selected="@(currentHostel == "Hostel C")">Hostel C</option>
                            <option value="Hostel D" selected="@(currentHostel == "Hostel D")">Hostel D</option>
                            <option value="Girls Hostel" selected="@(currentHostel == "Girls Hostel")">Girls Hostel</option>
                            <option value="Faculty Block" selected="@(currentHostel == "Faculty Block")">Faculty Block</option>
                            <option value="Other" selected="@(currentHostel == "Other")">Other</option>
                        </select>
                    </div>
                </div>

                <!-- Room Number -->
                <div>
                    <label class="uv-label">
                        <i class="bi bi-geo-alt text-emerald-400"></i> Room Number / Floor
                    </label>
                    <div class="uv-input-wrap">
                        <i class="bi bi-door-closed uv-input-icon"></i>
                        <input type="text" name="roomNumber" value="@currentRoom" class="uv-input-box" placeholder="e.g. B-304, Room 412" required />
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <!-- Runner Contact Number -->
                <div>
                    <label class="uv-label">
                        <i class="bi bi-telephone text-emerald-400"></i> Runner Contact Number (WhatsApp / Call)
                    </label>
                    <div class="uv-input-wrap">
                        <i class="bi bi-telephone uv-input-icon"></i>
                        <input type="tel" name="phoneNumber" value="@currentPhone" class="uv-input-box" placeholder="e.g. +91 98765 43210" required />
                    </div>
                </div>

                <!-- Quick Drop-off Note -->
                <div>
                    <label class="uv-label">
                        <i class="bi bi-phone text-emerald-400"></i> Quick Drop-off Note (Optional)
                    </label>
                    <div class="uv-input-wrap">
                        <i class="bi bi-chat-left-dots uv-input-icon"></i>
                        <input type="text" name="deliveryInstructions" value="@Model.DefaultInstructions" class="uv-input-box" placeholder="e.g. Knock twice or leave at door handle" />
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; pt-2;">
                <button type="submit" class="btn-save-green">
                    <i class="bi bi-floppy"></i>
                    <span>Save Delivery Defaults</span>
                </button>
            </div>
        </form>
    </div>

    <!-- 5. ACCOUNT & SECURITY (Matching SettingsClient.tsx lines 653-865) -->
    <div id="section-security" class="uv-section-card">
        <div class="uv-card-header">
            <div class="uv-card-icon-box">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <h2 style="font-size: 17px; font-weight: 800; color: #ffffff; margin: 0;">
                    Account & Security
                </h2>
                <p style="font-size: 12px; color: rgba(255, 255, 255, 0.5); margin: 2px 0 0 0;">
                    Manage credentials, active device sessions, and login security
                </p>
            </div>
        </div>

        <!-- Read-Only Credentials Grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px;">
