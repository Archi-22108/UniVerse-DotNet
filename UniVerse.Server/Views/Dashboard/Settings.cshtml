@section Scripts {
<script>
    // Tab Filter Switcher
    function switchSettingsTab(tabId) {
        document.querySelectorAll('.uv-tab-btn').forEach(btn => btn.classList.remove('active'));
        if (event && event.currentTarget) {
            event.currentTarget.classList.add('active');
        }

        const deliverySec = document.getElementById('section-delivery');
        const securitySec = document.getElementById('section-security');
        const notifSec = document.getElementById('section-notifications');
        const dangerSec = document.getElementById('section-danger');

        if (tabId === 'all') {
            deliverySec.style.display = 'block';
            securitySec.style.display = 'block';
            notifSec.style.display = 'block';
            dangerSec.style.display = 'block';
        } else if (tabId === 'delivery') {
            deliverySec.style.display = 'block';
            securitySec.style.display = 'none';
            notifSec.style.display = 'none';
            dangerSec.style.display = 'none';
        } else if (tabId === 'security') {
            deliverySec.style.display = 'none';
            securitySec.style.display = 'block';
            notifSec.style.display = 'none';
            dangerSec.style.display = 'none';
        } else if (tabId === 'notifications') {
            deliverySec.style.display = 'none';
            securitySec.style.display = 'none';
            notifSec.style.display = 'block';
            dangerSec.style.display = 'none';
        } else if (tabId === 'danger') {
            deliverySec.style.display = 'none';
            securitySec.style.display = 'none';
            notifSec.style.display = 'none';
            dangerSec.style.display = 'block';
        }
    }

    // Toggle Password Visibility
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // Password Strength Meter
    function checkPasswordStrength(pwd) {
        let score = 0;
        if (pwd.length >= 6) score += 1;
        if (pwd.length >= 8) score += 1;
        if (/[A-Z]/.test(pwd) || /[0-9]/.test(pwd)) score += 1;
        if (/[^A-Za-z0-9]/.test(pwd)) score += 1;

        const colors = ['', '#ef4444', '#f59e0b', '#34d399', '#00E676'];
        const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];

        for (let i = 1; i <= 4; i++) {
            const bar = document.getElementById('bar' + i);
            if (i <= score) {
                bar.style.backgroundColor = colors[score];
            } else {
                bar.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
            }
        }

        const text = document.getElementById('strengthText');
        text.innerText = pwd ? 'Password Strength: ' + labels[score] : '';
        text.style.color = colors[score] || 'rgba(255,255,255,0.4)';
    }

    // Password Match Indicator
    function checkPasswordMatch() {
        const p1 = document.getElementById('newPwd').value;
        const p2 = document.getElementById('confirmPwd').value;
        const matchText = document.getElementById('matchText');
        if (!p2) {
            matchText.innerText = '';
            return;
        }
        if (p1 === p2) {
            matchText.innerText = '✓ Passwords match';
            matchText.style.color = '#00E676';
        } else {
            matchText.innerText = 'Passwords do not match';
            matchText.style.color = '#f59e0b';
        }
    }

    // Toggle Sound Test Row
    function toggleSoundRow(checked) {
        const row = document.getElementById('soundTestRow');
        if (row) row.style.display = checked ? 'flex' : 'none';
    }

    // Web Audio Synthesizer (Real synthesised chimes matching Next.js sounds)
    function playWebAudioChime(type) {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (type === 'chat') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15); // A5
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                osc.start();
                osc.stop(ctx.currentTime + 0.35);
            } else {
                // Order Milestone double chime
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
                osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.12); // E5
                osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.24); // G5
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            }
            if (window.showToast) {
                showToast(type === 'chat' ? '💬 Chat chime played' : '✨ Order milestone chime played');
            }
        } catch (e) {
            console.warn('Web Audio not supported:', e);
        }
    }

    // Delete Modal
    function openDeleteModal() {
        document.getElementById('deleteAccountModal').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('deleteAccountModal').style.display = 'none';
        document.getElementById('delConfirmInput').value = '';
        checkDeleteText('');
    }

    function checkDeleteText(val) {
        const btn = document.getElementById('btnFinalDelete');
        if (val === 'DELETE') {
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
        } else {
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.style.cursor = 'not-allowed';
        }
    }
</script>
}
