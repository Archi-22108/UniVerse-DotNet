@model UniVerse.Server.Models.ViewModels.SettingsPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Settings";
    ViewBag.ActivePage = "settings";

    var user = Model.CurrentUser;
}

@section Styles {
<style>
    .uv-settings-card {
        background: rgba(10, 16, 13, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 24px;
        backdrop-filter: blur(16px);
        position: relative;
        overflow: hidden;
    }

    .uv-card-title-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .uv-card-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: var(--accent-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .uv-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .uv-toggle-row:last-child {
        border-bottom: none;
    }

    /* Switch toggle */
    .switch {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 26px;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.15);
        transition: .3s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--accent-green);
    }

    input:checked + .slider:before {
        transform: translateX(22px);
        background-color: #050A07;
    }
</style>
}

<div style="max-w: 800px; margin: 0 auto;">
    <!-- Top Header -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <a href="/Dashboard" class="uv-bell-btn" title="Back to Dashboard" style="text-decoration: none;">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 style="font-family: var(--font-heading); font-size: clamp(1.8rem, 3vw, 2.3rem); font-weight: 800; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px;">
                <span>Settings</span>
                <span style="color: var(--accent-green); font-size: 22px;">✦</span>
            </h1>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 2px 0 0 0;">
                Manage your campus identity, security credentials, and preferences.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background: rgba(0, 230, 118, 0.15); border: 1px solid rgba(0, 230, 118, 0.4); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <form method="post" action="/Dashboard/SaveSettings">
        <!-- 1. Campus Identity -->
        <div class="uv-settings-card">
            <div class="uv-card-title-row">
                <div class="uv-card-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <h3 style="font-size: 16px; font-weight: 800; color: #fff; margin: 0;">Campus Identity</h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">Hostel building and room drop-off locations.</p>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label class="uv-label" style="font-size: 11px; font-family: var(--font-mono); font-weight: 700; color: rgba(255,255,255,0.6); display: block; margin-bottom: 6px;">HOSTEL BUILDING</label>
                    <select name="hostelName" style="width: 100%; background: #09120d; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 11px 14px; color: #fff; font-size: 13px; outline: none;">
                        <option value="Hostel A">Hostel A</option>
                        <option value="Hostel B">Hostel B</option>
                        <option value="Hostel C">Hostel C</option>
                        <option value="Hostel D" selected>Hostel D</option>
                        <option value="Girls Hostel">Girls Hostel</option>
                        <option value="Faculty Block">Faculty Block</option>
                    </select>
                </div>

                <div>
                    <label class="uv-label" style="font-size: 11px; font-family: var(--font-mono); font-weight: 700; color: rgba(255,255,255,0.6); display: block; margin-bottom: 6px;">ROOM NUMBER</label>
                    <input type="text" name="roomNumber" value="@user.RoomNumber" style="width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 11px 14px; color: #fff; font-size: 13px; outline: none;" required />
                </div>
            </div>

            <div>
                <label class="uv-label" style="font-size: 11px; font-family: var(--font-mono); font-weight: 700; color: rgba(255,255,255,0.6); display: block; margin-bottom: 6px;">CONTACT PHONE</label>
                <input type="tel" name="phoneNumber" value="@user.PhoneNumber" style="width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 11px 14px; color: #fff; font-size: 13px; outline: none;" placeholder="+91 98765 43210" />
            </div>
        </div>

        <!-- 2. Preferences & Alerts -->
        <div class="uv-settings-card">
            <div class="uv-card-title-row">
                <div class="uv-card-icon">
                    <i class="bi bi-bell"></i>
                </div>
                <div>
                    <h3 style="font-size: 16px; font-weight: 800; color: #fff; margin: 0;">Notifications & Alerts</h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">Manage your order alerts and notifications.</p>
                </div>
            </div>

            <div class="uv-toggle-row">
                <div>
                    <div style="font-weight: 700; color: #fff; font-size: 13.5px;">Push Notifications</div>
                    <div style="font-size: 12px; color: var(--text-muted);">Receive real-time alerts when a runner accepts your order</div>
                </div>
                <label class="switch">
                    <input type="checkbox" name="pushNotifications" value="true" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="uv-toggle-row">
                <div>
                    <div style="font-weight: 700; color: #fff; font-size: 13.5px;">Delivery Sound Effects</div>
                    <div style="font-size: 12px; color: var(--text-muted);">Play audio chime when runner arrives at hostel gate</div>
                </div>
                <label class="switch">
                    <input type="checkbox" name="soundEffects" value="true" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="uv-toggle-row">
                <div>
                    <div style="font-weight: 700; color: #fff; font-size: 13.5px;">Order Status SMS Alerts</div>
                    <div style="font-size: 12px; color: var(--text-muted);">Send backup OTP via campus SMS gateway</div>
                </div>
                <label class="switch">
                    <input type="checkbox" name="orderAlerts" value="true" checked />
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- Save Button -->
        <div style="margin-bottom: 24px;">
            <button type="submit" class="btn-gradient-full" style="padding: 14px; font-size: 14px; margin-top: 0;">
                <i class="bi bi-check2-circle me-1"></i> Save Preferences
            </button>
        </div>
    </form>

    <!-- 3. Security & Danger Zone -->
    <div class="uv-settings-card" style="border-color: rgba(239, 68, 68, 0.25);">
        <div class="uv-card-title-row">
            <div class="uv-card-icon" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.25); color: #ef4444;">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 800; color: #fff; margin: 0;">Security & Sessions</h3>
                <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">Manage campus account credentials and active sessions.</p>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
                <div style="font-weight: 700; color: #fff; font-size: 13.5px;">Active Campus Sessions</div>
                <div style="font-size: 12px; color: var(--text-muted);">Signed in on Chrome (Windows) &bull; Marwadi Wi-Fi</div>
            </div>
            <a href="/Account/Logout" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; font-size: 12.5px; font-weight: 700; padding: 8px 16px; border-radius: 12px; text-decoration: none;">
                Sign Out All Devices
            </a>
        </div>
    </div>
</div>
