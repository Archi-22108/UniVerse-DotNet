@model UniVerse.Server.Models.ViewModels.AnalyticsPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Analytics & Reports";
    ViewBag.ActivePage = "analytics";

    var role = Model.CurrentUser?.Role?.ToLower() == "runner" ? "runner" : "student";
    var totalRequests = Model.TotalOrders;
    var completedCount = Model.CompletedCount;
    var pendingCount = Model.PendingCount;
    var cancelledCount = Model.CancelledCount;

    double activePct = totalRequests > 0 ? (pendingCount * 100.0 / totalRequests) : 0.0;
    double completedPct = totalRequests > 0 ? (completedCount * 100.0 / totalRequests) : 0.0;
    double cancelledPct = totalRequests > 0 ? (cancelledCount * 100.0 / totalRequests) : 0.0;

    // Calculate SVG Area Chart Path
    var vols = Model.DailyVolumes;
    int volCount = Math.Max(1, vols.Count);
    double chartWidth = 900.0;
    double chartHeight = 220.0;
    double paddingX = 40.0;
    double paddingY = 25.0;

    double maxAmt = vols.Any() ? vols.Max(v => v.Amount) : 300.0;
    if (maxAmt <= 0) maxAmt = 300.0;

    var points = new List<(double x, double y)>();
    for (int i = 0; i < volCount; i++)
    {
        double x = paddingX + (i * (chartWidth - 2 * paddingX) / Math.Max(1, volCount - 1));
        double amt = (i < vols.Count) ? vols[i].Amount : 50.0;
        double y = chartHeight - paddingY - ((amt / maxAmt) * (chartHeight - 2 * paddingY));
        points.Add((x, y));
    }

    // Generate smooth SVG curve
    var pathD = "";
    var areaD = "";
    if (points.Count > 0)
    {
        pathD = $"M {points[0].x:F1} {points[0].y:F1}";
        for (int i = 0; i < points.Count - 1; i++)
        {
            var p0 = points[i];
            var p1 = points[i + 1];
            double cx1 = p0.x + (p1.x - p0.x) / 2.0;
            double cy1 = p0.y;
            double cx2 = p0.x + (p1.x - p0.x) / 2.0;
            double cy2 = p1.y;
            pathD += $" C {cx1:F1} {cy1:F1}, {cx2:F1} {cy2:F1}, {p1.x:F1} {p1.y:F1}";
        }
        areaD = $"{pathD} L {points.Last().x:F1} {chartHeight - paddingY:F1} L {points[0].x:F1} {chartHeight - paddingY:F1} Z";
    }
}

@section Styles {
<style>
    /* Ambient Glow & Canvas */
    .analytics-canvas {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        background: #060a08;
        padding: 4px 0 40px 0;
    }

    .analytics-canvas::before {
        content: '';
        position: absolute;
        top: -160px;
        left: -160px;
        width: 384px;
        height: 384px;
        background: rgba(16, 185, 129, 0.08);
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
    }

    .analytics-canvas::after {
        content: '';
        position: absolute;
        top: 30%;
        right: -160px;
        width: 384px;
        height: 384px;
        background: rgba(20, 184, 166, 0.05);
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
    }

    /* Header */
    .analytics-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .analytics-title {
        font-family: var(--font-heading, 'Outfit', sans-serif);
        font-size: 28px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        letter-spacing: -0.5px;
    }

    .live-pill {
        font-size: 11px;
        padding: 2px 10px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: #34d399;
        font-weight: 700;
        font-family: var(--font-mono, monospace);
        letter-spacing: 0.5px;
    }

    .analytics-subtitle {
        color: rgba(255, 255, 255, 0.5);
        font-size: 13.5px;
        margin: 4px 0 0 0;
        font-weight: 500;
    }

    /* Filters Bar */
    .filter-pill-container {
        display: flex;
        align-items: center;
        background: #0c1410;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 9999px;
        padding: 3px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .range-tab-btn {
        padding: 6px 16px;
        font-size: 12px;
        font-weight: 700;
        border-radius: 9999px;
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        background: transparent;
        cursor: pointer;
    }

    .range-tab-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.05);
    }

    .range-tab-btn.active {
        background: #10b981;
        color: #000000;
        font-weight: 800;
        box-shadow: 0 0 14px rgba(16, 185, 129, 0.45);
    }

    .export-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #ffffff;
        padding: 7px 16px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .export-btn:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(16, 185, 129, 0.4);
        color: #34d399;
    }

    /* Stat Cards Grid (3 Cards) */
    .stat-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    @@media (max-width: 900px) {
        .stat-cards-grid { grid-template-columns: 1fr; }
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        background: rgba(12, 20, 16, 0.85);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .stat-card:hover {
        border-color: rgba(16, 185, 129, 0.35);
        box-shadow: 0 0 24px rgba(16, 185, 129, 0.12);
    }

    .stat-card-glow {
        position: absolute;
        top: -40px;
        right: -40px;
        width: 110px;
        height: 110px;
        background: rgba(16, 185, 129, 0.06);
        border-radius: 50%;
        filter: blur(28px);
        pointer-events: none;
    }

    .stat-card-title {
        font-size: 13.5px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 8px;
    }

    .stat-card-value {
        font-size: 32px;
        font-weight: 800;
        color: #ffffff;
        font-family: var(--font-heading, 'Outfit', sans-serif);
        letter-spacing: -0.5px;
    }

    .stat-card-desc {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.4);
        margin-top: 6px;
    }

    .stat-card-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #34d399;
        font-size: 20px;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.15);
    }

    .stat-card-footer {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        font-size: 12px;
    }

    .trend-up {
        display: inline-flex;
        align-items: center;
        color: #10b981;
        font-weight: 700;
        margin-right: 6px;
    }

    .trend-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        display: inline-block;
        margin-right: 8px;
        box-shadow: 0 0 10px #10b981;
        animation: pulseDot 2s infinite;
    }

    @@keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
    }

    /* Chart Containers */
    .chart-container-card {
        background: rgba(12, 20, 16, 0.85);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 24px;
        transition: border-color 0.3s ease;
    }

    .chart-container-card:hover {
        border-color: rgba(16, 185, 129, 0.3);
    }

    .chart-header {
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chart-title {
        font-size: 17px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-desc {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.5);
        margin: 3px 0 0 0;
    }

    /* 2-Column Row */
    .charts-split-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @@media (max-width: 992px) {
        .charts-split-grid { grid-template-columns: 1fr; }
    }

    /* Bar Chart Grouping */
    .bars-chart-canvas {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 220px;
        padding: 20px 24px 10px 24px;
        gap: 12px;
    }

    .bar-group-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 8px;
    }

    .bar-triple {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        width: 100%;
        max-width: 44px;
        height: 170px;
    }

    .bar-item {
        flex: 1;
        border-radius: 4px 4px 1px 1px;
        transition: all 0.3s ease;
        position: relative;
    }

    .bar-created { background: #38bdf8; }
    .bar-completed { background: #10b981; }
    .bar-cancelled { background: #ef4444; }

    .bar-item:hover {
        filter: brightness(1.2);
    }

    /* Donut Chart */
    .donut-layout {
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 24px;
        height: 260px;
    }

    .donut-circle-wrap {
        position: relative;
        width: 180px;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .donut-center-text {
        position: absolute;
        text-align: center;
        pointer-events: none;
    }

    .donut-center-num {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
    }

    .donut-center-lbl {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 4px;
    }

    .donut-legend {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .legend-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        font-size: 12.5px;
    }

    /* Analytics Summary Bar (2-Column Grid Matching Reference UI) */
    .summary-metrics-bar {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
        margin-bottom: 24px;
    }

    @@media (max-width: 640px) {
        .summary-metrics-bar { grid-template-columns: 1fr; }
    }

    .metric-cell {
        background: rgba(12, 20, 16, 0.95);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: background 0.2s ease;
    }

    .metric-cell:hover {
        background: rgba(16, 27, 21, 0.95);
    }

    .metric-icon-bubble {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .metric-title {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    .metric-value {
        font-size: 17px;
        font-weight: 800;
        color: #ffffff;
        font-family: var(--font-heading, 'Outfit', sans-serif);
        margin-top: 2px;
    }

    /* Recent Activity Feed */
    .activity-feed-list {
        padding: 16px 24px 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .activity-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .activity-item-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .activity-icon-node {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-right: 14px;
        flex-shrink: 0;
    }
</style>
}

<div class="analytics-canvas">
    <div style="max-width: 1160px; margin: 0 auto; position: relative; z-index: 10;">
        
        <!-- ─── 1. Page Header & Filter Controls ─────────────────────────── -->
        <div class="analytics-header">
            <div>
                <h1 class="analytics-title">
                    <span>Analytics & Reports</span>
                    <span class="live-pill">Live</span>
                </h1>
                <p class="analytics-subtitle">
                    Track your @(role == "student" ? "spending, requests," : "earnings, deliveries,") and activity.
                </p>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <!-- Time Range Pill (Matching Next.js Pill exactly) -->
                <div class="filter-pill-container">
                    <a href="/Dashboard/Analytics?range=7" class="range-tab-btn @(Model.TimeRangeDays == 7 ? "active" : "")">7 Days</a>
                    <a href="/Dashboard/Analytics?range=30" class="range-tab-btn @(Model.TimeRangeDays == 30 ? "active" : "")">30 Days</a>
                    <a href="/Dashboard/Analytics?range=90" class="range-tab-btn @(Model.TimeRangeDays == 90 ? "active" : "")">90 Days</a>
                </div>

                <!-- Export CSV Button (Matching Next.js ExportReportButton) -->
                <button type="button" class="export-btn" onclick="exportAnalyticsReport()">
                    <i class="bi bi-download"></i>
                    <span>Export CSV</span>
                </button>
            </div>
        </div>

        <!-- ─── 2. Top 3 Stat Cards (Matching StatCard.tsx exactly) ─────── -->
        <div class="stat-cards-grid">
            
            <!-- Card 1: Total Spent / Earnings -->
            <div class="stat-card">
                <div class="stat-card-glow"></div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="stat-card-title">@(role == "student" ? $"Total Spent ({Model.TimeRangeDays}d)" : $"Total Earnings ({Model.TimeRangeDays}d)")</div>
                        <div class="stat-card-value">₹@Model.TotalSpent.ToString("F2")</div>
                        <div class="stat-card-desc">@(role == "student" ? "Total funds used for deliveries" : "Total funds earned from deliveries")</div>
                    </div>
                    <div class="stat-card-icon-box">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                </div>
                <div class="stat-card-footer">
                    <span class="trend-up">
                        <i class="bi bi-arrow-up-right"></i> +@Model.SpentTrend%
                    </span>
                    <span style="color: rgba(255, 255, 255, 0.4);">from previous @Model.TimeRangeDays days</span>
                </div>
            </div>

            <!-- Card 2: Requests Made / Deliveries Completed -->
            <div class="stat-card">
                <div class="stat-card-glow"></div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="stat-card-title">@(role == "student" ? $"Requests Made ({Model.TimeRangeDays}d)" : $"Deliveries Completed ({Model.TimeRangeDays}d)")</div>
                        <div class="stat-card-value">@Model.TotalOrders Orders</div>
                        <div class="stat-card-desc">@(role == "student" ? "Total delivery requests placed" : "Successful deliveries")</div>
                    </div>
                    <div class="stat-card-icon-box">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <div class="stat-card-footer">
                    <span class="trend-up">
                        <i class="bi bi-arrow-up-right"></i> +@Model.OrdersTrend%
                    </span>
                    <span style="color: rgba(255, 255, 255, 0.4);">from previous @Model.TimeRangeDays days</span>
                </div>
            </div>

            <!-- Card 3: Wallet Status (Status Card) -->
            <div class="stat-card">
                <div class="stat-card-glow"></div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <div class="stat-card-title">Wallet Status</div>
                        <div class="stat-card-value" style="color: #34d399;">Active</div>
                        <div class="stat-card-desc">Your wallet is secure and ready</div>
                    </div>
                    <div class="stat-card-icon-box" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4);">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
                <div class="stat-card-footer" style="color: #34d399; font-weight: 600;">
                    <span class="trend-pulse"></span>
                    <span>Wallet is in good standing</span>
                </div>
            </div>

        </div>

        <!-- ─── 3. VolumeChart / Spending Trend Area Chart (VolumeChart.tsx) ── -->
        <div class="chart-container-card">
            <div class="chart-header">
                <div>
                    <h2 class="chart-title">
                        <i class="bi bi-graph-up" style="color: #34d399;"></i>
                        <span>@(role == "student" ? "Spending Trend" : "Earnings Trend")</span>
                    </h2>
                    <p class="chart-desc">Daily volume over the last @Model.TimeRangeDays days</p>
                </div>
                <div style="display: flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 4px 10px; font-size: 12px; color: rgba(255, 255, 255, 0.7);">
                    <span>Daily</span>
                    <i class="bi bi-chevron-down" style="font-size: 10px; opacity: 0.6;"></i>
                </div>
            </div>

            <div style="padding: 24px; position: relative;">
                <!-- Smooth SVG Recharts-style Area Curve -->
                <svg viewBox="0 0 900 240" style="width: 100%; height: 260px; overflow: visible;">
                    <defs>
                        <linearGradient id="areaEmeraldGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stop-color="#10b981" stop-opacity="0.35" />
                            <stop offset="95%" stop-color="#10b981" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>

                    <!-- Subtle Horizontal Grid Lines -->
                    <line x1="40" y1="30" x2="860" y2="30" stroke="rgba(255, 255, 255, 0.05)" stroke-dasharray="3 3" />
                    <line x1="40" y1="85" x2="860" y2="85" stroke="rgba(255, 255, 255, 0.05)" stroke-dasharray="3 3" />
                    <line x1="40" y1="140" x2="860" y2="140" stroke="rgba(255, 255, 255, 0.05)" stroke-dasharray="3 3" />
                    <line x1="40" y1="195" x2="860" y2="195" stroke="rgba(255, 255, 255, 0.08)" />

                    <!-- Area Fill -->
                    @if (!string.IsNullOrEmpty(areaD))
                    {
                        <path d="@areaD" fill="url(#areaEmeraldGrad)" />
                        <path d="@pathD" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
                    }

                    <!-- Data Nodes & Tooltip Targets -->
                    @for (int i = 0; i < points.Count; i++)
                    {
                        var pt = points[i];
                        var item = (i < vols.Count) ? vols[i] : null;
                        var dayLabel = item?.DayName ?? $"Day {i+1}";
                        var amountVal = item?.Amount ?? 50.0;

                        <g class="chart-point-group" style="cursor: pointer;">
                            <circle cx="@pt.x.ToString("F1")" cy="@pt.y.ToString("F1")" r="4.5" fill="#060a08" stroke="#10b981" stroke-width="2.5" />
                            <text x="@pt.x.ToString("F1")" y="218" font-size="11" fill="rgba(255,255,255,0.45)" text-anchor="middle" font-family="'Space Mono', monospace">@dayLabel</text>
                            <title>@dayLabel: ₹@amountVal.ToString("F2")</title>
                        </g>
                    }
                </svg>
            </div>
        </div>

        <!-- ─── 4. Request Charts Row (Split 60% / 40%) ───────────────────── -->
        <div class="charts-split-grid">
            
            <!-- Left: Request Activity Bar Chart (RequestActivityChart.tsx) -->
            <div class="chart-container-card" style="margin-bottom: 0;">
                <div class="chart-header">
                    <div>
                        <h2 class="chart-title">
                            <i class="bi bi-activity" style="color: #38bdf8;"></i>
                            <span>Request Activity</span>
                        </h2>
                        <p class="chart-desc">Volume over the last @Model.TimeRangeDays days</p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 14px; font-size: 11.5px;">
                        <span style="display: flex; align-items: center; gap: 5px; color: rgba(255,255,255,0.7);">
                            <span style="width: 8px; height: 8px; background: #38bdf8; border-radius: 2px;"></span> Created
                        </span>
                        <span style="display: flex; align-items: center; gap: 5px; color: rgba(255,255,255,0.7);">
                            <span style="width: 8px; height: 8px; background: #10b981; border-radius: 2px;"></span> Completed
                        </span>
                        <span style="display: flex; align-items: center; gap: 5px; color: rgba(255,255,255,0.7);">
                            <span style="width: 8px; height: 8px; background: #ef4444; border-radius: 2px;"></span> Cancelled
                        </span>
                    </div>
                </div>

                <div class="bars-chart-canvas">
                    @foreach (var act in Model.RequestActivities.Take(7))
                    {
                        var createdH = Math.Min(100, Math.Max(15, act.Created * 18));
                        var completedH = Math.Min(100, Math.Max(10, act.Completed * 18));
                        var cancelledH = Math.Min(100, Math.Max(5, act.Cancelled * 18));

                        <div class="bar-group-col">
                            <div class="bar-triple">
                                <div class="bar-item bar-created" style="height: @(createdH)%;" title="Created: @act.Created"></div>
                                <div class="bar-item bar-completed" style="height: @(completedH)%;" title="Completed: @act.Completed"></div>
                                <div class="bar-item bar-cancelled" style="height: @(cancelledH)%;" title="Cancelled: @act.Cancelled"></div>
                            </div>
                            <span style="font-family: var(--font-mono, monospace); font-size: 11px; color: rgba(255, 255, 255, 0.45);">@act.Date</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Request Status Breakdown Donut Chart (RequestStatusDonut.tsx) -->
            <div class="chart-container-card" style="margin-bottom: 0;">
                <div class="chart-header">
                    <div>
                        <h2 class="chart-title">
                            <i class="bi bi-pie-chart" style="color: #34d399;"></i>
                            <span>Request Status Breakdown</span>
                        </h2>
                        <p class="chart-desc">Overview of request statuses</p>
                    </div>
                </div>

                <div class="donut-layout">
                    <!-- SVG Donut Chart with Total in Center -->
                    <div class="donut-circle-wrap">
                        <svg viewBox="0 0 160 160" width="160" height="160">
                            <!-- Background Ring -->
                            <circle cx="80" cy="80" r="60" fill="transparent" stroke="rgba(255,255,255,0.06)" stroke-width="18" />
                            
                            <!-- Active Slice (Green) -->
                            <circle cx="80" cy="80" r="60" fill="transparent" stroke="#22c55e" stroke-width="18"
                                    stroke-dasharray="@((activePct * 3.77).ToString("F1")) 377"
                                    stroke-dashoffset="0"
                                    transform="rotate(-90 80 80)" stroke-linecap="round" />

                            <!-- Completed Slice (Blue) -->
                            <circle cx="80" cy="80" r="60" fill="transparent" stroke="#3b82f6" stroke-width="18"
                                    stroke-dasharray="@((completedPct * 3.77).ToString("F1")) 377"
                                    stroke-dashoffset="@((-activePct * 3.77).ToString("F1"))"
                                    transform="rotate(-90 80 80)" stroke-linecap="round" />

                            <!-- Cancelled Slice (Red) -->
                            <circle cx="80" cy="80" r="60" fill="transparent" stroke="#ef4444" stroke-width="18"
                                    stroke-dasharray="@((cancelledPct * 3.77).ToString("F1")) 377"
                                    stroke-dashoffset="@((-(activePct + completedPct) * 3.77).ToString("F1"))"
                                    transform="rotate(-90 80 80)" stroke-linecap="round" />
                        </svg>

                        <!-- Centered Total Label -->
                        <div class="donut-center-text">
                            <div class="donut-center-num">@totalRequests</div>
                            <div class="donut-center-lbl">Total</div>
                        </div>
                    </div>

                    <!-- Donut Legend (Matching React Donut Legend) -->
                    <div class="donut-legend">
                        <div class="legend-row">
                            <span style="display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.85); font-weight: 600;">
                                <span style="width: 10px; height: 10px; border-radius: 50%; background: #22c55e;"></span>
                                Active
                            </span>
                            <span style="font-family: var(--font-mono, monospace); font-weight: 700; color: #fff;">@pendingCount <small style="color: rgba(255,255,255,0.4); font-size: 11px;">(@activePct.ToString("F0")%)</small></span>
                        </div>
                        <div class="legend-row">
                            <span style="display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.85); font-weight: 600;">
                                <span style="width: 10px; height: 10px; border-radius: 50%; background: #3b82f6;"></span>
                                Completed
                            </span>
                            <span style="font-family: var(--font-mono, monospace); font-weight: 700; color: #fff;">@completedCount <small style="color: rgba(255,255,255,0.4); font-size: 11px;">(@completedPct.ToString("F0")%)</small></span>
                        </div>
                        <div class="legend-row">
                            <span style="display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.85); font-weight: 600;">
                                <span style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444;"></span>
                                Cancelled
                            </span>
                            <span style="font-family: var(--font-mono, monospace); font-weight: 700; color: #fff;">@cancelledCount <small style="color: rgba(255,255,255,0.4); font-size: 11px;">(@cancelledPct.ToString("F0")%)</small></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ─── 5. Analytics Summary Bar (AnalyticsSummaryBar.tsx) ────────── -->
        <div class="summary-metrics-bar">
            
            <!-- Average Spent -->
            <div class="metric-cell">
                <div class="metric-icon-bubble" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa;">
                    <i class="bi bi-calculator"></i>
                </div>
                <div>
                    <p class="metric-title">Average Spent</p>
                    <div class="metric-value">₹@Model.AvgSpending.ToString("F2")</div>
                </div>
            </div>

            <!-- Highest Cost -->
            <div class="metric-cell">
                <div class="metric-icon-bubble" style="background: rgba(16, 185, 129, 0.12); color: #34d399;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <p class="metric-title">Highest Cost</p>
                    <div class="metric-value">₹@Model.HighestCost.ToString("F2")</div>
                </div>
            </div>

            <!-- Lowest Cost -->
            <div class="metric-cell">
                <div class="metric-icon-bubble" style="background: rgba(245, 158, 11, 0.12); color: #fbbf24;">
                    <i class="bi bi-graph-down-arrow"></i>
                </div>
                <div>
                    <p class="metric-title">Lowest Cost</p>
                    <div class="metric-value">₹@Model.LowestCost.ToString("F2")</div>
                </div>
            </div>

            <!-- Completed Requests -->
            <div class="metric-cell">
                <div class="metric-icon-bubble" style="background: rgba(16, 185, 129, 0.12); color: #34d399;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <p class="metric-title">Completed</p>
                    <div class="metric-value">@Model.CompletedCount</div>
                </div>
            </div>

            <!-- Cancelled Requests -->
            <div class="metric-cell">
                <div class="metric-icon-bubble" style="background: rgba(239, 68, 68, 0.12); color: #f87171;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <p class="metric-title">Cancelled</p>
                    <div class="metric-value">@Model.CancelledCount</div>
                </div>
            </div>

            <!-- Empty slot for balanced 2-column grid layout -->
            <div class="metric-cell" style="background: rgba(12, 20, 16, 0.95);"></div>

        </div>

        <!-- ─── 6. Recent Activity List (RecentActivityList.tsx) ─────────── -->
        <div class="chart-container-card">
            <div class="chart-header">
                <div>
                    <h2 class="chart-title">
                        <i class="bi bi-clock-history" style="color: #34d399;"></i>
                        <span>Recent Activity</span>
                    </h2>
                </div>
                <a href="/Dashboard/Requests" style="color: #34d399; font-size: 13px; font-weight: 600; text-decoration: none;">
                    View All &rarr;
                </a>
            </div>

            <div class="activity-feed-list">
                @foreach (var act in Model.RecentActivities)
                {
                    var isCompleted = act.Type == "request_completed";
                    var isCancelled = act.Type == "request_cancelled";
                    var bgStyle = isCompleted ? "background: rgba(16, 185, 129, 0.1); color: #34d399;" : (isCancelled ? "background: rgba(239, 68, 68, 0.1); color: #f87171;" : "background: rgba(56, 189, 248, 0.1); color: #38bdf8;");
                    var iconClass = isCompleted ? "bi-check-circle-fill" : (isCancelled ? "bi-x-circle-fill" : "bi-box-seam");

                    <div class="activity-item-row">
                        <div style="display: flex; align-items: center;">
                            <div class="activity-icon-node" style="@bgStyle">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; color: #ffffff; font-size: 14px;">@act.Title</div>
                                <div style="font-size: 12.5px; color: rgba(255, 255, 255, 0.5); margin-top: 2px;">@act.Description</div>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            <span style="font-size: 12px; color: rgba(255, 255, 255, 0.4); font-family: var(--font-mono, monospace);">
                                @act.Date.ToString("MMM dd, HH:mm")
                            </span>
                            @if (act.Amount.HasValue)
                            {
                                <div style="font-size: 13px; font-weight: 700; color: rgba(255, 255, 255, 0.8); margin-top: 2px;">
                                    ₹@act.Amount.Value.ToString("F2")
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function exportAnalyticsReport() {
        const rows = [
            ["Metric", "Value"],
            ["Total Spent", "@Model.TotalSpent.ToString("F2")"],
            ["Total Orders", "@Model.TotalOrders"],
            ["Completed Deliveries", "@Model.CompletedCount"],
            ["Active In-Transit", "@Model.PendingCount"],
            ["Cancelled Requests", "@Model.CancelledCount"],
            ["Average Spending", "@Model.AvgSpending.ToString("F2")"],
            ["Highest Cost", "@Model.HighestCost.ToString("F2")"],
            ["Lowest Cost", "@Model.LowestCost.ToString("F2")"],
            ["Report Period", "@Model.TimeRangeDays Days"],
            ["Generated At", new Date().toISOString()]
        ];

        let csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `student_analytics_report_@(Model.TimeRangeDays)d.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
}
