@model UniVerse.Server.Models.ViewModels.ProfilePageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Profile";
    ViewBag.ActivePage = "profile";

    var user = Model.CurrentUser;
    var rawName = string.IsNullOrEmpty(user.FullName) ? "Student" : user.FullName;
    var initial = rawName.Length > 0 ? rawName.Substring(0, 1).ToUpper() : "S";
}

@section Styles {
<style>
    .uv-profile-box {
        background: rgba(10, 16, 13, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 24px;
        padding: 32px;
        backdrop-filter: blur(20px);
        max-width: 680px;
        margin: 0 auto;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .uv-avatar-large {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10B981, #059669);
        border: 2px solid var(--accent-green);
        color: #022c22;
        font-size: 36px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.3);
        position: relative;
    }

    .uv-input-field {
        width: 100%;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 12px 16px;
        color: #fff;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s;
    }

    .uv-input-field:focus {
        border-color: var(--accent-green);
        background: rgba(255, 255, 255, 0.07);
    }

    .uv-label {
        display: block;
        font-size: 11.5px;
        font-family: var(--font-mono);
        font-weight: 700;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        margin-bottom: 6px;
    }
</style>
}

<div style="max-w: 740px; margin: 0 auto;">
    <!-- Top Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <a href="/Dashboard" class="uv-bell-btn" title="Back to Dashboard" style="text-decoration: none;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 style="font-family: var(--font-heading); font-size: 24px; font-weight: 800; color: #fff; margin: 0;">
                    Edit Profile
                </h1>
                <p style="color: var(--text-muted); font-size: 12.5px; margin: 2px 0 0 0;">
                    Update your university identity and contact details.
                </p>
            </div>
        </div>

        <div style="background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 800; color: var(--accent-green); display: flex; align-items: center; gap: 6px;">
            <i class="bi bi-star-fill text-warning"></i>
            <span>4.9 Verified Student</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background: rgba(0, 230, 118, 0.15); border: 1px solid rgba(0, 230, 118, 0.4); border-radius: 14px; padding: 12px 18px; color: var(--accent-green); font-weight: 700; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- Form Box -->
    <div class="uv-profile-box">
        <!-- Avatar Header -->
        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); flex-wrap: wrap;">
            <div class="uv-avatar-large">
                @initial
                <button type="button" onclick="showToast('Profile photo updated successfully!')" style="position: absolute; bottom: 0; right: 0; width: 32px; height: 32px; border-radius: 50%; background: #050A07; border: 1px solid var(--accent-green); color: var(--accent-green); display: flex; align-items: center; justify-content: center; cursor: pointer;">
                    <i class="bi bi-camera-fill" style="font-size: 13px;"></i>
                </button>
            </div>
            <div>
                <h3 style="font-size: 16px; font-weight: 800; color: #fff; margin: 0 0 4px 0;">Profile Photo</h3>
                <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 10px 0;">
                    Clear student photo helps runners recognize you at the hostel gate.
                </p>
                <button type="button" onclick="showToast('Choose file feature simulated.')" style="background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); color: var(--accent-green); font-size: 12px; font-weight: 700; padding: 6px 14px; border-radius: 10px; cursor: pointer;">
                    <i class="bi bi-upload me-1"></i> Upload Photo
                </button>
            </div>
        </div>

        <!-- Form -->
        <form method="post" action="/Dashboard/UpdateProfile">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label class="uv-label">Full Name</label>
                    <input type="text" name="fullName" value="@user.FullName" class="uv-input-field" required />
                </div>
                <div>
                    <label class="uv-label">Campus Email (University Locked)</label>
                    <input type="email" value="@user.Email" class="uv-input-field" readonly style="opacity: 0.6; cursor: not-allowed;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label class="uv-label">Department / Branch</label>
                    <select name="department" class="uv-input-field" style="background: #09120d;">
                        <option value="Computer Science & Engineering" selected>Computer Science & Engineering</option>
                        <option value="Information Technology">Information Technology</option>
                        <option value="AI & Machine Learning">AI & Machine Learning</option>
                        <option value="Mechanical Engineering">Mechanical Engineering</option>
                        <option value="Civil Engineering">Civil Engineering</option>
                        <option value="Management Studies">Management Studies</option>
                    </select>
                </div>
                <div>
                    <label class="uv-label">Semester</label>
                    <select name="semester" class="uv-input-field" style="background: #09120d;">
                        <option value="Semester 2">Semester 2</option>
                        <option value="Semester 4">Semester 4</option>
                        <option value="Semester 6" selected>Semester 6</option>
                        <option value="Semester 8">Semester 8</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label class="uv-label">Hostel Building</label>
                    <input type="text" name="hostelName" value="@user.HostelName" class="uv-input-field" required />
                </div>
                <div>
                    <label class="uv-label">Room Number</label>
                    <input type="text" name="roomNumber" value="@user.RoomNumber" class="uv-input-field" required />
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label class="uv-label">Phone Number (For Runner WhatsApp / Call)</label>
                <input type="tel" name="phoneNumber" value="@user.PhoneNumber" class="uv-input-field" placeholder="+91 98765 43210" />
            </div>

            <button type="submit" class="btn-gradient-full" style="padding: 14px; font-size: 14px; margin-top: 0;">
                <i class="bi bi-check2-circle me-1"></i> Save Profile Details
            </button>
        </form>
    </div>
</div>
