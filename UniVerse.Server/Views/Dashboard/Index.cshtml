@model UniVerse.Server.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    var user = Model.CurrentUser;
    var displayName = string.IsNullOrEmpty(user.FullName) ? "Student" : user.FullName;
    var initial = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "S";
}

<style>
    /* ─── Dashboard Atmospheric Cosmic Styles ─── */
    .uv-dash-container {
        max-width: 1380px;
        margin: 0 auto;
        padding: 24px 16px 64px;
        position: relative;
    }

    .uv-ambient-glow-1 {
        position: fixed;
        top: -10%;
        left: 20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
    }

    .uv-ambient-glow-2 {
        position: fixed;
        bottom: -10%;
        right: 10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(20, 184, 166, 0.10) 0%, transparent 70%);
        filter: blur(90px);
        pointer-events: none;
        z-index: 0;
    }

    /* Top Bar */
    .uv-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        position: relative;
        z-index: 10;
    }

    .uv-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 9999px;
        color: #34d399;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .uv-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: pulse 1.8s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Action Buttons */
    .btn-create-order {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #022c22;
        font-weight: 800;
        font-size: 13.5px;
        padding: 10px 22px;
        border-radius: 12px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
    }

    .btn-create-order:hover {
        color: #022c22;
        transform: translateY(-2px);
        box-shadow: 0 8px 26px rgba(16, 185, 129, 0.5);
    }

    .btn-action-glass {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        font-weight: 600;
        font-size: 13px;
        padding: 9px 18px;
        border-radius: 12px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .btn-action-glass:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(16, 185, 129, 0.4);
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* Welcome Header */
    .uv-header-card {
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 28px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
        z-index: 10;
    }

    .uv-header-card::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 300px;
        height: 100%;
        background: radial-gradient(circle at right, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .uv-header-title {
        font-size: clamp(1.6rem, 3.5vw, 2.3rem);
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        margin-bottom: 8px;
    }

    .uv-header-subtitle {
        color: rgba(255, 255, 255, 0.65);
        font-size: 14px;
        margin-bottom: 16px;
    }

    .uv-pill-tags {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .uv-info-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 5px 12px;
        border-radius: 9999px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
    }

    /* Stat Cards */
    .uv-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
        position: relative;
        z-index: 10;
    }

    .uv-stat-card {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 22px;
        backdrop-filter: blur(14px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .uv-stat-card:hover {
        border-color: rgba(16, 185, 129, 0.35);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .uv-stat-card-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .uv-stat-num {
        font-size: 32px;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
        margin-bottom: 4px;
        font-family: 'Outfit', sans-serif;
    }

    .uv-stat-label {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 600;
    }

    .uv-stat-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    /* Main Grid: Left (Orders) & Right (Sidebar) */
    .uv-dash-main {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 28px;
        align-items: start;
        position: relative;
        z-index: 10;
    }

    @@media (max-width: 1024px) {
        .uv-dash-main {
            grid-template-columns: 1fr;
        }
    }

    /* Section Headings */
    .uv-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .uv-section-title {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .uv-count-bubble {
        background: #10b981;
        color: #022c22;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 9999px;
    }

    /* Order Cards */
    .uv-orders-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .uv-order-card {
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 20px;
        backdrop-filter: blur(16px);
        transition: all 0.3s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .uv-order-card:hover {
        border-color: rgba(16, 185, 129, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
    }

    .uv-order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        gap: 8px;
    }

    .uv-order-badge {
        padding: 3px 10px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .uv-order-badge-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .uv-order-badge-active {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .uv-otp-pin {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: #6ee7b7;
        font-family: monospace;
        font-weight: 700;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: 8px;
    }

    .uv-order-fee {
        font-family: monospace;
        font-weight: 800;
        font-size: 15px;
        color: #34d399;
    }

    .uv-route-step {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 6px;
    }

    .uv-route-step b {
        color: #ffffff;
    }

    .uv-order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin-top: 14px;
    }

    .uv-runner-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
    }

    .uv-runner-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Tables */
    .uv-table-card {
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 20px;
        backdrop-filter: blur(16px);
        overflow-x: auto;
    }

    .uv-data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
    }

    .uv-data-table th {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        padding: 12px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        letter-spacing: 0.06em;
    }

    .uv-data-table td {
        padding: 14px;
        font-size: 13.5px;
        color: rgba(255, 255, 255, 0.85);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .uv-data-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
    }

    /* Sidebar Cards */
    .uv-sidebar-card {
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 22px;
        backdrop-filter: blur(16px);
        margin-bottom: 20px;
    }

    .uv-profile-avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        font-size: 24px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
        margin-bottom: 14px;
    }

    .uv-profile-name {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .uv-profile-email {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 16px;
        word-break: break-all;
    }

    .uv-profile-field {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 12.5px;
    }

    .uv-field-label {
        color: rgba(255, 255, 255, 0.5);
    }

    .uv-field-val {
        color: #ffffff;
        font-weight: 600;
    }

    .uv-quick-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #ffffff;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 8px;
        transition: all 0.2s ease;
    }

    .uv-quick-link:hover {
        background: rgba(16, 185, 129, 0.12);
        border-color: rgba(16, 185, 129, 0.3);
        color: #34d399;
        transform: translateX(3px);
    }
</style>

<div class="uv-ambient-glow-1"></div>
<div class="uv-ambient-glow-2"></div>

<div class="uv-dash-container">
    <!-- Top Action Bar -->
    <div class="uv-top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="uv-status-badge">
                <span class="uv-pulse-dot"></span>
                <span>MARWADI CAMPUS OPEN &bull; @(Model.ActiveRequestsCount) ACTIVE ORDERS</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-controller="Delivery" asp-action="Create" class="btn-create-order">
                <i class="bi bi-plus-lg"></i>
                <span>New Delivery Request</span>
            </a>
            <a asp-controller="Delivery" asp-action="RunnerHub" class="btn-action-glass">
                <i class="bi bi-lightning-charge text-warning"></i>
                <span>Runner Mode</span>
            </a>
            <a asp-controller="Marketplace" asp-action="Index" class="btn-action-glass">
                <i class="bi bi-shop text-info"></i>
                <span>Resale Market</span>
            </a>
        </div>
    </div>

    <!-- Welcome Hero Header -->
    <div class="uv-header-card">
        <h1 class="uv-header-title">Welcome back, @displayName!</h1>
        <p class="uv-header-subtitle">Your personal hostel hub for food requests, room deliveries, and campus marketplace.</p>
        
        <div class="uv-pill-tags">
            <span class="uv-info-pill">
                <i class="bi bi-mortarboard text-success"></i>
                <span>Marwadi University Student</span>
            </span>
            <span class="uv-info-pill">
                <i class="bi bi-geo-alt text-danger"></i>
                <span>@user.HostelName &bull; Room @user.RoomNumber</span>
            </span>
            <span class="uv-info-pill">
                <i class="bi bi-wallet2 text-warning"></i>
                <span>₹@user.RewardBalance.ToString("F2") Runner Wallet</span>
            </span>
            <span class="uv-info-pill">
                <i class="bi bi-shield-check text-info"></i>
                <span>Verified Campus Profile</span>
            </span>
        </div>
    </div>

    <!-- 4 Bento Stat Cards -->
    <div class="uv-stat-grid">
        <div class="uv-stat-card">
            <div class="uv-stat-card-inner">
                <div>
                    <div class="uv-stat-num">@Model.TotalRequestsCount</div>
                    <div class="uv-stat-label">Total Requests</div>
                </div>
                <div class="uv-stat-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>

        <div class="uv-stat-card">
            <div class="uv-stat-card-inner">
                <div>
                    <div class="uv-stat-num text-success">@Model.ActiveRequestsCount</div>
                    <div class="uv-stat-label">Active Orders</div>
                </div>
                <div class="uv-stat-icon-box" style="background: rgba(16, 185, 129, 0.2); color: #10b981;">
                    <i class="bi bi-bicycle"></i>
                </div>
            </div>
        </div>

        <div class="uv-stat-card">
            <div class="uv-stat-card-inner">
                <div>
                    <div class="uv-stat-num text-info">@Model.CompletedRequestsCount</div>
                    <div class="uv-stat-label">Delivered Successfully</div>
                </div>
                <div class="uv-stat-icon-box" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8;">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="uv-stat-card">
            <div class="uv-stat-card-inner">
                <div>
                    <div class="uv-stat-num text-warning">₹@user.RewardBalance.ToString("F2")</div>
                    <div class="uv-stat-label">Wallet Balance</div>
                </div>
                <div class="uv-stat-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main 2-Column Content -->
    <div class="uv-dash-main">
        <!-- LEFT COLUMN: Active Deliveries & Recent Orders -->
        <div>
            <!-- Active Deliveries Section -->
            <div class="uv-section-head">
                <h2 class="uv-section-title">
                    <span>Active Campus Deliveries</span>
                    <span class="uv-count-bubble">@Model.ActiveRequestsCount</span>
                </h2>
                <a asp-controller="Delivery" asp-action="Index" class="btn btn-sm btn-link text-success text-decoration-none fw-bold">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (Model.ActiveRequestsCount == 0)
            {
                <div class="uv-order-card mb-4 text-center p-5" style="border-style: dashed;">
                    <i class="bi bi-cup-hot text-secondary fs-1 d-block mb-3"></i>
                    <h5 class="text-white fw-bold mb-1">No active deliveries right now</h5>
                    <p class="text-secondary small mb-3">Craving snacks or cold coffee from the canteen? Request a hostel delivery!</p>
                    <div>
                        <a asp-controller="Delivery" asp-action="Create" class="btn-create-order">
                            <i class="bi bi-plus-lg"></i>
                            <span>Order Snacks Now</span>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="uv-orders-grid">
                    @foreach (var req in Model.ActiveRequests)
                    {
                        var isPending = req.Status == "pending";
                        <div class="uv-order-card">
                            <div>
                                <div class="uv-order-header">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="uv-order-badge @(isPending ? "uv-order-badge-pending" : "uv-order-badge-active")">
                                            @(req.Status.Replace("_", " "))
                                        </span>
                                        @if (!string.IsNullOrEmpty(req.DeliveryOtp))
                                        {
                                            <span class="uv-otp-pin" title="Share this OTP with your runner at delivery">
                                                🔐 OTP: @req.DeliveryOtp
                                            </span>
                                        }
                                    </div>
                                    <div class="uv-order-fee">
                                        +₹@req.DeliveryFee.ToString("F2") Tip
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="uv-route-step">
                                        <i class="bi bi-geo-alt-fill text-warning"></i>
                                        <span><b>From:</b> @req.PickupLocation</span>
                                    </div>
                                    <div class="uv-route-step">
                                        <i class="bi bi-door-closed-fill text-success"></i>
                                        <span><b>To:</b> @req.DropoffLocation</span>
                                    </div>
                                </div>

                                @if (req.Items.Count > 0)
                                {
                                    <div class="mb-2 text-white small">
                                        <i class="bi bi-bag-check text-success me-1"></i>
                                        @string.Join(", ", req.Items.Select(i => $"{i.Name} (x{i.Quantity})"))
                                    </div>
                                }
                            </div>

                            <div class="uv-order-footer">
                                <div class="uv-runner-badge">
                                    <div class="uv-runner-avatar">
                                        @(string.IsNullOrEmpty(req.RunnerName) ? "R" : req.RunnerName.Substring(0, 1))
                                    </div>
                                    <span>
                                        Runner: <strong class="text-white">@(string.IsNullOrEmpty(req.RunnerName) ? "Finding Runner..." : req.RunnerName)</strong>
                                    </span>
                                </div>

                                <a asp-controller="Delivery" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" style="font-size: 11px;">
                                    Track Live &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Recent Completed Table -->
            <div class="uv-section-head mt-4">
                <h2 class="uv-section-title">
                    <span>Recent Completed Orders</span>
                </h2>
                <a asp-controller="Delivery" asp-action="Index" asp-route-status="delivered" class="btn btn-sm btn-link text-success text-decoration-none fw-bold">
                    View History <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="uv-table-card">
                <table class="uv-data-table">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th>Pickup Spot</th>
                            <th>Hostel Drop</th>
                            <th>Delivered By</th>
                            <th>Status</th>
                            <th>Runner Tip</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CompletedRequestsCount == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-secondary">
                                    No completed delivery history yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in Model.CompletedRequests.Take(5))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-white">
                                                    @(req.Items.FirstOrDefault()?.Name ?? "Snacks / Food")
                                                    @if (req.Items.Count > 1)
                                                    {
                                                        <span class="text-secondary small">(+@(req.Items.Count - 1) more)</span>
                                                    }
                                                </div>
                                                <div class="text-secondary" style="font-size: 11px;">
                                                    Est. ₹@req.TotalEstimatedAmount.ToString("F2")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="text-white-50">@req.PickupLocation</span></td>
                                    <td><span class="text-white-50">@req.DropoffLocation</span></td>
                                    <td>
                                        <span class="text-white fw-semibold">
                                            @(string.IsNullOrEmpty(req.RunnerName) ? "Campus Runner" : req.RunnerName)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 rounded-pill px-2 py-1">
                                            &bull; Delivered
                                        </span>
                                    </td>
                                    <td>
                                        <span class="font-monospace fw-bold text-success">
                                            ₹@req.DeliveryFee.ToString("F2")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="Delivery" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-glass py-1 px-2 text-white">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- RIGHT COLUMN: Sidebar (Profile & Quick Links) -->
        <div>
            <!-- Student Profile Summary -->
            <div class="uv-sidebar-card">
                <div class="uv-profile-avatar">
                    @initial
                </div>
                <div class="uv-profile-name">@displayName</div>
                <div class="uv-profile-email">@user.Email</div>

                <div class="uv-profile-field">
                    <span class="uv-field-label">Primary Role</span>
                    <span class="badge bg-success bg-opacity-20 text-success text-uppercase">@user.Role</span>
                </div>
                <div class="uv-profile-field">
                    <span class="uv-field-label">Hostel Building</span>
                    <span class="uv-field-val">@user.HostelName</span>
                </div>
                <div class="uv-profile-field">
                    <span class="uv-field-label">Room Number</span>
                    <span class="uv-field-val">Room @user.RoomNumber</span>
                </div>
                <div class="uv-profile-field">
                    <span class="uv-field-label">Contact Phone</span>
                    <span class="uv-field-val">@(string.IsNullOrEmpty(user.PhoneNumber) ? "+91 98765 43210" : user.PhoneNumber)</span>
                </div>
                <div class="uv-profile-field" style="border-bottom: none;">
                    <span class="uv-field-label">Runner Wallet</span>
                    <span class="uv-field-val text-success font-monospace fs-6">₹@user.RewardBalance.ToString("F2")</span>
                </div>
            </div>

            <!-- Quick Action Navigation -->
            <div class="uv-sidebar-card">
                <h3 class="fw-bold text-white fs-6 mb-3">Campus Quick Actions</h3>

                <a asp-controller="Delivery" asp-action="Create" class="uv-quick-link">
                    <span><i class="bi bi-cart-plus me-2 text-success"></i> Request Food / Snacks</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>

                <a asp-controller="Delivery" asp-action="RunnerHub" class="uv-quick-link">
                    <span><i class="bi bi-lightning me-2 text-warning"></i> Open Runner Hub</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>

                <a asp-controller="Marketplace" asp-action="Index" class="uv-quick-link">
                    <span><i class="bi bi-shop me-2 text-info"></i> Buy / Sell Used Items</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>

                <a asp-controller="Delivery" asp-action="Index" class="uv-quick-link">
                    <span><i class="bi bi-list-check me-2 text-primary"></i> Browse All Campus Feed</span>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
            </div>

            <!-- Campus Marketplace Preview -->
            @if (Model.RecentListings.Any())
            {
                <div class="uv-sidebar-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-bold text-white fs-6 m-0">Campus Marketplace</h3>
                        <a asp-controller="Marketplace" asp-action="Index" class="text-success small fw-bold text-decoration-none">View All</a>
                    </div>

                    @foreach (var item in Model.RecentListings.Take(3))
                    {
                        <div class="p-2 mb-2 rounded-3 bg-white bg-opacity-5 border border-white border-opacity-5 d-flex justify-content-between align-items-center">
                            <div class="truncate me-2">
                                <div class="text-white fw-semibold small text-truncate" style="max-width: 170px;">@item.Title</div>
                                <span class="badge bg-secondary bg-opacity-50 text-white" style="font-size: 10px;">@item.Category</span>
                            </div>
                            <div class="font-monospace fw-bold text-success text-nowrap">
                                ₹@item.Price.ToString("F0")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
