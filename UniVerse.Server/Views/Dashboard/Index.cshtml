                <p style="font-size: 12px; color: var(--text-muted); max-width: 400px; margin: 0 auto 16px; line-height: 1.5;">
                    You have no active orders in progress right now. Place a delivery request to get food, stationery, or printouts delivered directly to your hostel room.
                </p>
                <a href="/Delivery/Create" class="btn-new-request" style="font-size: 12px; padding: 8px 18px;">
                    <i class="bi bi-plus-lg"></i>
                    <span>Create Your First Request</span>
                </a>
            </div>
        }

        <!-- Dashboard Charts Section -->
        <div class="uv-charts-card">
            <div class="uv-chart-head">
                <div>
                    <h3 class="uv-chart-title">Delivery Activity Overview</h3>
                    <div class="uv-chart-sub">Past 7 days campus order frequency</div>
                </div>
                <span class="uv-status-pill uv-status-active">PAST 7 DAYS</span>
            </div>

            <div class="uv-chart-bars">
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 32%;"></div>
                    <span class="uv-bar-lbl">Mon</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 58%;"></div>
                    <span class="uv-bar-lbl">Tue</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 42%;"></div>
                    <span class="uv-bar-lbl">Wed</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 78%;"></div>
                    <span class="uv-bar-lbl">Thu</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 96%;"></div>
                    <span class="uv-bar-lbl">Fri</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 68%;"></div>
                    <span class="uv-bar-lbl">Sat</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 52%;"></div>
                    <span class="uv-bar-lbl">Sun</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── RIGHT COLUMN (Sidebar Cards) ── -->
