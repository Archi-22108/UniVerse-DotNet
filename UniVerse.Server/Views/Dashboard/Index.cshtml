@model UniVerse.Server.Models.ViewModels.DashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Student Dashboard";
    ViewBag.ActivePage = "dashboard";
    ViewBag.ActiveRequestsCount = Model.ActiveRequestsCount;

    var user = Model.CurrentUser;
    var rawName = string.IsNullOrEmpty(user?.FullName) ? "Student" : user.FullName;
    var firstName = rawName.Split(' ')[0];
    var userInitial = rawName.Length > 0 ? rawName.Substring(0, 1).ToUpper() : "U";
    var rollPrefix = !string.IsNullOrEmpty(user?.EnrollmentNumber) ? user.EnrollmentNumber : "Student";
    var userEmail = user?.Email ?? "student@marwadiuniversity.ac.in";
    var userHostel = string.IsNullOrEmpty(user?.HostelName) ? "Hostel D" : user.HostelName;
    var userRoom = string.IsNullOrEmpty(user?.RoomNumber) ? "304" : user.RoomNumber;
    var userPhone = string.IsNullOrEmpty(user?.PhoneNumber) ? "" : user.PhoneNumber;
    var userBalance = user?.RewardBalance ?? 0.0;
}

@section Styles {
<style>
    /* ─── Top Bar (Actions & Status) ─── */
    .uv-dash-topbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .uv-campus-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 16px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 0.04em;
    }

    .uv-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-green);
        box-shadow: 0 0 8px var(--accent-green);
        animation: pulse-dot 1.8s infinite;
        flex-shrink: 0;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    .uv-bell-btn {
        background: rgba(10, 15, 12, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.8);
        cursor: pointer;
        backdrop-filter: blur(12px);
        transition: all 0.2s ease;
    }

    .uv-bell-btn:hover {
        border-color: rgba(16, 185, 129, 0.4);
        color: #ffffff;
    }

    .btn-new-request {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(90deg, #10B981 0%, #34D399 100%);
        color: #022c22;
        font-weight: 800;
        font-size: 13px;
        padding: 9px 20px;
        border-radius: 12px;
        text-decoration: none;
        border: none;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-new-request:hover {
        transform: translateY(-1px);
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.55);
        color: #022c22;
    }

    /* ─── Layout Grid (2 Columns on Desktop) ─── */
    .uv-dash-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 28px;
        align-items: start;
    }

    @@media (max-width: 1200px) {
        .uv-dash-grid { grid-template-columns: 1fr; }
    }

    /* ─── Welcome Header ─── */
    .uv-welcome-box {
        margin-bottom: 20px;
    }

    .uv-greeting-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: var(--emerald-400);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.12);
    }

    .uv-welcome-title {
        font-family: var(--font-heading);
        font-size: clamp(1.9rem, 3.5vw, 2.5rem);
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        line-height: 1.15;
        margin-bottom: 6px;
    }

    .uv-name-gradient {
        background: linear-gradient(90deg, #34D399 0%, #6EE7B7 50%, #2DD4BF 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .uv-welcome-sub {
        font-size: 13.5px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ─── Action Chips (Quick filters / shortcuts) ─── */
    .uv-action-chips {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding-bottom: 4px;
    }

    .uv-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 12px;
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .uv-chip-primary {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: var(--accent-green);
        font-weight: 700;
        box-shadow: 0 0 12px rgba(0, 230, 118, 0.15);
    }

    .uv-chip-primary:hover {
        background: rgba(16, 185, 129, 0.25);
        color: #ffffff;
    }

    .uv-chip-glass {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
    }

    .uv-chip-glass:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    /* ─── 4 Bento Metric Cards ─── */
    .uv-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 30px;
    }

    @@media (max-width: 900px) {
        .uv-stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 480px) {
        .uv-stats-grid { grid-template-columns: 1fr; }
    }

    .uv-stat-card {
        background: rgba(10, 15, 12, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 18px 20px;
        backdrop-filter: blur(16px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .uv-stat-card:hover {
        border-color: rgba(16, 185, 129, 0.3);
        transform: translateY(-2px);
    }

    .uv-stat-card.active-card {
        border-color: rgba(0, 230, 118, 0.4);
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.12);
    }

    .uv-stat-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .uv-stat-label {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .uv-stat-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.7);
        font-size: 16px;
    }

    .uv-stat-value {
        font-family: var(--font-heading);
        font-size: 32px;
        font-weight: 900;
        color: #ffffff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }

    .uv-stat-trend {
        font-size: 11.5px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ─── Active Deliveries Section ─── */
    .uv-section-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .uv-section-title {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .uv-section-badge {
        background: var(--accent-green);
        color: #022c22;
        font-size: 11px;
        font-weight: 900;
        padding: 2px 8px;
        border-radius: 9999px;
    }

    .uv-view-all {
        color: var(--emerald-400);
        text-decoration: none;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform 0.2s;
    }

    .uv-view-all:hover {
        transform: translateX(2px);
    }

    .uv-active-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 30px;
    }

    @@media (max-width: 900px) {
        .uv-active-grid { grid-template-columns: 1fr; }
    }

    .uv-active-card {
        background: rgba(10, 15, 12, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 4px solid var(--accent-green);
        border-radius: 20px;
        padding: 20px;
        backdrop-filter: blur(16px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .uv-active-card.glow-card {
        border-color: rgba(0, 230, 118, 0.4);
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.12);
    }

    .uv-active-card:hover {
        border-color: rgba(16, 185, 129, 0.5);
        transform: translateY(-2px);
    }

    .uv-active-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .uv-status-pill {
        font-size: 11px;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .uv-status-pending {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #F59E0B;
    }

    .uv-status-transit {
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #A78BFA;
    }

    .uv-status-active {
        background: rgba(0, 230, 118, 0.15);
        border: 1px solid rgba(0, 230, 118, 0.3);
        color: #00E676;
    }

    .uv-pin-pill {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 11px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        padding: 3px 10px;
        border-radius: 9999px;
        color: #6EE7B7;
    }

    .uv-tip-val {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 14px;
        color: #34D399;
    }

    .uv-route-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 14px;
    }

    .uv-items-list {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .uv-card-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .uv-runner-profile {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .uv-runner-circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--accent-green);
        color: #022c22;
        font-weight: 800;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-track-live {
        font-size: 12px;
        font-weight: 700;
        color: var(--accent-green);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform 0.2s;
    }

    .btn-track-live:hover {
        transform: translateX(2px);
    }

    /* ─── Chart Bar Section ─── */
    .uv-charts-card {
        background: rgba(10, 15, 12, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 22px;
        backdrop-filter: blur(16px);
        margin-bottom: 30px;
    }

    .uv-chart-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .uv-chart-title {
        font-size: 16px;
        font-weight: 800;
        color: #ffffff;
    }

    .uv-chart-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .uv-chart-bars {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 140px;
        padding-top: 10px;
        gap: 16px;
    }

    .uv-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 8px;
    }

    .uv-bar-fill {
        width: 100%;
        max-width: 44px;
        background: linear-gradient(180deg, #10B981 0%, rgba(16, 185, 129, 0.25) 100%);
        border-radius: 8px 8px 3px 3px;
        box-shadow: 0 0 16px rgba(16, 185, 129, 0.2);
        transition: height 0.5s ease;
    }

    .uv-bar-fill:hover {
        background: linear-gradient(180deg, #34D399 0%, rgba(52, 211, 153, 0.35) 100%);
        box-shadow: 0 0 24px rgba(0, 230, 118, 0.4);
    }

    .uv-bar-lbl {
        font-family: var(--font-mono);
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
    }

    /* ─── Sidebar Side Cards ─── */
    .uv-side-card {
        background: rgba(10, 15, 12, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 22px;
        backdrop-filter: blur(16px);
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

    .uv-profile-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
    }

    .uv-avatar-box {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--accent-green);
        color: #022c22;
        font-size: 24px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.35);
        flex-shrink: 0;
    }

    .uv-name-title {
        font-size: 16px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 3px;
    }

    .uv-roll-tag {
        font-size: 11px;
        font-family: var(--font-mono);
        color: rgba(255, 255, 255, 0.4);
    }

    .uv-detail-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 10px;
    }

    .uv-detail-item i {
        color: var(--emerald-400);
        font-size: 14px;
    }

    .btn-side-full {
        width: 100%;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: var(--emerald-400);
        font-size: 12.5px;
        font-weight: 700;
        padding: 10px;
        border-radius: 12px;
        text-align: center;
        text-decoration: none;
        display: block;
        margin-top: 14px;
        transition: all 0.2s ease;
    }

    .btn-side-full:hover {
        background: rgba(16, 185, 129, 0.18);
        color: #ffffff;
    }

    .btn-gradient-full {
        width: 100%;
        background: linear-gradient(90deg, #10B981 0%, #34D399 100%);
        color: #022c22;
        font-size: 13.5px;
        font-weight: 800;
        padding: 12px;
        border-radius: 12px;
        text-align: center;
        text-decoration: none;
        display: block;
        margin-bottom: 12px;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
        transition: all 0.2s ease;
    }

    .btn-gradient-full:hover {
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.5);
        color: #022c22;
    }

    .uv-timeline-item {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
    }

    .uv-timeline-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .uv-timeline-text {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.4;
    }

    .uv-timeline-time {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.4);
        margin-top: 2px;
        font-family: var(--font-mono);
    }
</style>
}

<!-- Top Bar Action Row -->
<div class="uv-dash-topbar">
    <!-- Campus Status Pill -->
    <div class="uv-campus-pill">
        <span class="uv-live-dot"></span>
        <span>MARWADI CAMPUS OPEN &bull; 2 ACTIVE ORDERS</span>
    </div>

    <!-- Bell Notification -->
    <button class="uv-bell-btn" title="Campus Notifications" aria-label="Notifications" onclick="showToast('No new campus alerts at this time.')">
        <i class="bi bi-bell"></i>
    </button>

    <!-- New Request Gradient Button -->
    <a href="/Delivery/Create" class="btn-new-request">
        <i class="bi bi-plus-lg" style="font-weight: 900;"></i>
        <span>New Request</span>
    </a>
</div>

<!-- Layout Grid: Left (Main Dashboard) & Right (Sidebar) -->
<div class="uv-dash-grid">
    <!-- ── LEFT COLUMN ── -->
    <div>
        <!-- Welcome Header -->
        <div class="uv-welcome-box">
            <div class="uv-greeting-badge">
                <i class="bi bi-stars"></i>
                <span>Good afternoon 🌤️</span>
                <span style="opacity: 0.5; margin: 0 2px;">|</span>
                <span style="font-family: var(--font-mono); font-size: 11px;">ID: @rollPrefix</span>
            </div>

            <h1 class="uv-welcome-title">
                <span>Welcome back,</span>
                <span class="uv-name-gradient">@firstName</span>
                <span>👋</span>
            </h1>

            <div class="uv-welcome-sub">
                <span>Marwadi University</span>
                <span style="color: rgba(16, 185, 129, 0.5);">&bull;</span>
                <span>Your campus deliveries, your UniVerse.</span>
            </div>
        </div>

        <!-- Quick Action Chips (Mobile-first shortcuts bar) -->
        <div class="uv-action-chips">
            <a href="/Delivery/Create" class="uv-chip uv-chip-primary">
                <i class="bi bi-plus-lg"></i>
                <span>Order Snacks</span>
            </a>
            <a href="/Dashboard/Marketplace" class="uv-chip uv-chip-glass">
                <span>🛍️ Resale</span>
            </a>
            <a href="/Dashboard/Runner" class="uv-chip uv-chip-glass">
                <span>🏃 Runner Mode</span>
            </a>
            <a href="/Dashboard/Wallet" class="uv-chip uv-chip-glass">
                <span>💳 Wallet</span>
            </a>
            <a href="/Dashboard/Chat" class="uv-chip uv-chip-glass">
                <span>💬 Chat</span>
            </a>
        </div>

        <!-- 4 Bento Metric Cards -->
        <div class="uv-stats-grid">
            <!-- Total Requests -->
            <div class="uv-stat-card">
                <div class="uv-stat-head">
                    <span class="uv-stat-label">TOTAL REQUESTS</span>
                    <div class="uv-stat-icon-wrap">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <div class="uv-stat-value">@Model.TotalRequestsCount</div>
                <div class="uv-stat-trend">All time campus activity</div>
            </div>

            <!-- Active Requests -->
            <div class="uv-stat-card active-card">
                <div class="uv-stat-head">
                    <span class="uv-stat-label" style="color: var(--accent-green);">ACTIVE REQUESTS</span>
                    <div class="uv-stat-icon-wrap" style="background: rgba(0, 230, 118, 0.15); color: #00E676;">
                        <i class="bi bi-bicycle"></i>
                    </div>
                </div>
                <div class="uv-stat-value" style="color: #00E676;">@Model.ActiveRequestsCount</div>
                <div class="uv-stat-trend" style="color: #34D399;">
                    <span class="uv-live-dot"></span>
                    <span>Live in progress</span>
                </div>
            </div>

            <!-- Completed -->
            <div class="uv-stat-card">
                <div class="uv-stat-head">
                    <span class="uv-stat-label">COMPLETED</span>
                    <div class="uv-stat-icon-wrap" style="background: rgba(14, 165, 233, 0.15); color: #38BDF8;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="uv-stat-value" style="color: #38BDF8;">@Model.CompletedRequestsCount</div>
                <div class="uv-stat-trend">Delivered successfully</div>
            </div>

            <!-- Cancelled -->
            <div class="uv-stat-card">
                <div class="uv-stat-head">
                    <span class="uv-stat-label">CANCELLED</span>
                    <div class="uv-stat-icon-wrap" style="background: rgba(239, 68, 68, 0.12); color: #F87171;">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
                <div class="uv-stat-value" style="color: #F87171;">@Model.CancelledRequestsCount</div>
                <div class="uv-stat-trend">All clean &bull; 0 issues</div>
            </div>
        </div>

        <!-- Active Deliveries Section -->
        <div class="uv-section-bar">
            <h2 class="uv-section-title">
                <span>Active Deliveries</span>
                <span class="uv-section-badge">@Model.ActiveRequestsCount</span>
            </h2>
            <a href="/Dashboard/Requests" class="uv-view-all">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.ActiveRequests != null && Model.ActiveRequests.Any())
        {
            <div class="uv-active-grid">
                @foreach (var req in Model.ActiveRequests)
                {
                    var isTransit = req.Status == "in_transit" || req.Status == "assigned";
                    var statusColor = isTransit ? "#8B5CF6" : "#00E676";
                    var statusLabel = isTransit ? "IN TRANSIT" : "PENDING";
                    var itemsSummary = req.Items != null && req.Items.Any()
                        ? string.Join(", ", req.Items.Select(i => $"{i.Name} (x{i.Quantity})"))
                        : "Campus Delivery Package";

                    <div class="uv-active-card glow-card" style="border-left-color: @statusColor;">
                        <div class="uv-active-head">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="uv-status-pill @(isTransit ? "uv-status-transit" : "uv-status-pending")">@statusLabel</span>
                                @if (!string.IsNullOrEmpty(req.DeliveryOtp))
                                {
                                    <span class="uv-pin-pill">🔐 PIN: @req.DeliveryOtp</span>
                                }
                            </div>
                            <div class="uv-tip-val">
                                ₹@req.DeliveryFee.ToString("F0") Tip
                            </div>
                        </div>

                        <div class="uv-route-info">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-geo-alt-fill text-warning"></i>
                                <span><b style="color: #fff;">From:</b> @req.PickupLocation</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-door-closed-fill text-success"></i>
                                <span><b style="color: #fff;">To:</b> @req.DropoffLocation</span>
                            </div>
                        </div>

                        <div class="uv-items-list">
                            <i class="bi bi-bag-check-fill text-success"></i>
                            <span>@itemsSummary</span>
                        </div>

                        <div class="uv-card-foot">
                            <div class="uv-runner-profile">
                                <div class="uv-runner-circle">R</div>
                                <span>Runner: <b style="color: #fff;">@(string.IsNullOrEmpty(req.RunnerName) ? "Finding Runner..." : req.RunnerName)</b></span>
                            </div>

                            <a href="/Delivery/Details/@req.Id" class="btn-track-live">
                                Track Live <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background: rgba(10, 15, 12, 0.4); border: 1px dashed rgba(255, 255, 255, 0.12); border-radius: 18px; padding: 36px 20px; text-align: center; margin-bottom: 24px;">
                <div style="width: 52px; height: 52px; border-radius: 16px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; color: var(--accent-green); font-size: 22px;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h4 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: #fff; margin-bottom: 4px;">No Active Deliveries</h4>
                <p style="font-size: 12px; color: var(--text-muted); max-width: 400px; margin: 0 auto 16px; line-height: 1.5;">
                    You have no active orders in progress right now. Place a delivery request to get food, stationery, or printouts delivered directly to your hostel room.
                </p>
                <a href="/Delivery/Create" class="btn-new-request" style="font-size: 12px; padding: 8px 18px;">
                    <i class="bi bi-plus-lg"></i>
                    <span>Create Your First Request</span>
                </a>
            </div>
        }

        <!-- Dashboard Charts Section -->
        <div class="uv-charts-card">
            <div class="uv-chart-head">
                <div>
                    <h3 class="uv-chart-title">Delivery Activity Overview</h3>
                    <div class="uv-chart-sub">Past 7 days campus order frequency</div>
                </div>
                <span class="uv-status-pill uv-status-active">PAST 7 DAYS</span>
            </div>

            <div class="uv-chart-bars">
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 32%;"></div>
                    <span class="uv-bar-lbl">Mon</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 58%;"></div>
                    <span class="uv-bar-lbl">Tue</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 42%;"></div>
                    <span class="uv-bar-lbl">Wed</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 78%;"></div>
                    <span class="uv-bar-lbl">Thu</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 96%;"></div>
                    <span class="uv-bar-lbl">Fri</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 68%;"></div>
                    <span class="uv-bar-lbl">Sat</span>
                </div>
                <div class="uv-bar-col">
                    <div class="uv-bar-fill" style="height: 52%;"></div>
                    <span class="uv-bar-lbl">Sun</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── RIGHT COLUMN (Sidebar Cards) ── -->
    <div>
        <!-- 1. Profile Summary Card -->
        <div class="uv-side-card">
            <div class="uv-profile-header">
                <div class="uv-avatar-box">@userInitial</div>
                <div>
                    <h3 class="uv-name-title">@rawName</h3>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span class="uv-status-pill uv-status-active" style="background: #00E676; color: #022c22; font-weight: 900; padding: 2px 8px; font-size: 10px;">
                            VERIFIED STUDENT
                        </span>
                        <span class="uv-roll-tag">#@rollPrefix</span>
                    </div>
                </div>
            </div>

            <div class="uv-detail-item">
                <i class="bi bi-envelope"></i>
                <span style="word-break: break-all;">@userEmail</span>
            </div>

            <div class="uv-detail-item">
                <i class="bi bi-geo-alt"></i>
                <span>@userHostel &bull; Room @userRoom</span>
            </div>

            @if (!string.IsNullOrEmpty(userPhone))
            {
                <div class="uv-detail-item">
                    <i class="bi bi-telephone"></i>
                    <span>@userPhone</span>
                </div>
            }

            <div class="uv-detail-item" style="margin-bottom: 0;">
                <i class="bi bi-wallet2"></i>
                <span style="font-family: var(--font-mono); font-weight: 800; color: #00E676;">
                    Wallet: ₹@userBalance.ToString("F2")
                </span>
            </div>

            <a href="/Dashboard/Profile" class="btn-side-full">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </a>
        </div>

        <!-- 2. Quick Actions Card -->
        <div class="uv-side-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 15px; font-weight: 800; color: #fff; margin: 0;">Quick Actions</h3>
                <span style="color: var(--accent-green); font-size: 11px; font-family: var(--font-mono); font-weight: 700;">✦ Shortcuts</span>
            </div>

            <a href="/Delivery/Create" class="btn-gradient-full">
                <i class="bi bi-plus-lg me-1"></i> Create New Request
            </a>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <a href="/Dashboard/Requests" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                    <i class="bi bi-file-text text-success"></i>
                    <span style="color: #fff;">My Requests</span>
                    <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                </a>

                <a href="/Dashboard/Runner" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                    <i class="bi bi-bicycle text-warning"></i>
                    <span style="color: #fff;">Runner Mode</span>
                    <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                </a>

                <a href="/Dashboard/Marketplace" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                    <i class="bi bi-shop text-info"></i>
                    <span style="color: #fff;">Resale Marketplace</span>
                    <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                </a>
            </div>
        </div>

        <!-- 3. Campus Activity Feed -->
        <div class="uv-side-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 15px; font-weight: 800; color: #fff; margin: 0;">Live Activity</h3>
                <span class="uv-live-dot"></span>
            </div>

            @if (Model.AllRequests != null && Model.AllRequests.Any())
            {
                @foreach (var act in Model.AllRequests.Take(3))
                {
                    <div class="uv-timeline-item">
                        <div class="uv-timeline-icon" style="background: rgba(0, 230, 118, 0.15); color: #00E676;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <div class="uv-timeline-text">Delivery to <b style="color: #00E676;">@act.DropoffLocation</b>: @act.Status.ToUpper()</div>
                            <div class="uv-timeline-time">₹@act.DeliveryFee.ToString("F0") tip &bull; @act.PickupLocation</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="font-size: 12px; color: var(--text-muted); padding: 12px 0; text-align: center;">
                    No recent activity yet. When you create or complete deliveries, they will appear here.
                </div>
            }
        </div>
    </div>
</div>
