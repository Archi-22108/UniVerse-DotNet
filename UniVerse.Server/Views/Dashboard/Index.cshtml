                    <span class="uv-live-dot" style="width: 6px; height: 6px;"></span>
                    <span style="font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">Realtime Radar Live</span>
                </div>
                <a href="/Dashboard/Requests" style="color: #A7B8B0; font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px; font-weight: 600;">
                    <span>Activity Feed</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- New Request Gradient Button -->
