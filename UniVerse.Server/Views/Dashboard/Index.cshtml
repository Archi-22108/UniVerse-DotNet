@model UniVerse.Server.Models.ViewModels.DashboardViewModel
@{
    Layout = null;
    var user = Model.CurrentUser;
    var rawName = string.IsNullOrEmpty(user.FullName) ? "Student" : user.FullName;
    var nameParts = rawName.Split(' ');
    var firstName = nameParts.Length > 0 ? nameParts[0] : "Student";
    var initial = rawName.Length > 0 ? rawName.Substring(0, 1).ToUpper() : "S";
    var rollNo = !string.IsNullOrEmpty(user.EnrollmentNumber) ? user.EnrollmentNumber : "92100103001";
    var rollPrefix = rollNo.Length > 4 ? rollNo.Substring(rollNo.Length - 4) : rollNo;

    // Time-based greeting
    var hour = DateTime.Now.Hour;
    string greetingText = hour >= 5 && hour < 12 ? "Good morning"
                        : hour >= 12 && hour < 17 ? "Good afternoon"
                        : hour >= 17 && hour < 21 ? "Good evening"
                        : "Good night";
    string greetingEmoji = hour >= 5 && hour < 12 ? "☀️"
                         : hour >= 12 && hour < 17 ? "🌤️"
                         : hour >= 17 && hour < 21 ? "🌆"
                         : "🌙";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard · UniVerse</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-canvas: #050A07;
            --bg-card: rgba(10, 15, 12, 0.55);
            --bg-sidebar: #050A07;
            --accent-green: #00E676;
            --emerald-500: #10B981;
            --emerald-400: #34D399;
            --text-muted: #A7B8B0;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-green: rgba(102, 255, 178, 0.12);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            background-color: var(--bg-canvas);
            color: #ffffff;
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Ambient Glow Lights ─── */
        .ambient-glow {
            position: fixed;
            pointer-events: none;
            border-radius: 50%;
            z-index: 0;
            filter: blur(140px);
        }
        .glow-1 { top: -15%; left: 15%; width: 650px; height: 650px; background: rgba(16, 185, 129, 0.12); }
        .glow-2 { top: 35%; left: 20%; width: 520px; height: 520px; background: rgba(16, 185, 129, 0.15); filter: blur(110px); }
        .glow-3 { top: 45%; right: -5%; width: 500px; height: 500px; background: rgba(5, 150, 105, 0.12); }
        .glow-4 { bottom: -10%; left: -5%; width: 500px; height: 500px; background: rgba(20, 184, 166, 0.08); }

        /* ─── Sidebar Navigation (Desktop) ─── */
        .uv-sidebar {
            width: 240px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-green);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 50;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .uv-brand-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 32px;
            padding-left: 6px;
        }

        .uv-brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px rgba(0, 230, 118, 0.4);
        }

        .uv-brand-icon i {
            color: #050A07;
            font-size: 18px;
        }

        .uv-brand-name {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-heading);
            letter-spacing: -0.02em;
        }

        .uv-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            list-style: none;
        }

        .uv-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.2s ease;
            position: relative;
        }

        .uv-nav-link i {
            font-size: 16px;
            flex-shrink: 0;
        }

        .uv-nav-link:hover {
            color: var(--accent-green);
            background: rgba(0, 230, 118, 0.05);
        }

        .uv-nav-link.active {
            background: rgba(0, 230, 118, 0.1);
            color: var(--accent-green);
            font-weight: 700;
        }

        .uv-nav-badge {
            margin-left: auto;
            background: rgba(16, 185, 129, 0.2);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.4);
            font-size: 10px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .uv-logout-wrap {
            padding-top: 16px;
            border-top: 1px solid var(--border-green);
        }

        .uv-logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            color: #ef4444;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .uv-logout-btn:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }

        /* ─── Main Content Area ─── */
        .uv-main-content {
            flex: 1;
            margin-left: 240px;
            min-width: 0;
            position: relative;
            z-index: 10;
            padding: 24px 32px 64px;
        }

        @@media (max-width: 1024px) {
            .uv-sidebar { display: none; }
            .uv-main-content { margin-left: 0; padding: 16px 16px 48px; }
        }

        /* ─── Mobile Header (<1024px) ─── */
        .uv-mobile-header {
            display: none;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(5, 10, 7, 0.95);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-green);
            padding: 12px 16px;
            align-items: center;
            justify-content: space-between;
            z-index: 40;
        }

        @@media (max-width: 1024px) {
            .uv-mobile-header { display: flex; }
        }

        /* ─── Top Bar (Actions & Status) ─── */
        .uv-dash-topbar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .uv-bell-btn {
            background: rgba(10, 15, 12, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            backdrop-filter: blur(12px);
            transition: all 0.2s ease;
        }

        .uv-bell-btn:hover {
            border-color: rgba(16, 185, 129, 0.4);
            color: #ffffff;
        }

        .uv-campus-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 14px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 11.5px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.75);
        }

        .uv-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--accent-green);
            box-shadow: 0 0 8px var(--accent-green);
            animation: pulse-dot 1.8s infinite;
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }

        .btn-new-request {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(90deg, #10B981 0%, #34D399 100%);
            color: #022c22;
            font-weight: 800;
            font-size: 13.5px;
            padding: 10px 20px;
            border-radius: 12px;
            text-decoration: none;
            border: none;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-new-request:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 28px rgba(16, 185, 129, 0.55);
            color: #022c22;
        }

        /* ─── Layout Grid (2 Columns on Desktop) ─── */
        .uv-dash-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 28px;
            align-items: start;
        }

        @@media (max-width: 1200px) {
            .uv-dash-grid { grid-template-columns: 1fr; }
        }

        /* ─── Welcome Header ─── */
        .uv-welcome-box {
            margin-bottom: 20px;
        }

        .uv-greeting-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 4px 12px;
            border-radius: 9999px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: var(--emerald-400);
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 12px;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.15);
        }

        .uv-welcome-title {
            font-family: var(--font-heading);
            font-size: clamp(1.8rem, 3.5vw, 2.4rem);
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            line-height: 1.15;
            margin-bottom: 8px;
        }

        .uv-name-gradient {
            background: linear-gradient(90deg, #34D399 0%, #6EE7B7 50%, #2DD4BF 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .uv-welcome-sub {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        /* ─── Quick Action Scrollable Chips (Mobile & Shortcuts) ─── */
        .uv-action-chips {
            display: flex;
            align-items: center;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 4px;
            margin-bottom: 24px;
        }

        .uv-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 12px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 700;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .uv-chip-primary {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: var(--accent-green);
            box-shadow: 0 0 12px rgba(0, 230, 118, 0.15);
        }

        .uv-chip-glass {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
        }

        .uv-chip-glass:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(16, 185, 129, 0.3);
            color: #ffffff;
        }

        /* ─── 4 Stat Cards ─── */
        .uv-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 32px;
        }

        @@media (max-width: 900px) {
            .uv-stats-grid { grid-template-columns: repeat(2, 1fr); }
        }

        .uv-stat-card {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(16px);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        .uv-stat-card:hover {
            border-color: rgba(16, 185, 129, 0.35);
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        .uv-stat-card.active-card {
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.12);
        }

        .uv-stat-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .uv-stat-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        .uv-stat-icon-wrap {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.2);
            color: var(--emerald-400);
        }

        .uv-stat-value {
            font-size: 32px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-mono);
            line-height: 1;
            margin-bottom: 6px;
        }

        .uv-stat-trend {
            font-size: 11.5px;
            color: rgba(255, 255, 255, 0.45);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* ─── Active Deliveries Section ─── */
        .uv-section-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .uv-section-title {
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .uv-section-badge {
            background: var(--accent-green);
            color: #050A07;
            font-size: 11px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 9999px;
        }

        .uv-view-all {
            color: var(--emerald-400);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .uv-view-all:hover {
            text-decoration: underline;
        }

        .uv-active-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .uv-active-card {
            background: rgba(10, 15, 12, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-left: 4px solid var(--accent-green);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(16px);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .uv-active-card:hover {
            border-color: rgba(16, 185, 129, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 10px 35px rgba(16, 185, 129, 0.15);
        }

        .uv-active-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .uv-status-pill {
            font-size: 11px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .uv-status-pending {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #F59E0B;
        }

        .uv-status-active {
            background: rgba(0, 230, 118, 0.15);
            border: 1px solid rgba(0, 230, 118, 0.3);
            color: #00E676;
        }

        .uv-pin-pill {
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 11.5px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #6EE7B7;
            padding: 2px 8px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .uv-tip-val {
            font-family: var(--font-mono);
            font-weight: 900;
            font-size: 14px;
            color: #6EE7B7;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 3px 8px;
            border-radius: 8px;
        }

        .uv-route-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 12px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
        }

        .uv-route-info i {
            color: var(--emerald-400);
            font-size: 13px;
        }

        .uv-items-list {
            font-size: 12.5px;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .uv-card-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .uv-runner-profile {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.65);
        }

        .uv-runner-circle {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.2);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: var(--emerald-400);
            font-size: 11px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-track-live {
            background: var(--accent-green);
            color: #050A07;
            font-size: 11.5px;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s ease;
        }

        .btn-track-live:hover {
            background: #69F0AE;
            color: #050A07;
        }

        /* ─── Dashboard Charts Component ─── */
        .uv-charts-card {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 24px;
            backdrop-filter: blur(16px);
            margin-bottom: 32px;
        }

        .uv-chart-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .uv-chart-title {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .uv-chart-sub {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.45);
        }

        .uv-chart-bars {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
            height: 140px;
            padding-top: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 12px;
        }

        .uv-bar-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100%;
            justify-content: flex-end;
            gap: 8px;
        }

        .uv-bar-fill {
            width: 100%;
            max-width: 28px;
            border-radius: 6px 6px 0 0;
            background: linear-gradient(180deg, #34D399 0%, #059669 100%);
            transition: height 0.6s ease;
        }

        .uv-bar-lbl {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            font-family: var(--font-mono);
        }

        /* ─── Recent Completed Table ─── */
        .uv-table-box {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 16px 20px;
            backdrop-filter: blur(16px);
            overflow-x: auto;
        }

        .uv-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
        }

        .uv-table th {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 12px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            font-family: var(--font-mono);
            text-align: left;
        }

        .uv-table td {
            padding: 14px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.85);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            vertical-align: middle;
        }

        .uv-table tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        /* ─── Right Sidebar Cards ─── */
        .uv-side-card {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 22px;
            backdrop-filter: blur(16px);
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }

        .uv-profile-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

        .uv-avatar-box {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            border: 1px solid rgba(110, 231, 183, 0.4);
            color: #022c22;
            font-size: 20px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
        }

        .uv-name-title {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 3px;
        }

        .uv-roll-tag {
            font-size: 10px;
            font-family: var(--font-mono);
            color: rgba(255, 255, 255, 0.4);
        }

        .uv-detail-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12.5px;
            color: rgba(255, 255, 255, 0.65);
            margin-bottom: 10px;
        }

        .uv-detail-item i {
            color: var(--emerald-400);
            font-size: 14px;
        }

        .btn-side-full {
            width: 100%;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: var(--emerald-400);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin-top: 14px;
            transition: all 0.2s ease;
        }

        .btn-side-full:hover {
            background: rgba(16, 185, 129, 0.2);
            color: #ffffff;
        }

        .btn-gradient-full {
            width: 100%;
            background: linear-gradient(90deg, #10B981 0%, #34D399 100%);
            color: #022c22;
            font-size: 13px;
            font-weight: 800;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            display: block;
            margin-top: 14px;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
            transition: all 0.2s ease;
        }

        .btn-gradient-full:hover {
            box-shadow: 0 0 28px rgba(16, 185, 129, 0.5);
            color: #022c22;
        }

        /* ─── Timeline Items ─── */
        .uv-timeline-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 16px;
            position: relative;
        }

        .uv-timeline-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
        }

        .uv-timeline-text {
            font-size: 12.5px;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.4;
        }

        .uv-timeline-time {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 2px;
            font-family: var(--font-mono);
        }
    </style>
</head>
<body>

    <!-- Atmospheric Glowing Nebulas -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>
    <div class="ambient-glow glow-4"></div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         1. AUTHENTIC LEFT DESKTOP SIDEBAR
    ═══════════════════════════════════════════════════════════════════════ -->
    <aside class="uv-sidebar">
        <!-- Logo -->
        <a href="/" class="uv-brand-wrap">
            <div class="uv-brand-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <span class="uv-brand-name">UniVerse</span>
        </a>

        <!-- Navigation Links -->
        <ul class="uv-nav-list">
            <li>
                <a href="/" class="uv-nav-link">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link active">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Delivery" class="uv-nav-link">
                    <i class="bi bi-file-text"></i>
                    <span>My Requests</span>
                    @if (Model.ActiveRequestsCount > 0)
                    {
                        <span class="uv-nav-badge">
                            <i class="bi bi-circle-fill" style="font-size: 6px;"></i> @Model.ActiveRequestsCount live
                        </span>
                    }
                </a>
            </li>
            <li>
                <a href="/Delivery/RunnerHub" class="uv-nav-link">
                    <i class="bi bi-bicycle"></i>
                    <span>Runner Mode</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link">
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                </a>
            </li>
            <li>
                <a href="/Marketplace" class="uv-nav-link">
                    <i class="bi bi-bag"></i>
                    <span>Marketplace</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link">
                    <i class="bi bi-chat-dots"></i>
                    <span>Chat Support</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link">
                    <i class="bi bi-bar-chart"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li>
                <a href="/Dashboard" class="uv-nav-link">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <!-- Logout Bottom -->
        <div class="uv-logout-wrap">
            <a href="/Account/Logout" class="uv-logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log out</span>
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════════════════════════════════════
         2. MOBILE HEADER BAR (<1024px)
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="uv-mobile-header">
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
            <div class="uv-brand-icon" style="width: 28px; height: 28px;">
                <i class="bi bi-lightning-charge-fill" style="font-size: 15px;"></i>
            </div>
            <span class="uv-brand-name" style="font-size: 18px;">UniVerse</span>
        </a>

        <div class="d-flex align-items-center gap-2">
            <a href="/Delivery/Create" class="btn-new-request" style="padding: 6px 14px; font-size: 12px;">
                <i class="bi bi-plus-lg"></i>
                <span>New</span>
            </a>
            <a href="/Delivery" class="uv-bell-btn" style="width: 36px; height: 36px;">
                <i class="bi bi-box-seam"></i>
            </a>
        </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════════════
         3. MAIN CONTENT CONTAINER
    ═══════════════════════════════════════════════════════════════════════ -->
    <main class="uv-main-content">
        <!-- Top Bar Action Row -->
        <div class="uv-dash-topbar">
            <!-- Campus Status Pill -->
            <div class="uv-campus-pill">
                <span class="uv-live-dot"></span>
                <span>MARWADI CAMPUS OPEN &bull; @(Model.ActiveRequestsCount) ACTIVE ORDERS</span>
            </div>

            <!-- Bell Notification -->
            <button class="uv-bell-btn" title="Campus Notifications" aria-label="Notifications">
                <i class="bi bi-bell"></i>
            </button>

            <!-- New Request Gradient Button -->
            <a href="/Delivery/Create" class="btn-new-request">
                <i class="bi bi-plus-lg" style="font-weight: 800;"></i>
                <span>New Request</span>
            </a>
        </div>

        <!-- Layout Grid: Left (Main Dashboard) & Right (Sidebar) -->
        <div class="uv-dash-grid">
            <!-- ── LEFT COLUMN ── -->
            <div>
                <!-- Welcome Header -->
                <div class="uv-welcome-box">
                    <div class="uv-greeting-badge">
                        <i class="bi bi-stars"></i>
                        <span>@greetingText @greetingEmoji</span>
                        <span style="opacity: 0.5; margin-left: 4px;">|</span>
                        <span style="font-family: var(--font-mono); font-size: 10px; margin-left: 4px;">ID: @rollPrefix</span>
                    </div>

                    <h1 class="uv-welcome-title">
                        <span>Welcome back,</span>
                        <span class="uv-name-gradient">@firstName</span>
                        <span>👋</span>
                    </h1>

                    <div class="uv-welcome-sub">
                        <span>Marwadi University</span>
                        <span style="color: rgba(16, 185, 129, 0.5);">&bull;</span>
                        <span>Your campus deliveries, your UniVerse.</span>
                    </div>
                </div>

                <!-- Quick Action Chips (Mobile-first shortcuts bar) -->
                <div class="uv-action-chips">
                    <a href="/Delivery/Create" class="uv-chip uv-chip-primary">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Order Snacks</span>
                    </a>
                    <a href="/Marketplace" class="uv-chip uv-chip-glass">
                        <span>🛍️ Resale</span>
                    </a>
                    <a href="/Delivery/RunnerHub" class="uv-chip uv-chip-glass">
                        <span>🏃 Runner Mode</span>
                    </a>
                    <a href="/Delivery" class="uv-chip uv-chip-glass">
                        <span>💳 Wallet</span>
                    </a>
                    <a href="/Delivery" class="uv-chip uv-chip-glass">
                        <span>💬 Chat</span>
                    </a>
                </div>

                <!-- 4 Bento Metric Cards -->
                <div class="uv-stats-grid">
                    <!-- Total Requests -->
                    <div class="uv-stat-card">
                        <div class="uv-stat-head">
                            <span class="uv-stat-label">TOTAL REQUESTS</span>
                            <div class="uv-stat-icon-wrap">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        </div>
                        <div class="uv-stat-value">@Model.TotalRequestsCount</div>
                        <div class="uv-stat-trend">All time campus activity</div>
                    </div>

                    <!-- Active Requests -->
                    <div class="uv-stat-card @(Model.ActiveRequestsCount > 0 ? "active-card" : "")">
                        <div class="uv-stat-head">
                            <span class="uv-stat-label">ACTIVE REQUESTS</span>
                            <div class="uv-stat-icon-wrap" style="background: rgba(0, 230, 118, 0.15); color: #00E676;">
                                <i class="bi bi-bicycle"></i>
                            </div>
                        </div>
                        <div class="uv-stat-value" style="color: #00E676;">@Model.ActiveRequestsCount</div>
                        <div class="uv-stat-trend" style="color: #34D399;">
                            <span class="uv-live-dot"></span>
                            <span>Live in progress</span>
                        </div>
                    </div>

                    <!-- Completed -->
                    <div class="uv-stat-card">
                        <div class="uv-stat-head">
                            <span class="uv-stat-label">COMPLETED</span>
                            <div class="uv-stat-icon-wrap" style="background: rgba(14, 165, 233, 0.15); color: #38BDF8;">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                        <div class="uv-stat-value" style="color: #38BDF8;">@Model.CompletedRequestsCount</div>
                        <div class="uv-stat-trend">Delivered successfully</div>
                    </div>

                    <!-- Cancelled / Wallet -->
                    <div class="uv-stat-card">
                        <div class="uv-stat-head">
                            <span class="uv-stat-label">CANCELLED</span>
                            <div class="uv-stat-icon-wrap" style="background: rgba(239, 68, 68, 0.12); color: #F87171;">
                                <i class="bi bi-exclamation-circle"></i>
                            </div>
                        </div>
                        <div class="uv-stat-value" style="color: #F87171;">@Model.CancelledRequestsCount</div>
                        <div class="uv-stat-trend">All clean &bull; 0 issues</div>
                    </div>
                </div>

                <!-- Active Deliveries Section -->
                <div class="uv-section-bar">
                    <h2 class="uv-section-title">
                        <span>Active Deliveries</span>
                        <span class="uv-section-badge">@Model.ActiveRequestsCount</span>
                    </h2>
                    <a href="/Delivery" class="uv-view-all">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (Model.ActiveRequestsCount == 0)
                {
                    <div class="uv-active-card text-center py-5" style="border-style: dashed; border-left-style: dashed; margin-bottom: 32px;">
                        <i class="bi bi-box2 text-secondary" style="font-size: 36px; display: block; margin-bottom: 12px;"></i>
                        <p style="color: rgba(255, 255, 255, 0.6); font-size: 13.5px; margin-bottom: 14px;">
                            No active deliveries right now. Tap &ldquo;New Request&rdquo; to order snacks!
                        </p>
                        <a href="/Delivery/Create" class="btn-new-request" style="display: inline-flex;">
                            <i class="bi bi-plus-lg"></i>
                            <span>Create Request</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="uv-active-grid">
                        @foreach (var req in Model.ActiveRequests)
                        {
                            var isPending = req.Status == "pending";
                            <div class="uv-active-card">
                                <div class="uv-active-head">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="uv-status-pill @(isPending ? "uv-status-pending" : "uv-status-active")">
                                            @(req.Status.Replace("_", " "))
                                        </span>
                                        @if (!string.IsNullOrEmpty(req.DeliveryOtp))
                                        {
                                            <span class="uv-pin-pill" title="Share this PIN with runner on delivery">
                                                🔐 PIN: @req.DeliveryOtp
                                            </span>
                                        }
                                    </div>
                                    <div class="uv-tip-val">
                                        ₹@req.DeliveryFee.ToString("F0") Tip
                                    </div>
                                </div>

                                <div class="uv-route-info">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <i class="bi bi-geo-alt-fill text-warning"></i>
                                        <span><b style="color: #fff;">From:</b> @req.PickupLocation</span>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <i class="bi bi-door-closed-fill text-success"></i>
                                        <span><b style="color: #fff;">To:</b> @req.DropoffLocation</span>
                                    </div>
                                </div>

                                @if (req.Items.Count > 0)
                                {
                                    <div class="uv-items-list">
                                        <i class="bi bi-bag-check-fill text-success"></i>
                                        <span>@string.Join(", ", req.Items.Select(i => $"{i.Name} (x{i.Quantity})"))</span>
                                    </div>
                                }

                                <div class="uv-card-foot">
                                    <div class="uv-runner-profile">
                                        <div class="uv-runner-circle">
                                            @(string.IsNullOrEmpty(req.RunnerName) ? "R" : req.RunnerName.Substring(0, 1))
                                        </div>
                                        <span>Runner: <b style="color: #fff;">@(string.IsNullOrEmpty(req.RunnerName) ? "Finding Runner..." : req.RunnerName)</b></span>
                                    </div>

                                    <a href="/Delivery/Details/@req.Id" class="btn-track-live">
                                        Track Live <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Dashboard Charts Section -->
                <div class="uv-charts-card">
                    <div class="uv-chart-head">
                        <div>
                            <h3 class="uv-chart-title">Delivery Activity Overview</h3>
                            <div class="uv-chart-sub">Past 7 days campus order frequency</div>
                        </div>
                        <span class="uv-status-pill uv-status-active">Past 7 Days</span>
                    </div>

                    <div class="uv-chart-bars">
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 35%;"></div>
                            <span class="uv-bar-lbl">Mon</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 60%;"></div>
                            <span class="uv-bar-lbl">Tue</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 45%;"></div>
                            <span class="uv-bar-lbl">Wed</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 80%;"></div>
                            <span class="uv-bar-lbl">Thu</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 95%;"></div>
                            <span class="uv-bar-lbl">Fri</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 70%;"></div>
                            <span class="uv-bar-lbl">Sat</span>
                        </div>
                        <div class="uv-bar-col">
                            <div class="uv-bar-fill" style="height: 50%;"></div>
                            <span class="uv-bar-lbl">Sun</span>
                        </div>
                    </div>
                </div>

                <!-- Recent Completed Table -->
                <div class="uv-section-bar">
                    <h2 class="uv-section-title">
                        <span>Recent Completed</span>
                    </h2>
                    <a href="/Delivery" class="uv-view-all">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="uv-table-box">
                    <table class="uv-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Runner</th>
                                <th>Status</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CompletedRequestsCount == 0)
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; color: rgba(255,255,255,0.4); padding: 24px;">
                                        No completed requests yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var req in Model.CompletedRequests.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: #fff;">
                                                @(req.Items.FirstOrDefault()?.Name ?? "Snacks / Food")
                                                @if (req.Items.Count > 1)
                                                {
                                                    <span style="font-size: 11px; color: var(--text-muted); font-weight: normal;">(+@(req.Items.Count - 1))</span>
                                                }
                                            </div>
                                        </td>
                                        <td style="color: rgba(255,255,255,0.65);">@req.PickupLocation</td>
                                        <td style="color: rgba(255,255,255,0.65);">@req.DropoffLocation</td>
                                        <td style="font-weight: 600; color: #fff;">
                                            @(string.IsNullOrEmpty(req.RunnerName) ? "Campus Runner" : req.RunnerName)
                                        </td>
                                        <td>
                                            <span style="display: inline-flex; align-items: center; gap: 4px; background: rgba(0, 230, 118, 0.12); color: #00E676; border: 1px solid rgba(0, 230, 118, 0.3); font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 9999px;">
                                                ● Delivered
                                            </span>
                                        </td>
                                        <td style="font-family: var(--font-mono); font-weight: 900; color: #6EE7B7;">
                                            ₹@req.DeliveryFee.ToString("F0")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── RIGHT COLUMN (Sidebar Cards) ── -->
            <div>
                <!-- 1. Profile Summary Card -->
                <div class="uv-side-card">
                    <div class="uv-profile-header">
                        <div class="uv-avatar-box">@initial</div>
                        <div>
                            <h3 class="uv-name-title">@rawName</h3>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span class="uv-status-pill uv-status-active" style="padding: 2px 7px; font-size: 10px;">
                                    Verified Student
                                </span>
                                <span class="uv-roll-tag">#@rollPrefix</span>
                            </div>
                        </div>
                    </div>

                    <div class="uv-detail-item">
                        <i class="bi bi-envelope"></i>
                        <span style="word-break: break-all;">@user.Email</span>
                    </div>

                    <div class="uv-detail-item">
                        <i class="bi bi-geo-alt"></i>
                        <span>@user.HostelName &bull; Room @user.RoomNumber</span>
                    </div>

                    <div class="uv-detail-item">
                        <i class="bi bi-telephone"></i>
                        <span>@(string.IsNullOrEmpty(user.PhoneNumber) ? "+91 98765 43210" : user.PhoneNumber)</span>
                    </div>

                    <div class="uv-detail-item" style="margin-bottom: 0;">
                        <i class="bi bi-wallet2"></i>
                        <span style="font-family: var(--font-mono); font-weight: 800; color: #34D399;">
                            Wallet: ₹@user.RewardBalance.ToString("F2")
                        </span>
                    </div>

                    <a href="/Dashboard" class="btn-side-full">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                </div>

                <!-- 2. Quick Actions Card -->
                <div class="uv-side-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3 style="font-size: 15px; font-weight: 800; color: #fff; margin: 0;">Quick Actions</h3>
                        <span style="color: var(--accent-green); font-size: 11px; font-family: var(--font-mono); font-weight: 700;">✦ Shortcuts</span>
                    </div>

                    <a href="/Delivery/Create" class="btn-gradient-full" style="margin-top: 0; margin-bottom: 12px;">
                        <i class="bi bi-plus-lg me-1"></i> Create New Request
                    </a>

                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <a href="/Delivery" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                            <i class="bi bi-file-text text-success"></i>
                            <span style="color: #fff;">My Requests</span>
                            <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                        </a>

                        <a href="/Delivery/RunnerHub" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                            <i class="bi bi-bicycle text-warning"></i>
                            <span style="color: #fff;">Runner Mode</span>
                            <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                        </a>

                        <a href="/Marketplace" class="uv-nav-link" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); padding: 10px 14px;">
                            <i class="bi bi-shop text-info"></i>
                            <span style="color: #fff;">Resale Marketplace</span>
                            <i class="bi bi-chevron-right ms-auto" style="font-size: 11px; color: rgba(255, 255, 255, 0.3);"></i>
                        </a>
                    </div>
                </div>

                <!-- 3. Campus Activity Feed -->
                <div class="uv-side-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3 style="font-size: 15px; font-weight: 800; color: #fff; margin: 0;">Live Activity</h3>
                        <span class="uv-live-dot"></span>
                    </div>

                    <div class="uv-timeline-item">
                        <div class="uv-timeline-icon" style="background: rgba(99, 102, 241, 0.15); color: #818CF8;">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
