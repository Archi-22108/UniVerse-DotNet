@model UniVerse.Server.Models.ViewModels.DashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Student Dashboard";
    ViewBag.ActivePage = "dashboard";
    ViewBag.ActiveRequestsCount = Model.ActiveRequestsCount;

    var user = Model.CurrentUser;
    var rawName = string.IsNullOrEmpty(user?.FullName) ? "Student" : user.FullName;
    var firstName = rawName.Split(' ')[0];
    var userInitial = rawName.Length > 0 ? rawName.Substring(0, 1).ToUpper() : "U";
    var rollPrefix = !string.IsNullOrEmpty(user?.EnrollmentNumber) ? user.EnrollmentNumber : "Student";
    var userEmail = user?.Email ?? "student@marwadiuniversity.ac.in";
    var userHostel = string.IsNullOrEmpty(user?.HostelName) ? "Hostel D" : user.HostelName;
    var userRoom = string.IsNullOrEmpty(user?.RoomNumber) ? "304" : user.RoomNumber;
    var userPhone = string.IsNullOrEmpty(user?.PhoneNumber) ? "" : user.PhoneNumber;
    var userBalance = user?.RewardBalance ?? 0.0;
}

@section Styles {
<style>
    /* ─── Top Bar (Actions & Status) ─── */
    .uv-dash-topbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .uv-campus-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 16px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 0.04em;
    }

    .uv-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-green);
        box-shadow: 0 0 8px var(--accent-green);
        animation: pulse-dot 1.8s infinite;
        flex-shrink: 0;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    .uv-notif-wrapper {
        position: relative;
    }

    .uv-bell-btn {
        position: relative;
        background: rgba(10, 15, 12, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.8);
        cursor: pointer;
        backdrop-filter: blur(12px);
        transition: all 0.2s ease;
    }

    .uv-bell-btn:hover, .uv-bell-btn.uv-bell-active {
        border-color: rgba(16, 185, 129, 0.5);
        color: #00E676;
        background: rgba(16, 185, 129, 0.15);
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.25);
    }

    .uv-notif-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        z-index: 2;
    }

    .uv-notif-ping {
        position: absolute;
        inset: 0;
        border-radius: 9999px;
        background: #34d399;
        opacity: 0.75;
        animation: notif-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @@keyframes notif-ping {
        75%, 100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    .uv-notif-count {
        position: relative;
        padding: 0 4px;
        height: 18px;
        min-width: 18px;
        border-radius: 9999px;
        background: linear-gradient(135deg, #10b981, #00e676);
        color: #051109;
        font-size: 10px;
        font-weight: 900;
        line-height: 18px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0, 230, 118, 0.7);
    }

    /* Notification Dropdown Panel */
    .uv-notif-panel {
        display: none;
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 390px;
        max-width: calc(100vw - 24px);
        background: rgba(10, 18, 14, 0.96);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: 20px;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 35px rgba(0, 230, 118, 0.1);
        backdrop-filter: blur(24px);
        z-index: 1000;
        overflow: hidden;
        flex-direction: column;
        animation: panelFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .uv-notif-panel.active {
        display: flex;
    }

    @@keyframes panelFadeIn {
        from { opacity: 0; transform: translateY(-8px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .uv-notif-glowline {
        height: 2px;
        background: linear-gradient(90deg, transparent, #00E676, transparent);
    }

    .uv-notif-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(0, 0, 0, 0.25);
    }

    .uv-notif-title {
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.3px;
        margin: 0;
    }

    .uv-notif-pill {
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.15);
        color: #00E676;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .uv-notif-tool-btn {
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .uv-notif-tool-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
    }

    .uv-notif-tabs {
        display: flex;
        gap: 6px;
        padding: 8px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(0, 0, 0, 0.15);
        overflow-x: auto;
        scrollbar-width: none;
    }

    .uv-notif-tabs::-webkit-scrollbar {
        display: none;
    }

    .uv-notif-tab {
        background: transparent;
        border: 1px solid transparent;
        color: #94a3b8;
        font-size: 11.5px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 9999px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .uv-notif-tab:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
    }

    .uv-notif-tab.active {
        background: rgba(16, 185, 129, 0.18);
        color: #00E676;
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
    }

    .uv-tab-badge {
        font-size: 9.5px;
        padding: 1px 5px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.08);
        color: #cbd5e1;
    }

    .uv-notif-tab.active .uv-tab-badge {
        background: rgba(16, 185, 129, 0.35);
        color: #6ee7b7;
    }

    .uv-notif-scroll {
        max-height: 340px;
        min-height: 180px;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(0, 230, 118, 0.2) transparent;
    }

    .uv-notif-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition: background 0.15s ease;
        position: relative;
    }

    .uv-notif-item:hover {
        background: rgba(255, 255, 255, 0.03);
    }

    .uv-notif-item.unread {
        background: rgba(16, 185, 129, 0.05);
        border-left: 2.5px solid #00E676;
    }

    .uv-notif-item.unread:hover {
        background: rgba(16, 185, 129, 0.09);
    }

    .uv-notif-icon-wrap {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 15px;
        margin-top: 2px;
        border: 1px solid transparent;
    }

    .uv-notif-body {
        flex: 1;
        min-width: 0;
    }

    .uv-notif-item-title {
        font-size: 12.5px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 3px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
    }

    .uv-notif-item-title .time {
        font-size: 10.5px;
        font-weight: 500;
        color: #64748b;
        font-family: var(--font-mono);
        white-space: nowrap;
    }

    .uv-notif-item-msg {
        font-size: 11.5px;
        color: #94a3b8;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .uv-notif-actions {
        display: flex;
        align-items: center;
        gap: 4px;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .uv-notif-item:hover .uv-notif-actions {
        opacity: 1;
    }

    .uv-notif-act-btn {
        background: rgba(255, 255, 255, 0.06);
        border: none;
        color: #94a3b8;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.15s;
    }

    .uv-notif-act-btn:hover {
        background: rgba(16, 185, 129, 0.2);
        color: #00E676;
    }

    .uv-notif-act-btn.delete:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #f87171;
    }

    .uv-notif-unread-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #00E676;
        box-shadow: 0 0 6px #00E676;
        flex-shrink: 0;
        align-self: center;
    }

    .uv-notif-empty {
        padding: 36px 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .uv-notif-empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #00E676;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 12px;
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.15);
    }

    .uv-notif-empty-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .uv-notif-empty-desc {
        font-size: 11.5px;
        color: #94a3b8;
        max-width: 250px;
        line-height: 1.4;
    }

    .uv-notif-footer {
        padding: 10px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .btn-new-request {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(90deg, #10B981 0%, #34D399 100%);
        color: #022c22;
        font-weight: 800;
        font-size: 13px;
        padding: 9px 20px;
        border-radius: 12px;
        text-decoration: none;
        border: none;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-new-request:hover {
        transform: translateY(-1px);
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.55);
        color: #022c22;
    }

    /* ─── Layout Grid (2 Columns on Desktop) ─── */
    .uv-dash-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 28px;
        align-items: start;
    }

    @@media (max-width: 1200px) {
        .uv-dash-grid { grid-template-columns: 1fr; }
    }

    /* ─── Welcome Header ─── */
    .uv-welcome-box {
        margin-bottom: 20px;
    }

    .uv-greeting-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: var(--emerald-400);
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.12);
    }

    .uv-welcome-title {
        font-family: var(--font-heading);
        font-size: clamp(1.9rem, 3.5vw, 2.5rem);
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        line-height: 1.15;
        margin-bottom: 6px;
    }

    .uv-name-gradient {
        background: linear-gradient(90deg, #34D399 0%, #6EE7B7 50%, #2DD4BF 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .uv-welcome-sub {
        font-size: 13.5px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ─── Action Chips (Quick filters / shortcuts) ─── */
    .uv-action-chips {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding-bottom: 4px;
    }

    .uv-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 12px;
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .uv-chip-primary {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: var(--accent-green);
        font-weight: 700;
        box-shadow: 0 0 12px rgba(0, 230, 118, 0.15);
    }

    .uv-chip-primary:hover {
        background: rgba(16, 185, 129, 0.25);
        color: #ffffff;
    }

    .uv-chip-glass {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
    }

    .uv-chip-glass:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    /* ─── 4 Bento Metric Cards ─── */
    .uv-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 30px;
    }

    @@media (max-width: 900px) {
        .uv-stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 480px) {
        .uv-stats-grid { grid-template-columns: 1fr; }
    }

    .uv-stat-card {
        background: rgba(10, 15, 12, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 18px 20px;
        backdrop-filter: blur(16px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .uv-stat-card:hover {
        border-color: rgba(16, 185, 129, 0.3);
        transform: translateY(-2px);
    }

    .uv-stat-card.active-card {
        border-color: rgba(0, 230, 118, 0.4);
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.12);
    }

    .uv-stat-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .uv-stat-label {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .uv-stat-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.7);
        font-size: 16px;
    }

    .uv-stat-value {
        font-family: var(--font-heading);
        font-size: 32px;
        font-weight: 900;
        color: #ffffff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }

    .uv-stat-trend {
        font-size: 11.5px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ─── Active Deliveries Section ─── */
    .uv-section-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .uv-section-title {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .uv-section-badge {
        background: var(--accent-green);
        color: #022c22;
        font-size: 11px;
        font-weight: 900;
        padding: 2px 8px;
        border-radius: 9999px;
    }

    .uv-view-all {
        color: var(--emerald-400);
        text-decoration: none;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform 0.2s;
    }

    .uv-view-all:hover {
        transform: translateX(2px);
    }

    .uv-active-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 30px;
    }

    @@media (max-width: 900px) {
        .uv-active-grid { grid-template-columns: 1fr; }
    }

    .uv-active-card {
        background: rgba(10, 15, 12, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 4px solid var(--accent-green);
        border-radius: 20px;
        padding: 20px;
        backdrop-filter: blur(16px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .uv-active-card.glow-card {
        border-color: rgba(0, 230, 118, 0.4);
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.12);
    }

    .uv-active-card:hover {
        border-color: rgba(16, 185, 129, 0.5);
        transform: translateY(-2px);
    }

    .uv-active-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .uv-status-pill {
        font-size: 11px;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .uv-status-pending {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #F59E0B;
    }

    .uv-status-transit {
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #A78BFA;
    }

    .uv-status-active {
        background: rgba(0, 230, 118, 0.15);
        border: 1px solid rgba(0, 230, 118, 0.3);
        color: #00E676;
    }

    .uv-pin-pill {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 11px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        padding: 3px 10px;
        border-radius: 9999px;
        color: #6EE7B7;
    }

    .uv-tip-val {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 14px;
        color: #34D399;
    }

    .uv-route-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 14px;
    }

    .uv-items-list {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .uv-card-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .uv-runner-profile {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .uv-runner-circle {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--accent-green);
        color: #022c22;
        font-weight: 800;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-track-live {
        font-size: 12px;
        font-weight: 700;
        color: var(--accent-green);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform 0.2s;
    }

    .btn-track-live:hover {
        transform: translateX(2px);
    }

    /* ─── Chart Bar Section ─── */
    .uv-charts-card {
        background: rgba(10, 15, 12, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 22px;
        backdrop-filter: blur(16px);
        margin-bottom: 30px;
    }

    .uv-chart-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .uv-chart-title {
        font-size: 16px;
