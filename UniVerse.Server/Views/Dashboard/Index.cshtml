<script>
    // ═══════════════════════════════════════════════════════════════════════════
    // UniVerse Notification Center (1:1 Port of NotificationList.tsx)
    // ═══════════════════════════════════════════════════════════════════════════
    (function () {
        let notifications = [];
        let unreadCount = 0;
        let currentFilter = "all";
        let soundEnabled = localStorage.getItem("universe_sound_enabled") !== "false";

        // Elements
        const bellBtn = document.getElementById("uvNotificationBellBtn");
        const panel = document.getElementById("uvNotificationPanel");
        const badge = document.getElementById("uvNotifBadge");
        const countSpan = document.getElementById("uvNotifCount");
        const headerCount = document.getElementById("uvNotifHeaderCount");
        const soundBtn = document.getElementById("uvNotifSoundBtn");
        const soundIcon = document.getElementById("uvNotifSoundIcon");
        const markAllReadBtn = document.getElementById("uvNotifMarkAllReadBtn");
        const clearBtn = document.getElementById("uvNotifClearBtn");
        const closeBtn = document.getElementById("uvNotifCloseBtn");
        const itemsContainer = document.getElementById("uvNotifItemsContainer");
        const tabs = document.querySelectorAll(".uv-notif-tab");

        // Tab count badges
        const countTabAll = document.getElementById("countTabAll");
        const countTabUnread = document.getElementById("countTabUnread");
        const countTabDelivery = document.getElementById("countTabDelivery");
        const countTabRequest = document.getElementById("countTabRequest");
        const countTabRunner = document.getElementById("countTabRunner");

        function updateSoundUI() {
            if (soundIcon) {
                soundIcon.className = soundEnabled ? "bi bi-volume-up text-success" : "bi bi-volume-mute text-secondary";
            }
        }
        updateSoundUI();

        // Synthesize pleasant campus chime via Web Audio API
        function playChime() {
            if (!soundEnabled) return;
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                const now = ctx.currentTime;

                const osc1 = ctx.createOscillator();
                const osc2 = ctx.createOscillator();
                const gain = ctx.createGain();

                osc1.type = "sine";
                osc1.frequency.setValueAtTime(587.33, now); // D5
                osc1.frequency.exponentialRampToValueAtTime(880, now + 0.12); // A5

                osc2.type = "triangle";
                osc2.frequency.setValueAtTime(880, now + 0.12);
                osc2.frequency.exponentialRampToValueAtTime(1174.66, now + 0.22); // D6

                gain.gain.setValueAtTime(0.08, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

                osc1.connect(gain);
                osc2.connect(gain);
                gain.connect(ctx.destination);

                osc1.start(now);
                osc2.start(now + 0.12);
                osc1.stop(now + 0.35);
                osc2.stop(now + 0.35);
            } catch (err) {
                // AudioContext autoplay restrictions handled safely
            }
        }

        // Categorize notification helper (matching original logic)
        function getCategory(notif) {
            const t = (notif.type || "").toLowerCase();
            const title = (notif.title || "").toLowerCase();
            if (t.includes("delivery") || t.includes("picked") || t.includes("transit") || t.includes("delivered")) {
                return "delivery";
            }
            if (t.includes("runner") || title.includes("runner")) {
                return "runner";
            }
            return "request";
        }

        function formatRelativeTime(dateStr) {
            try {
                const date = new Date(dateStr);
                const diffSec = Math.floor((new Date() - date) / 1000);
                if (diffSec < 60) return "just now";
                const diffMin = Math.floor(diffSec / 60);
                if (diffMin < 60) return diffMin + "m ago";
                const diffHour = Math.floor(diffMin / 60);
                if (diffHour < 24) return diffHour + "h ago";
                const diffDays = Math.floor(diffHour / 24);
                return diffDays + "d ago";
            } catch {
                return "recently";
            }
        }

        function getCategoryIconMeta(notif) {
            const t = (notif.type || "").toLowerCase();
            if (t.includes("delivered")) {
                return { icon: "bi-geo-alt-fill", color: "#10b981", bg: "rgba(16, 185, 129, 0.15)", border: "rgba(16, 185, 129, 0.3)" };
            }
            if (t.includes("cancelled")) {
                return { icon: "bi-exclamation-triangle-fill", color: "#f43f5e", bg: "rgba(244, 63, 94, 0.15)", border: "rgba(244, 63, 94, 0.3)" };
            }
            if (t.includes("transit") || t.includes("picked")) {
                return { icon: "bi-truck", color: "#06b6d4", bg: "rgba(6, 182, 212, 0.15)", border: "rgba(6, 182, 212, 0.3)" };
            }
            if (t.includes("accepted")) {
                return { icon: "bi-check-circle-fill", color: "#f59e0b", bg: "rgba(245, 158, 11, 0.15)", border: "rgba(245, 158, 11, 0.3)" };
            }
            if (t.includes("broadcast")) {
                return { icon: "bi-broadcast", color: "#00E676", bg: "rgba(0, 230, 118, 0.2)", border: "rgba(0, 230, 118, 0.4)" };
            }
            const cat = getCategory(notif);
            if (cat === "runner") {
                return { icon: "bi-bicycle", color: "#10b981", bg: "rgba(16, 185, 129, 0.15)", border: "rgba(16, 185, 129, 0.3)" };
            }
            if (cat === "delivery") {
                return { icon: "bi-box-seam", color: "#10b981", bg: "rgba(16, 185, 129, 0.15)", border: "rgba(16, 185, 129, 0.3)" };
            }
            return { icon: "bi-lightning-charge-fill", color: "#10b981", bg: "rgba(16, 185, 129, 0.15)", border: "rgba(16, 185, 129, 0.3)" };
        }

        function fetchNotifications(silent = false) {
            fetch("/api/notifications")
                .then(r => r.json())
                .then(data => {
                    if (data && data.success) {
                        const prevUnread = unreadCount;
                        notifications = data.notifications || [];
                        unreadCount = data.unreadCount || 0;

                        if (!silent && unreadCount > prevUnread) {
                            playChime();
                        }

                        updateCounts();
                        renderList();
                    }
                })
                .catch(err => {
                    console.error("Notifications fetch error:", err);
                });
        }

        function updateCounts() {
            // Bell badge
            if (unreadCount > 0) {
                badge.style.display = "flex";
                countSpan.innerText = unreadCount > 99 ? "99+" : unreadCount;
                headerCount.innerText = unreadCount + " new";
                headerCount.style.display = "inline-block";
            } else {
                badge.style.display = "none";
                headerCount.innerText = notifications.length + " total";
            }

            // Category counts
            let counts = { all: notifications.length, unread: unreadCount, delivery: 0, request: 0, runner: 0 };
            notifications.forEach(n => {
                const cat = getCategory(n);
                if (cat === "delivery") counts.delivery++;
                else if (cat === "runner") counts.runner++;
                else counts.request++;
            });

            if (countTabAll) countTabAll.innerText = counts.all;
            if (countTabUnread) countTabUnread.innerText = counts.unread;
            if (countTabDelivery) countTabDelivery.innerText = counts.delivery;
            if (countTabRequest) countTabRequest.innerText = counts.request;
            if (countTabRunner) countTabRunner.innerText = counts.runner;
        }

        function renderList() {
            if (!itemsContainer) return;

            const filtered = notifications.filter(n => {
                if (currentFilter === "all") return true;
                if (currentFilter === "unread") return !n.isRead;
                return getCategory(n) === currentFilter;
            });

            if (filtered.length === 0) {
                let emptyTitle = "All Quiet on Campus";
                let emptyDesc = "You're all caught up! Real-time alerts will chime in when campus delivery activity starts.";
                let btnText = "Explore Campus Hub";
                let btnLink = "/Dashboard";

                if (currentFilter === "unread") {
                    emptyTitle = "Zero Unread Alerts";
                    emptyDesc = "No pending notifications require your attention.";
                    btnText = "View All Notifications";
                    btnLink = null;
                } else if (currentFilter === "delivery") {
                    emptyTitle = "No Delivery Updates";
                    emptyDesc = "Active parcel pickups, runner transits, and deliveries will show up here.";
                    btnText = "Track Deliveries";
                    btnLink = "/Dashboard/Requests";
                } else if (currentFilter === "runner") {
                    emptyTitle = "No Runner Tasks";
                    emptyDesc = "Accept open delivery requests on campus to start earning reward points.";
                    btnText = "Open Runner Hub";
                    btnLink = "/Dashboard/Runner";
                } else if (currentFilter === "request") {
                    emptyTitle = "No Request Alerts";
                    emptyDesc = "Need something delivered or an errand run across campus?";
                    btnText = "Create a Request";
                    btnLink = "/Delivery/Create";
                }

                itemsContainer.innerHTML = `
                    <div class="uv-notif-empty">
                        <div class="uv-notif-empty-icon">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h4 class="uv-notif-empty-title">${emptyTitle}</h4>
                        <p class="uv-notif-empty-desc">${emptyDesc}</p>
                        ${btnLink 
                            ? `<a href="${btnLink}" class="btn-gradient-full" style="width: auto; padding: 7px 18px; font-size: 12px; margin-top: 14px; text-decoration: none;">${btnText} &rarr;</a>`
                            : `<button type="button" id="btnShowAllTab" class="btn-gradient-full" style="width: auto; padding: 7px 18px; font-size: 12px; margin-top: 14px;">${btnText} &rarr;</button>`
                        }
                    </div>
                `;

                const btnShowAllTab = document.getElementById("btnShowAllTab");
                if (btnShowAllTab) {
                    btnShowAllTab.addEventListener("click", () => {
                        setTab("all");
                    });
                }
                return;
            }

            let html = "";
            filtered.forEach(notif => {
                const meta = getCategoryIconMeta(notif);
                const isUnread = !notif.isRead;
                const timeText = formatRelativeTime(notif.createdAt);

                html += `
                    <div class="uv-notif-item ${isUnread ? "unread" : ""}" data-id="${notif.id}">
                        <div class="uv-notif-icon-wrap" style="color: ${meta.color}; background: ${meta.bg}; border-color: ${meta.border};">
                            <i class="bi ${meta.icon}"></i>
                        </div>
                        <div class="uv-notif-body">
                            <div class="uv-notif-item-title">
                                <span>${escapeHtml(notif.title)}</span>
                                <span class="time">${timeText}</span>
                            </div>
                            <div class="uv-notif-item-msg">${escapeHtml(notif.message)}</div>
                        </div>
                        <div class="uv-notif-actions">
                            ${isUnread ? `
                                <button type="button" class="uv-notif-act-btn mark-read" title="Mark as read" data-id="${notif.id}">
                                    <i class="bi bi-check"></i>
                                </button>
                            ` : ""}
                            <button type="button" class="uv-notif-act-btn delete" title="Delete notification" data-id="${notif.id}">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                        ${isUnread ? '<div class="uv-notif-unread-dot"></div>' : ""}
                    </div>
                `;
            });

            itemsContainer.innerHTML = html;

            // Wire card item click events
            itemsContainer.querySelectorAll(".uv-notif-item").forEach(el => {
                el.addEventListener("click", (e) => {
                    if (e.target.closest(".uv-notif-actions")) return;
                    const id = el.getAttribute("data-id");
                    const notif = notifications.find(n => n.id === id);
                    if (notif && !notif.isRead) {
                        markRead(id);
                    }
                    togglePanel(false);
                    if (notif && notif.referenceId) {
                        window.location.href = "/Dashboard/Requests";
                    }
                });
            });

            // Wire action buttons
            itemsContainer.querySelectorAll(".uv-notif-act-btn.mark-read").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const id = btn.getAttribute("data-id");
                    markRead(id);
                });
            });

            itemsContainer.querySelectorAll(".uv-notif-act-btn.delete").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const id = btn.getAttribute("data-id");
                    deleteNotif(id);
                });
            });
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        function markRead(id) {
            fetch(`/api/notifications/mark-read/${id}`, { method: "POST" })
                .then(r => r.json())
                .then(data => {
                    if (data && data.success) {
                        const n = notifications.find(item => item.id === id);
                        if (n) n.isRead = true;
                        unreadCount = data.unreadCount !== undefined ? data.unreadCount : Math.max(0, unreadCount - 1);
                        updateCounts();
                        renderList();
                    }
                });
        }

        function deleteNotif(id) {
            fetch(`/api/notifications/delete/${id}`, { method: "POST" })
                .then(r => r.json())
                .then(data => {
                    if (data && data.success) {
                        notifications = notifications.filter(item => item.id !== id);
                        if (data.unreadCount !== undefined) unreadCount = data.unreadCount;
                        updateCounts();
                        renderList();
                    }
                });
        }

        function setTab(filter) {
            currentFilter = filter;
            tabs.forEach(t => {
                if (t.getAttribute("data-filter") === filter) {
                    t.classList.add("active");
                } else {
                    t.classList.remove("active");
                }
            });
            renderList();
        }

        function togglePanel(forcedState) {
            const isOpen = forcedState !== undefined ? forcedState : !panel.classList.contains("active");
            if (isOpen) {
                panel.classList.add("active");
                bellBtn.classList.add("uv-bell-active");
                playChime();
                fetchNotifications(true);
            } else {
                panel.classList.remove("active");
                bellBtn.classList.remove("uv-bell-active");
            }
        }

        // Event listeners
        if (bellBtn) {
            bellBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                togglePanel();
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", () => {
                togglePanel(false);
            });
        }

        if (soundBtn) {
            soundBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                soundEnabled = !soundEnabled;
                localStorage.setItem("universe_sound_enabled", String(soundEnabled));
                updateSoundUI();
                if (soundEnabled) playChime();
            });
        }

        if (markAllReadBtn) {
            markAllReadBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                if (unreadCount === 0) return;
                fetch("/api/notifications/mark-all-read", { method: "POST" })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.success) {
                            notifications.forEach(n => n.isRead = true);
                            unreadCount = 0;
                            updateCounts();
                            renderList();
                        }
                    });
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                if (notifications.length === 0) return;
                fetch("/api/notifications/clear-all", { method: "POST" })
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.success) {
                            notifications = [];
                            unreadCount = 0;
                            updateCounts();
                            renderList();
                        }
                    });
            });
        }

        tabs.forEach(tab => {
            tab.addEventListener("click", () => {
                setTab(tab.getAttribute("data-filter"));
            });
        });

        // Close on click outside
        document.addEventListener("click", (e) => {
            if (panel && panel.classList.contains("active")) {
                if (!panel.contains(e.target) && !bellBtn.contains(e.target)) {
                    togglePanel(false);
                }
            }
        });

        // Close on Escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                togglePanel(false);
            }
        });

        // Initial fetch on page load
        fetchNotifications(true);

        // Periodic background poll every 25 seconds
        setInterval(() => {
            fetchNotifications(true);
        }, 25000);
    })();

    // Global showToast fallback helper
    window.showToast = function (msg) {
        const toast = document.createElement("div");
        toast.style.cssText = "position: fixed; bottom: 24px; right: 24px; background: rgba(10, 18, 14, 0.95); border: 1px solid rgba(16, 185, 129, 0.4); color: #fff; padding: 12px 20px; border-radius: 12px; font-size: 13px; z-index: 99999; box-shadow: 0 10px 30px rgba(0,0,0,0.8); backdrop-filter: blur(12px); display: flex; align-items: center; gap: 8px; animation: panelFadeIn 0.2s ease;";
        toast.innerHTML = '<i class="bi bi-info-circle text-success"></i><span>' + msg + '</span>';
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    };
</script>
