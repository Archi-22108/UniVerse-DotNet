            <a href="/Dashboard/Requests" class="uv-view-all">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.ActiveRequests != null && Model.ActiveRequests.Any())
        {
            <div class="uv-active-grid">
                @foreach (var req in Model.ActiveRequests)
                {
                    var isTransit = req.Status == "in_transit" || req.Status == "assigned";
                    var statusColor = isTransit ? "#8B5CF6" : "#00E676";
                    var statusLabel = isTransit ? "IN TRANSIT" : "PENDING";
                    var itemsSummary = req.Items != null && req.Items.Any()
                        ? string.Join(", ", req.Items.Select(i => $"{i.Name} (x{i.Quantity})"))
                        : "Campus Delivery Package";

                    <div class="uv-active-card glow-card" style="border-left-color: @statusColor;">
                        <div class="uv-active-head">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="uv-status-pill @(isTransit ? "uv-status-transit" : "uv-status-pending")">@statusLabel</span>
                                @if (!string.IsNullOrEmpty(req.DeliveryOtp))
                                {
                                    <span class="uv-pin-pill">🔐 PIN: @req.DeliveryOtp</span>
                                }
                            </div>
                            <div class="uv-tip-val">
                                ₹@req.DeliveryFee.ToString("F0") Tip
                            </div>
                        </div>

                        <div class="uv-route-info">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-geo-alt-fill text-warning"></i>
                                <span><b style="color: #fff;">From:</b> @req.PickupLocation</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-door-closed-fill text-success"></i>
                                <span><b style="color: #fff;">To:</b> @req.DropoffLocation</span>
                            </div>
                        </div>

                        <div class="uv-items-list">
                            <i class="bi bi-bag-check-fill text-success"></i>
                            <span>@itemsSummary</span>
                        </div>

                        <div class="uv-card-foot">
                            <div class="uv-runner-profile">
                                <div class="uv-runner-circle">R</div>
                                <span>Runner: <b style="color: #fff;">@(string.IsNullOrEmpty(req.RunnerName) ? "Finding Runner..." : req.RunnerName)</b></span>
                            </div>

                            <a href="/Delivery/Details/@req.Id" class="btn-track-live">
                                Track Live <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background: rgba(10, 15, 12, 0.4); border: 1px dashed rgba(255, 255, 255, 0.12); border-radius: 18px; padding: 36px 20px; text-align: center; margin-bottom: 24px;">
                <div style="width: 52px; height: 52px; border-radius: 16px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; color: var(--accent-green); font-size: 22px;">
