@model UniVerse.Server.Models.ViewModels.DeliveryCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Request • Campus Delivery Network";
    var runnerCount = (int)(ViewBag.RunnerCount ?? 0);
    var defaultHostel = Model.DropoffHostel ?? "Hostel D";
    var defaultRoom = Model.DropoffRoom ?? "304";
}

@section Styles {
<style>
    /* ─── Ambient 2D Glow & Cyber Dot Grid matching universe/src/app/request/new/page.tsx ─── */
    .uv-request-page-wrapper {
        position: relative;
        min-height: calc(100vh - 72px);
        background: #050805;
        overflow-x: hidden;
        padding: 24px 16px 64px 16px;
    }

    .uv-ambient-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        user-select: none;
    }

    .uv-glow-top {
        position: absolute;
        top: -120px;
        left: 50%;
        transform: translateX(-50%);
        width: 850px;
        height: 500px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0.05) 50%, rgba(0, 0, 0, 0) 70%);
        filter: blur(80px);
        border-radius: 50%;
    }

    .uv-glow-right {
        position: absolute;
        top: 35%;
        right: -5%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(5, 150, 105, 0.10) 0%, rgba(0, 0, 0, 0) 70%);
        filter: blur(80px);
        border-radius: 50%;
    }

    .uv-glow-left {
        position: absolute;
        bottom: -10%;
        left: -5%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(20, 184, 166, 0.10) 0%, rgba(0, 0, 0, 0) 70%);
        filter: blur(80px);
        border-radius: 50%;
    }

    .uv-dot-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(#10b981 1px, transparent 1px);
        background-size: 48px 48px;
        opacity: 0.04;
    }

    .uv-vignette {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, rgba(5, 8, 5, 0.4) 60%, #050805 100%);
    }

    /* ─── Main Container ─── */
    .uv-request-main {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
    }

    /* ─── Top Bar ─── */
    .uv-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .uv-btn-dashboard {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(10, 15, 12, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #A7B8B0;
        font-weight: 600;
        font-size: 13px;
        padding: 8px 14px;
        border-radius: 12px;
        text-decoration: none;
        backdrop-filter: blur(12px);
        transition: all 0.2s ease;
    }

    .uv-btn-dashboard:hover {
        background: rgba(16, 185, 129, 0.15);
        color: #ffffff;
        border-color: rgba(16, 185, 129, 0.3);
        transform: translateX(-2px);
    }

    .uv-brand-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .uv-brand-zap {
        background: #00E676;
        border-radius: 10px;
        padding: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.35);
    }

    .uv-brand-text {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
    }

    .uv-brand-text span {
        color: #00E676;
    }

    .uv-runners-pulse-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(10, 15, 12, 0.8);
        border: 1px solid rgba(16, 185, 129, 0.3);
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.18);
        padding: 7px 14px;
        border-radius: 12px;
        backdrop-filter: blur(12px);
    }

    .uv-pulse-dot {
        position: relative;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #00E676;
    }

    .uv-pulse-dot::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        background: #00E676;
        opacity: 0.6;
        animation: pulse-ring 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    }

    @@keyframes pulse-ring {
        0% { transform: scale(0.6); opacity: 0.8; }
        100% { transform: scale(2.2); opacity: 0; }
    }

    .uv-runners-text {
        color: #34d399;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.02em;
    }

    /* ─── Hero Header ─── */
    .uv-hero-header {
        text-align: center;
        margin-bottom: 28px;
        display: flex;
        flex-col;
        align-items: center;
    }

    .uv-hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #34d399;
        font-size: 11.5px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .uv-hero-title {
        font-size: 32px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
    }

    .uv-hero-title span {
        color: #00E676;
        text-shadow: 0 0 24px rgba(0, 230, 118, 0.4);
    }

    .uv-hero-desc {
        color: #A7B8B0;
        font-size: 14px;
        max-width: 440px;
        margin: 0 auto;
        line-height: 1.5;
    }

    /* ─── Dynamic Stepper Header ─── */
    .uv-stepper-wrap {
        width: 100%;
        max-width: 580px;
        margin: 0 auto 32px auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .uv-step-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 2;
    }

    .uv-step-circle {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 14px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .uv-step-btn.active .uv-step-circle {
        background: #00E676;
        color: #050805;
        border-color: #00E676;
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.45);
        transform: scale(1.08);
    }

    .uv-step-btn.completed .uv-step-circle {
        background: rgba(16, 185, 129, 0.2);
        color: #00E676;
        border-color: #00E676;
    }

    .uv-step-label {
        font-size: 11.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.4);
        transition: color 0.2s ease;
    }

    .uv-step-btn.active .uv-step-label {
        color: #ffffff;
    }

    .uv-step-divider {
        flex: 1;
        height: 2px;
        margin: 0 12px 20px 12px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        overflow: hidden;
        position: relative;
    }

    .uv-step-divider-fill {
        height: 100%;
        background: linear-gradient(90deg, #00E676, #34d399);
        width: 0%;
        transition: width 0.4s ease;
    }

    /* ─── Main Glassmorphic Form Card ─── */
    .uv-form-card {
        background: rgba(10, 15, 12, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 12px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 230, 118, 0.04);
        backdrop-filter: blur(24px);
        display: flex;
        flex-direction: column;
        gap: 28px;
        transition: all 0.2s ease;
    }

    .uv-step-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .uv-step-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00E676;
        font-size: 20px;
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.15);
        flex-shrink: 0;
    }

    .uv-step-title {
        font-size: 19px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .uv-step-desc {
        color: #A7B8B0;
        font-size: 13px;
        margin: 2px 0 0 0;
    }

    /* ─── Categories Desktop Grid & Mobile Horizontal Pills ─── */
    .uv-categories-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .uv-category-tile {
        height: 84px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 6px 4px;
        position: relative;
        overflow: hidden;
    }

    .uv-category-tile:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .uv-category-tile.active {
        background: rgba(16, 185, 129, 0.15);
        border-color: #00E676;
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.25);
        transform: translateY(-2px);
    }

    .uv-category-tile.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #00E676, transparent);
    }

    .uv-category-tile i {
        font-size: 20px;
        color: #A7B8B0;
        transition: color 0.2s ease;
    }

    .uv-category-tile.active i {
        color: #00E676;
    }

    .uv-category-tile span {
        font-size: 11px;
        font-weight: 600;
        color: #A7B8B0;
        text-align: center;
        line-height: 1.1;
    }

    .uv-category-tile.active span {
        color: #ffffff;
        font-weight: 700;
    }

    /* ─── Vending Machine Products Live Stock Grid ─── */
    .uv-vending-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 4px;
    }

    .uv-subfilter-btn {
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 11.5px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .uv-subfilter-btn:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.25);
    }

    .uv-subfilter-btn.active {
        background: rgba(0, 230, 118, 0.2);
        border-color: #00E676;
        color: #00E676;
        box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
        font-weight: 800;
    }

    .uv-search-box {
        position: relative;
        width: 230px;
    }

    .uv-search-box input {
        width: 100%;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 7px 12px 7px 32px;
        font-size: 12px;
        color: #ffffff;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .uv-search-box input:focus {
        border-color: #00E676;
    }

    .uv-search-box i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 13px;
        color: rgba(255, 255, 255, 0.4);
    }

    .uv-vending-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        max-height: 480px;
        overflow-y: auto;
        padding-right: 6px;
    }

    .uv-vending-grid::-webkit-scrollbar {
        width: 6px;
    }
    .uv-vending-grid::-webkit-scrollbar-thumb {
        background: rgba(16, 185, 129, 0.3);
        border-radius: 10px;
    }

    .uv-product-card {
        background: rgba(14, 22, 18, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .uv-product-card:hover {
        background: #132219;
        border-color: rgba(0, 230, 118, 0.6);
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.2);
        transform: translateY(-2px);
    }

    .uv-product-card.in-cart {
        background: #122319;
        border-color: #00E676;
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.25);
    }

    .uv-card-qty-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        background: #00E676;
        color: #050805;
        font-size: 10px;
        font-weight: 900;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        border: 2px solid #050805;
        z-index: 5;
    }

    .uv-prod-img-box {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: rgba(0, 0, 0, 0.4);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        margin-bottom: 8px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .uv-prod-img-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5));
        transition: transform 0.3s ease;
    }

    .uv-product-card:hover .uv-prod-img-box img {
        transform: scale(1.06);
    }

    .uv-slot-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        font-family: var(--font-mono, monospace);
        font-size: 9px;
        font-weight: 800;
        color: #00E676;
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .uv-prod-name {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.25;
        margin-bottom: 6px;
        min-height: 30px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .uv-prod-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 6px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .uv-prod-price {
        color: #00E676;
        font-weight: 800;
        font-size: 13.5px;
    }

    .uv-stepper-mini {
        display: flex;
        align-items: center;
        background: #00E676;
        color: #050805;
        border-radius: 8px;
        padding: 2px;
        box-shadow: 0 0 10px rgba(0, 230, 118, 0.35);
    }

    .uv-stepper-mini button {
        background: transparent;
        border: none;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #050805;
        font-weight: 900;
        font-size: 12px;
    }

    .uv-stepper-mini span {
        font-size: 11.5px;
        font-weight: 900;
        padding: 0 4px;
        min-width: 14px;
        text-align: center;
    }

    .uv-btn-add-mini {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #00E676;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .uv-btn-add-mini:hover {
        background: #00E676;
        color: #050805;
        border-color: #00E676;
    }

    /* ─── Popular Chips for Other Categories ─── */
    .uv-popular-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 220px;
        overflow-y: auto;
    }

    .uv-popular-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 6px 12px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .uv-popular-chip:hover {
        background: rgba(16, 185, 129, 0.15);
        border-color: rgba(16, 185, 129, 0.3);
        color: #00E676;
        transform: translateY(-1px);
    }

    .uv-chip-price {
        color: #34d399;
        font-weight: 800;
        font-size: 11px;
        background: rgba(16, 185, 129, 0.12);
        padding: 1px 6px;
        border-radius: 6px;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    /* ─── Custom Add Row ─── */
    .uv-custom-input-box {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 12px;
    }

    .uv-input-main {
        flex: 1;
        min-width: 160px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13.5px;
        color: #ffffff;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .uv-input-main:focus {
        border-color: #00E676;
        background: rgba(255, 255, 255, 0.06);
    }

    .uv-price-input-wrap {
        width: 120px;
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 6px 10px;
    }

    .uv-price-input-wrap span {
        color: #34d399;
        font-weight: 800;
        font-size: 13px;
        margin-right: 4px;
    }

    .uv-price-input-wrap input {
        width: 100%;
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 13px;
        outline: none;
    }

    .uv-qty-ctrls {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
    }

    .uv-qty-ctrls button {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .uv-qty-ctrls button:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

    .uv-qty-ctrls span {
        font-size: 13.5px;
        font-weight: 800;
        color: #ffffff;
        min-width: 24px;
        text-align: center;
    }

    .uv-btn-add-primary {
        background: #00E676;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 800;
        font-size: 13.5px;
        color: #050805;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.3);
        transition: all 0.2s ease;
    }

    .uv-btn-add-primary:hover {
        background: #34d399;
        transform: translateY(-1px);
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.45);
    }

    /* ─── Cart List ─── */
    .uv-cart-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 12px;
        max-height: 260px;
        overflow-y: auto;
    }

    .uv-cart-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 10px 14px;
    }

    .uv-cart-item-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .uv-cart-qty-pill {
        background: rgba(0, 230, 118, 0.15);
        color: #00E676;
        font-size: 11.5px;
        font-weight: 900;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .uv-cart-item-name {
        color: #ffffff;
        font-weight: 600;
        font-size: 13.5px;
    }

    .uv-cart-cat-badge {
        font-size: 11px;
        color: #A7B8B0;
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 6px;
        border-radius: 6px;
    }

    .uv-btn-trash {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        transition: color 0.2s ease;
        padding: 4px;
    }

    .uv-btn-trash:hover {
        color: #f87171;
    }

    /* ─── Step Actions ─── */
    .uv-btn-continue {
        width: 100%;
        background: linear-gradient(90deg, #00C853, #00E676);
        color: #050805;
        font-weight: 800;
        font-size: 15px;
        padding: 16px;
        border: none;
        border-radius: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 0 25px rgba(0, 230, 118, 0.35);
        transition: all 0.2s ease;
    }

    .uv-btn-continue:hover {
        box-shadow: 0 0 35px rgba(0, 230, 118, 0.5);
        transform: translateY(-1px);
    }

    .uv-btn-back-step {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .uv-btn-back-step:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    /* ─── Step 2 Option Grid & Buttons ─── */
    .uv-option-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .uv-option-tile {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 14px;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .uv-option-tile.active {
        background: rgba(16, 185, 129, 0.15);
        border-color: #00E676;
        box-shadow: 0 0 15px rgba(0, 230, 118, 0.2);
    }

    .uv-hostel-chips {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
    }

    .uv-hostel-chip {
        padding: 10px 6px;
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s ease;
    }

    .uv-hostel-chip.active {
        background: rgba(16, 185, 129, 0.2);
        border-color: #00E676;
        color: #00E676;
        font-weight: 800;
        box-shadow: 0 0 12px rgba(0, 230, 118, 0.25);
    }

    .uv-reward-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .uv-reward-chip {
        padding: 8px 14px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #A7B8B0;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .uv-reward-chip.active {
        background: rgba(0, 230, 118, 0.2);
        border-color: #00E676;
        color: #00E676;
        box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
        font-weight: 800;
    }

    /* ─── Step 3 Order Summary Glass Card ─── */
    .uv-summary-card {
        background: rgba(16, 185, 129, 0.04);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 18px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .uv-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13.5px;
    }

    .uv-summary-label {
        color: #A7B8B0;
        font-weight: 500;
    }

    .uv-summary-val {
        color: #ffffff;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .uv-categories-grid {
            grid-template-columns: repeat(4, 1fr);
        }
        .uv-vending-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .uv-hostel-chips {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
}

<div class="uv-request-page-wrapper">
    <!-- Ambient 2D Glow & Cyber Dot Grid -->
    <div class="uv-ambient-bg">
        <div class="uv-glow-top"></div>
        <div class="uv-glow-right"></div>
        <div class="uv-glow-left"></div>
        <div class="uv-dot-grid"></div>
        <div class="uv-vignette"></div>
    </div>

    <main class="uv-request-main">
        <!-- ── Top Bar ── -->
        <div class="uv-top-bar">
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/Dashboard" class="uv-btn-dashboard" title="Back to Dashboard">
                    <i class="bi bi-arrow-left"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/Dashboard" class="uv-brand-inline">
                    <div class="uv-brand-zap">
                        <i class="bi bi-lightning-charge-fill" style="color: #050805; font-size: 14px;"></i>
                    </div>
                    <span class="uv-brand-text">Uni<span>Verse</span></span>
                </a>
            </div>

            <div class="uv-runners-pulse-badge" title="@(runnerCount > 0 ? $"{runnerCount} verified student runners registered on campus" : "Campus delivery network online")">
                <span class="uv-pulse-dot"></span>
                <span class="uv-runners-text">
                    @(runnerCount > 0 ? $"{runnerCount} Runners Online" : "Campus Network Active")
                </span>
            </div>
        </div>

        <!-- ── Hero Header ── -->
        <div class="uv-hero-header">
            <div class="uv-hero-pill">
                <i class="bi bi-stars"></i>
                <span>Instant Campus Delivery Network</span>
            </div>
            <h1 class="uv-hero-title">
                Create <span>Request</span>
            </h1>
            <p class="uv-hero-desc">
                Tell us what you need — student runners will deliver it straight to your room.
            </p>
        </div>

        <!-- ── Stepper Navigation ── -->
        <div class="uv-stepper-wrap">
            <button type="button" class="uv-step-btn active" id="stepper1" onclick="goToStep(1)">
                <div class="uv-step-circle" id="circle1">1</div>
                <span class="uv-step-label">Item Details</span>
            </button>

            <div class="uv-step-divider">
                <div class="uv-step-divider-fill" id="divider1"></div>
            </div>

            <button type="button" class="uv-step-btn" id="stepper2" onclick="goToStep(2)">
                <div class="uv-step-circle" id="circle2">2</div>
                <span class="uv-step-label">Delivery & Reward</span>
            </button>

            <div class="uv-step-divider">
                <div class="uv-step-divider-fill" id="divider2"></div>
            </div>

            <button type="button" class="uv-step-btn" id="stepper3" onclick="goToStep(3)">
                <div class="uv-step-circle" id="circle3">3</div>
                <span class="uv-step-label">Confirm</span>
            </button>
        </div>

        <!-- Form Validation / Error Box -->
        <div id="clientErrorBox" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; padding: 14px 18px; color: #fca5a5; font-size: 13px; font-weight: 600; margin-bottom: 20px; align-items: center; gap: 10px;">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            <span id="clientErrorMsg"></span>
        </div>

        <!-- Actual POST Form -->
        <form id="deliveryPostForm" asp-controller="Delivery" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden inputs bound to backend model -->
            <input type="hidden" name="PickupLocation" id="hiddenPickupLocation" value="Hostel Vending Machine" />
            <input type="hidden" name="CustomPickupLocation" id="hiddenCustomPickup" value="" />
            <input type="hidden" name="DropoffLocation" id="hiddenDropoffLocation" value="@Model.DropoffLocation" />
            <input type="hidden" name="DropoffHostel" id="hiddenDropoffHostel" value="@defaultHostel" />
            <input type="hidden" name="DropoffRoom" id="hiddenDropoffRoom" value="@defaultRoom" />
            <input type="hidden" name="Urgency" id="hiddenUrgency" value="standard" />
            <input type="hidden" name="DeliveryFee" id="hiddenDeliveryFee" value="5" />
            <input type="hidden" name="EstimatedAmount" id="hiddenEstimatedAmount" value="0" />
            <input type="hidden" name="Instructions" id="hiddenInstructions" value="" />
            <input type="hidden" name="ItemsJson" id="hiddenItemsJson" value="[]" />

            <!-- ── Main Glassmorphic Form Card ── -->
            <div class="uv-form-card">

                <!-- ================= STEP 1: ITEM DETAILS ================= -->
                <div id="stepContainer1">
                    <div class="uv-step-header" style="margin-bottom: 20px;">
                        <div class="uv-step-icon-box">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <h2 class="uv-step-title">What do you need delivered?</h2>
                            <p class="uv-step-desc">Pick a category, tap quick campus favorites or type any custom item.</p>
                        </div>
                    </div>

                    <!-- 7 Category Selector Tiles -->
                    <div class="uv-categories-grid" style="margin-bottom: 22px;">
                        <div class="uv-category-tile active" data-cat="Vending Machine" onclick="selectCategory('Vending Machine', this)">
                            <i class="bi bi-shop"></i>
                            <span>Vending Machine</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Snack" onclick="selectCategory('Snack', this)">
                            <i class="bi bi-egg-fried"></i>
                            <span>Snack</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Beverage" onclick="selectCategory('Beverage', this)">
                            <i class="bi bi-cup-hot"></i>
                            <span>Beverage</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Meal" onclick="selectCategory('Meal', this)">
                            <i class="bi bi-basket"></i>
                            <span>Meal</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Grocery" onclick="selectCategory('Grocery', this)">
                            <i class="bi bi-bag"></i>
                            <span>Grocery</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Stationery" onclick="selectCategory('Stationery', this)">
                            <i class="bi bi-book"></i>
                            <span>Stationery</span>
                        </div>
                        <div class="uv-category-tile" data-cat="Medicine" onclick="selectCategory('Medicine', this)">
                            <i class="bi bi-capsule"></i>
                            <span>Medicine</span>
                        </div>
                    </div>

                    <!-- Vending Machine Section -->
                    <div id="vendingMachineSection" style="margin-bottom: 24px;">
                        <div class="uv-vending-header" style="margin-bottom: 14px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-stars" style="color: #00E676; font-size: 13px;"></i>
                                <span style="font-size: 12.5px; font-weight: 700; color: #A7B8B0;">
                                    Hostel Vending Live Stock:
                                </span>
                                <span style="background: rgba(0, 230, 118, 0.15); border: 1px solid rgba(0, 230, 118, 0.3); border-radius: 999px; padding: 2px 8px; font-size: 10px; font-weight: 800; color: #00E676;">
                                    • GF Machines
                                </span>
                            </div>

                            <div class="uv-search-box">
                                <i class="bi bi-search"></i>
                                <input type="text" id="vendingSearchInput" placeholder="Search 57 snacks & drinks..." oninput="filterVendingStock()" />
                            </div>
                        </div>

                        <!-- Sub-Category Filter Tabs -->
                        <div style="display: flex; gap: 6px; margin-bottom: 14px; overflow-x: auto; padding-bottom: 4px;">
                            <button type="button" class="uv-subfilter-btn active" onclick="filterVendingSub('All', this)">All (57)</button>
                            <button type="button" class="uv-subfilter-btn" onclick="filterVendingSub('Drinks', this)">🥤 Drinks (21)</button>
                            <button type="button" class="uv-subfilter-btn" onclick="filterVendingSub('Snacks', this)">🍿 Chips (19)</button>
                            <button type="button" class="uv-subfilter-btn" onclick="filterVendingSub('Sweets', this)">🍫 Chocolates (17)</button>
                        </div>

                        <!-- Products Live Grid -->
                        <div class="uv-vending-grid" id="vendingProductsGrid">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- Non-Vending Popular Chips Section (Shown when other category chosen) -->
                    <div id="otherCategoryChipsSection" style="display: none; margin-bottom: 24px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                            <i class="bi bi-stars" style="color: #00E676; font-size: 13px;"></i>
                            <span id="otherCatLabel" style="font-size: 12.5px; font-weight: 700; color: #A7B8B0;">Popular Items:</span>
                        </div>
                        <div class="uv-popular-chips-wrap" id="popularChipsContainer">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- Custom Add Input Box -->
                    <div style="margin-bottom: 24px;">
                        <div style="font-size: 12px; font-weight: 700; color: #A7B8B0; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-pencil-square" style="color: #00E676;"></i>
                            <span>Or Type Any Custom Campus Item:</span>
                        </div>
                        <div class="uv-custom-input-box">
                            <input type="text" id="customItemName" class="uv-input-main" placeholder="Type item name..." />
                            
                            <div class="uv-price-input-wrap">
                                <span>₹</span>
                                <input type="number" id="customItemPrice" placeholder="Est. price" min="0" />
                            </div>

                            <div class="uv-qty-ctrls">
                                <button type="button" onclick="adjustCustomQty(-1)">-</button>
                                <span id="customQtyLabel">1</span>
                                <button type="button" onclick="adjustCustomQty(1)">+</button>
                            </div>

                            <button type="button" class="uv-btn-add-primary" onclick="addCustomItem()">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>

                    <!-- Added Items Cart -->
                    <div style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #A7B8B0;">
                                Added Items (<span id="cartCountLabel">0</span>)
                            </span>
                            <button type="button" style="background: transparent; border: none; color: #A7B8B0; font-size: 12px; cursor: pointer;" onclick="clearAllItems()">
                                <i class="bi bi-trash"></i> Clear all
                            </button>
                        </div>

                        <div id="cartEmptyState" style="border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 16px; padding: 32px; text-align: center; background: rgba(0, 0, 0, 0.25);">
                            <i class="bi bi-box-seam" style="font-size: 26px; color: #00E676; opacity: 0.8;"></i>
                            <h4 style="font-size: 14px; font-weight: 700; color: #ffffff; margin: 8px 0 4px 0;">No items added yet</h4>
                            <p style="font-size: 12px; color: #A7B8B0; margin: 0;">Tap vending items above or type custom items and hit "Add".</p>
                        </div>

                        <div id="cartItemsList" class="uv-cart-container" style="display: none;">
                            <!-- Populated dynamically -->
                        </div>

                        <div id="cartTotalSummaryRow" style="display: none; justify-content: space-between; align-items: center; padding-top: 10px; margin-top: 6px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 13px;">
                            <span style="color: #A7B8B0;">Est. Items Total:</span>
                            <span style="color: #00E676; font-weight: 800; font-size: 15px;">₹<span id="cartEstTotalVal">0</span></span>
                        </div>
                    </div>

                    <!-- Step 1 Continue Button -->
                    <button type="button" class="uv-btn-continue" onclick="handleStep1Continue()">
                        <span>Continue to Delivery Details</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <!-- ================= STEP 2: LOGISTICS & REWARD ================= -->
                <div id="stepContainer2" style="display: none;">
                    <div class="uv-step-header" style="margin-bottom: 20px;">
                        <div class="uv-step-icon-box">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <h2 class="uv-step-title">Logistics & Runner Reward</h2>
                            <p class="uv-step-desc">Specify where to fetch your items and the reward for the student runner.</p>
                        </div>
                    </div>

                    <!-- Selected Items Mini Review Card -->
                    <div style="background: rgba(14, 22, 18, 0.95); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 16px; padding: 16px; margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="color: #00E676; font-size: 12px; font-weight: 800; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-box"></i> Selected Items (<span id="step2TotalItemCount">0</span> items)
                            </span>
                            <button type="button" style="background: transparent; border: none; color: #00E676; font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: underline;" onclick="goToStep(1)">
                                Edit Items
                            </button>
                        </div>
                        <div id="step2ItemsSummaryList" style="display: flex; flex-direction: column; gap: 6px; max-height: 140px; overflow-y: auto;">
                            <!-- Dynamically generated list -->
                        </div>
                        <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 10px; margin-top: 10px; font-size: 12px; color: #A7B8B0;">
                            <span>Items Est. Total: <strong style="color: #fff;" id="step2EstItemsTotal">₹0</strong></span>
                            <span>Min Runner Reward: <strong style="color: #00E676;" id="step2MinRewardFormula">₹5 × 1 = ₹5</strong></span>
                        </div>
                    </div>

                    <!-- Pickup Location -->
                    <div style="margin-bottom: 24px;">
                        <label style="color: #00E676; font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                            <i class="bi bi-pin-map"></i> Pickup Location
                        </label>
                        <div class="uv-option-grid" style="margin-bottom: 12px;">
                            <button type="button" class="uv-option-tile active" id="btnPickupVending" onclick="selectPickupLocation('Hostel Vending Machine', this)">
                                <strong style="color: #fff; font-size: 13px;">Hostel Vending Machine</strong>
                                <span style="color: #A7B8B0; font-size: 11.5px;">Ground floor instant machines (3-5 min delivery)</span>
                            </button>
                            <button type="button" class="uv-option-tile" id="btnPickupCustom" onclick="selectPickupLocation('Other (Custom Spot)', this)">
                                <strong style="color: #fff; font-size: 13px;">Other (Custom Spot)</strong>
                                <span style="color: #A7B8B0; font-size: 11.5px;">Canteen, stationery, Nescafe, campus gate</span>
                            </button>
                        </div>

                        <div id="vendingPerkBanner" style="display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 12px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #6ee7b7; font-size: 12px;">
                            <i class="bi bi-lightning-charge-fill" style="color: #00E676;"></i>
                            <span><strong>Hostel Vending Machine:</strong> Student runners in your hostel can dispense and deliver your items to your room in 3–5 minutes!</span>
                        </div>

                        <div id="customPickupInputRow" style="display: none; margin-top: 10px;">
                            <input type="text" id="customPickupField" class="uv-input-main" placeholder="Enter custom pickup spot (e.g. Marwadi Central Canteen, Nescafe near Library)..." oninput="updateCustomPickup(this.value)" />
                        </div>
                    </div>

                    <!-- Delivery Destination (Hostel + Room) -->
                    <div style="margin-bottom: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
                        <label style="color: #00E676; font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                            <i class="bi bi-building"></i> Delivery Destination (Hostel & Room)
                        </label>
                        <div class="uv-hostel-chips" style="margin-bottom: 12px;">
                            <button type="button" class="uv-hostel-chip @(defaultHostel == "Hostel A" ? "active" : "")" onclick="selectHostel('Hostel A', this)">Hostel A</button>
                            <button type="button" class="uv-hostel-chip @(defaultHostel == "Hostel B" ? "active" : "")" onclick="selectHostel('Hostel B', this)">Hostel B</button>
                            <button type="button" class="uv-hostel-chip @(defaultHostel == "Hostel C" ? "active" : "")" onclick="selectHostel('Hostel C', this)">Hostel C</button>
                            <button type="button" class="uv-hostel-chip @(defaultHostel == "Hostel D" ? "active" : "")" onclick="selectHostel('Hostel D', this)">Hostel D</button>
                            <button type="button" class="uv-hostel-chip @(defaultHostel == "Girls Hostel" ? "active" : "")" onclick="selectHostel('Girls Hostel', this)">Girls Hostel</button>
                        </div>

                        <input type="text" id="dropoffRoomInput" class="uv-input-main" value="@defaultRoom" placeholder="Room Number (e.g. 304, B-205)..." oninput="updateDropoffRoom(this.value)" />
                    </div>

                    <!-- Delivery Speed -->
                    <div style="margin-bottom: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
                        <label style="color: #00E676; font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                            <i class="bi bi-clock-history"></i> Delivery Speed & Priority
                        </label>
                        <div class="uv-option-grid">
                            <button type="button" class="uv-option-tile active" id="btnUrgencyStandard" onclick="selectUrgency('standard', this)">
                                <strong style="color: #34d399; font-size: 13px;">🟢 Standard Delivery</strong>
                                <span style="color: #A7B8B0; font-size: 11.5px;">Usually delivered within 30-45 minutes</span>
                            </button>
                            <button type="button" class="uv-option-tile" id="btnUrgencyUrgent" onclick="selectUrgency('urgent', this)">
                                <strong style="color: #fff; font-size: 13px;">⚡ Express Priority</strong>
                                <span style="color: #A7B8B0; font-size: 11.5px;">High runner priority for fast delivery</span>
                            </button>
                        </div>
                    </div>

                    <!-- Delivery Reward for Runner -->
                    <div style="margin-bottom: 28px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <label style="color: #00E676; font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-coin"></i> Delivery Reward for Runner
                            </label>
                            <span style="color: #34d399; font-size: 11px; font-weight: 700; background: rgba(16, 185, 129, 0.12); padding: 2px 8px; border-radius: 999px;">
                                ₹5 per item (Min ₹<span id="minRewardBadge">5</span>)
                            </span>
                        </div>
                        <p style="color: #A7B8B0; font-size: 12px; margin-bottom: 12px;">
                            The minimum reward is ₹5 per item. You can add extra tip to incentivize runners for fastest pickup.
                        </p>

                        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
                            <div class="uv-price-input-wrap" style="width: 140px; padding: 10px 14px;">
                                <span style="font-size: 18px; color: #00E676;">₹</span>
