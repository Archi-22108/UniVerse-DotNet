            if (step === 3 && !dropoffRoom.trim()) {
                showError("Please provide your room number before confirming.");
                return;
            }

            clearError();
            currentStep = step;

            document.getElementById("stepContainer1").style.display = step === 1 ? "block" : "none";
            document.getElementById("stepContainer2").style.display = step === 2 ? "block" : "none";
            document.getElementById("stepContainer3").style.display = step === 3 ? "block" : "none";

            document.getElementById("stepper1").className = "step-item " + (step === 1 ? "active" : "completed");
            document.getElementById("stepper2").className = "step-item " + (step === 2 ? "active" : (step > 2 ? "completed" : ""));
            document.getElementById("stepper3").className = "step-item " + (step === 3 ? "active" : "");

            document.getElementById("divider1").style.width = step >= 2 ? "100%" : "0%";
            document.getElementById("divider2").style.width = step === 3 ? "100%" : "0%";

            if (step === 2) {
                renderStep2Review();
                updateRewardPresets();
            } else if (step === 3) {
