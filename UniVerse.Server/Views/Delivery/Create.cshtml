            el.classList.add("active");
            renderVendingProducts();
        }

        function filterVendingStock() {
            vendingSearchQuery = document.getElementById("vendingSearchInput").value.trim().toLowerCase();
            renderVendingProducts();
        }

        function renderVendingProducts() {
            const grid = document.getElementById("vendingProductsGrid");
            grid.innerHTML = "";

            const filtered = VENDING_PRODUCTS.filter(p => {
                const matchesTab = vendingSubFilter === "All" || p.subType === vendingSubFilter;
                const matchesSearch = !vendingSearchQuery || p.name.toLowerCase().includes(vendingSearchQuery) || p.slot.toLowerCase().includes(vendingSearchQuery);
                return matchesTab && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `<div style="grid-column: 1 / -1; padding: 30px; text-align: center; color: rgba(255,255,255,0.4); font-size: 13px;">No vending products found matching "${vendingSearchQuery}".</div>`;
                return;
            }

            filtered.forEach(p => {
                const inCartItem = cartItems.find(it => it.name.toLowerCase() === p.name.toLowerCase());
                const qty = inCartItem ? inCartItem.quantity : 0;

                const card = document.createElement("div");
                card.className = "product-card" + (qty > 0 ? " in-cart" : "");
                card.onclick = () => {
                    if (qty === 0) addToCart(p.name, "Vending Machine", p.price, 1);
                };

                let stepperHtml = "";
                if (qty > 0) {
                    stepperHtml = `
                        <div class="product-stepper-pill" onclick="event.stopPropagation()">
                            <button type="button" onclick="adjustItemQty('${p.name}', -1)">-</button>
                            <span>${qty}</span>
                            <button type="button" onclick="adjustItemQty('${p.name}', 1)">+</button>
                        </div>
                    `;
                } else {
                    stepperHtml = `
                        <button type="button" class="btn-add-circle" title="Add ${p.name}">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    `;
                }

                card.innerHTML = `
                    ${qty > 0 ? `<div class="product-qty-bubble">${qty}</div>` : ""}
                    <div class="product-image-container">
                        <img src="${p.image}" alt="${p.name}" loading="lazy" />
                        <span class="product-slot-badge">${p.slot}</span>
                    </div>
                    <div class="product-title">${p.name}</div>
                    <div class="product-card-footer">
                        <span class="product-price-tag">₹${p.price}</span>
                        ${stepperHtml}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ── Popular Chips Render ──
        function renderPopularChips(category) {
            const container = document.getElementById("popularChipsContainer");
            container.innerHTML = "";
            const list = POPULAR_ITEMS[category] || [];

            list.forEach(item => {
                const chip = document.createElement("button");
                chip.type = "button";
                chip.className = "category-chip-btn";
                chip.onclick = () => addToCart(item.name, category, item.price, 1);
                chip.innerHTML = `
                    <i class="bi bi-plus-lg" style="color: var(--accent-green);"></i>
                    <span>${item.name}</span>
                    <span class="chip-badge-price">₹${item.price}</span>
                `;
                container.appendChild(chip);
            });
        }

        // ── Custom Add ──
        function adjustCustomQty(delta) {
            customItemQty = Math.max(1, customItemQty + delta);
            document.getElementById("customQtyLabel").innerText = customItemQty;
        }

        function addCustomItem() {
            const nameInput = document.getElementById("customItemName");
            const priceInput = document.getElementById("customItemPrice");
            const name = nameInput.value.trim();
            const price = priceInput.value ? Math.max(0, parseFloat(priceInput.value)) : 0;

            if (!name) {
                showError("Please enter an item name.");
                return;
            }

            addToCart(name, selectedCategory, price, customItemQty);
            nameInput.value = "";
            priceInput.value = "";
            customItemQty = 1;
            document.getElementById("customQtyLabel").innerText = "1";
            clearError();
        }

        // ── Cart Operations ──
        function addToCart(name, category, price, quantity) {
            const existing = cartItems.find(it => it.name.toLowerCase() === name.toLowerCase());
            if (existing) {
                existing.quantity += quantity;
            } else {
                cartItems.push({
                    id: Math.random().toString(36).substring(2, 9),
                    name: name,
                    category: category,
                    quantity: quantity,
                    estimatedPrice: price || 0
                });
            }
            updateCartUI();
            if (selectedCategory === "Vending Machine") renderVendingProducts();
        }

        function adjustItemQty(name, delta) {
            const idx = cartItems.findIndex(it => it.name.toLowerCase() === name.toLowerCase());
            if (idx === -1) return;

            cartItems[idx].quantity += delta;
            if (cartItems[idx].quantity <= 0) {
                cartItems.splice(idx, 1);
            }
            updateCartUI();
            if (selectedCategory === "Vending Machine") renderVendingProducts();
        }

        function removeCartItem(id) {
            cartItems = cartItems.filter(it => it.id !== id);
            updateCartUI();
            if (selectedCategory === "Vending Machine") renderVendingProducts();
        }

        function clearAllItems() {
            cartItems = [];
            updateCartUI();
            if (selectedCategory === "Vending Machine") renderVendingProducts();
        }

        function getTotalItemCount() {
            return cartItems.reduce((sum, it) => sum + it.quantity, 0);
        }

        function getMinRequiredReward() {
            const total = getTotalItemCount();
            return Math.max(5, total * 5);
        }

        function getEstItemsTotal() {
            return cartItems.reduce((sum, it) => sum + (it.estimatedPrice || 0) * it.quantity, 0);
        }

        function updateCartUI() {
            const count = cartItems.length;
            document.getElementById("cartCountLabel").innerText = count;

            const empty = document.getElementById("cartEmptyState");
            const list = document.getElementById("cartItemsList");
            const totalRow = document.getElementById("cartTotalSummaryRow");
            const estTotalVal = document.getElementById("cartEstTotalVal");

            if (count === 0) {
                empty.style.display = "block";
                list.style.display = "none";
                totalRow.style.display = "none";
            } else {
                empty.style.display = "none";
                list.style.display = "flex";
                totalRow.style.display = "flex";

                const estTotal = getEstItemsTotal();
                estTotalVal.innerText = estTotal;

                list.innerHTML = "";
                cartItems.forEach(item => {
                    const row = document.createElement("div");
                    row.className = "cart-row";
                    row.innerHTML = `
                        <div class="cart-info">
                            <span class="cart-qty-pill">${item.quantity}x</span>
                            <span class="cart-item-title">${item.name}</span>
                            <span class="cart-item-cat">${item.category}</span>
                            ${item.estimatedPrice > 0 ? `<span style="color: #34d399; font-size: 12px; font-weight: 700;">~₹${item.estimatedPrice * item.quantity}</span>` : ""}
                        </div>
                        <button type="button" class="btn-trash" style="background: transparent; border: none; color: rgba(255,255,255,0.4); cursor: pointer; padding: 4px;" onclick="removeCartItem('${item.id}')" title="Remove">
                            <i class="bi bi-trash"></i>
                        </button>
                    `;
                    list.appendChild(row);
                });
            }
        }

        // ── Step 2 Review & Options ──
        function renderStep2Review() {
            const totalCount = getTotalItemCount();
            const minReward = getMinRequiredReward();
            const estTotal = getEstItemsTotal();

            document.getElementById("step2TotalItemCount").innerText = totalCount;
            document.getElementById("step2EstItemsTotal").innerText = `~₹${estTotal}`;
            document.getElementById("step2MinRewardFormula").innerText = `₹5 × ${totalCount} = ₹${minReward}`;
            document.getElementById("minRewardBadge").innerText = minReward;

            const summaryList = document.getElementById("step2ItemsSummaryList");
            summaryList.innerHTML = "";

            cartItems.forEach(it => {
                const itemRow = document.createElement("div");
                itemRow.style.display = "flex";
                itemRow.style.justifyContent = "space-between";
                itemRow.style.alignItems = "center";
                itemRow.style.background = "rgba(0, 0, 0, 0.4)";
                itemRow.style.border = "1px solid rgba(255, 255, 255, 0.08)";
                itemRow.style.borderRadius = "10px";
                itemRow.style.padding = "6px 12px";
                itemRow.style.fontSize = "12px";

                itemRow.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="color: var(--accent-green); font-weight: 900; background: rgba(0, 230, 118, 0.15); padding: 1px 6px; border-radius: 4px;">${it.quantity}x</span>
                        <span style="color: #fff; font-weight: 600;">${it.name}</span>
                        <span style="color: rgba(255,255,255,0.4); font-size: 10px;">(${it.category})</span>
                    </div>
                    <span style="color: #34d399; font-weight: 700;">${it.estimatedPrice > 0 ? `~₹${it.estimatedPrice * it.quantity}` : "Custom"}</span>
                `;
                summaryList.appendChild(itemRow);
            });

            if (customReward < minReward) {
                customReward = minReward;
                document.getElementById("customRewardInput").value = minReward;
            }
        }

        function selectPickupLocation(loc, btn) {
            pickupLocation = loc;
            document.querySelectorAll(".option-button-card").forEach(el => {
                if (el.id === "btnPickupVending" || el.id === "btnPickupCustom") el.classList.remove("active");
            });
            btn.classList.add("active");

            const isVending = loc === "Hostel Vending Machine";
            document.getElementById("vendingPerkBanner").style.display = isVending ? "flex" : "none";
            document.getElementById("customPickupInputRow").style.display = isVending ? "none" : "block";
        }

        function updateCustomPickup(val) {
            customPickup = val;
        }

        function selectHostel(hostel, btn) {
            dropoffHostel = hostel;
            document.querySelectorAll(".hostel-btn-tile").forEach(el => el.classList.remove("active"));
            btn.classList.add("active");
        }

        function updateDropoffRoom(val) {
            dropoffRoom = val;
        }

        function selectUrgency(urg, btn) {
            deliverySpeed = urg;
            document.getElementById("btnUrgencyStandard").classList.remove("active");
            document.getElementById("btnUrgencyUrgent").classList.remove("active");
            btn.classList.add("active");
        }

        function updateRewardPresets() {
            const min = getMinRequiredReward();
            const wrap = document.getElementById("rewardPresetsWrap");
            wrap.innerHTML = "";

            const presets = [
                { label: `₹${min} (Min)`, val: min },
                { label: `₹${min + 5}`, val: min + 5 },
                { label: `₹${min + 10}`, val: min + 10 },
                { label: `₹${min + 20}`, val: min + 20 },
                { label: `₹${min + 35}`, val: min + 35 },
                { label: `₹${min + 50}`, val: min + 50 }
            ];

            presets.forEach(p => {
                const chip = document.createElement("button");
                chip.type = "button";
                chip.className = "reward-pill-btn" + (customReward === p.val ? " active" : "");
                chip.innerText = p.label;
                chip.onclick = () => {
                    customReward = p.val;
                    document.getElementById("customRewardInput").value = p.val;
                    updateRewardPresets();
                };
                wrap.appendChild(chip);
            });
        }

        function updateRewardVal(val) {
            const num = parseFloat(val) || getMinRequiredReward();
            customReward = num;
            updateRewardPresets();
        }

        function updateInstructions(val) {
            instructions = val;
        }

        // ── Step 3 Summary Render ──
        function renderStep3Summary() {
            const totalCount = getTotalItemCount();
            const estTotal = getEstItemsTotal();

            document.getElementById("sumTotalItemCount").innerText = `${totalCount} ${totalCount === 1 ? "item" : "items"}`;

            const listContainer = document.getElementById("sumItemsList");
            listContainer.innerHTML = "";
            cartItems.forEach(i => {
                const span = document.createElement("span");
                span.style.fontSize = "12.5px";
                span.style.color = "#fff";
                span.innerHTML = `<strong>${i.quantity}x</strong> ${i.name} <span style="color: var(--text-muted); font-size: 11px;">(${i.category})</span>`;
                listContainer.appendChild(span);
            });

            document.getElementById("sumPickupVal").innerText = pickupLocation === "Other (Custom Spot)" ? (customPickup || "Custom Spot") : pickupLocation;
            document.getElementById("sumDropoffVal").innerText = `${dropoffHostel}, Room ${dropoffRoom}`;
            document.getElementById("sumSpeedVal").innerText = deliverySpeed === "urgent" ? "⚡ Express Priority" : "🟢 Standard (~30-45m)";
            document.getElementById("sumEstItemsCost").innerText = `~₹${estTotal}`;
            document.getElementById("sumRewardVal").innerText = `₹${customReward}`;
        }

        // ── Final Submit Execution ──
        function submitFinalDeliveryRequest() {
            if (cartItems.length === 0) {
                showError("Your cart is empty. Please add items.");
                goToStep(1);
                return;
            }
            if (!dropoffRoom.trim()) {
                showError("Please enter your room number.");
                goToStep(2);
                return;
            }

            const minReq = getMinRequiredReward();
            if (customReward < minReq) {
                showError(`Minimum delivery reward is ₹${minReq} (₹5 per item).`);
                goToStep(2);
                return;
            }

            document.getElementById("hiddenPickupLocation").value = pickupLocation;
            document.getElementById("hiddenCustomPickup").value = customPickup;
            document.getElementById("hiddenDropoffHostel").value = dropoffHostel;
            document.getElementById("hiddenDropoffRoom").value = dropoffRoom;
            document.getElementById("hiddenDropoffLocation").value = `${dropoffHostel}, Room ${dropoffRoom}`;
            document.getElementById("hiddenUrgency").value = deliverySpeed;
            document.getElementById("hiddenDeliveryFee").value = customReward;
            document.getElementById("hiddenEstimatedAmount").value = getEstItemsTotal();
            document.getElementById("hiddenInstructions").value = instructions;
            document.getElementById("hiddenItemsJson").value = JSON.stringify(cartItems);

            const btn = document.getElementById("btnPublishRequest");
            const btnText = document.getElementById("btnPublishText");
            const btnIcon = document.getElementById("btnPublishIcon");
            btn.disabled = true;
            btn.style.opacity = "0.8";
            btnText.innerText = "Publishing Request to Campus...";
            btnIcon.className = "spinner-border spinner-border-sm text-dark";

            document.getElementById("deliveryPostForm").submit();
        }

        // ── Helpers ──
        function showError(msg) {
            const box = document.getElementById("clientErrorBox");
            const text = document.getElementById("clientErrorMsg");
            text.innerText = msg;
            box.style.display = "flex";
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        function clearError() {
            const box = document.getElementById("clientErrorBox");
            box.style.display = "none";
        }
    </script>
</body>
</html>
