        if (cat === "Vending Machine") {
            document.getElementById("vendingMachineSection").style.display = "block";
            document.getElementById("otherCategoryChipsSection").style.display = "none";
            renderVendingProducts();
        } else {
            document.getElementById("vendingMachineSection").style.display = "none";
            document.getElementById("otherCategoryChipsSection").style.display = "block";
            document.getElementById("otherCatLabel").innerText = `Popular ${cat} Items:`;
            renderPopularChips(cat);
        }
    }

    // ─── Vending Machine Render & Search ───
