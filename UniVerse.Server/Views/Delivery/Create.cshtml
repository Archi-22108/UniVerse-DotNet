    // ─── Stepper Logic ───
    function goToStep(step) {
        if (step === 2 && cartItems.length === 0) {
            showError("Please add at least one item before continuing.");
            return;
        }
        if (step === 3 && !dropoffRoom.trim()) {
            showError("Please provide your room number before confirming.");
            return;
        }

        clearError();
        currentStep = step;

        // Toggle Views
        document.getElementById("stepContainer1").style.display = step === 1 ? "block" : "none";
        document.getElementById("stepContainer2").style.display = step === 2 ? "block" : "none";
        document.getElementById("stepContainer3").style.display = step === 3 ? "block" : "none";

        // Update Stepper UI
        document.getElementById("stepper1").className = "uv-step-btn " + (step === 1 ? "active" : "completed");
        document.getElementById("stepper2").className = "uv-step-btn " + (step === 2 ? "active" : (step > 2 ? "completed" : ""));
