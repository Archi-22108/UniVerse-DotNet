@model UniVerse.Server.Models.ViewModels.DeliveryCreateViewModel
@{
    Layout = null;
    var runnerCount = (int)(ViewBag.RunnerCount ?? 0);
    var defaultHostel = Model.DropoffHostel ?? "Hostel D";
    var defaultRoom = Model.DropoffRoom ?? "304";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Create Request • UniVerse Campus Delivery Network</title>

    <!-- Google Fonts: Outfit & Plus Jakarta Sans (Exact match to universe/src/lib/fonts.ts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --font-heading: 'Outfit', sans-serif;
            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --color-bg: #050805;
            --accent-green: #00E676;
            --emerald-primary: #10B981;
            --emerald-hover: #00C853;
            --text-muted: #A7B8B0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--color-bg);
            color: #ffffff;
            font-family: var(--font-body);
            min-height: 100vh;
            min-height: 100dvh;
            position: relative;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Sleek 2D Ambient Glow Background (Matching universe/src/app/request/new/page.tsx lines 49-60) ── */
        .ambient-bg {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
            user-select: none;
        }

        .ambient-glow-top {
            position: absolute;
            top: -128px;
            left: 50%;
            transform: translateX(-50%);
            width: 850px;
            height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0.05) 50%, transparent 70%);
            filter: blur(80px);
            border-radius: 9999px;
        }

        .ambient-glow-right {
            position: absolute;
            top: 35%;
            right: -5%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(5, 150, 105, 0.10) 0%, transparent 70%);
            filter: blur(80px);
            border-radius: 9999px;
        }

        .ambient-glow-left {
            position: absolute;
            bottom: -10%;
            left: -5%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(20, 184, 166, 0.10) 0%, transparent 70%);
            filter: blur(80px);
            border-radius: 9999px;
        }

        .ambient-grid {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(#10b981 1px, transparent 1px);
            background-size: 48px 48px;
            opacity: 0.04;
        }

        .ambient-vignette {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 0%, rgba(5, 8, 5, 0.4) 60%, #050805 100%);
        }

        /* ── Container Layout ── */
        .request-page-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 896px; /* max-w-4xl */
            margin: 0 auto;
            padding: 24px 16px 64px 16px;
        }

        @@media (min-width: 640px) {
            .request-page-container {
                padding: 32px 24px 80px 24px;
            }
        }

        /* ── Top Bar (Matching page.tsx lines 64-116) ── */
        .request-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        @@media (min-width: 640px) {
            .request-top-bar {
                margin-bottom: 32px;
            }
        }

        .btn-back-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(10, 15, 12, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-muted);
            font-weight: 600;
            font-size: 13px;
            padding: 8px 14px;
            border-radius: 12px;
            text-decoration: none;
            backdrop-filter: blur(12px);
            transition: all 0.2s ease;
        }

        .btn-back-dashboard:hover {
            background: rgba(16, 185, 129, 0.15);
            color: #ffffff;
            border-color: rgba(16, 185, 129, 0.3);
            transform: translateX(-2px);
        }

        .brand-link {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: transform 0.2s;
        }

        .brand-link:hover {
            transform: scale(1.02);
        }

        .brand-zap-icon {
            background: var(--accent-green);
            border-radius: 12px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.35);
        }

        .brand-title {
            font-family: var(--font-heading);
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #ffffff;
        }

        .brand-title span {
            color: var(--accent-green);
        }

        .runners-pulse-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(10, 15, 12, 0.8);
            border: 1px solid rgba(16, 185, 129, 0.3);
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.18);
            padding: 7px 14px;
            border-radius: 12px;
            backdrop-filter: blur(12px);
            user-select: none;
        }

        .pulse-indicator {
            position: relative;
            display: flex;
            width: 8px;
            height: 8px;
        }

        .pulse-ping {
            position: absolute;
            display: inline-flex;
            width: 100%;
            height: 100%;
            border-radius: 9999px;
            background: var(--accent-green);
            opacity: 0.75;
            animation: pulse-ping-anim 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
        }

        .pulse-dot-core {
            position: relative;
            display: inline-flex;
            border-radius: 9999px;
            width: 8px;
            height: 8px;
            background: var(--accent-green);
        }

        @@keyframes pulse-ping-anim {
            75%, 100% {
                transform: scale(2.2);
                opacity: 0;
            }
        }

        .runners-text {
            color: #34d399;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 0.02em;
        }

        /* ── Centered Hero Header (Matching page.tsx lines 118-130) ── */
        .request-hero-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 24px;
        }

        @@media (min-width: 640px) {
            .request-hero-header {
                margin-bottom: 32px;
            }
        }

        .hero-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 9999px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: #34d399;
            font-size: 11.5px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .hero-title {
            font-family: var(--font-heading);
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
            letter-spacing: -0.02em;
            line-height: 1.15;
        }

        @@media (min-width: 640px) {
            .hero-title {
                font-size: 36px;
            }
        }

        .hero-title span {
            color: var(--accent-green);
            text-shadow: 0 0 20px rgba(0, 230, 118, 0.35);
        }

        .hero-subtitle {
            color: var(--text-muted);
            font-size: 13.5px;
            max-width: 440px;
            line-height: 1.5;
            padding: 0 8px;
        }

        /* ── Dynamic Stepper Header (Matching CreateRequestForm.tsx lines 565-683) ── */
        .stepper-container {
            width: 100%;
            max-width: 620px;
            margin: 0 auto 32px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: transparent;
            border: none;
            cursor: pointer;
            z-index: 2;
        }

        .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 14.5px;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .step-item.active .step-circle {
            background: var(--accent-green);
            color: #050805;
            border-color: var(--accent-green);
            box-shadow: 0 0 20px rgba(0, 230, 118, 0.4);
            transform: scale(1.06);
            outline: 4px solid rgba(0, 230, 118, 0.25);
        }

        .step-item.completed .step-circle {
            background: rgba(16, 185, 129, 0.2);
            color: var(--accent-green);
            border-color: var(--accent-green);
        }

        .step-label {
            font-size: 11.5px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.4);
            letter-spacing: 0.02em;
            transition: color 0.2s ease;
        }

        .step-item.active .step-label {
            color: #ffffff;
            font-weight: 700;
        }

        .stepper-line {
            flex: 1;
            height: 2px;
            margin: 0 12px 18px 12px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            overflow: hidden;
        }

        .stepper-line-progress {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-green), #34d399);
            width: 0%;
            transition: width 0.4s ease;
        }

        /* ── Main Glassmorphic Form Card (Matching CreateRequestForm.tsx lines 697-702) ── */
        .request-form-card {
            background: rgba(10, 15, 12, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 28px;
            padding: 24px;
            box-shadow: 0 12px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 230, 118, 0.04);
            backdrop-filter: blur(24px);
            display: flex;
            flex-direction: column;
            gap: 28px;
            transition: border-color 0.2s ease;
        }

        @@media (min-width: 640px) {
            .request-form-card {
                padding: 36px;
            }
        }

        .step-heading-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .step-icon-badge {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-green);
            font-size: 22px;
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.15);
            flex-shrink: 0;
        }

        .step-title {
            font-family: var(--font-heading);
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 2px;
            letter-spacing: -0.01em;
        }

        .step-desc {
            color: var(--text-muted);
            font-size: 13px;
        }

        /* ── Categories 7-Grid ── */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
        }

        .category-tile {
            height: 86px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 6px 4px;
            position: relative;
            overflow: hidden;
            user-select: none;
        }

        .category-tile:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .category-tile.active {
            background: rgba(16, 185, 129, 0.15);
            border-color: var(--accent-green);
            box-shadow: 0 0 20px rgba(0, 230, 118, 0.25);
            transform: scale(1.02);
        }

        .category-tile.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-green), transparent);
        }

        .category-tile i {
            font-size: 20px;
            color: var(--text-muted);
            transition: color 0.2s ease;
        }

        .category-tile.active i {
            color: var(--accent-green);
        }

        .category-tile span {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-align: center;
            line-height: 1.1;
        }

        .category-tile.active span {
            color: #ffffff;
            font-weight: 700;
        }

        /* ── Vending Stock Live Products Grid ── */
        .vending-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .vending-subfilter-btn {
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .vending-subfilter-btn:hover {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.25);
        }

        .vending-subfilter-btn.active {
            background: rgba(0, 230, 118, 0.2);
            border-color: var(--accent-green);
            color: var(--accent-green);
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
            font-weight: 800;
        }

        .vending-search-wrap {
            position: relative;
            width: 220px;
        }

        .vending-search-wrap input {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 7px 12px 7px 32px;
            font-size: 12px;
            color: #ffffff;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .vending-search-wrap input:focus {
            border-color: var(--accent-green);
        }

        .vending-search-wrap i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            color: rgba(255, 255, 255, 0.4);
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            max-height: 460px;
            overflow-y: auto;
            padding-right: 6px;
        }

        .products-grid::-webkit-scrollbar {
            width: 6px;
        }
        .products-grid::-webkit-scrollbar-thumb {
            background: rgba(16, 185, 129, 0.3);
            border-radius: 10px;
        }

        .product-card {
            background: rgba(14, 22, 18, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }

        .product-card:hover {
            background: #132219;
            border-color: rgba(0, 230, 118, 0.6);
            box-shadow: 0 0 20px rgba(0, 230, 118, 0.2);
            transform: translateY(-2px);
        }

        .product-card.in-cart {
            background: #122319;
            border-color: var(--accent-green);
            box-shadow: 0 0 20px rgba(0, 230, 118, 0.25);
        }

        .product-qty-bubble {
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--accent-green);
            color: #050805;
            font-size: 10px;
            font-weight: 900;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
            border: 2px solid #050805;
            z-index: 5;
        }

        .product-image-container {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            margin-bottom: 8px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .product-image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5));
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image-container img {
            transform: scale(1.06);
        }

        .product-slot-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            font-family: var(--font-mono);
            font-size: 9px;
            font-weight: 800;
            color: var(--accent-green);
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 4px;
            padding: 1px 4px;
        }

        .product-title {
            font-size: 12px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.25;
            margin-bottom: 6px;
            min-height: 30px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 6px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .product-price-tag {
            color: var(--accent-green);
            font-weight: 800;
            font-size: 13.5px;
        }

        .product-stepper-pill {
            display: flex;
            align-items: center;
            background: var(--accent-green);
            color: #050805;
            border-radius: 8px;
            padding: 2px;
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.35);
        }

        .product-stepper-pill button {
            background: transparent;
            border: none;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #050805;
            font-weight: 900;
            font-size: 12px;
        }

        .product-stepper-pill span {
            font-size: 11.5px;
            font-weight: 900;
            padding: 0 4px;
            min-width: 14px;
            text-align: center;
        }

        .btn-add-circle {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-add-circle:hover {
            background: var(--accent-green);
            color: #050805;
            border-color: var(--accent-green);
        }

        /* ── Popular Chips for other categories ── */
        .chips-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-height: 220px;
            overflow-y: auto;
        }

        .category-chip-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 6px 12px;
            color: rgba(255, 255, 255, 0.85);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .category-chip-btn:hover {
            background: rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.3);
            color: var(--accent-green);
            transform: translateY(-1px);
        }

        .chip-badge-price {
            color: #34d399;
            font-weight: 800;
            font-size: 11px;
            background: rgba(16, 185, 129, 0.12);
            padding: 1px 6px;
            border-radius: 6px;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        /* ── Custom Item Input Row ── */
        .custom-item-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 12px;
        }

        .input-text-standard {
            flex: 1;
            min-width: 160px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 13.5px;
            color: #ffffff;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .input-text-standard:focus {
            border-color: var(--accent-green);
            background: rgba(255, 255, 255, 0.06);
        }

        .price-badge-input {
            width: 120px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 6px 10px;
        }

        .price-badge-input span {
            color: #34d399;
            font-weight: 800;
            font-size: 13px;
            margin-right: 4px;
        }

        .price-badge-input input {
            width: 100%;
            background: transparent;
            border: none;
            color: #ffffff;
            font-size: 13px;
            outline: none;
        }

        .stepper-quantity-wrap {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            overflow: hidden;
        }

        .stepper-quantity-wrap button {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            padding: 8px 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .stepper-quantity-wrap button:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .stepper-quantity-wrap span {
            font-size: 13.5px;
            font-weight: 800;
            color: #ffffff;
            min-width: 24px;
            text-align: center;
        }

        .btn-add-primary {
            background: var(--accent-green);
            border: none;
            border-radius: 12px;
            padding: 10px 18px;
            font-weight: 800;
            font-size: 13.5px;
            color: #050805;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.3);
            transition: all 0.2s ease;
        }

        .btn-add-primary:hover {
            background: var(--emerald-hover);
            transform: translateY(-1px);
        }

        /* ── Cart List ── */
        .cart-list-box {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 12px;
            max-height: 260px;
            overflow-y: auto;
        }

        .cart-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 10px 14px;
        }

        .cart-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-qty-pill {
            background: rgba(0, 230, 118, 0.15);
            color: var(--accent-green);
            font-size: 11.5px;
            font-weight: 900;
            padding: 2px 8px;
            border-radius: 6px;
        }

        .cart-item-title {
            color: #ffffff;
            font-weight: 600;
            font-size: 13.5px;
        }

        .cart-item-cat {
            font-size: 11px;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 2px 6px;
            border-radius: 6px;
        }

        /* ── Buttons & Step Actions ── */
        .btn-continue-gradient {
            width: 100%;
            background: linear-gradient(90deg, #00C853, var(--accent-green));
            color: #050805;
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 15px;
            padding: 16px;
            border: none;
            border-radius: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 0 25px rgba(0, 230, 118, 0.35);
            transition: all 0.2s ease;
        }

        .btn-continue-gradient:hover {
            box-shadow: 0 0 35px rgba(0, 230, 118, 0.5);
            transform: translateY(-1px);
        }

        .btn-back-square {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .btn-back-square:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* ── Step 2 Logistics Tiles ── */
        .options-two-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .option-button-card {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            padding: 14px;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .option-button-card.active {
            background: rgba(16, 185, 129, 0.15);
            border-color: var(--accent-green);
            box-shadow: 0 0 15px rgba(0, 230, 118, 0.2);
        }

        .hostel-tiles-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        .hostel-btn-tile {
            padding: 10px 6px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
        }

        .hostel-btn-tile.active {
            background: rgba(16, 185, 129, 0.2);
            border-color: var(--accent-green);
            color: var(--accent-green);
            font-weight: 800;
            box-shadow: 0 0 12px rgba(0, 230, 118, 0.25);
        }

        .reward-pills-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .reward-pill-btn {
            padding: 8px 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-muted);
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .reward-pill-btn.active {
            background: rgba(0, 230, 118, 0.2);
            border-color: var(--accent-green);
            color: var(--accent-green);
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
            font-weight: 800;
        }

        /* ── Step 3 Order Summary Glass Card ── */
        .order-summary-box {
            background: rgba(16, 185, 129, 0.04);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-radius: 18px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .order-summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13.5px;
        }

        .summary-label-col {
            color: var(--text-muted);
            font-weight: 500;
        }

        .summary-value-col {
            color: #ffffff;
            font-weight: 700;
        }

        /* ── Mobile Responsive Overrides ── */
        @@media (max-width: 768px) {
            .categories-grid {
                grid-template-columns: repeat(4, 1fr);
            }
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .hostel-tiles-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .options-two-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ── Ambient 2D Glow & Cyber Dot Grid ── -->
    <div class="ambient-bg">
        <div class="ambient-glow-top"></div>
        <div class="ambient-glow-right"></div>
        <div class="ambient-glow-left"></div>
        <div class="ambient-grid"></div>
        <div class="ambient-vignette"></div>
    </div>

    <!-- ── Page Wrapper ── -->
    <div class="request-page-container">
        <!-- ── Top Bar ── -->
        <div class="request-top-bar">
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/Dashboard" class="btn-back-dashboard" title="Back to Dashboard">
                    <i class="bi bi-arrow-left"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/Dashboard" class="brand-link">
                    <div class="brand-zap-icon">
                        <i class="bi bi-lightning-charge-fill" style="color: #050805; font-size: 14px;"></i>
                    </div>
                    <span class="brand-title">Uni<span>Verse</span></span>
                </a>
            </div>

            <div class="runners-pulse-badge" title="@(runnerCount > 0 ? $"{runnerCount} verified student runners registered on campus" : "Campus delivery network online")">
                <span class="pulse-indicator">
                    <span class="pulse-ping"></span>
                    <span class="pulse-dot-core"></span>
                </span>
                <span class="runners-text">
                    @(runnerCount > 0 ? $"{runnerCount} Runners Online" : "Campus Network Active")
                </span>
            </div>
        </div>

        <!-- ── Hero Header ── -->
        <div class="request-hero-header">
            <div class="hero-pill-badge">
                <i class="bi bi-stars"></i>
                <span>Instant Campus Delivery Network</span>
            </div>
            <h1 class="hero-title">
                Create <span>Request</span>
            </h1>
            <p class="hero-subtitle">
                Tell us what you need — student runners will deliver it straight to your room.
            </p>
        </div>

        <!-- ── Dynamic Stepper Header ── -->
        <div class="stepper-container">
            <button type="button" class="step-item active" id="stepper1" onclick="goToStep(1)">
                <div class="step-circle" id="circle1">1</div>
                <span class="step-label">Item Details</span>
            </button>

            <div class="stepper-line">
                <div class="stepper-line-progress" id="divider1"></div>
            </div>

            <button type="button" class="step-item" id="stepper2" onclick="goToStep(2)">
                <div class="step-circle" id="circle2">2</div>
                <span class="step-label">Delivery & Reward</span>
            </button>

            <div class="stepper-line">
                <div class="stepper-line-progress" id="divider2"></div>
            </div>

            <button type="button" class="step-item" id="stepper3" onclick="goToStep(3)">
                <div class="step-circle" id="circle3">3</div>
                <span class="step-label">Confirm</span>
            </button>
        </div>

        <!-- Validation / Error Box -->
        <div id="clientErrorBox" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 16px; padding: 14px 18px; color: #fca5a5; font-size: 13px; font-weight: 600; margin-bottom: 20px; align-items: center; gap: 10px;">
            <i class="bi bi-exclamation-triangle-fill" style="color: #ef4444; font-size: 18px;"></i>
            <span id="clientErrorMsg"></span>
        </div>

        <!-- Main Form -->
        <form id="deliveryPostForm" asp-controller="Delivery" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden inputs bound to backend model -->
            <input type="hidden" name="PickupLocation" id="hiddenPickupLocation" value="Hostel Vending Machine" />
            <input type="hidden" name="CustomPickupLocation" id="hiddenCustomPickup" value="" />
            <input type="hidden" name="DropoffLocation" id="hiddenDropoffLocation" value="@Model.DropoffLocation" />
            <input type="hidden" name="DropoffHostel" id="hiddenDropoffHostel" value="@defaultHostel" />
            <input type="hidden" name="DropoffRoom" id="hiddenDropoffRoom" value="@defaultRoom" />
            <input type="hidden" name="Urgency" id="hiddenUrgency" value="standard" />
            <input type="hidden" name="DeliveryFee" id="hiddenDeliveryFee" value="5" />
            <input type="hidden" name="EstimatedAmount" id="hiddenEstimatedAmount" value="0" />
            <input type="hidden" name="Instructions" id="hiddenInstructions" value="" />
            <input type="hidden" name="ItemsJson" id="hiddenItemsJson" value="[]" />

            <!-- Main Glass Card -->
            <div class="request-form-card">

                <!-- ================= STEP 1: ITEM DETAILS ================= -->
                <div id="stepContainer1">
                    <div class="step-heading-row" style="margin-bottom: 20px;">
                        <div class="step-icon-badge">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <h2 class="step-title">What do you need delivered?</h2>
                            <p class="step-desc">Pick a category, tap quick campus favorites or type any custom item.</p>
                        </div>
                    </div>

                    <!-- 7 Category Selector Tiles -->
                    <div class="categories-grid" style="margin-bottom: 22px;">
                        <div class="category-tile active" data-cat="Vending Machine" onclick="selectCategory('Vending Machine', this)">
                            <i class="bi bi-shop"></i>
                            <span>Vending Machine</span>
                        </div>
                        <div class="category-tile" data-cat="Snack" onclick="selectCategory('Snack', this)">
                            <i class="bi bi-egg-fried"></i>
                            <span>Snack</span>
                        </div>
                        <div class="category-tile" data-cat="Beverage" onclick="selectCategory('Beverage', this)">
                            <i class="bi bi-cup-hot"></i>
                            <span>Beverage</span>
                        </div>
                        <div class="category-tile" data-cat="Meal" onclick="selectCategory('Meal', this)">
                            <i class="bi bi-basket"></i>
                            <span>Meal</span>
                        </div>
                        <div class="category-tile" data-cat="Grocery" onclick="selectCategory('Grocery', this)">
                            <i class="bi bi-bag"></i>
                            <span>Grocery</span>
                        </div>
                        <div class="category-tile" data-cat="Stationery" onclick="selectCategory('Stationery', this)">
                            <i class="bi bi-book"></i>
                            <span>Stationery</span>
                        </div>
                        <div class="category-tile" data-cat="Medicine" onclick="selectCategory('Medicine', this)">
                            <i class="bi bi-capsule"></i>
                            <span>Medicine</span>
                        </div>
                    </div>

                    <!-- Vending Machine Section -->
                    <div id="vendingMachineSection" style="margin-bottom: 24px;">
                        <div class="vending-header-row">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-stars" style="color: var(--accent-green); font-size: 13px;"></i>
                                <span style="font-size: 12.5px; font-weight: 700; color: var(--text-muted);">
                                    Hostel Vending Live Stock:
                                </span>
                                <span style="background: rgba(0, 230, 118, 0.15); border: 1px solid rgba(0, 230, 118, 0.3); border-radius: 9999px; padding: 2px 8px; font-size: 10px; font-weight: 800; color: var(--accent-green);">
                                    • GF Machines
                                </span>
                            </div>

                            <div class="vending-search-wrap">
                                <i class="bi bi-search"></i>
                                <input type="text" id="vendingSearchInput" placeholder="Search 57 snacks & drinks..." oninput="filterVendingStock()" />
                            </div>
                        </div>

                        <!-- Sub-Category Filter Tabs -->
                        <div style="display: flex; gap: 6px; margin-bottom: 14px; overflow-x: auto; padding-bottom: 4px;">
                            <button type="button" class="vending-subfilter-btn active" onclick="filterVendingSub('All', this)">All (57)</button>
                            <button type="button" class="vending-subfilter-btn" onclick="filterVendingSub('Drinks', this)">🥤 Drinks (21)</button>
                            <button type="button" class="vending-subfilter-btn" onclick="filterVendingSub('Snacks', this)">🍿 Chips (19)</button>
                            <button type="button" class="vending-subfilter-btn" onclick="filterVendingSub('Sweets', this)">🍫 Chocolates (17)</button>
                        </div>

                        <!-- Products Live Grid -->
                        <div class="products-grid" id="vendingProductsGrid">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- Non-Vending Popular Chips Section (Shown when other category chosen) -->
                    <div id="otherCategoryChipsSection" style="display: none; margin-bottom: 24px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                            <i class="bi bi-stars" style="color: var(--accent-green); font-size: 13px;"></i>
                            <span id="otherCatLabel" style="font-size: 12.5px; font-weight: 700; color: var(--text-muted);">Popular Items:</span>
                        </div>
                        <div class="chips-container" id="popularChipsContainer">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- Custom Add Input Box -->
                    <div style="margin-bottom: 24px;">
                        <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-pencil-square" style="color: var(--accent-green);"></i>
                            <span>Or Type Any Custom Campus Item:</span>
                        </div>
                        <div class="custom-item-row">
                            <input type="text" id="customItemName" class="input-text-standard" placeholder="Type item name..." />
                            
                            <div class="price-badge-input">
                                <span>₹</span>
                                <input type="number" id="customItemPrice" placeholder="Est. price" min="0" />
                            </div>

                            <div class="stepper-quantity-wrap">
                                <button type="button" onclick="adjustCustomQty(-1)">-</button>
                                <span id="customQtyLabel">1</span>
                                <button type="button" onclick="adjustCustomQty(1)">+</button>
                            </div>

                            <button type="button" class="btn-add-primary" onclick="addCustomItem()">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>

                    <!-- Added Items Cart -->
                    <div style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
                                Added Items (<span id="cartCountLabel">0</span>)
                            </span>
                            <button type="button" style="background: transparent; border: none; color: var(--text-muted); font-size: 12px; cursor: pointer;" onclick="clearAllItems()">
                                <i class="bi bi-trash"></i> Clear all
                            </button>
                        </div>

                        <div id="cartEmptyState" style="border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 16px; padding: 32px; text-align: center; background: rgba(0, 0, 0, 0.25);">
                            <i class="bi bi-box-seam" style="font-size: 26px; color: var(--accent-green); opacity: 0.8;"></i>
                            <h4 style="font-size: 14px; font-weight: 700; color: #ffffff; margin: 8px 0 4px 0;">No items added yet</h4>
                            <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Tap vending items above or type custom items and hit "Add".</p>
                        </div>

                        <div id="cartItemsList" class="cart-list-box" style="display: none;">
                            <!-- Populated dynamically -->
                        </div>

                        <div id="cartTotalSummaryRow" style="display: none; justify-content: space-between; align-items: center; padding-top: 10px; margin-top: 6px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 13px;">
                            <span style="color: var(--text-muted);">Est. Items Total:</span>
                            <span style="color: var(--accent-green); font-weight: 800; font-size: 15px;">₹<span id="cartEstTotalVal">0</span></span>
                        </div>
                    </div>

                    <!-- Step 1 Continue Button -->
                    <button type="button" class="btn-continue-gradient" onclick="handleStep1Continue()">
                        <span>Continue to Delivery Details</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <!-- ================= STEP 2: LOGISTICS & REWARD ================= -->
                <div id="stepContainer2" style="display: none;">
                    <div class="step-heading-row" style="margin-bottom: 20px;">
                        <div class="step-icon-badge">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <h2 class="step-title">Logistics & Runner Reward</h2>
                            <p class="step-desc">Specify where to fetch your items and the reward for the student runner.</p>
                        </div>
                    </div>

                    <!-- Selected Items Mini Review Card -->
                    <div style="background: rgba(14, 22, 18, 0.95); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 16px; padding: 16px; margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="color: var(--accent-green); font-size: 12px; font-weight: 800; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-box"></i> Selected Items (<span id="step2TotalItemCount">0</span> items)
                            </span>
                            <button type="button" style="background: transparent; border: none; color: var(--accent-green); font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: underline;" onclick="goToStep(1)">
                                Edit Items
                            </button>
                        </div>
                        <div id="step2ItemsSummaryList" style="display: flex; flex-direction: column; gap: 6px; max-height: 140px; overflow-y: auto;">
                            <!-- Dynamically generated list -->
                        </div>
                        <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 10px; margin-top: 10px; font-size: 12px; color: var(--text-muted);">
                            <span>Items Est. Total: <strong style="color: #fff;" id="step2EstItemsTotal">₹0</strong></span>
                            <span>Min Runner Reward: <strong style="color: var(--accent-green);" id="step2MinRewardFormula">₹5 × 1 = ₹5</strong></span>
                        </div>
                    </div>

                    <!-- Pickup Location -->
                    <div style="margin-bottom: 24px;">
                        <label style="color: var(--accent-green); font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                            <i class="bi bi-pin-map"></i> Pickup Location
                        </label>
                        <div class="options-two-grid" style="margin-bottom: 12px;">
                            <button type="button" class="option-button-card active" id="btnPickupVending" onclick="selectPickupLocation('Hostel Vending Machine', this)">
                                <strong style="color: #fff; font-size: 13px;">Hostel Vending Machine</strong>
                                <span style="color: var(--text-muted); font-size: 11.5px;">Ground floor instant machines (3-5 min delivery)</span>
                            </button>
                            <button type="button" class="option-button-card" id="btnPickupCustom" onclick="selectPickupLocation('Other (Custom Spot)', this)">
                                <strong style="color: #fff; font-size: 13px;">Other (Custom Spot)</strong>
                                <span style="color: var(--text-muted); font-size: 11.5px;">Canteen, stationery, Nescafe, campus gate</span>
                            </button>
                        </div>

                        <div id="vendingPerkBanner" style="display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 12px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #6ee7b7; font-size: 12px;">
                            <i class="bi bi-lightning-charge-fill" style="color: var(--accent-green);"></i>
                            <span><strong>Hostel Vending Machine:</strong> Student runners in your hostel can dispense and deliver your items to your room in 3–5 minutes!</span>
                        </div>

                        <div id="customPickupInputRow" style="display: none; margin-top: 10px;">
                            <input type="text" id="customPickupField" class="input-text-standard" placeholder="Enter custom pickup spot (e.g. Marwadi Central Canteen, Nescafe near Library)..." oninput="updateCustomPickup(this.value)" />
                        </div>
                    </div>

                    <!-- Delivery Destination (Hostel + Room) -->
                    <div style="margin-bottom: 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
                        <label style="color: var(--accent-green); font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
                            <i class="bi bi-building"></i> Delivery Destination (Hostel & Room)
                        </label>
                        <div class="hostel-tiles-grid" style="margin-bottom: 12px;">
                            <button type="button" class="hostel-btn-tile @(defaultHostel == "Hostel A" ? "active" : "")" onclick="selectHostel('Hostel A', this)">Hostel A</button>
                            <button type="button" class="hostel-btn-tile @(defaultHostel == "Hostel B" ? "active" : "")" onclick="selectHostel('Hostel B', this)">Hostel B</button>
                            <button type="button" class="hostel-btn-tile @(defaultHostel == "Hostel C" ? "active" : "")" onclick="selectHostel('Hostel C', this)">Hostel C</button>
                            <button type="button" class="hostel-btn-tile @(defaultHostel == "Hostel D" ? "active" : "")" onclick="selectHostel('Hostel D', this)">Hostel D</button>
