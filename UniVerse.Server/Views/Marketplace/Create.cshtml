@model UniVerse.Server.Models.ViewModels.MarketplaceCreateViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Post Used Campus Item · UniVerse Resale";
    ViewBag.ActivePage = "marketplace";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <a href="/Dashboard/Marketplace" class="btn btn-outline-light btn-sm" style="border-radius: 12px; background: rgba(255,255,255,0.05);">
                    &larr; Back to Marketplace
                </a>
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-1">
                    Free Peer-to-Peer Listing
                </span>
            </div>

            <div class="universe-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-tag-fill text-success fs-2"></i>
                    </div>
                    <h2 class="fw-bold text-white mb-1">Sell an Item on Campus</h2>
                    <p class="text-secondary small">List textbooks, electronics, cycle, or hostel essentials for fellow students</p>
                </div>

                <form asp-controller="Marketplace" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label text-secondary small fw-semibold">Item Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Introduction to Algorithms (CLRS 4th Ed.)" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Category & Condition -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label text-secondary small fw-semibold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Books">Books</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Study Notes">Study Notes</option>
                                <option value="Hostel Life">Hostel Life</option>
                                <option value="Sports">Sports</option>
                                <option value="Furniture">Furniture</option>
                                <option value="Clothing">Clothing</option>
                                <option value="Gaming">Gaming</option>
                                <option value="Other" selected>Other / Equipment</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Condition" class="form-label text-secondary small fw-semibold">Condition</label>
                            <select asp-for="Condition" class="form-select">
                                <option value="Brand New">Brand New</option>
                                <option value="Like New">Like New</option>
                                <option value="Good" selected>Good Condition</option>
                                <option value="Fair">Fair / Usable</option>
                            </select>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label text-secondary small fw-semibold">Selling Price (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary border-opacity-25 text-success fw-bold">₹</span>
                                <input asp-for="Price" class="form-control" type="number" step="10" placeholder="500" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OriginalPrice" class="form-label text-secondary small fw-semibold">Original Price / MRP (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary">₹</span>
                                <input asp-for="OriginalPrice" class="form-control" type="number" step="10" placeholder="Optional MRP (e.g. 1200)" />
                            </div>
                        </div>
                    </div>

                    <!-- Negotiable Toggle -->
                    <div class="form-check mb-3">
                        <input asp-for="Negotiable" class="form-check-input bg-dark border-secondary" type="checkbox" id="negCheck" />
                        <label class="form-check-label text-light small" for="negCheck">
                            Allow Price Negotiation / Counter Offers from buyers
                        </label>
                    </div>

                    <!-- Pickup Spot -->
                    <div class="mb-3">
                        <label asp-for="PickupLocation" class="form-label text-secondary small fw-semibold">Campus Meetup Location</label>
                        <input asp-for="PickupLocation" class="form-control" placeholder="e.g. Central Library Entrance, Hostel D Reception, or Lab 301" required />
                        <span asp-validation-for="PickupLocation" class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label text-secondary small fw-semibold">Image URL (Optional)</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/... (Direct link to image)" />
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label text-secondary small fw-semibold">Item Details & Condition Notes</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Highlight edition, included accessories, battery health, or reason for selling..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-emerald w-100 py-2 fs-6 mb-2">
                        Post Listing on Campus Marketplace
                    </button>
                    <a href="/Dashboard/Marketplace" class="btn btn-glass w-100 py-2 text-decoration-none text-center">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
