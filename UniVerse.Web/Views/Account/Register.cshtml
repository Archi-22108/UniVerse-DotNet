@model UniVerse.Web.Models.RegisterViewModel
@{
    Layout = null; // Immersive full-screen sci-fi auth layout matching screenshot
    ViewData["Title"] = "Create Account - UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Inter & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Three.js for 3D Gargantua Black Hole WebGL Accretion Disk Simulation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #020408 url('/images/login-bg.jpg') center center / cover no-repeat;
            background-attachment: fixed;
            color: #ffffff;
            font-family: 'Inter', -apple-system, sans-serif;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
        }

        /* ── WebGL Canvas Container ── */
        #blackHoleContainer {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* ── Sci-Fi HUD Coordinates ── */
        .hud-tl {
            position: fixed;
            top: 28px;
            left: 32px;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
            user-select: none;
        }

        .hud-tl .corner-bracket {
            position: absolute;
            top: -6px;
            left: -6px;
            width: 10px;
            height: 10px;
            border-left: 1px solid rgba(0, 210, 255, 0.75);
            border-top: 1px solid rgba(0, 210, 255, 0.75);
        }

        .hud-tr {
            position: fixed;
            top: 28px;
            right: 32px;
            text-align: right;
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            z-index: 10;
            user-select: none;
        }

        .hud-tr .corner-bracket {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 10px;
            height: 10px;
            border-right: 1px solid rgba(0, 210, 255, 0.75);
            border-top: 1px solid rgba(0, 210, 255, 0.75);
        }

        .hud-cyan {
            color: #00d2ff;
            font-weight: 700;
        }

        /* ── Center Registration Container ── */
        .auth-wrapper {
            position: relative;
            z-index: 5;
            width: 100%;
            max-width: 460px;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: all 1.1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .auth-wrapper.warping {
            transform: scale(0) rotate(-10deg);
            opacity: 0;
            filter: blur(14px);
            pointer-events: none;
            transition: all 0.35s cubic-bezier(0.7, 0, 0.84, 0);
        }

        /* ── Brand Header ── */
        .brand-link {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
            cursor: pointer;
        }

        .brand-header-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #00d2ff 0%, #0077ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.5);
            flex-shrink: 0;
        }

        .brand-title {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: #ffffff;
            line-height: 1;
        }

        .brand-tagline {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 3px;
            font-weight: 400;
            font-family: 'Space Mono', monospace;
            text-transform: uppercase;
        }

        /* ── Glass Auth Card ── */
        .sci-card {
            width: 100%;
            background: rgba(12, 14, 20, 0.48);
            backdrop-filter: blur(28px) saturate(140%);
            -webkit-backdrop-filter: blur(28px) saturate(140%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            padding: clamp(20px, 4.5vw, 32px);
            display: flex;
            flex-direction: column;
            gap: 16px;
            position: relative;
        }

        /* Top Accent Highlight Beam */
        .sci-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.7), transparent);
        }

        /* Card Header */
        .card-header-block {
            text-align: center;
        }

        .card-header-title {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 4px;
        }

        .card-header-title h1 {
            margin: 0;
            font-size: 21px;
            font-weight: 600;
            letter-spacing: 3px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .card-header-sub {
            margin: 4px 0 0;
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        /* Error Alert Box */
        .sci-error-banner {
            padding: 10px 14px;
            border-radius: 6px;
            background: rgba(255, 68, 68, 0.15);
            border: 1px solid rgba(255, 68, 68, 0.4);
            color: #ff8b8b;
            font-size: 11.5px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Form Fields */
        .field-unit {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .field-label {
            font-size: 10px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.65);
            text-transform: uppercase;
        }

        .input-shell {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 6px;
            transition: all 0.25s ease;
        }

        .input-shell:focus-within {
            border-color: #00d2ff;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.25), inset 0 0 10px rgba(0, 210, 255, 0.1);
        }

        .input-shell.has-error {
            border-color: rgba(255, 68, 68, 0.6);
            box-shadow: 0 0 15px rgba(255, 68, 68, 0.2);
        }

        .input-left-icon {
            position: absolute;
            left: 14px;
            display: flex;
            align-items: center;
            color: rgba(255, 255, 255, 0.45);
            pointer-events: none;
            transition: color 0.2s;
            font-size: 15px;
        }

        .input-shell:focus-within .input-left-icon {
            color: #00d2ff;
        }

        .sci-input {
            width: 100%;
            background: transparent !important;
            background-color: transparent !important;
            border: none !important;
            outline: none !important;
            color: #ffffff !important;
            font-size: 13.5px;
            padding: 12px 42px 12px 40px;
            font-family: 'Inter', sans-serif;
            caret-color: #00d2ff;
            color-scheme: dark;
        }

        .sci-input::placeholder {
            color: rgba(255, 255, 255, 0.25);
            font-size: 13px;
        }

        .sci-input:-webkit-autofill,
        .sci-input:-webkit-autofill:hover,
        .sci-input:-webkit-autofill:focus,
        .sci-input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px #020408 inset !important;
            box-shadow: 0 0 0 1000px #020408 inset !important;
            -webkit-text-fill-color: #ffffff !important;
            color: #ffffff !important;
            caret-color: #00d2ff !important;
            border-radius: 4px;
            transition: background-color 5000000s ease-in-out 0s;
        }

        .input-right-node {
            position: absolute;
            right: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            padding: 0;
            color: rgba(255, 255, 255, 0.45);
            transition: color 0.2s;
            font-size: 15px;
        }

        .action-icon-btn:hover {
            color: #00d2ff;
        }

        .validation-status-icon {
            color: #00d2ff;
            font-size: 16px;
            display: none;
        }

        .field-error-msg {
            font-size: 10.5px;
            color: #ff6b6b;
            font-family: 'Space Mono', monospace;
            letter-spacing: 0.5px;
            margin-top: 2px;
        }

        /* Gravitational Password Stability Bar */
        .stability-meter-track {
            width: 100%;
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 6px;
            display: none;
        }

        .stability-meter-fill {
            height: 100%;
            width: 0%;
            background: #ff4444;
            box-shadow: 0 0 10px #ff4444;
            transition: all 0.3s ease;
        }

        /* Checkbox Row */
        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-top: 2px;
        }

        .custom-checkbox {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            flex-shrink: 0;
            margin-top: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.15s ease;
            user-select: none;
        }

        .custom-checkbox.checked {
            background: #00d2ff;
            border-color: #00d2ff;
        }

        .custom-checkbox i {
            font-size: 11px;
            color: #000000;
            display: none;
            font-weight: 900;
        }

        .custom-checkbox.checked i {
            display: block;
        }

        .terms-text {
            font-size: 10.5px;
            color: rgba(255, 255, 255, 0.65);
            font-family: 'Space Mono', monospace;
            line-height: 1.4;
        }

        .terms-text a {
            color: #00d2ff;
            text-decoration: none;
        }

        .terms-text a:hover {
            text-decoration: underline;
        }

        /* Primary Submit Button */
        .scifi-btn {
            width: 100%;
            margin-top: 4px;
            padding: 13px 20px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 4px;
            color: #ffffff;
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
            font-size: 12.5px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            box-shadow: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            user-select: none;
        }

        .scifi-btn:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.25);
        }

        .scifi-btn:active {
            transform: scale(0.99);
        }

        .scifi-btn.warping {
            background: rgba(0, 210, 255, 0.2) !important;
            border: 1px solid #00d2ff !important;
            color: #00d2ff !important;
            box-shadow: 0 0 25px rgba(0, 210, 255, 0.5) !important;
        }

        /* OR Divider */
        .scifi-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 1px 0;
        }

        .scifi-divider::before, .scifi-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
        }

        .divider-text {
            font-size: 9.5px;
            color: rgba(255, 255, 255, 0.4);
            font-family: 'Space Mono', monospace;
            letter-spacing: 3px;
        }

        /* Google OAuth Button */
        .scifi-google-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 4px;
            padding: 11px 18px;
            color: #ffffff;
            font-size: 11.5px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .scifi-google-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 210, 255, 0.4);
        }

        /* Sign In Link */
        .signin-prompt {
            margin: 2px 0 0;
            text-align: center;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
            font-family: 'Space Mono', monospace;
            letter-spacing: 1px;
        }

        .signin-prompt a {
            color: #00d2ff;
            font-weight: 700;
            text-decoration: none;
        }

        .signin-prompt a:hover {
            text-decoration: underline;
        }

        /* Secure Connection Established */
        .secure-status {
            text-align: center;
            font-size: 9px;
            font-family: 'Space Mono', monospace;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 2px;
        }

        .secure-indicators {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-top: 6px;
        }

        .sec-pill {
            display: block;
            width: 14px;
            height: 2px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 1px;
        }

        .sec-pill.active {
            background: rgba(0, 210, 255, 0.85);
            box-shadow: 0 0 6px rgba(0, 210, 255, 0.6);
        }

        /* Trust Footer Bar */
        .trust-footer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-top: 16px;
            flex-wrap: wrap;
            opacity: 0.75;
            font-family: 'Space Mono', monospace;
            font-size: 9.5px;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.6);
        }

        @@media (max-width: 640px) {
            .hud-tl, .hud-tr {
                display: none;
            }
            .sci-card {
                padding: 20px 16px;
            }
        }
    </style>
</head>
<body>
    <!-- 3D WebGL Gargantua Black Hole Accretion Disk Canvas Container -->
    <div id="blackHoleContainer"></div>

    <!-- Top Left HUD -->
    <div class="hud-tl">
        <div class="corner-bracket"></div>
        <strong style="color: #ffffff;">EVENT HORIZON</strong><br />
        <span class="hud-cyan">GRAVITY: STABILIZED</span>
    </div>

    <!-- Top Right HUD -->
    <div class="hud-tr">
        <div class="corner-bracket"></div>
        <strong style="color: #ffffff;">SYSTEM STATUS</strong><br />
        <span class="hud-cyan">ONLINE // NOMINAL</span>
    </div>

    <!-- Main Auth Center Container -->
    <div class="auth-wrapper" id="authWrapper">
        <!-- Logo + Tagline -->
        <a asp-controller="Home" asp-action="Index" class="brand-link">
            <div class="brand-header-row">
                <div class="brand-icon-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="black" stroke="black" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                </div>
                <span class="brand-title">UniVerse</span>
            </div>
            <span class="brand-tagline">One Universe. Infinite Possibilities.</span>
        </a>

        <!-- Semi-Transparent Sci-Fi Glass Card -->
        <div class="sci-card">
            <!-- Card Header -->
            <div class="card-header-block">
                <div class="card-header-title">
                    <!-- Cyan 4-pointed Star -->
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2L13.5 9.5L21 11L13.5 12.5L12 20L10.5 12.5L3 11L10.5 9.5L12 2Z" fill="#00d2ff" />
                    </svg>
                    <h1>Create account</h1>
                </div>
                <p class="card-header-sub">Join UniVerse — exclusively for Marwadi University</p>
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="sci-error-banner">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <!-- Form -->
            <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate style="display: flex; flex-direction: column; gap: 14px;">
                @Html.AntiForgeryToken()

                <!-- Full Name Field -->
                <div class="field-unit">
                    <label class="field-label" for="FullName">Full Name</label>
                    <div class="input-shell" id="nameShell">
                        <span class="input-left-icon">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="FullName" id="fullNameInput" class="sci-input" placeholder="e.g. Avinash Kumar" autocomplete="name" required />
                    </div>
                    <span asp-validation-for="FullName" class="field-error-msg" id="nameError"></span>
                </div>

                <!-- University Email Field -->
                <div class="field-unit">
                    <label class="field-label" for="Email">University Email</label>
                    <div class="input-shell" id="emailShell">
                        <span class="input-left-icon">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" id="emailInput" class="sci-input" type="email" placeholder="you@marwadiuniversity.ac.in" autocomplete="email" required />
                        <div class="input-right-node">
                            <i class="bi bi-check-circle-fill validation-status-icon" id="emailCheckIcon"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Email" class="field-error-msg" id="emailError"></span>
                </div>

                <!-- Password Field -->
                <div class="field-unit">
                    <label class="field-label" for="Password">Password</label>
                    <div class="input-shell" id="pwShell">
                        <span class="input-left-icon">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" id="pwInput" class="sci-input" type="password" placeholder="Min. 8 characters" autocomplete="new-password" required />
                        <div class="input-right-node">
                            <button type="button" class="action-icon-btn" id="togglePwBtn" aria-label="Toggle Password Visibility">
                                <i class="bi bi-eye" id="togglePwIcon"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Gravitational Stability Meter -->
                    <div class="stability-meter-track" id="stabilityTrack">
                        <div class="stability-meter-fill" id="stabilityFill"></div>
                    </div>
                    <span asp-validation-for="Password" class="field-error-msg" id="pwError"></span>
                </div>

                <!-- Confirm Password Field -->
                <div class="field-unit">
                    <label class="field-label" for="ConfirmPassword">Confirm Password</label>
                    <div class="input-shell" id="cpwShell">
                        <span class="input-left-icon">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="ConfirmPassword" id="cpwInput" class="sci-input" type="password" placeholder="Re-enter your password" autocomplete="new-password" required />
                        <div class="input-right-node">
                            <i class="bi bi-check-circle-fill validation-status-icon" id="cpwCheckIcon"></i>
                            <button type="button" class="action-icon-btn" id="toggleCpwBtn" aria-label="Toggle Confirm Password Visibility">
                                <i class="bi bi-eye" id="toggleCpwIcon"></i>
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-error-msg" id="cpwError"></span>
                </div>

                <!-- Terms Checkbox -->
                <div class="terms-row">
                    <input type="checkbox" asp-for="AgreeTerms" id="agreeTermsInput" style="display: none;" />
                    <div class="custom-checkbox" id="customCheck">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <span class="terms-text" id="termsLabel">
                        I agree to the <a href="javascript:void(0)" onclick="openModal('terms')">Terms of Service</a> & <a href="javascript:void(0)" onclick="openModal('privacy')">Privacy Policy</a>
                    </span>
                </div>
                <span class="field-error-msg" id="termsError" style="display: none;">You must agree to the Terms & Privacy Policy to continue.</span>

                <!-- Submit Button -->
                <button type="submit" class="scifi-btn" id="submitBtn">
                    <span id="btnText">Create Account</span>
                    <i class="bi bi-arrow-right" id="btnArrow"></i>
                </button>
            </form>

            <!-- OR Divider -->
            <div class="scifi-divider">
                <span class="divider-text">OR</span>
            </div>

            <!-- Google OAuth Form -->
            <form asp-controller="Account" asp-action="GoogleRegister" method="post" id="googleForm">
                @Html.AntiForgeryToken()
                <button type="button" class="scifi-google-btn" id="googleBtn" onclick="triggerGoogleWarp()">
                    <svg viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                    <span>Continue with Google</span>
                </button>
            </form>

            <!-- Sign in link -->
            <p class="signin-prompt">
                Already have an account?
                <a asp-controller="Account" asp-action="Login">Sign in &gt;</a>
            </p>

            <!-- Secure Connection Established -->
            <div class="secure-status">
                SECURE CONNECTION ESTABLISHED
                <div class="secure-indicators">
                    <span class="sec-pill"></span>
                    <span class="sec-pill active"></span>
                    <span class="sec-pill"></span>
                </div>
            </div>
        </div>

        <!-- Trust Footer -->
        <div class="trust-footer">
            <span>256-BIT ENCRYPTED</span>
            <span>•</span>
            <span>YOUR DATA IS PRIVATE</span>
            <span>•</span>
            <span>TRUSTED BY STUDENTS</span>
        </div>
    </div>

    <!-- Client-Side Scripts: Three.js Black Hole & Form Logic -->
    <script>
        // ── 1. Three.js Gargantua Black Hole WebGL Accretion Disk Simulation ──
        (function initBlackHole() {
            const container = document.getElementById('blackHoleContainer');
            if (!container || typeof THREE === 'undefined') return;

            const VERTEX_SHADER = `
                varying vec2 vUv;
                void main() {
                    vUv = uv;
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                }
            `;

            const FRAGMENT_SHADER = `
                uniform float uTime;
                uniform float uStabilize;
                uniform float uAspect;
                uniform float uExposure;
                varying vec2 vUv;

                float random(vec2 st) {
                    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
                }

                float noise(vec2 st) {
                    vec2 i = floor(st);
                    vec2 f = fract(st);
                    float a = random(i); float b = random(i + vec2(1.0, 0.0));
                    float c = random(i + vec2(0.0, 1.0)); float d = random(i + vec2(1.0, 1.0));
                    vec2 u = f * f * (3.0 - 2.0 * f);
                    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
                }

                float fbm(vec2 st) {
                    float v = 0.0; float a = 0.5; vec2 shift = vec2(100.0);
                    mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
                    for (int i = 0; i < 5; ++i) {
                        v += a * noise(st); st = rot * st * 2.0 + shift; a *= 0.5;
                    }
                    return v;
                }

                void main() {
                    vec2 uv = vUv - 0.5;
                    uv.x *= uAspect;

                    float chaos = 1.0 - uStabilize;
                    float rBase = length(uv);

                    float twist = chaos * 15.0 * exp(-rBase * 6.0);
                    float angle = atan(uv.y, uv.x) + twist;

                    vec2 p = vec2(cos(angle), sin(angle)) * rBase;
                    float pr = length(p);

                    float horizon = 0.15;
                    float isVoid = smoothstep(horizon - 0.005, horizon + 0.005, pr);

                    float haloRadius = horizon * 1.5;
                    float haloThickness = abs(pr - haloRadius);
                    float pinch = smoothstep(0.0, 0.15, abs(p.y));

                    float halo = exp(-haloThickness * 40.0) * pinch;
                    halo += exp(-haloThickness * 10.0) * 0.4 * pinch;

                    float diskY = abs(p.y);
                    float diskX = abs(p.x);

                    float innerEllipse = length(vec2(p.x, p.y * 5.0));
                    float diskCutout = smoothstep(horizon * 1.1, horizon * 1.4, innerEllipse);

                    float frontDisk = exp(-diskY * 80.0) * diskCutout;
                    frontDisk += exp(-diskY * 15.0) * 0.5 * diskCutout;
                    frontDisk *= smoothstep(1.3, 0.3, diskX);

                    vec2 polar = vec2(atan(p.y, p.x), pr);
                    float nHalo = fbm(vec2(polar.x * 4.0 - uTime * 0.1, pr * 50.0));
                    halo *= (nHalo * 0.7 + 0.3);

                    float nDisk = fbm(vec2(p.x * 10.0 - uTime * 0.4, p.y * 100.0));
                    frontDisk *= (nDisk * 0.8 + 0.2);

                    float density = (halo * isVoid) + frontDisk;

                    float nebula = fbm(p * 3.0 + uTime * 0.02) * 0.1;
                    nebula *= smoothstep(0.0, 0.6, pr);
                    density += nebula;

                    vec3 cDark = vec3(0.18, 0.05, 0.01);
                    vec3 cMid = vec3(1.0, 0.45, 0.15);
                    vec3 cLight = vec3(1.0, 0.95, 0.9);

                    vec3 color = mix(vec3(0.0), cDark, smoothstep(0.0, 0.15, density));
                    color = mix(color, cMid, smoothstep(0.15, 0.4, density));
                    color = mix(color, cLight, smoothstep(0.4, 1.0, density));

                    float doppler = 1.0 - p.x * 0.6;
                    color *= mix(1.0, doppler, smoothstep(0.0, 1.0, pr * 2.0));

                    vec2 starPos = p * 150.0;
                    float starGrid = random(floor(starPos));
                    float starShape = smoothstep(0.4, 0.0, length(fract(starPos) - 0.5));
                    float lensedStars = smoothstep(0.98, 1.0, starGrid) * starShape;
                    lensedStars *= smoothstep(horizon * 1.05, horizon * 1.5, pr);
                    lensedStars *= smoothstep(0.4, 0.0, density);

                    vec3 starColor = mix(vec3(0.5, 0.8, 1.0), vec3(1.0, 0.7, 0.4), random(floor(starPos) + 1.0));
                    color += starColor * lensedStars * 3.0 * isVoid;

                    color *= isVoid;
                    color *= 1.35 * uExposure;

                    float alphaMask = smoothstep(1.0, 0.4, pr);
                    alphaMask = max(alphaMask, smoothstep(0.1, 0.5, density));

                    gl_FragColor = vec4(color, alphaMask);
                }
            `;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 4.0;

            const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
            container.appendChild(renderer.domElement);

            const uniforms = {
                uTime: { value: 0.0 },
                uStabilize: { value: 1.0 },
                uAspect: { value: window.innerWidth / window.innerHeight },
                uExposure: { value: 1.1 }
            };

            const portalGeo = new THREE.PlaneGeometry(12, 12);
            const portalMat = new THREE.ShaderMaterial({
                vertexShader: VERTEX_SHADER,
                fragmentShader: FRAGMENT_SHADER,
                uniforms: uniforms,
                transparent: true,
                depthWrite: false
            });
            const portal = new THREE.Mesh(portalGeo, portalMat);
            scene.add(portal);

            // Stars
            const starsCount = window.innerWidth < 768 ? 1200 : 2500;
            const starsGeo = new THREE.BufferGeometry();
            const posArray = new Float32Array(starsCount * 3);
            for (let i = 0; i < starsCount * 3; i += 3) {
                posArray[i] = (Math.random() - 0.5) * 30;
                posArray[i + 1] = (Math.random() - 0.5) * 30;
                posArray[i + 2] = (Math.random() - 0.5) * 20;
            }
            starsGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const starsMat = new THREE.PointsMaterial({
                size: 0.045,
                color: 0xffffff,
                transparent: true,
                opacity: 0.7,
                blending: THREE.AdditiveBlending
            });
            const starMesh = new THREE.Points(starsGeo, starsMat);
            scene.add(starMesh);

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
                uniforms.uAspect.value = window.innerWidth / window.innerHeight;
            });

            let isWarpingState = false;
            let warpProgress = 0;
            let lastTime = performance.now();

            window.triggerThreeJsWarp = function() {
                isWarpingState = true;
            };

            function animate() {
                requestAnimationFrame(animate);
                const now = performance.now();
                const delta = Math.min((now - lastTime) / 1000, 0.1);
                lastTime = now;

                if (isWarpingState) {
                    warpProgress += delta * 4.0;
                    const ease = Math.min(1.0, Math.pow(warpProgress, 1.4));
                    uniforms.uTime.value += delta * (1.0 + ease * 12.0);
                    uniforms.uStabilize.value = 1.0 - ease * 2.0;
                    uniforms.uExposure.value = 1.1 + ease * 2.5;
                    camera.position.z = 4.0 - ease * 12.0;
                } else {
                    uniforms.uTime.value += delta * 0.8;
                }

                renderer.render(scene, camera);
            }
            animate();
        })();

        // ── 2. Form Interactions, Real-Time Validation & Stability Meter ──
        const fullNameInput = document.getElementById('fullNameInput');
        const emailInput = document.getElementById('emailInput');
        const emailCheckIcon = document.getElementById('emailCheckIcon');
        const pwInput = document.getElementById('pwInput');
        const cpwInput = document.getElementById('cpwInput');
        const cpwCheckIcon = document.getElementById('cpwCheckIcon');
        const stabilityTrack = document.getElementById('stabilityTrack');
        const stabilityFill = document.getElementById('stabilityFill');
        const customCheck = document.getElementById('customCheck');
        const agreeTermsInput = document.getElementById('agreeTermsInput');
        const termsLabel = document.getElementById('termsLabel');
        const termsError = document.getElementById('termsError');
        const registerForm = document.getElementById('registerForm');
        const authWrapper = document.getElementById('authWrapper');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnArrow = document.getElementById('btnArrow');

        // Email validation indicator
        const emailRegex = /^[a-zA-Z0-9._%+-]+@@marwadiuniversity\.ac\.in$/i;
        emailInput.addEventListener('input', () => {
            if (emailRegex.test(emailInput.value.trim())) {
                emailCheckIcon.style.display = 'block';
            } else {
                emailCheckIcon.style.display = 'none';
            }
        });

        // Password Show/Hide Toggle
        const togglePwBtn = document.getElementById('togglePwBtn');
        const togglePwIcon = document.getElementById('togglePwIcon');
        togglePwBtn.addEventListener('click', () => {
            if (pwInput.type === 'password') {
                pwInput.type = 'text';
                togglePwIcon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                pwInput.type = 'password';
                togglePwIcon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });

        const toggleCpwBtn = document.getElementById('toggleCpwBtn');
        const toggleCpwIcon = document.getElementById('toggleCpwIcon');
        toggleCpwBtn.addEventListener('click', () => {
            if (cpwInput.type === 'password') {
                cpwInput.type = 'text';
                toggleCpwIcon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                cpwInput.type = 'password';
                toggleCpwIcon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });

        // Gravitational Password Stability calculation
        pwInput.addEventListener('input', () => {
            const val = pwInput.value;
            if (val.length > 0) {
                stabilityTrack.style.display = 'block';
                let score = Math.min(100, (val.length * 8) + (/[A-Z]/.test(val) ? 15 : 0) + (/[0-9]/.test(val) ? 15 : 0) + (/[^A-Za-z0-9]/.test(val) ? 20 : 0));
                stabilityFill.style.width = score + '%';
                let color = score < 40 ? '#ff4444' : score < 75 ? '#ff8c42' : '#00d2ff';
                stabilityFill.style.background = color;
                stabilityFill.style.boxShadow = `0 0 10px ${color}`;
            } else {
                stabilityTrack.style.display = 'none';
            }
            checkPasswordsMatch();
        });

        // Confirm password matching indicator
        cpwInput.addEventListener('input', checkPasswordsMatch);

        function checkPasswordsMatch() {
            if (pwInput.value.length >= 8 && pwInput.value === cpwInput.value) {
                cpwCheckIcon.style.display = 'block';
            } else {
                cpwCheckIcon.style.display = 'none';
            }
        }

        // Custom checkbox toggle
        function toggleAgreement() {
            agreeTermsInput.checked = !agreeTermsInput.checked;
            if (agreeTermsInput.checked) {
                customCheck.classList.add('checked');
                termsError.style.display = 'none';
            } else {
                customCheck.classList.remove('checked');
            }
        }

        customCheck.addEventListener('click', toggleAgreement);

        // Form Submit with Warp Jump Animation
        registerForm.addEventListener('submit', (e) => {
            if (!agreeTermsInput.checked) {
                e.preventDefault();
                termsError.style.display = 'block';
                return;
            }

            // Trigger Cinematic Warp Transition
            e.preventDefault();
            if (window.triggerThreeJsWarp) window.triggerThreeJsWarp();

            btnText.innerText = 'ENTERING...';
            btnArrow.style.display = 'none';
            submitBtn.classList.add('warping');
            authWrapper.classList.add('warping');

            setTimeout(() => {
                registerForm.submit();
            }, 380);
        });

        // Google Register Simulation
        function triggerGoogleWarp() {
            if (window.triggerThreeJsWarp) window.triggerThreeJsWarp();
            authWrapper.classList.add('warping');
            setTimeout(() => {
                document.getElementById('googleForm').submit();
            }, 380);
        }

        function openModal(type) {
            alert(type === 'terms' 
                ? "UniVerse Terms of Service:\n1. Open exclusively to verified students and campus runners.\n2. Respect campus delivery safety and community guidelines." 
                : "UniVerse Privacy Policy:\n1. Data is encrypted end-to-end.\n2. Student credentials are never shared outside the university network.");
        }
    </script>
</body>
