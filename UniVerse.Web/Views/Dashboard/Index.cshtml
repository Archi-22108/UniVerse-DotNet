                                    </svg>
                                    <div class="donut-center-info">
                                        <div class="donut-val-mono">@Model.TotalRequests</div>
                                        <div class="donut-tag-mono">TOTAL</div>
                                    </div>
                                </div>

                                <!-- Breakdown Rows -->
                                <div class="status-rows-stack">
                                    <div class="status-pill-item">
                                        <div class="status-item-left">
                                            <span class="status-dot-circle dot-c-green"></span>
                                            <span>Completed</span>
                                        </div>
                                        <span class="status-pct-label">@Model.CompletedPercentage%</span>
                                    </div>

                                    <div class="status-pill-item">
                                        <div class="status-item-left">
                                            <span class="status-dot-circle dot-c-amber"></span>
                                            <span>In Progress</span>
                                        </div>
                                        <span class="status-pct-label">@Model.InProgressPercentage%</span>
                                    </div>

                                    <div class="status-pill-item">
                                        <div class="status-item-left">
                                            <span class="status-dot-circle dot-c-red"></span>
                                            <span>Cancelled</span>
                                        </div>
