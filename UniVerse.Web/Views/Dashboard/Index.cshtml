@model UniVerse.Web.Models.DashboardViewModel
@{
    Layout = null; // Immersive full-screen dashboard matching target screenshot 100%
    ViewData["Title"] = "Dashboard · UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Inter & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --uv-bg: #030708;
            --uv-card-bg: rgba(10, 16, 14, 0.55);
            --uv-card-border: rgba(255, 255, 255, 0.07);
            --uv-emerald: #00e599;
            --uv-emerald-glow: rgba(0, 229, 153, 0.35);
            --uv-text-muted: rgba(255, 255, 255, 0.6);
            --uv-text-dim: rgba(255, 255, 255, 0.38);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--uv-bg);
            color: #ffffff;
            font-family: 'Inter', -apple-system, sans-serif;
            min-height: 100vh;
            min-height: 100dvh;
            overflow-x: hidden;
            position: relative;
        }

        /* ── Canvas Starfield & Ambient Cosmic Nebula ── */
        #starCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .ambient-glow {
            position: fixed;
            pointer-events: none;
            z-index: 1;
            filter: blur(140px);
            opacity: 0.65;
        }

        .glow-top-left {
            top: -150px;
            left: 10%;
            width: 650px;
            height: 650px;
            background: radial-gradient(circle, rgba(0, 229, 153, 0.18) 0%, transparent 70%);
        }

        .glow-middle-right {
            top: 35%;
            right: -100px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
        }

        /* ── Top Navbar ── */
        .dash-nav {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1.5rem;
            background: rgba(3, 7, 8, 0.88);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .nav-inner {
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
        }

        .brand-monogram {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(0, 229, 153, 0.12);
            border: 1.5px solid var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 14px var(--uv-emerald-glow);
        }

        .brand-monogram svg {
            width: 16px;
            height: 16px;
        }

        .brand-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .btn-nav-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.035);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.75);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-nav-icon:hover {
            border-color: rgba(0, 229, 153, 0.4);
            color: #ffffff;
            background: rgba(0, 229, 153, 0.08);
        }

        .btn-new-request {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: var(--uv-emerald);
            color: #030708;
            font-size: 0.82rem;
            font-weight: 800;
            padding: 0.55rem 1.1rem;
            border-radius: 9999px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 0 18px var(--uv-emerald-glow);
        }

        .btn-new-request:hover {
            background: #25f4ab;
            transform: translateY(-1px);
            box-shadow: 0 0 25px rgba(0, 229, 153, 0.55);
        }

        /* ── Centered Column Main Container (Matches Screenshot Proportions) ── */
        .dash-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            padding: 1.75rem 1rem 4rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        /* ── Welcome Header Block ── */
        .welcome-block {
            margin-bottom: 0.25rem;
        }

        .greeting-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.32rem 0.85rem;
            border-radius: 9999px;
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.22);
            color: var(--uv-emerald);
            font-size: 0.72rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            box-shadow: 0 0 12px rgba(0, 229, 153, 0.12);
        }

        .welcome-title-row {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            flex-wrap: wrap;
        }

        .welcome-title {
            font-size: clamp(1.75rem, 3.2vw, 2.3rem);
            font-weight: 800;
            letter-spacing: -0.4px;
            line-height: 1.2;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .student-name-highlight {
            color: var(--uv-emerald);
        }

        /* The glowing planet orb right beside "Welcome back, Archi.kumari126697 👋" */
        .header-planet-orb {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #00e599 0%, #059669 45%, #022c22 100%);
            box-shadow: 0 0 32px rgba(0, 229, 153, 0.55), inset 0 0 12px rgba(0, 229, 153, 0.4);
            display: inline-block;
            margin-left: 0.75rem;
            vertical-align: middle;
            flex-shrink: 0;
        }

        .welcome-sub {
            font-size: 0.82rem;
            color: var(--uv-text-muted);
            margin-top: 0.4rem;
        }

        .welcome-sub span {
            color: rgba(0, 229, 153, 0.4);
            margin: 0 0.35rem;
        }

        /* ── 2x2 Stats Grid Matching Screenshot ── */
        .stats-grid-2x2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }

        .stat-card-box {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.1rem 1.25rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 104px;
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: all 0.25s ease;
        }

        .stat-card-box:hover {
            border-color: rgba(0, 229, 153, 0.25);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }

        .stat-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .stat-label-mono {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #A7B8B0;
            font-family: 'Space Mono', monospace;
        }

        .stat-icon-circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(0, 229, 153, 0.09);
            border: 1px solid rgba(0, 229, 153, 0.2);
            color: var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        .stat-number-mono {
            font-family: 'Space Mono', monospace;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.1;
            margin: 0.35rem 0 0.15rem;
        }

        .stat-trend-text {
            font-size: 0.7rem;
            color: var(--uv-text-dim);
        }

        /* ── Glass Section Containers ── */
        .dash-card-section {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.25rem 1.4rem;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: border-color 0.2s ease;
        }

        .dash-card-section:hover {
            border-color: rgba(0, 229, 153, 0.2);
        }

        .section-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }

        .section-header-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .badge-count-pill {
            background: var(--uv-emerald);
            color: #030708;
            font-size: 0.68rem;
            font-weight: 800;
            padding: 0.12rem 0.52rem;
            border-radius: 9999px;
        }

        .empty-placeholder {
            text-align: center;
            padding: 2.25rem 1rem;
            color: var(--uv-text-dim);
            font-size: 0.82rem;
            font-weight: 500;
        }

        /* ── Overview Analytics ── */
        .analytics-subtext {
            font-size: 0.72rem;
            color: var(--uv-text-muted);
            margin-top: 0.15rem;
        }

        .pill-select-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 9999px;
            padding: 0.32rem 0.8rem;
            color: #ffffff;
            font-size: 0.74rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            cursor: pointer;
        }

        .chart-box-relative {
            margin-top: 1.25rem;
            position: relative;
            height: 110px;
            width: 100%;
        }

        .chart-y-axis-labels {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            color: var(--uv-text-dim);
        }

        .chart-stage-area {
            margin-left: 22px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .chart-svg-draw {
            flex: 1;
            width: 100%;
            position: relative;
        }

        .chart-svg-draw svg {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .chart-x-days-row {
            display: flex;
            justify-content: space-between;
            padding-top: 0.4rem;
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            color: var(--uv-text-muted);
        }

        /* ── Requests by Status ── */
        .badge-total-pill {
            border: 1px solid rgba(0, 229, 153, 0.3);
            color: var(--uv-emerald);
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.12rem 0.6rem;
            border-radius: 9999px;
            background: rgba(0, 229, 153, 0.08);
        }

        .status-chart-flex {
            display: flex;
            align-items: center;
            gap: 1.75rem;
            margin-top: 0.4rem;
            flex-wrap: wrap;
        }

        .status-donut-ring {
            width: 100px;
            height: 100px;
            position: relative;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .status-donut-ring svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .donut-center-info {
            position: absolute;
            text-align: center;
        }

        .donut-val-mono {
            font-family: 'Space Mono', monospace;
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1;
        }

        .donut-tag-mono {
            font-size: 0.6rem;
            font-family: 'Space Mono', monospace;
            color: var(--uv-text-dim);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 0.15rem;
        }

        .status-rows-stack {
            flex: 1;
            min-width: 190px;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .status-pill-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.8rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 8px;
        }

        .status-item-left {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.85);
        }

        .status-dot-circle {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .dot-c-green { background: #00e599; box-shadow: 0 0 6px #00e599; }
        .dot-c-amber { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
        .dot-c-red { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

        .status-pct-label {
            font-family: 'Space Mono', monospace;
            font-size: 0.74rem;
            font-weight: 700;
            color: var(--uv-text-muted);
        }

        /* ── Recent Completed Table ── */
        .table-headers-grid {
            display: grid;
            grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr 1fr 1fr 1fr;
            padding: 0.5rem 0.25rem 0.65rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            font-weight: 700;
            color: #A7B8B0;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        /* ── Quick Actions ── */
        .quick-actions-box {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .btn-create-request-big {
            width: 100%;
            background: linear-gradient(90deg, #00e599 0%, #00d284 100%);
            color: #030708;
            font-size: 0.85rem;
            font-weight: 800;
            padding: 0.7rem 1rem;
            border-radius: 12px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 0 20px var(--uv-emerald-glow);
        }

        .btn-create-request-big:hover {
            background: #25f4ab;
            box-shadow: 0 0 28px rgba(0, 229, 153, 0.6);
            transform: translateY(-1px);
        }

        .shortcut-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .shortcut-item-row:hover {
            background: rgba(0, 229, 153, 0.08);
            border-color: rgba(0, 229, 153, 0.25);
            color: #ffffff;
            transform: translateX(2px);
        }

        .shortcut-item-left {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .shortcut-item-left i {
            color: var(--uv-emerald);
            font-size: 0.95rem;
        }

        .shortcut-chevron {
            color: var(--uv-text-dim);
            font-size: 0.75rem;
        }

        /* ── Profile Summary Card ── */
        .profile-summary-box {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .profile-top-avatar-row {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .avatar-initial-box {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--uv-emerald);
            color: #030708;
            font-size: 1.25rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px rgba(0, 229, 153, 0.4);
            flex-shrink: 0;
        }

        .profile-identity-info {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .student-full-name {
            font-size: 0.92rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
        }

        .student-verified-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.62rem;
            font-weight: 700;
            color: var(--uv-emerald);
            background: rgba(0, 229, 153, 0.09);
            border: 1px solid rgba(0, 229, 153, 0.22);
            padding: 0.12rem 0.45rem;
            border-radius: 9999px;
            width: fit-content;
        }

        .profile-contact-data {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            padding-top: 0.6rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.74rem;
            color: var(--uv-text-muted);
        }

        .contact-data-line {
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }

        .contact-data-line i {
            color: var(--uv-emerald);
            font-size: 0.85rem;
        }

        .btn-edit-student-profile {
            width: 100%;
            background: transparent;
            border: 1px solid rgba(0, 229, 153, 0.28);
            border-radius: 10px;
            padding: 0.55rem;
            color: var(--uv-emerald);
            font-size: 0.76rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-edit-student-profile:hover {
            background: rgba(0, 229, 153, 0.09);
            border-color: var(--uv-emerald);
        }

        @@media (max-width: 640px) {
            .table-headers-grid {
                font-size: 0.6rem;
            }
            .welcome-title {
                font-size: 1.6rem;
            }
            .header-planet-orb {
                width: 32px;
                height: 32px;
            }
        }
    </style>
</head>
<body>
    <!-- ── Interactive Canvas Twinkling Stars Background ── -->
    <canvas id="starCanvas"></canvas>

    <!-- ── Ambient Cosmic Glows ── -->
    <div class="ambient-glow glow-top-left"></div>
    <div class="ambient-glow glow-middle-right"></div>

    <!-- ── Top Navbar ── -->
    <header class="dash-nav">
        <div class="nav-inner">
            <a asp-controller="Home" asp-action="Index" class="nav-brand">
                <div class="brand-monogram">
                    <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7 6V14C7 17.866 10.134 21 14 21C17.866 21 21 17.866 21 14V6" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
                        <circle cx="14" cy="14" r="2.2" fill="#00e599" />
                    </svg>
                </div>
                <span class="brand-name">UniVerse</span>
            </a>

            <div class="nav-actions">
                <!-- Bell Icon Button -->
                <button class="btn-nav-icon" onclick="showNotice('Notifications', 'No new campus announcements right now.')" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <!-- New Request Pill Button -->
                <a asp-controller="Dashboard" asp-action="NewRequest" class="btn-new-request">
                    <i class="bi bi-plus-lg"></i>
                    <span>New Request</span>
                </a>

                <!-- Hamburger Menu Button -->
                <button class="btn-nav-icon" onclick="toggleNavMenu()" aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- ── Main Dashboard Single-Column Stack (Matching Screenshot) ── -->
    <main class="dash-container">
        <!-- ── 1. Welcome Header Block ── -->
        <div class="welcome-block">
            <!-- Greeting Pill -->
            <div class="greeting-pill">
                <i class="bi bi-stars"></i>
                <span id="greetingText">Good night 🌙</span>
            </div>

            <!-- Welcome Title with glowing green planet orb beside it -->
            <div class="welcome-title-row">
                <h1 class="welcome-title">
                    <span>Welcome back,</span>
                    <span class="student-name-highlight">@Model.DisplayName</span>
                    <span>👋</span>
                </h1>
                <div class="header-planet-orb"></div>
            </div>

            <!-- Subtitle -->
            <p class="welcome-sub">
                @Model.UniversityName <span>•</span> Your campus deliveries, your UniVerse.
            </p>
        </div>

        <!-- ── 2. 2x2 Stats Grid Matching Screenshot ── -->
        <div class="stats-grid-2x2">
            <!-- Stat 1: Total Requests -->
            <div class="stat-card-box">
                <div class="stat-card-top">
                    <span class="stat-label-mono">TOTAL REQUESTS</span>
                    <div class="stat-icon-circle">
                        <i class="bi bi-globe"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-number-mono">@Model.TotalRequests</div>
                    <div class="stat-trend-text">All time</div>
                </div>
            </div>

            <!-- Stat 2: Active Requests -->
            <div class="stat-card-box">
                <div class="stat-card-top">
                    <span class="stat-label-mono">ACTIVE REQUESTS</span>
                    <div class="stat-icon-circle">
                        <i class="bi bi-bicycle"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-number-mono">@Model.ActiveRequests</div>
                    <div class="stat-trend-text">In progress</div>
                </div>
            </div>

            <!-- Stat 3: Completed -->
            <div class="stat-card-box">
                <div class="stat-card-top">
                    <span class="stat-label-mono">COMPLETED</span>
                    <div class="stat-icon-circle">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-number-mono">@Model.CompletedRequests</div>
                    <div class="stat-trend-text">Delivered</div>
                </div>
            </div>

            <!-- Stat 4: Cancelled -->
            <div class="stat-card-box">
                <div class="stat-card-top">
                    <span class="stat-label-mono">CANCELLED</span>
                    <div class="stat-icon-circle">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-number-mono">@Model.CancelledRequests</div>
                    <div class="stat-trend-text">All clean · 0 issues</div>
                </div>
            </div>
        </div>

        <!-- ── 3. Active Deliveries Section ── -->
        <section class="dash-card-section">
            <div class="section-header-row">
                <div class="section-header-title">
                    <span>Active Deliveries</span>
                    <span class="badge-count-pill">@Model.ActiveRequests</span>
                </div>
            </div>

            @if (Model.ActiveDeliveries.Count == 0)
            {
                <div class="empty-placeholder">
                    No active deliveries right now. Tap &ldquo;New Request&rdquo; to order snacks!
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var req in Model.ActiveDeliveries)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border-radius: 10px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                            <div>
                                <b style="color: #ffffff; font-size: 0.85rem;">@req.ItemsDescription</b>
                                <div style="color: var(--uv-text-dim); font-size: 0.72rem;">To: @req.HostelRoom</div>
                            </div>
                            <div style="text-align: right;">
                                <span style="color: #f59e0b; font-size: 0.72rem; font-weight: 700;">● @req.Status</span>
                                <div style="color: var(--uv-emerald); font-weight: 800; font-family: 'Space Mono', monospace;">₹@req.TotalAmount</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- ── 4. Overview Analytics Section ── -->
        <section class="dash-card-section">
            <div class="section-header-row">
                <div>
                    <div class="section-header-title" style="margin-bottom: 0;">Overview Analytics</div>
                    <div class="analytics-subtext">Campus delivery activity this week</div>
                </div>
                <button class="pill-select-btn">
                    <span>This Week</span>
                    <i class="bi bi-chevron-down" style="font-size: 0.6rem;"></i>
                </button>
            </div>

            <!-- Sparkline Chart Area -->
            <div class="chart-box-relative">
                <!-- Y-axis -->
                <div class="chart-y-axis-labels">
                    <span>1</span>
                    <span>0</span>
                </div>

                <!-- Chart SVG Drawing -->
                <div class="chart-stage-area">
                    <div class="chart-svg-draw">
                        <svg viewBox="0 0 700 70" preserveAspectRatio="none">
                            <!-- Dotted Upper Grid line -->
                            <line x1="0" y1="8" x2="700" y2="8" stroke="rgba(255, 255, 255, 0.05)" stroke-dasharray="3,3" />
                            <!-- Baseline Solid line -->
                            <line x1="0" y1="65" x2="700" y2="65" stroke="rgba(255, 255, 255, 0.07)" />

                            <!-- Sleek glowing green sparkline line matching screenshot -->
                            <path d="M 20 65 L 120 65 L 220 65 L 320 65 L 420 65 L 530 65 L 680 65"
                                  fill="none"
                                  stroke="#00e599"
                                  stroke-width="2.2"
                                  stroke-linecap="round"
                                  style="filter: drop-shadow(0 0 6px rgba(0, 229, 153, 0.8));" />
                        </svg>
                    </div>

                    <!-- X-axis Days -->
                    <div class="chart-x-days-row">
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span>Sat</span>
                        <span>Sun</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── 5. Requests by Status Section ── -->
        <section class="dash-card-section">
            <div class="section-header-row">
                <div class="section-header-title">Requests by Status</div>
                <span class="badge-total-pill">@Model.TotalRequests Total</span>
            </div>

            <div class="status-chart-flex">
                <!-- Left Donut Ring Chart -->
                <div class="status-donut-ring">
                    <svg viewBox="0 0 36 36">
                        <path stroke="rgba(255, 255, 255, 0.07)" stroke-width="3" fill="none"
                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <path stroke="#00e599" stroke-width="3" stroke-linecap="round" fill="none"
                              stroke-dasharray="@Model.CompletedPercentage, 100"
                              style="filter: drop-shadow(0 0 6px rgba(0, 229, 153, 0.7));"
                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                    </svg>
                    <div class="donut-center-info">
                        <div class="donut-val-mono">@Model.TotalRequests</div>
                        <div class="donut-tag-mono">TOTAL</div>
                    </div>
                </div>

                <!-- Right Status Breakdown Rows -->
                <div class="status-rows-stack">
                    <div class="status-pill-item">
                        <div class="status-item-left">
                            <span class="status-dot-circle dot-c-green"></span>
                            <span>Completed</span>
                        </div>
                        <span class="status-pct-label">@Model.CompletedPercentage%</span>
                    </div>

                    <div class="status-pill-item">
                        <div class="status-item-left">
                            <span class="status-dot-circle dot-c-amber"></span>
                            <span>In Progress</span>
                        </div>
                        <span class="status-pct-label">@Model.InProgressPercentage%</span>
                    </div>

                    <div class="status-pill-item">
                        <div class="status-item-left">
                            <span class="status-dot-circle dot-c-red"></span>
                            <span>Cancelled</span>
                        </div>
                        <span class="status-pct-label">@Model.CancelledPercentage%</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── 6. Recent Completed Section ── -->
        <section class="dash-card-section" style="overflow-x: auto;">
            <div class="section-header-row" style="margin-bottom: 0.4rem;">
                <div class="section-header-title">Recent Completed</div>
            </div>

            <div style="width: 100%; min-width: 580px;">
                <!-- Table Headers -->
                <div class="table-headers-grid">
                    <span>ITEM</span>
                    <span>FROM</span>
                    <span>TO</span>
                    <span>RUNNER</span>
                    <span>TIME</span>
                    <span>STATUS</span>
                    <span style="text-align: right;">PRICE</span>
                </div>

                @if (Model.RecentCompleted.Count == 0)
                {
                    <div class="empty-placeholder" style="padding: 2.5rem 1rem;">
                        No completed requests yet.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column;">
                        @foreach (var item in Model.RecentCompleted)
                        {
                            <div style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr 1fr 1fr 1fr; padding: 0.75rem 0.25rem; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 0.75rem; align-items: center;">
                                <b style="color: #ffffff;">@item.ItemsDescription</b>
                                <span style="color: var(--uv-text-muted);">@item.PickupLocation</span>
                                <span style="color: var(--uv-text-muted);">@item.DropoffLocation</span>
                                <span style="color: #ffffff;">@(item.RunnerName ?? "Assigned")</span>
                                <span style="color: var(--uv-text-dim); font-family: 'Space Mono', monospace;">@item.CreatedAt.ToString("MMM dd")</span>
                                <span><span style="background: rgba(0,229,153,0.1); color: var(--uv-emerald); padding: 0.12rem 0.45rem; border-radius: 9999px; font-size: 0.68rem; font-weight: 700;">● Delivered</span></span>
                                <span style="text-align: right; color: var(--uv-emerald); font-weight: 800; font-family: 'Space Mono', monospace;">₹@item.TotalAmount</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- ── 7. Quick Actions Section ── -->
        <section class="dash-card-section quick-actions-box">
            <div class="section-header-row" style="margin-bottom: 0;">
                <span style="font-size: 0.95rem; font-weight: 800; color: #ffffff;">Quick Actions</span>
                <span style="color: var(--uv-emerald); font-size: 0.7rem; font-family: 'Space Mono', monospace; font-weight: 700;">✦ Shortcuts</span>
            </div>

            <!-- Wide Create New Request Button -->
            <a asp-controller="Dashboard" asp-action="NewRequest" class="btn-create-request-big">
                <i class="bi bi-plus-lg"></i>
                <span>Create New Request</span>
            </a>

            <!-- Action Rows Stack -->
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                <a asp-controller="Dashboard" asp-action="Requests" class="shortcut-item-row">
                    <div class="shortcut-item-left">
                        <i class="bi bi-file-text"></i>
                        <span>My Requests</span>
                    </div>
                    <i class="bi bi-chevron-right shortcut-chevron"></i>
                </a>

                <a asp-controller="Dashboard" asp-action="Runner" class="shortcut-item-row">
                    <div class="shortcut-item-left">
                        <i class="bi bi-bicycle"></i>
                        <span>Runner Mode</span>
                    </div>
                    <i class="bi bi-chevron-right shortcut-chevron"></i>
                </a>

                <a asp-controller="Dashboard" asp-action="Wallet" class="shortcut-item-row">
                    <div class="shortcut-item-left">
                        <i class="bi bi-wallet2"></i>
                        <span>Wallet</span>
                    </div>
                    <i class="bi bi-chevron-right shortcut-chevron"></i>
                </a>

                <a asp-controller="Dashboard" asp-action="Chat" class="shortcut-item-row">
                    <div class="shortcut-item-left">
                        <i class="bi bi-chat-dots"></i>
                        <span>Chat Support</span>
                    </div>
                    <i class="bi bi-chevron-right shortcut-chevron"></i>
                </a>

                <a asp-controller="Dashboard" asp-action="Requests" asp-route-tab="analytics" class="shortcut-item-row">
                    <div class="shortcut-item-left">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Analytics</span>
                    </div>
                    <i class="bi bi-chevron-right shortcut-chevron"></i>
                </a>
            </div>
        </section>

        <!-- ── 8. Profile Summary Card ── -->
        <section class="dash-card-section profile-summary-box">
            <div class="profile-top-avatar-row">
                <!-- Large Initial Avatar 'A' -->
                <div class="avatar-initial-box">
                    @Model.Initial
                </div>

                <!-- Student Identity & Verified Badge -->
                <div class="profile-identity-info">
                    <span class="student-full-name">@Model.DisplayName</span>
                    <span class="student-verified-pill">
                        <i class="bi bi-shield-check"></i>
                        <span>Verified Student</span>
                    </span>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="profile-contact-data">
                <div class="contact-data-line">
                    <i class="bi bi-envelope"></i>
                    <span>@Model.Email</span>
                </div>
                <div class="contact-data-line">
                    <i class="bi bi-telephone"></i>
                    <a href="javascript:void(0)" onclick="promptPhone()" style="color: var(--uv-text-muted); text-decoration: none;">
                        @(Model.PhoneNumber ?? "Add phone number")
                    </a>
                </div>
            </div>

            <!-- Edit Profile Button -->
            <a asp-controller="Dashboard" asp-action="Profile" class="btn-edit-student-profile">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Profile</span>
            </a>
        </section>

        <!-- ── 9. Recent Activity Section ── -->
        <section class="dash-card-section" style="margin-bottom: 1.5rem;">
            <div class="section-header-row" style="margin-bottom: 0;">
                <span style="font-size: 0.95rem; font-weight: 800; color: #ffffff;">Recent Activity</span>
            </div>

            @if (Model.Activities.Count == 0)
            {
                <div class="empty-placeholder" style="padding: 1.75rem 0.5rem;">
                    No recent activity.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem; padding-top: 0.5rem;">
                    @foreach (var act in Model.Activities)
                    {
                        <div style="display: flex; gap: 0.65rem; align-items: flex-start;">
                            <div style="width: 22px; height: 22px; border-radius: 50%; background: rgba(0,229,153,0.12); color: var(--uv-emerald); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; flex-shrink: 0; margin-top: 2px;">
                                <i class="bi @act.IconType"></i>
                            </div>
                            <div style="font-size: 0.74rem;">
                                <p style="color: #ffffff; margin-bottom: 0.1rem;">@act.Description</p>
                                <span style="color: var(--uv-text-dim); font-size: 0.66rem;">@act.TimeAgo</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </main>

    <!-- ── Interactive Client Scripts: Dynamic Starfield & Actions ── -->
    <script>
        // ── 1. HTML5 Canvas Starfield with Subtle Twinkling matching Next.js ──
        (function initStarfield() {
            const canvas = document.getElementById('starCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w = (canvas.width = window.innerWidth);
            let h = (canvas.height = window.innerHeight);

            window.addEventListener('resize', () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            });

            // Realistic stars distribution
            const starCount = 65;
            const stars = Array.from({ length: starCount }, () => ({
                x: Math.random() * w,
                y: Math.random() * h,
                r: Math.random() * 1.4 + 0.4,
                alpha: Math.random() * 0.7 + 0.2,
                speed: Math.random() * 0.02 + 0.005,
                phase: Math.random() * Math.PI * 2
            }));

            let t = 0;
            function render() {
                t += 0.02;
                ctx.clearRect(0, 0, w, h);

                stars.forEach(s => {
                    const currentAlpha = s.alpha * (0.6 + 0.4 * Math.sin(t * s.speed * 20 + s.phase));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha})`;
                    ctx.fill();
                });

                requestAnimationFrame(render);
            }
            render();
        })();

        // ── 2. Dynamic Time-Based Greeting ──
        (function updateGreeting() {
            const hours = new Date().getHours();
            let text = "Good night 🌙";
            if (hours >= 5 && hours < 12) {
                text = "Good morning ☀️";
            } else if (hours >= 12 && hours < 17) {
                text = "Good afternoon 🌤️";
            } else if (hours >= 17 && hours < 21) {
                text = "Good evening 🌇";
            } else {
                text = "Good night 🌙";
            }
            const el = document.getElementById('greetingText');
            if (el) el.innerText = text;
        })();

        // ── 3. Notification Popup ──
        function showNotice(title, message) {
            alert(title + ":\n" + message);
        }

        // ── 4. Phone Number Prompt ──
        function promptPhone() {
            const phone = prompt("Enter your campus mobile / WhatsApp number:");
            if (phone) {
                alert("Phone number saved: " + phone);
            }
        }

        // ── 5. Hamburger Menu Toggle ──
        function toggleNavMenu() {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    </script>
</body>
</html>
