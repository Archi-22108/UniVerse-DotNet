                                </div>
                            </div>
                        </section>

                        <!-- Requests by Status Card -->
                        <section class="dash-card-section">
                            <div class="section-header-row">
                                <div class="section-header-title">Requests by Status</div>
                                <span class="badge-total-pill">@Model.TotalRequests Total</span>
                            </div>

                            <div class="status-chart-flex">
                                <!-- Donut Ring -->
                                <div class="status-donut-ring">
                                    <svg viewBox="0 0 36 36">
                                        <path stroke="rgba(255, 255, 255, 0.06)" stroke-width="3.2" fill="none"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                        <path stroke="#00e599" stroke-width="3.2" stroke-linecap="round" fill="none"
                                              stroke-dasharray="@Model.CompletedPercentage, 100"
                                              style="filter: drop-shadow(0 0 5px rgba(0, 229, 153, 0.6));"
