                    </div>

                    <!-- 5. Recent Completed Table Section -->
                    <section class="dash-card-section" style="overflow-x: auto;">
                        <div class="section-header-row" style="margin-bottom: 0.5rem;">
                            <div class="section-header-title">Recent Completed</div>
                        </div>

                        <div style="width: 100%; min-width: 520px;">
                            <!-- Table Headers -->
                            <div class="table-headers-grid">
                                <span>ITEM</span>
                                <span>FROM</span>
                                <span>TO</span>
                                <span>RUNNER</span>
                                <span>TIME</span>
                                <span>STATUS</span>
                                <span style="text-align: right;">PRICE</span>
                            </div>

                            @if (Model.RecentCompleted.Count == 0)
                            {
                                <div class="empty-placeholder" style="padding: 2.75rem 1rem;">
                                    No completed requests yet.
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column;">
                                    @foreach (var item in Model.RecentCompleted)
                                    {
                                        <div style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr 1fr 1fr 1fr; padding: 0.75rem 0.25rem; border-bottom: 1px solid rgba(255,255,255,0.035); font-size: 0.74rem; align-items: center;">
                                            <b style="color: #ffffff;">@item.ItemsDescription</b>
                                            <span style="color: var(--uv-text-muted);">@item.PickupLocation</span>
                                            <span style="color: var(--uv-text-muted);">@item.DropoffLocation</span>
                                            <span style="color: #ffffff;">@(item.RunnerName ?? "Assigned")</span>
                                            <span style="color: var(--uv-text-dim); font-family: 'Space Mono', monospace; font-size: 0.68rem;">@item.CreatedAt.ToString("MMM dd")</span>
                                            <span><span style="background: rgba(0,229,153,0.1); color: var(--uv-emerald); padding: 0.12rem 0.45rem; border-radius: 9999px; font-size: 0.65rem; font-weight: 700;">● Delivered</span></span>
                                            <span style="text-align: right; color: var(--uv-emerald); font-weight: 800; font-family: 'Space Mono', monospace;">₹@item.TotalAmount</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- ════════ RIGHT WIDGETS COLUMN ════════ -->
                <div class="col-right-widgets">
                    <!-- 1. Quick Actions Card -->
                    <section class="dash-card-section quick-actions-box">
                        <div class="section-header-row" style="margin-bottom: 0;">
                            <span style="font-size: 0.92rem; font-weight: 800; color: #ffffff;">Quick Actions</span>
                            <span style="color: var(--uv-emerald); font-size: 0.65rem; font-family: 'Space Mono', monospace; font-weight: 700;">✦ Shortcuts</span>
                        </div>

                        <!-- Wide Create New Request Button -->
                        <a asp-controller="Dashboard" asp-action="NewRequest" class="btn-create-request-big">
                            <i class="bi bi-plus-lg"></i>
                            <span>Create New Request</span>
                        </a>

                        <!-- Action Rows Stack -->
                        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <a asp-controller="Dashboard" asp-action="Requests" class="shortcut-item-row">
                                <div class="shortcut-item-left">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <span>My Requests</span>
                                </div>
                                <i class="bi bi-chevron-right shortcut-chevron"></i>
                            </a>

                            <a asp-controller="Dashboard" asp-action="Runner" class="shortcut-item-row">
                                <div class="shortcut-item-left">
                                    <i class="bi bi-bicycle"></i>
                                    <span>Runner Mode</span>
                                </div>
                                <i class="bi bi-chevron-right shortcut-chevron"></i>
                            </a>

                            <a asp-controller="Dashboard" asp-action="Wallet" class="shortcut-item-row">
                                <div class="shortcut-item-left">
                                    <i class="bi bi-wallet2"></i>
                                    <span>Wallet</span>
                                </div>
                                <i class="bi bi-chevron-right shortcut-chevron"></i>
                            </a>

                            <a asp-controller="Dashboard" asp-action="Chat" class="shortcut-item-row">
                                <div class="shortcut-item-left">
                                    <i class="bi bi-chat-dots"></i>
                                    <span>Chat Support</span>
                                </div>
                                <i class="bi bi-chevron-right shortcut-chevron"></i>
                            </a>

                            <a asp-controller="Dashboard" asp-action="Analytics" class="shortcut-item-row">
                                <div class="shortcut-item-left">
                                    <i class="bi bi-bar-chart"></i>
                                    <span>Analytics</span>
                                </div>
                                <i class="bi bi-chevron-right shortcut-chevron"></i>
                            </a>
                        </div>
                    </section>

                    <!-- 2. Profile Summary Card -->
                    <section class="dash-card-section profile-summary-box">
                        <div class="profile-top-avatar-row">
                            <!-- Large Initial Avatar 'A' -->
                            <div class="avatar-initial-box">
                                @Model.Initial
                            </div>

                            <!-- Student Identity & Verified Badge -->
                            <div class="profile-identity-info">
                                <span class="student-full-name">@Model.DisplayName</span>
                                <span class="student-verified-pill">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Verified Student</span>
                                </span>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="profile-contact-data">
                            <div class="contact-data-line">
                                <i class="bi bi-envelope"></i>
                                <span>@Model.Email</span>
                            </div>
                            <div class="contact-data-line">
                                <i class="bi bi-telephone"></i>
                                <a href="javascript:void(0)" onclick="promptPhone()" style="color: #7f9689; text-decoration: none;">
                                    @(Model.PhoneNumber ?? "Add phone number")
                                </a>
                            </div>
                        </div>

                        <!-- Edit Profile Button -->
                        <a asp-controller="Dashboard" asp-action="Profile" class="btn-edit-student-profile">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit Profile</span>
                        </a>
                    </section>

                    <!-- 3. Recent Activity Section -->
                    <section class="dash-card-section">
                        <div class="section-header-row" style="margin-bottom: 0;">
                            <span style="font-size: 0.92rem; font-weight: 800; color: #ffffff;">Recent Activity</span>
                        </div>

                        @if (Model.Activities.Count == 0)
                        {
                            <div class="empty-placeholder" style="padding: 2.25rem 0.5rem;">
                                No recent activity.
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 0.75rem; padding-top: 0.5rem;">
                                @foreach (var act in Model.Activities)
                                {
                                    <div style="display: flex; gap: 0.65rem; align-items: flex-start;">
                                        <div style="width: 22px; height: 22px; border-radius: 50%; background: rgba(0,229,153,0.12); color: var(--uv-emerald); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; flex-shrink: 0; margin-top: 2px;">
                                            <i class="bi @act.IconType"></i>
                                        </div>
                                        <div style="font-size: 0.74rem;">
                                            <p style="color: #ffffff; margin-bottom: 0.1rem;">@act.Description</p>
                                            <span style="color: var(--uv-text-dim); font-size: 0.66rem;">@act.TimeAgo</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Interactive Client Scripts: Dynamic Starfield & Actions ── -->
    <script>
        // ── 1. HTML5 Canvas Starfield with Subtle Twinkling matching Next.js ──
        (function initStarfield() {
            const canvas = document.getElementById('starCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w = (canvas.width = window.innerWidth);
            let h = (canvas.height = window.innerHeight);

            window.addEventListener('resize', () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            });

            const starCount = 80;
            const stars = Array.from({ length: starCount }, () => ({
                x: Math.random() * w,
                y: Math.random() * h,
                r: Math.random() * 1.3 + 0.3,
                alpha: Math.random() * 0.7 + 0.2,
                speed: Math.random() * 0.02 + 0.005,
                phase: Math.random() * Math.PI * 2
            }));

            let t = 0;
            function render() {
                t += 0.02;
                ctx.clearRect(0, 0, w, h);

                stars.forEach(s => {
                    const currentAlpha = s.alpha * (0.6 + 0.4 * Math.sin(t * s.speed * 20 + s.phase));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha})`;
                    ctx.fill();
                });

                requestAnimationFrame(render);
            }
            render();
        })();

        // ── 2. Time-Based Greeting ──
        (function updateGreeting() {
            const hours = new Date().getHours();
            let text = "Good night 🌙";
            if (hours >= 5 && hours < 12) {
                text = "Good morning ☀️";
            } else if (hours >= 12 && hours < 17) {
                text = "Good afternoon 🌤️";
            } else if (hours >= 17 && hours < 21) {
                text = "Good evening 🌇";
            } else {
                text = "Good night 🌙";
            }
            const el = document.getElementById('greetingText');
            if (el) el.innerText = text;
        })();

        // ── 3. Notification Popup ──
        function showNotice(title, message) {
            alert(title + ":\n" + message);
        }

        // ── 4. Phone Number Prompt ──
        function promptPhone() {
            const phone = prompt("Enter your campus mobile / WhatsApp number:");
            if (phone) {
                alert("Phone number saved: " + phone);
            }
        }
    </script>
</body>
</html>
