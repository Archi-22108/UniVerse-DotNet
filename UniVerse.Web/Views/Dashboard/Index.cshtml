                            </div>
                        }
                    </section>

                    <!-- 4. Two-Column Analytics + Requests by Status Row -->
                    <div class="charts-double-row">
                        <!-- Overview Analytics Card -->
                        <section class="dash-card-section">
                            <div class="section-header-row">
                                <div>
                                    <div class="section-header-title" style="margin-bottom: 0;">Overview Analytics</div>
                                    <div class="analytics-subtext">Campus delivery activity this week</div>
                                </div>
                                <button class="pill-select-btn">
                                    <span>This Week</span>
                                    <i class="bi bi-chevron-down" style="font-size: 0.58rem;"></i>
                                </button>
                            </div>

                            <div class="chart-box-relative">
                                <!-- Y-axis -->
                                <div class="chart-y-axis-labels">
                                    <span>1</span>
                                    <span>0</span>
                                </div>

                                <!-- SVG Sparkline Drawing -->
                                <div class="chart-stage-area">
                                    <div class="chart-svg-draw">
                                        <svg viewBox="0 0 700 70" preserveAspectRatio="none">
                                            <!-- Dotted Upper Grid line -->
                                            <line x1="0" y1="8" x2="700" y2="8" stroke="rgba(255, 255, 255, 0.04)" stroke-dasharray="3,3" />
                                            <!-- Baseline Solid line -->
                                            <line x1="0" y1="65" x2="700" y2="65" stroke="rgba(255, 255, 255, 0.05)" />

                                            <!-- Sleek glowing green sparkline line matching screenshot -->
