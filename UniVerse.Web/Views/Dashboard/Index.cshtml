@model UniVerse.Web.Models.DashboardViewModel
@{
    Layout = null; // Full desktop immersive dashboard matching screenshot 100%
    ViewData["Title"] = "Dashboard · UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Inter & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --uv-bg: #030708;
            --uv-card-bg: rgba(9, 16, 13, 0.58);
            --uv-card-border: rgba(255, 255, 255, 0.055);
            --uv-card-border-hover: rgba(0, 229, 153, 0.25);
            --uv-emerald: #00e599;
            --uv-emerald-glow: rgba(0, 229, 153, 0.35);
            --uv-text-main: #ffffff;
            --uv-text-muted: #85988e;
            --uv-text-dim: #54685e;
            --uv-sidebar-w: 230px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--uv-bg);
            color: var(--uv-text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            min-height: 100dvh;
            overflow-x: hidden;
            position: relative;
        }

        /* ── Canvas Starfield & Ambient Glow ── */
        #starCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .ambient-planet-glow {
            position: absolute;
            top: 280px;
            left: 280px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle at 40% 30%, rgba(0, 229, 153, 0.28) 0%, rgba(5, 150, 105, 0.12) 55%, transparent 80%);
            filter: blur(55px);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-bottom-glow {
            position: absolute;
            bottom: 80px;
            left: 450px;
            width: 320px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 229, 153, 0.15) 0%, transparent 70%);
            filter: blur(60px);
            pointer-events: none;
            z-index: 1;
        }

        /* ── Desktop Layout Container ── */
        .dash-app-layout {
            display: flex;
            min-height: 100vh;
            position: relative;
            z-index: 10;
        }

        /* ── Left Sidebar (Exact match to screenshot) ── */
        .dash-sidebar {
            width: var(--uv-sidebar-w);
            min-width: var(--uv-sidebar-w);
            background: #030708;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            padding: 1.5rem 1.15rem 1.5rem 1.35rem;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            scrollbar-width: none;
        }

        .dash-sidebar::-webkit-scrollbar {
            display: none;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
            padding-left: 0.25rem;
            margin-bottom: 2rem;
        }

        .sidebar-brand-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px var(--uv-emerald-glow);
        }

        .sidebar-brand-icon svg {
            width: 16px;
            height: 16px;
            fill: #020806;
        }

        .sidebar-brand-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .sidebar-nav-list {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            flex: 1;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.62rem 0.95rem;
            border-radius: 9999px;
            color: #85988e;
            font-size: 0.84rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            position: relative;
        }

        .sidebar-link i {
            font-size: 1.05rem;
            color: inherit;
        }

        .sidebar-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.03);
        }

        .sidebar-link.active {
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.28);
            color: var(--uv-emerald);
            font-weight: 700;
            box-shadow: 0 0 14px rgba(0, 229, 153, 0.08);
        }

        .sidebar-link.active i {
            color: var(--uv-emerald);
        }

        .wallet-dot-badge {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--uv-emerald);
            box-shadow: 0 0 6px var(--uv-emerald);
            margin-left: auto;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 1.5rem;
        }

        .sidebar-logout-btn {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #ef4444;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            padding: 0.62rem 0.95rem;
            border-radius: 9999px;
            transition: all 0.2s ease;
        }

        .sidebar-logout-btn:hover {
            background: rgba(239, 68, 68, 0.08);
            color: #ff5c5c;
        }

        /* ── Main Content Area ── */
        .dash-main-viewport {
            flex: 1;
            min-width: 0;
            padding: 1.5rem 2rem 4rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        /* ── Top Header Actions (Bell + New Request button) ── */
        .top-action-bar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .btn-bell-circle {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.09);
            color: rgba(255, 255, 255, 0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-bell-circle:hover {
            border-color: rgba(0, 229, 153, 0.35);
            color: #ffffff;
            background: rgba(0, 229, 153, 0.08);
        }

        .btn-top-new-request {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: var(--uv-emerald);
            color: #020806;
            font-size: 0.82rem;
            font-weight: 800;
            padding: 0.52rem 1.15rem;
            border-radius: 9999px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 0 16px var(--uv-emerald-glow);
        }

        .btn-top-new-request:hover {
            background: #25f4ab;
            transform: translateY(-1px);
        }

        /* ── Desktop Two-Column Main Grid ── */
        .dash-content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 1.5rem;
            align-items: start;
        }

        /* ── Left Main Column ── */
        .col-left-main {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            min-width: 0;
        }

        /* Hero Greeting Block */
        .hero-welcome-block {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .greeting-badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.26rem 0.8rem;
            border-radius: 9999px;
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.24);
            color: var(--uv-emerald);
            font-size: 0.72rem;
            font-weight: 700;
            width: fit-content;
        }

        .hero-welcome-title {
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: -0.35px;
            line-height: 1.2;
            color: #ffffff;
        }

        .student-name-highlight {
            color: var(--uv-emerald);
        }

        .hero-welcome-sub {
            font-size: 0.78rem;
            color: var(--uv-text-muted);
            line-height: 1.35;
        }

        .hero-welcome-sub .dot-sep {
            color: rgba(0, 229, 153, 0.45);
            margin: 0 0.3rem;
        }

        /* 4 Stats Cards in a Single Horizontal Row */
        .stats-row-4cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
        }

        .stat-card-box {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 16px;
            padding: 0.95rem 1.1rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 98px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: all 0.2s ease;
        }

        .stat-card-box:hover {
            border-color: var(--uv-card-border-hover);
            transform: translateY(-1px);
        }

        .stat-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .stat-label-mono {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #7f9488;
            font-family: 'Space Mono', monospace;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .stat-icon-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.2);
            color: var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
            flex-shrink: 0;
        }

        .stat-number-mono {
            font-family: 'Space Mono', monospace;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.1;
            margin: 0.25rem 0 0.15rem;
        }

        .stat-trend-text {
            font-size: 0.68rem;
            color: #54685e;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Glass Section Container */
        .dash-card-section {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 16px;
            padding: 1.15rem 1.25rem;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: border-color 0.2s ease;
        }

        .dash-card-section:hover {
            border-color: var(--uv-card-border-hover);
        }

        .section-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }

        .section-header-title {
            font-size: 0.95rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }

        .badge-count-pill {
            background: var(--uv-emerald);
            color: #030708;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 0.1rem 0.5rem;
            border-radius: 9999px;
            margin-left: 0.25rem;
        }

        .empty-placeholder {
            text-align: center;
            padding: 2.25rem 1rem;
            color: #6b8075;
            font-size: 0.78rem;
            font-weight: 500;
            line-height: 1.4;
        }

        /* 2-Column Row for Analytics + Status */
        .charts-double-row {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 0.85rem;
        }

        .analytics-subtext {
            font-size: 0.68rem;
            color: #6b8075;
            margin-top: 0.15rem;
        }

        .pill-select-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 9999px;
            padding: 0.25rem 0.7rem;
            color: #ffffff;
            font-size: 0.68rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            cursor: pointer;
        }

        .chart-box-relative {
            margin-top: 1.15rem;
            position: relative;
            height: 90px;
            width: 100%;
        }

        .chart-y-axis-labels {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-family: 'Space Mono', monospace;
            font-size: 0.62rem;
            color: #54685e;
        }

        .chart-stage-area {
            margin-left: 20px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .chart-svg-draw {
            flex: 1;
            width: 100%;
            position: relative;
        }

        .chart-svg-draw svg {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .chart-x-days-row {
            display: flex;
            justify-content: space-between;
            padding-top: 0.4rem;
            font-family: 'Space Mono', monospace;
            font-size: 0.62rem;
            color: #6b8075;
        }

        /* Requests by Status */
        .badge-total-pill {
            border: 1px solid rgba(0, 229, 153, 0.35);
            color: var(--uv-emerald);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.12rem 0.55rem;
            border-radius: 9999px;
            background: rgba(0, 229, 153, 0.06);
        }

        .status-chart-flex {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            margin-top: 0.45rem;
        }

        .status-donut-ring {
            width: 84px;
            height: 84px;
            position: relative;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .status-donut-ring svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .donut-center-info {
            position: absolute;
            text-align: center;
        }

        .donut-val-mono {
            font-family: 'Space Mono', monospace;
            font-size: 1.35rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1;
        }

        .donut-tag-mono {
            font-size: 0.54rem;
            font-family: 'Space Mono', monospace;
            color: #54685e;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 0.15rem;
        }

        .status-rows-stack {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .status-pill-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.45rem 0.7rem;
            background: rgba(255, 255, 255, 0.015);
            border: 1px solid rgba(255, 255, 255, 0.035);
            border-radius: 6px;
        }

        .status-item-left {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.74rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.85);
        }

        .status-dot-circle {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .dot-c-green { background: #00e599; box-shadow: 0 0 5px #00e599; }
        .dot-c-amber { background: #f59e0b; box-shadow: 0 0 5px #f59e0b; }
        .dot-c-red { background: #ef4444; box-shadow: 0 0 5px #ef4444; }

        .status-pct-label {
            font-family: 'Space Mono', monospace;
            font-size: 0.72rem;
            font-weight: 700;
            color: #6b8075;
        }

        /* Recent Completed Table */
        .table-headers-grid {
            display: grid;
            grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr 1fr 1fr 1fr;
            padding: 0.45rem 0.25rem 0.55rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.045);
            font-family: 'Space Mono', monospace;
            font-size: 0.62rem;
            font-weight: 700;
            color: #6b8075;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        /* ── Right Column (Quick Actions, Profile, Activity) ── */
        .col-right-widgets {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        /* Quick Actions Card */
        .quick-actions-box {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .btn-create-request-big {
            width: 100%;
            background: linear-gradient(90deg, #00e599 0%, #00d284 100%);
            color: #020806;
            font-size: 0.82rem;
            font-weight: 800;
            padding: 0.7rem 1rem;
            border-radius: 12px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 0 18px var(--uv-emerald-glow);
        }

        .btn-create-request-big:hover {
            background: #25f4ab;
            transform: translateY(-1px);
        }

        .shortcut-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.62rem 0.75rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.015);
            border: 1px solid rgba(255, 255, 255, 0.035);
            color: #d0dcd5;
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .shortcut-item-row:hover {
            background: rgba(0, 229, 153, 0.06);
            border-color: rgba(0, 229, 153, 0.2);
            color: #ffffff;
            transform: translateX(2px);
        }

        .shortcut-item-left {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .shortcut-item-left i {
            color: var(--uv-emerald);
            font-size: 0.95rem;
        }

        .shortcut-chevron {
            color: #4a5c53;
            font-size: 0.75rem;
        }

        /* Profile Summary Card */
        .profile-summary-box {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .profile-top-avatar-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .avatar-initial-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--uv-emerald);
            color: #020806;
            font-size: 1.25rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 14px rgba(0, 229, 153, 0.4);
            flex-shrink: 0;
        }

        .profile-identity-info {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }

        .student-full-name {
            font-size: 0.88rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
        }

        .student-verified-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-size: 0.62rem;
            font-weight: 700;
            color: var(--uv-emerald);
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.22);
            padding: 0.08rem 0.42rem;
            border-radius: 9999px;
            width: fit-content;
        }

        .profile-contact-data {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            padding-top: 0.6rem;
            border-top: 1px solid rgba(255, 255, 255, 0.045);
            font-size: 0.72rem;
            color: #7f9689;
        }

        .contact-data-line {
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }

        .contact-data-line i {
            color: var(--uv-emerald);
            font-size: 0.85rem;
        }

        .btn-edit-student-profile {
            width: 100%;
            background: transparent;
            border: 1px solid rgba(0, 229, 153, 0.28);
            border-radius: 9px;
            padding: 0.5rem;
            color: var(--uv-emerald);
            font-size: 0.76rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            margin-top: 0.25rem;
        }

        .btn-edit-student-profile:hover {
            background: rgba(0, 229, 153, 0.08);
            border-color: var(--uv-emerald);
        }

        /* ── Responsive adjustments for tablet / smaller desktop ── */
        @@media (max-width: 1180px) {
            .dash-content-grid {
                grid-template-columns: 1fr;
            }
            .stats-row-4cards {
                grid-template-columns: repeat(2, 1fr);
            }
            .charts-double-row {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .dash-sidebar {
                display: none;
            }
            .dash-main-viewport {
                padding: 1rem;
            }
            .stats-row-4cards {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ── Interactive Canvas Twinkling Stars Background ── -->
    <canvas id="starCanvas"></canvas>

    <!-- ── Ambient Cosmic Planetary Glows matching screenshots ── -->
    <div class="ambient-planet-glow"></div>
    <div class="ambient-bottom-glow"></div>

    <div class="dash-app-layout">
        <!-- ── Left Sidebar (Exact 1:1 match to screenshot) ── -->
        <aside class="dash-sidebar">
            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z"/>
                    </svg>
                </div>
                <span class="sidebar-brand-title">UniVerse</span>
            </a>

            <!-- Navigation Links -->
            <nav class="sidebar-nav-list">
                <!-- 1. Home -->
                <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>

                <!-- 2. Dashboard (Active Item) -->
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link active">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>

                <!-- 3. My Requests -->
                <a asp-controller="Dashboard" asp-action="Requests" class="sidebar-link">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>My Requests</span>
                </a>

                <!-- 4. Runner Mode -->
                <a asp-controller="Dashboard" asp-action="Runner" class="sidebar-link">
                    <i class="bi bi-bicycle"></i>
                    <span>Runner Mode</span>
                </a>

                <!-- 5. Wallet (With Green Dot Indicator) -->
                <a asp-controller="Dashboard" asp-action="Wallet" class="sidebar-link">
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                    <span class="wallet-dot-badge"></span>
                </a>

                <!-- 6. Marketplace -->
                <a asp-controller="Dashboard" asp-action="Marketplace" class="sidebar-link">
                    <i class="bi bi-bag"></i>
                    <span>Marketplace</span>
                </a>

                <!-- 7. Chat -->
                <a asp-controller="Dashboard" asp-action="Chat" class="sidebar-link">
                    <i class="bi bi-chat-dots"></i>
                    <span>Chat</span>
                </a>

                <!-- 8. Analytics -->
                <a asp-controller="Dashboard" asp-action="Analytics" class="sidebar-link">
                    <i class="bi bi-bar-chart"></i>
                    <span>Analytics</span>
                </a>

                <!-- 9. Profile -->
                <a asp-controller="Dashboard" asp-action="Profile" class="sidebar-link">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>

                <!-- 10. Setting -->
                <a asp-controller="Dashboard" asp-action="Setting" class="sidebar-link">
                    <i class="bi bi-gear"></i>
                    <span>Setting</span>
                </a>
            </nav>

            <!-- Bottom Logout -->
            <div class="sidebar-bottom">
                <a asp-controller="Account" asp-action="Logout" class="sidebar-logout-btn">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Log out</span>
                </a>
            </div>
        </aside>

        <!-- ── Main Viewport (Center Content + Right Widgets) ── -->
        <div class="dash-main-viewport">
            <!-- Top Right Action Bar (Bell & New Request Button) -->
            <div class="top-action-bar">
                <!-- Bell Icon Button -->
                <button class="btn-bell-circle" onclick="showNotice('Notifications', 'No new campus announcements right now.')" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <!-- New Request Pill Button -->
                <a asp-controller="Dashboard" asp-action="NewRequest" class="btn-top-new-request">
                    <i class="bi bi-plus-lg"></i>
                    <span>New Request</span>
                </a>
            </div>

            <!-- Main Content 2-Column Grid -->
            <div class="dash-content-grid">
                <!-- ════════ LEFT MAIN COLUMN ════════ -->
                <div class="col-left-main">
                    <!-- 1. Welcome Greeting Header -->
                    <div class="hero-welcome-block">
                        <div class="greeting-badge-pill">
                            <span id="greetingText">Good night 🌙</span>
                        </div>

                        <h1 class="hero-welcome-title">
                            <span>Welcome back,</span>
                            <span class="student-name-highlight">@Model.DisplayName</span>
                            <span>👋</span>
                        </h1>

                        <p class="hero-welcome-sub">
                            @Model.UniversityName <span class="dot-sep">•</span> Your campus deliveries, your UniVerse.
                        </p>
                    </div>

                    <!-- 2. 4 Stats Cards in 1 Row (Exact Screenshot Grid) -->
                    <div class="stats-row-4cards">
                        <!-- Stat 1: Total Requests -->
                        <div class="stat-card-box">
                            <div class="stat-card-top">
                                <span class="stat-label-mono">TOTAL REQUESTS</span>
                                <div class="stat-icon-circle">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                            </div>
                            <div>
                                <div class="stat-number-mono">@Model.TotalRequests</div>
                                <div class="stat-trend-text">All time</div>
                            </div>
                        </div>

                        <!-- Stat 2: Active Requests -->
                        <div class="stat-card-box">
                            <div class="stat-card-top">
                                <span class="stat-label-mono">ACTIVE REQUES...</span>
                                <div class="stat-icon-circle">
                                    <i class="bi bi-bicycle"></i>
                                </div>
                            </div>
                            <div>
                                <div class="stat-number-mono">@Model.ActiveRequests</div>
                                <div class="stat-trend-text">In progress</div>
                            </div>
                        </div>

                        <!-- Stat 3: Completed -->
                        <div class="stat-card-box">
                            <div class="stat-card-top">
                                <span class="stat-label-mono">COMPLETED</span>
                                <div class="stat-icon-circle">
                                    <i class="bi bi-check2-circle"></i>
                                </div>
                            </div>
                            <div>
                                <div class="stat-number-mono">@Model.CompletedRequests</div>
                                <div class="stat-trend-text">Delivered</div>
                            </div>
                        </div>

                        <!-- Stat 4: Cancelled -->
                        <div class="stat-card-box">
                            <div class="stat-card-top">
                                <span class="stat-label-mono">CANCELLED</span>
                                <div class="stat-icon-circle">
                                    <i class="bi bi-exclamation-circle"></i>
                                </div>
                            </div>
                            <div>
                                <div class="stat-number-mono">@Model.CancelledRequests</div>
                                <div class="stat-trend-text">All clean · 0 iss...</div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Active Deliveries Section -->
                    <section class="dash-card-section">
                        <div class="section-header-row">
                            <div class="section-header-title">
                                <span>Active Deliveries</span>
                                <span class="badge-count-pill">@Model.ActiveRequests</span>
                            </div>
                        </div>

                        @if (Model.ActiveDeliveries.Count == 0)
                        {
                            <div class="empty-placeholder">
                                No active deliveries right now. Tap &ldquo;New Request&rdquo; to order snacks!
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 0.7rem;">
                                @foreach (var req in Model.ActiveDeliveries)
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border-radius: 8px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
