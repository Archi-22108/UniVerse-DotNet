    <!-- ── Interactive Client Script for Instant Photo Preview & Removal ── -->
    <script>
        // ── 1. Starfield particles animation ──
        (function initStars() {
            const canvas = document.getElementById('starCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w = (canvas.width = window.innerWidth);
            let h = (canvas.height = window.innerHeight);

            window.addEventListener('resize', () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            });

            const starCount = 55;
            const stars = Array.from({ length: starCount }, () => ({
                x: Math.random() * w,
                y: Math.random() * h,
                r: Math.random() * 1.2 + 0.3,
                alpha: Math.random() * 0.7 + 0.2,
                speed: Math.random() * 0.02 + 0.005,
                phase: Math.random() * Math.PI * 2
            }));

            let t = 0;
            function render() {
                t += 0.02;
                ctx.clearRect(0, 0, w, h);
                stars.forEach(s => {
                    const currentAlpha = s.alpha * (0.6 + 0.4 * Math.sin(t * s.speed * 20 + s.phase));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha})`;
                    ctx.fill();
                });
                requestAnimationFrame(render);
            }
            render();
        })();

        // ── 2. Live Photo Upload Preview ──
        function onPhotoSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];

                // Validate size (2MB)
                if (file.size > 2 * 1024 * 1024) {
                    alert('Image size exceeds 2MB maximum limit. Please choose a smaller image.');
                    input.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('avatarImgPreview');
                    const initial = document.getElementById('avatarInitial');
                    if (preview) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    }
                    if (initial) {
                        initial.style.display = 'none';
                    }
                    document.getElementById('removePhotoInput').value = 'false';
                };
                reader.readAsDataURL(file);
            }
        }

        // ── 3. Remove Photo Action ──
        function removePhotoAction() {
            const preview = document.getElementById('avatarImgPreview');
            const initial = document.getElementById('avatarInitial');
            const fileInput = document.getElementById('photoFileInput');
            const removeInput = document.getElementById('removePhotoInput');

            if (preview) {
                preview.src = '';
                preview.style.display = 'none';
            }
            if (initial) {
                initial.style.display = 'block';
            }
            if (fileInput) {
                fileInput.value = '';
            }
            if (removeInput) {
                removeInput.value = 'true';
            }
        }
    </script>
</body>
