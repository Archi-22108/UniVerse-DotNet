    <!-- ── Interactive Client Script ── -->
    <script>
        // ── 1. Ambient Starfield Animation ──
        (function initStars() {
            const canvas = document.getElementById('starCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w = (canvas.width = window.innerWidth);
            let h = (canvas.height = window.innerHeight);

            window.addEventListener('resize', () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            });

            const starCount = 65;
            const stars = Array.from({ length: starCount }, () => ({
                x: Math.random() * w,
                y: Math.random() * h,
                r: Math.random() * 1.2 + 0.3,
                alpha: Math.random() * 0.7 + 0.2,
                speed: Math.random() * 0.02 + 0.005,
                phase: Math.random() * Math.PI * 2
            }));

            let t = 0;
            function render() {
                t += 0.02;
                ctx.clearRect(0, 0, w, h);
                stars.forEach(s => {
                    const currentAlpha = s.alpha * (0.6 + 0.4 * Math.sin(t * s.speed * 20 + s.phase));
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha})`;
                    ctx.fill();
                });
                requestAnimationFrame(render);
            }
            render();
        })();

        // ── 2. Interactive Chart Tooltip ──
        function showTooltip(date, val, percentLeft, svgX, svgY) {
            const tooltip = document.getElementById('chartTooltip');
            const ttDate = document.getElementById('ttDate');
            const ttVal = document.getElementById('ttVal');
            const guideLine = document.getElementById('guideLineX');

            if (tooltip && ttDate && ttVal) {
                ttDate.textContent = date;
                ttVal.textContent = val;
                tooltip.style.left = `calc(${percentLeft}% - 35px)`;
                tooltip.style.top = `${Math.max(10, (svgY / 240) * 100 - 30)}%`;
            }

            if (guideLine) {
                guideLine.setAttribute('x1', svgX);
                guideLine.setAttribute('x2', svgX);
            }
        }
    </script>
</body>
</html>
