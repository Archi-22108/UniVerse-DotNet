@model UniVerse.Web.Models.AnalyticsViewModel
@{
    Layout = null; // Dedicated full widescreen layout matching screenshot 1:1
    ViewData["Title"] = "Analytics & Reports · UniVerse";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Inter & Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --uv-bg: #030708;
            --uv-sidebar-bg: #040907;
            --uv-card-bg: rgba(8, 14, 11, 0.75);
            --uv-card-border: rgba(0, 229, 153, 0.16);
            --uv-card-border-hover: rgba(0, 229, 153, 0.35);
            --uv-emerald: #00e599;
            --uv-emerald-glow: rgba(0, 229, 153, 0.4);
            --uv-text-main: #ffffff;
            --uv-text-muted: #85988e;
            --uv-text-dim: #54685e;
            --uv-blue: #3b82f6;
            --uv-red: #ef4444;
            --uv-amber: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--uv-bg);
            color: var(--uv-text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            min-height: 100dvh;
            overflow-x: hidden;
            display: flex;
        }

        /* ── Canvas Starfield ── */
        #starCanvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        /* ══════════════════════════════════════════════════════
           LEFT SIDEBAR (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .analytics-sidebar {
            width: 240px;
            background: var(--uv-sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem 1.15rem;
            position: sticky;
            top: 0;
            height: 100vh;
            z-index: 40;
            flex-shrink: 0;
        }

        .sidebar-brand-head {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
            padding: 0.25rem 0.5rem 1.5rem;
        }

        .brand-monogram-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 16px var(--uv-emerald-glow);
        }

        .brand-monogram-circle svg {
            width: 17px;
            height: 17px;
            fill: #020806;
        }

        .brand-text-h1 {
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .sidebar-menu-list {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            list-style: none;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.6rem 0.85rem;
            border-radius: 10px;
            color: #85988e;
            text-decoration: none;
            font-size: 0.84rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-nav-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .sidebar-nav-item i {
            font-size: 1.05rem;
            color: inherit;
        }

        .sidebar-nav-item:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.035);
        }

        .sidebar-nav-item.active {
            color: #ffffff;
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.22);
        }

        .sidebar-nav-item.active i {
            color: var(--uv-emerald);
        }

        .badge-live-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            background: rgba(0, 229, 153, 0.15);
            border: 1px solid rgba(0, 229, 153, 0.4);
            color: var(--uv-emerald);
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 9999px;
            box-shadow: 0 0 12px rgba(0, 229, 153, 0.25);
        }

        .dot-pulse-green {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--uv-emerald);
            box-shadow: 0 0 8px var(--uv-emerald);
            animation: pulseGlow 1.8s infinite;
        }

        @@keyframes pulseGlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.8); }
        }

        .wallet-indicator-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--uv-emerald);
            box-shadow: 0 0 8px var(--uv-emerald);
        }

        .sidebar-foot {
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
        }

        .btn-sidebar-logout {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            color: #ef4444;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            padding: 0.5rem 0.85rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .btn-sidebar-logout:hover {
            background: rgba(239, 68, 68, 0.08);
            color: #f87171;
        }

        /* ══════════════════════════════════════════════════════
           MAIN VIEWPORT (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .analytics-main-viewport {
            flex: 1;
            position: relative;
            z-index: 10;
            padding: 1.85rem 2.5rem 4rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            max-width: 1260px;
            margin: 0 auto;
            width: 100%;
        }

        /* ── Header Row ── */
        .analytics-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .analytics-head-left {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .analytics-title-wrap {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .analytics-title-wrap h1 {
            font-size: 1.85rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.4px;
        }

        .pill-badge-live {
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.35);
            color: var(--uv-emerald);
            font-family: 'Space Mono', monospace;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 0.15rem 0.55rem;
            border-radius: 9999px;
            letter-spacing: 0.05em;
        }

        .analytics-head-left p {
            font-size: 0.86rem;
            color: var(--uv-text-muted);
        }

        .analytics-head-right {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        /* Range Switcher Pill Group */
        .range-switcher-pill-group {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.025);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 9999px;
            padding: 0.2rem;
            gap: 0.2rem;
        }

        .range-pill-btn {
            padding: 0.45rem 1.15rem;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #85988e;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .range-pill-btn:hover {
            color: #ffffff;
        }

        .range-pill-btn.active {
            background: var(--uv-emerald);
            color: #020806;
            font-weight: 800;
            box-shadow: 0 0 14px rgba(0, 229, 153, 0.4);
        }

        .btn-export-csv {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #ffffff;
            border: none;
            color: #000000;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 0.55rem 1.25rem;
            border-radius: 9999px;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            transition: all 0.2s ease;
        }

        .btn-export-csv:hover {
            background: #f1f5f9;
            transform: translateY(-1px);
        }

        /* ══════════════════════════════════════════════════════
           TOP 3 STAT CARDS (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .analytics-stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.35rem;
            width: 100%;
        }

        @@media (max-width: 900px) {
            .analytics-stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card-box {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.4rem 1.5rem;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            position: relative;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .stat-card-box:hover {
            border-color: var(--uv-card-border-hover);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 229, 153, 0.1);
        }

        .stat-card-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .stat-card-label {
            font-size: 0.85rem;
            color: var(--uv-text-muted);
            font-weight: 500;
        }

        .stat-card-icon-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(0, 229, 153, 0.08);
            border: 1px solid rgba(0, 229, 153, 0.25);
            color: var(--uv-emerald);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .stat-card-val {
            font-size: 2.1rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            line-height: 1.1;
        }

        .stat-card-desc {
            font-size: 0.78rem;
            color: var(--uv-text-muted);
        }

        .stat-card-foot-trend {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.78rem;
            color: var(--uv-emerald);
            font-weight: 600;
            padding-top: 0.35rem;
        }

        .stat-card-foot-status {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.78rem;
            color: var(--uv-emerald);
            font-weight: 600;
            padding-top: 0.35rem;
        }

        .dot-status-green {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--uv-emerald);
            box-shadow: 0 0 8px var(--uv-emerald);
        }

        /* ══════════════════════════════════════════════════════
           SPENDING TREND CHART CONTAINER (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .chart-card-box {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.5rem 1.65rem 1.75rem;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            width: 100%;
        }

        .chart-head-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chart-head-title-group {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .chart-title-inner {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .chart-title-inner i {
            color: var(--uv-emerald);
            font-size: 1.15rem;
        }

        .chart-title-inner h2 {
            font-size: 1.15rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.2px;
        }

        .chart-head-title-group p {
            font-size: 0.8rem;
            color: var(--uv-text-muted);
        }

        .dropdown-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 0.35rem 0.85rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #ffffff;
            cursor: pointer;
            outline: none;
        }

        /* ── Spending Trend SVG Chart Area ── */
        .spending-chart-wrapper {
            position: relative;
            width: 100%;
            height: 240px;
        }

        .chart-svg-surface {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .grid-line-dashed {
            stroke: rgba(255, 255, 255, 0.04);
            stroke-dasharray: 4, 4;
            stroke-width: 1;
        }

        .axis-label-text {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            fill: #85988e;
        }

        /* Tooltip Popup on Chart Point */
        .chart-tooltip-bubble {
            position: absolute;
            background: #060d09;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 10px;
            padding: 0.5rem 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.8), 0 0 15px rgba(0, 229, 153, 0.2);
            pointer-events: none;
            transition: all 0.15s ease;
            z-index: 20;
        }

        .chart-tooltip-bubble .tt-date {
            font-size: 0.72rem;
            color: #85988e;
            font-weight: 600;
        }

        .chart-tooltip-bubble .tt-val {
            font-size: 0.95rem;
            color: #ffffff;
            font-weight: 800;
        }

        /* ══════════════════════════════════════════════════════
           TWO COLUMN CHARTS ROW (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .two-cols-charts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.35rem;
            width: 100%;
        }

        @@media (max-width: 950px) {
            .two-cols-charts-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Chart Legends */
        .chart-legend-strip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            font-size: 0.78rem;
            color: #85988e;
            padding-top: 0.5rem;
        }

        .legend-indicator-box {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            margin-right: 0.35rem;
        }

        .legend-box-red { background: var(--uv-red); }
        .legend-box-blue { background: var(--uv-blue); }
        .legend-box-green { background: var(--uv-emerald); }

        /* Donut Chart Layout */
        .donut-chart-container {
            display: flex;
            align-items: center;
            justify-content: space-around;
            gap: 1.5rem;
            padding: 1rem 0;
            flex-wrap: wrap;
        }

        .donut-svg-wrap {
            position: relative;
            width: 160px;
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .donut-center-metric {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            pointer-events: none;
        }

        .donut-center-metric .center-num {
            font-size: 2.2rem;
            font-weight: 900;
            color: #ffffff;
            line-height: 1;
        }

        .donut-center-metric .center-sub {
            font-size: 0.75rem;
            color: #85988e;
            margin-top: 0.2rem;
        }

        .donut-legend-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .donut-legend-item {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            font-size: 0.82rem;
            color: #ffffff;
            font-weight: 600;
        }

        .donut-legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .dot-green { background: var(--uv-emerald); box-shadow: 0 0 8px var(--uv-emerald); }
        .dot-blue { background: var(--uv-blue); box-shadow: 0 0 8px var(--uv-blue); }
        .dot-red { background: var(--uv-red); box-shadow: 0 0 8px var(--uv-red); }

        .donut-legend-count {
            color: #85988e;
            font-size: 0.8rem;
            margin-left: auto;
            padding-left: 1.5rem;
            font-family: 'Space Mono', monospace;
        }

        /* ══════════════════════════════════════════════════════
           5 KPI METRICS STRIP (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .kpi-strip-container {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.15rem 1.5rem;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1rem;
            width: 100%;
        }

        @@media (max-width: 900px) {
            .kpi-strip-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .kpi-metric-box {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .kpi-icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .icon-calc {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #60a5fa;
        }

        .icon-highest {
            background: rgba(0, 229, 153, 0.1);
            border: 1px solid rgba(0, 229, 153, 0.3);
            color: var(--uv-emerald);
        }

        .icon-lowest {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #fbbf24;
        }

        .icon-completed {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
        }

        .icon-cancelled {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #f87171;
        }

        .kpi-text-col {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }

        .kpi-label-text {
            font-size: 0.75rem;
            color: var(--uv-text-muted);
            font-weight: 500;
        }

        .kpi-value-text {
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        /* ══════════════════════════════════════════════════════
           RECENT ACTIVITY SECTION (MATCHING SCREENSHOT 1:1)
           ══════════════════════════════════════════════════════ */
        .recent-activity-card {
            background: var(--uv-card-bg);
            border: 1px solid var(--uv-card-border);
            border-radius: 18px;
            padding: 1.5rem 1.65rem;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            width: 100%;
        }

        .recent-activity-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .recent-activity-title-group {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .recent-activity-title-group i {
            color: var(--uv-emerald);
            font-size: 1.15rem;
        }

        .recent-activity-title-group h2 {
            font-size: 1.15rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.2px;
        }

        .btn-view-all-link {
            color: var(--uv-emerald);
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .btn-view-all-link:hover {
            opacity: 0.85;
            text-decoration: underline;
        }

        .activity-items-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .activity-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.015);
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.2s ease;
        }

        .activity-item-row:hover {
            background: rgba(255, 255, 255, 0.03);
            border-color: rgba(0, 229, 153, 0.2);
        }

        .activity-item-left {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .activity-icon-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.25);
            color: #60a5fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .activity-meta-col {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .activity-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: #ffffff;
        }

        .activity-sub-route {
            font-size: 0.78rem;
